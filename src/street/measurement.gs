/** Independent visible-building bounds. The candidate reader never sees source coordinates. */
function streetLandmarks105_(view){
 const schema={type:'OBJECT',properties:{buildings:{type:'ARRAY',minItems:3,maxItems:6,items:{type:'OBJECT',properties:{id:{type:'STRING'},label:{type:'STRING'},box:{type:'ARRAY',items:{type:'NUMBER'}}},required:['id','label','box']}}},required:['buildings']};
 const instruction='Locate 3 to 6 distinct visible building masses in this 3D viewport. Include the nearest building and separate buildings across the center and right distance. For each return its AXIS-ALIGNED VISIBLE bounding box [ymin,xmin,ymax,xmax] on the 0–1000 full-image scale, including black padding. Use the min/max coordinates of ALL visible pixels belonging to that building, including its side walls. Do not include shadows, people or adjacent buildings. A clipped building stops at the visible image-content border; never estimate hidden geometry. Bounding-box corners may lie in sky when the roof slopes: these are rectangular extents, NOT actual roof corner points. CRITICAL: labels MUST NOT mention any color, material, texture or historical name. Describe silhouette, relative size, left-to-right order, and neighboring buildings with enough detail to distinguish nearby small blocks from the prominent target. Color and texture will change later. Do not supply historical identities. Gray blocks are buildings. Output one box per distinct building, not per facade.';
 const out=streetJSON103_([{text:instruction},{inlineData:{mimeType:view.mime,data:view.data}}],schema,PropertiesService.getScriptProperties().getProperty('GEMINI_REVIEW_MODEL')||'gemini-3.1-pro-preview');
 const rows=(out.buildings||[]).map(r=>({...r,box:Array.isArray(r.box)?r.box.map(n=>n/1000):r.box})).filter(r=>typeof r.id==='string'&&typeof r.label==='string'&&streetBox105_(r.box));
 if(rows.length<3||new Set(rows.map(r=>r.id)).size!==rows.length||Math.max(...rows.map(r=>r.box[3]))-Math.min(...rows.map(r=>r.box[1]))<.35)throw new Error('REVIEW_UNAVAILABLE');return rows.slice(0,6);
}
function streetBox105_(box){return Array.isArray(box)&&box.length===4&&box.every(n=>Number.isFinite(n)&&n>=0&&n<=1)&&box[0]<box[2]&&box[1]<box[3];}
function streetMeasureCandidate105_(j,image){
 const schema={type:'OBJECT',properties:{buildings:{type:'ARRAY',items:{type:'OBJECT',properties:{id:{type:'STRING'},found:{type:'BOOLEAN'},box:{type:'ARRAY',items:{type:'NUMBER'}}},required:['id','found','box']}}},required:['buildings']};
 const instruction='Independently locate the described visible buildings in THIS proposed street image. You are not given the source image or its coordinates. Return each building AXIS-ALIGNED VISIBLE bounding box [ymin,xmin,ymax,xmax] on the 0–1000 full-image scale, INCLUDING black padding. The box is the min/max extent of all visible building pixels including side walls; do not include shadows, people or adjacent buildings. For clipped buildings use the visible image-content boundary. Never estimate hidden geometry. Bounding-box corners may lie in sky when the roof slopes; do NOT substitute a roof/wall junction for a rectangular box extent. Colors and textures may differ from the source. If a described building cannot be uniquely identified return found=false and box=[0,0,0,0]. Do not assume matching geometry or expected coordinates. Buildings: '+JSON.stringify(j.sourceLandmarks.map(r=>({id:r.id,label:r.label})));
 const out=streetJSON103_([{text:instruction},{inlineData:{mimeType:image.mime,data:image.data}}],schema,PropertiesService.getScriptProperties().getProperty('GEMINI_REVIEW_MODEL')||'gemini-3.1-pro-preview');
 const rows=(out.buildings||[]).map(r=>({...r,box:Array.isArray(r.box)?r.box.map(n=>n/1000):r.box})),matches=j.sourceLandmarks.map(a=>{const found=rows.filter(b=>b.id===a.id),b=found.length===1?found[0]:null;return {label:a.label,a:a.box,b:b?.box,found:b?.found===true&&streetBox105_(b.box)};});
 const valid=matches.filter(r=>r.found),errors=valid.flatMap(r=>r.a.map((n,i)=>Math.abs(n-r.b[i]))),anchors=valid.flatMap(r=>[{label:r.label+' · bounding extent min',a:[r.a[1],r.a[0]],b:[r.b[1],r.b[0]]},{label:r.label+' · bounding extent max',a:[r.a[3],r.a[2]],b:[r.b[3],r.b[2]]}]);
 return {approved:valid.length===matches.length&&valid.length>=3&&errors.every(e=>e<=.02),anchors:anchors,bounds:matches,maxAnchorError:errors.length?Math.max(...errors):null,missing:matches.filter(r=>!r.found).map(r=>r.label)};
}
/** Resolve a disputed correspondence against both images, retaining the same geometry limit. */
function streetResolveBounds105_(j,view,image,measured){
 const schema={type:'OBJECT',properties:{uncertain:{type:'BOOLEAN'},explanation:{type:'STRING'},buildings:{type:'ARRAY',items:{type:'OBJECT',properties:{id:{type:'STRING'},matched:{type:'BOOLEAN'},source:{type:'ARRAY',items:{type:'NUMBER'}},candidate:{type:'ARRAY',items:{type:'NUMBER'}}},required:['id','matched','source','candidate']}}},required:['uncertain','explanation','buildings']};
 const instruction='Resolve a DISPUTED building correspondence. IMAGE A is the fixed original viewport; IMAGE B is the generated candidate. An independent detector reported the bounding boxes below; its labels or coordinates may be wrong OR the candidate may have changed the geometry. Do not assume either conclusion. Identify the SAME PHYSICAL visible building using silhouette, relative order, size and neighbors, ignoring color/material. Independently read its full visible axis-aligned bounding box in BOTH images as [ymin,xmin,ymax,xmax] on the 0–1000 full-image scale including black padding. Include all visible facades, but exclude shadows, people and adjacent buildings. For sloped roofs measure rectangular extents, not roof/wall junctions. If the target is missing, replaced, enlarged or moved report the actual difference; never choose a nearby different building to make coordinates agree. Never copy source coordinates into candidate coordinates. Return all source IDs exactly once, matched=false when identification fails, and uncertain=true if comparison cannot be resolved. Explain the visual evidence for each corrected correspondence or actual geometric change. Source targets: '+JSON.stringify(j.sourceLandmarks)+' Independent disputed measurements: '+JSON.stringify(measured.bounds);
 const out=streetJSON103_([{text:instruction},{text:'IMAGE A — original fixed viewport'},{inlineData:{mimeType:view.mime,data:view.data}},{text:'IMAGE B — proposed candidate'},{inlineData:{mimeType:image.mime,data:image.data}}],schema,PropertiesService.getScriptProperties().getProperty('GEMINI_REVIEW_MODEL')||'gemini-3.1-pro-preview');
 const boxes=out.buildings||[],anchors=[],errors=[];let valid=out.uncertain===false&&boxes.length===j.sourceLandmarks.length;
 for(const target of j.sourceLandmarks){const matches=boxes.filter(r=>r.id===target.id),r=matches.length===1?matches[0]:null,a=r?.source?.map(n=>n/1000),b=r?.candidate?.map(n=>n/1000);if(!r?.matched||!streetBox105_(a)||!streetBox105_(b)){valid=false;continue;}const sourceError=Math.max(...a.map((n,i)=>Math.abs(n-target.box[i])));if(sourceError>.02)valid=false;errors.push(...a.map((n,i)=>Math.abs(n-b[i])));anchors.push({label:target.label+' · min',a:[a[1],a[0]],b:[b[1],b[0]]},{label:target.label+' · max',a:[a[3],a[2]],b:[b[3],b[2]]});}
 return {approved:valid&&errors.length>=12&&errors.every(e=>e<=.02),anchors:anchors,maxAnchorError:errors.length?Math.max(...errors):null,uncertain:out.uncertain!==false,explanation:String(out.explanation||'').slice(0,3000)};
}
