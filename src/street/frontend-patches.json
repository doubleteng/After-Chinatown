.milestone-description{font-size:9.8px!important}\n#mobile-map-sheet .map-coverage-warning{font-size:14px!important}\n\n/* User-drawn regions: camera capture, ellipse coordinates and notes share one frame. */\n#street-note-tools104{position:absolute;right:12px;top:12px;z-index:72;display:flex;flex-wrap:wrap;gap:6px;max-width:calc(100% - 120px)}\n#street-note-tools104 button,#street-note-editor104 button,#street-note-summary104 button{font:12px/1.4 system-ui;color:#244d3a;border:1px solid #9aaa98;border-radius:5px;background:#fffef6;padding:8px 11px;cursor:pointer;min-height:36px}\n#street-note-tools104 button:disabled{opacity:.55;cursor:default}\n#street-note-tools104[hidden],#street-note-tools104 [hidden],#street-note-pane104[hidden],#street-note-editor104[hidden]{display:none!important}\n#street-note-pane104{position:absolute;inset:0;z-index:67;background:#e1e5d9;overflow:hidden}\n#street-note-frame104,#street-note-canvas104{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}\n#street-note-frame104{pointer-events:none}#street-note-canvas104{touch-action:none;cursor:pointer}#street-note-pane104[data-drawing=true] #street-note-canvas104{cursor:crosshair}\n#street-note-hint104{position:absolute;bottom:12px;left:12px;margin:0;padding:7px 10px;max-width:55%;font:12px/1.5 system-ui;background:#fffff1e8;color:#344737;pointer-events:none;border-radius:4px}\n#street-note-editor104{position:absolute;right:12px;bottom:12px;z-index:73;width:min(330px,calc(100% - 24px));box-sizing:border-box;background:#fffef7;border:1px solid #91a48f;border-top:3px solid #b35435;border-radius:6px;padding:12px;box-shadow:0 4px 18px #0002;color:#243d30;text-align:left;font:12px/1.5 system-ui;max-height:calc(100% - 70px);overflow:auto}\n.street-note-title104{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:7px}#street-note-editor104 label{display:block;margin:7px 0 4px}#street-note-editor104 textarea,#street-note-editor104 input{width:100%;box