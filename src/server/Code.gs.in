ientRect().top+6;\n   for(const id of ['atlas-controls74','source-category-bar75']){const node=document.getElementById(id);if(node)node.style.top=top+'px';}\n  }\n  function open(name){\n   root.dataset.embedPanel=name;\n   for(const button of buttons)button.setAttribute('aria-expanded',String(button.dataset.panel===name));\n   if(name)positionPanels();\n  }\n  for(const [name,en,zh,id] of [['layers','Layers','\u56fe\u5c42','atlas-controls74'],['sources','Sources','\u53f2\u6599','source-category-bar75']]){\n   const button=document.createElement('button');button.type='button';button.className='button quiet embed-panel-toggle85';button.dataset.panel=name;button.dataset.noTranslate='';button.dataset.en=en;button.dataset.zh=zh;button.setAttribute('aria-controls',id);button.setAttribute('aria-expanded','false');\n   button.onclick=()=>open(root.dataset.embedPanel===name?'':name);actions.prepend(button);buttons.push(button);\n  }\n  const help=document.createElement('p');help.className='embed-help85';help.dataset.noTranslate='';document.getElementById('atlas-controls74').append(help);\n  function labels(){\n   const zh=window.AtlasI18n?.language()==='zh';\n   for(const button of buttons)button.textContent=button.dataset[zh?'zh':'en'];\n   help.textContent=zh?'\u6eda\u8f6e\u7f29\u653e\uff1b\u62d6\u52a8\u65cb\u8f6c\uff1b\u53cc\u51fb\u8fdb\u5165\u8857\u666f\u3002WASD \u79fb\u52a8\uff0cQ/E \u5347\u964d\uff0cShift \u52a0\u901f\u3002\u5386\u53f2\u8986\u76d6\u4e0d\u5b8c\u6574\uff0c\u7070\u8272\u4f53\u5757\u4e3a\u6682\u5b9a\u6a21\u578b\u3002':'Scroll to zoom; drag to orbit; double-click for street view. WASD to move, Q/E up/down, Shift to move faster. Historical coverage is partial; gray footprints are provisional.';\n  }\n  labels();window.addEventListener('atlas-language-changed',labels);\n  document.addEventListener('pointerdown',event=>{\n   if(root.dataset.compactAtlas==='true'||!root.dataset.embedPanel)return;\n   if(!event.target.closest('#atlas-controls74,#source-category-bar75,.embed-panel-toggle85'))open('');\n  },true);\n  window.addEventListener('keydown',event=>{\n   if(event.key==='Escape'&&root.dataset.embedPanel){event.preventDefault();event.stopImmediatePropagation();const selected=buttons.find(b=>b.dataset.panel===root.dataset.embedPanel);open('');selected?.focus();}\n  },true);\n  // Keep the existing mobile sheet and its original control nodes intact.\n  const media=matchMedia('(max-width:760px), (pointer:coarse)');\n  media.addEventListener('change',()=>{open('');for(const id of ['atlas-controls74','source-category-bar75'])document.getElementById(id)?.style.removeProperty('top');});\n  window.addEventListener('resize',()=>{if(root.dataset.embedPanel)positionPanels();});\n  root.dataset.workspaceVersion='85';\n  window.dispatchEvent(new Event('resize'));\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();\n})();\n</script>";}

