oint":[-83.059993,42.343715],"tagHeight":32,"periods":[{"label":"Shanghai Café · opened in the 1930s ≈","uncertain":true,"note":"Opening somewhere within the 1930s; exact date not established.","from":1930,"through":1938},{"label":"Shanghai Café","note":"By the end of the 1930s through 1981, as reported in the City StoryMap.","from":1939,"through":1981}],"sources":[{"url":"https://storymaps.arcgis.com/stories/66fbeec68dba4b5f98f0ff2560586a4d","title":"City of Detroit · Chinatown StoryMap"}]},{"id":"r59-2953P","name":"2753 Park, William E. Cole House","point":[-83.05719754403317,42.34200860053498],"periods":[{"label":"2753 Park, William E. Cole House ≈","from":1900,"through":2016,"uncertain":true,"note":"Cole House existed by the 1880s; converted from two-storey house to three-storey apartment building with a 1910s facade. Inventory says 1905 construction and 2017 demolition; construction field conflicts. Page confirms absent by June 2026. No historical facade photograph retrieved."}],"sources":[{"title":"Cass Park designation report / inventory","url":"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2953P"}],"note":"Cole House existed by the 1880s; converted from two-storey house to three-storey apartment building with a 1910s facade. Inventory says 1905 construction and 2017 demolition; construction field conflicts. Page confirms absent by June 2026. No historical facade photograph retrieved."},{"id":"r59-131T","name":"131 Temple, Will Mar Garage","point":[-83.05761292881037,42.341890249709884],"periods":[{"label":"131 Temple, Will Mar Garage ≈","from":1924,"through":2016,"uncertain":true,"note":"Will Mar Garage: 1924 in designation-report narrative, 1925 in inventory. Two floors and four facade bays described, but no photograph retrieved. Inventory records demolition in 2017; the 2018 eight-storey replacement is a separate building."}],"sources":[{"title":"Cass Park designation report / inventory","url":"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#131T"}],"note":"Will Mar Garage: 1924 in designation-report narrative, 1925 in inventory. Two floors and four facade bays described, but no photograph retrieved. Inventory records demolition in 2017; the 2018 eight-storey replacement is a separate building."},{"id":"r59-seville","name":"Seville / Forbidden City","point":[-83.06178044253058,42.34294763569128],"periods":[{"label":"Forbidden City · June 1967 photograph","from":1967,"through":1967,"note":"Yee family photo; print border JUN 67."},{"label":"Seville residents · recollection ≈","from":1975,"through":1982,"uncertain":true,"note":"Norm Norm’s self-reported residence interval."}],"sources":[{"title":"Seville / Forbidden City · source","url":"https://www.facebook.com/groups/1654599778116222/posts/4249779495264891/"}],"note":"Sources, dates and uncertainties recorded in archive tags."},{"id":"r59-whitegrove","name":"White Grove","point":[-83.06207359928547,42.34286928471559],"periods":[{"label":"White Grove · restaurant ≈","from":1948,"through":2013,"uncertain":true,"note":"Local history gives presence by 1948 and closure around 2013."},{"label":"White Grove · reopening reported","from":2026,"through":2026,"note":"June 2026 update by Eric Hergenreder."}],"sources":[{"title":"White Grove · source","url":"https://www.eherg.com/locations/3131-2nd-avenue"}],"note":"Sources, dates and uncertainties recorded in archive tags."},{"id":"r67-gold-dollar-merchants","name":"Gold Dollar building","point":[-83.05991831268842,42.3434162490397],"tagHeight":10,"periods":[{"label":"Gold Dollar · bar ≈","labelZh":"Gold Dollar · 酒吧 ≈","through":1955,"uncertain":true,"note":"Early bar period recalled by Neil Yee; exact opening unverified.","from":1935},{"label":"Gold Dollar · gay / drag-show bar ≈","labelZh":"Gold Dollar · 同性恋／变装表演酒吧 ≈","through":1988,"uncertain":true,"note":"Period reported retrospectively by Neil Yee. A 1963 newspaper independently describes female impersonators.","from":1956},{"label":"Gold Dollar → Cartell’s Lounge · bar · name transition ≈","labelZh":"Gold Dollar → Cartell’s Lounge · 酒吧·改名阶段 ≈","through":1990,"uncertain":true,"note":"Cartell’s operated for about one year after Gold Dollar. Boundary years uncertain.","from":1989},{"label":"Former Cartell’s Lounge · closed premises ≈","labelZh":"原 Cartell’s Lounge · 停业建筑 ≈","through":1993,"uncertain":true,"note":"Closure followed Cartell’s; exact dates unknown.","from":1991},{"label":"Gold Dollar · Neil Yee · acquisition / preparation ≈","labelZh":"Gold Dollar · Neil Yee · 接手／筹备 ≈","through":1995,"uncertain":true,"note":"Neil Yee recalled taking over in late 1994 or early 1995.","from":1994},{"label":"Gold Dollar · live music venue","labelZh":"Gold Dollar · 现场音乐场所","through":2000,"uncertain":false,"note":"Reopened by Neil Yee in 1996; final performance on 18 August 2001.","from":1996},{"label":"Gold Dollar · closed · former music venue","labelZh":"Gold Dollar · 已关闭 · 原音乐场所","through":2018,"uncertain":false,"note":"End-of-year view shows closure, not demolition. The building was photographed in 2016.","from":2001}],"sources":[{"title":"Melissa Giannini · interview with Neil Yee","url":"https://www.melissagiannini.com/hip-hole-in-the-wall-the-gold-dollar"},{"title":"Detroit Free Press · The New Chinatown, 3 November 1963","url":"https://www.arcgis.com/sharing/rest/content/items/66fbeec68dba4b5f98f0ff2560586a4d/resources/ccnWLEGFqm0m-P5UlF2du.jpeg"},{"title":"Curtis Chin interview · Pride Source, 2023","url":"https://pridesource.com/article/detroits-chinatown-has-vanished-but-this-queer-writer-keeps-the-memories-alive-in-new-memoir"},{"title":"Gold Dollar · final performance announcement","url":"https://www.golddollar.com/oldbar/closing.html"}],"note":"Occupant history and building survival are separate; an observation year does not imply a one-year business lifespan."},{"id":"r52-cass3124-merchants","name":"3124–3130 Cass storefronts","point":[-83.05920161132349,42.343488584145625],"tagHeight":10,"periods":[{"label":"Maharajah Restaurant / Kuwahara Trading · Indian restaurant / food store","labelZh":"Maharajah 餐厅／Kuwahara Trading · 印度餐馆／食品商店","through":1976,"uncertain":false,"note":"Photograph reads Maharajah Restaurant / India Food Boutique, 3130; Kuwahara Trading / Oriental Foods, 3126. Shared frontage matched provisionally to the 3124 inventory building beside 3136.","from":1976}],"sources":[{"title":"Maharajah / Kuwahara · photograph captioned 1976, WSU Reuther credit","url":"https://www.arcgis.com/sharing/rest/content/items/66fbeec68dba4b5f98f0ff2560586a4d/resources/IBb-UrMOd5hj1wm37CXCM.jpeg"}],"note":"Occupant history and building survival are separate; an observation year does not imply a one-year business lifespan."}]};
 function applySpatial(spatial){
  if(spatial.merchantHistoryVersion===data.version)return spatial;
  for(const b of spatial.buildings)if(data.buildingPatches[b.id])Object.assign(b,data.buildingPatches[b.id]);
  for(const b of data.newBuildings)if(!spatial.buildings.some(x=>x.id===b.id))spatial.buildings.push(JSON.parse(JSON.stringify(b)));
  Object.assign(spatial.addressReview.records,data.addressUpdates);
  spatial.addressReview.sources.R67_GOLD_ADDRESS={label:'Gold Dollar · 3129 Cass · Neil Yee interview',url:data.sources['gold-history'].url};
  spatial.storyPlaces=JSON.parse(JSON.stringify(data.storyPlaces));
  spatial.merchantHistoryVersion=data.version;
  return spatial;
 }
 function history(b){return data.histories[b.id]||b.merchantHistory||null;}
 function active(b,year){return (history(b)?.phases||[]).filter(p=>year>=p.fromYear&&year<=p.throughYear);}
 function name(b,year,zh=false){
  const h=history(b),phases=active(b,year),tr=(a,c)=>zh?c:a;
  if(phases.length)return phases.map(p=>(zh?p.nameZh:p.name)+' · '+(zh?p.categoryZh:p.category)+(p.approximate?' ≈':'')+(p.observedOnly?tr(' · observed '+year,' · '+year+' 年有记录'):'' )).join(' / ');
  if(h)return tr(h.buildingName,h.buildingNameZh)+tr(' · tenant in '+year+' unverified',' · '+year+' 年租户待考');
  const named=b.reviewed_name||b.name;
  return named&&!/^(Source-map|mapped|Building trace|Inventory building)/i.test(named)?named:tr('Building name unverified','建筑名称待考');
 }
 function label(b,year,address,zh=false){const n=name(b,year,zh),a=history(b)?.address||address;return n.toLowerCase()===a.toLowerCase()?n:n+' · '+a;}
 function aliases(b){const h=history(b);return h?[h.buildingName+' · '+h.address,...h.phases.map(p=>p.name+' · '+h.address),...h.phases.map(p=>p.nameZh+' · '+h.address)]:[];}
 function panel(b,year,zh,onYear){
  const h=history(b);if(!h)return null;
  const tr=(a,c)=>zh?c:a,root=document.createElement('section');root.className='merchant-history';root.setAttribute('data-no-translate','');
  const head=document.createElement('h3');head.textContent=tr('Businesses at this building','建筑内商铺与用途');root.append(head);
  for(const p of h.phases){
   const row=document.createElement('div');row.className='merchant-phase';row.dataset.active=String(year>=p.fromYear&&year<=p.throughYear);
   const jump=document.createElement('button');jump.type='button';jump.textContent=p.dateLabel+(p.approximate?' ≈':'');jump.onclick=()=>onYear(p.fromYear);row.append(jump);
   const title=document.createElement('strong');title.textContent=(zh?p.nameZh:p.name)+' · '+(zh?p.categoryZh:p.category);row.append(title);
   const note=document.createElement('p');note.textContent=zh?p.noteZh:p.note;row.append(note);
   for(const key of p.sourceKeys){const s=data.sources[key],a=document.createElement('a');a.textContent=s.title+' ↗';a.href=s.url;a.target='_blank';a.rel='noopener noreferrer';row.append(a);}
   root.append(row);
  }
  for(const n of (zh?h.notesZh:h.notes)||[]){const p=document.createElement('p');p.className='small';p.textContent=n;root.append(p);}
  return root;
 }
 return {data,applySpatial,history,active,name,label,aliases,panel};
})();

function archivePage_(){return __HTML_ARCHIVE__; }


/** Round 37: only reviewed seed image IDs; unlocated photos remain viewable in the archive. */
function getRound37Image_(id){
 if(typeof id!=='string'||id.length>160)return fail_('INVALID','Invalid record.');
 const r=archiveSeed_().records.find(x=>x.id===id&&x.integrated_round===37&&x.has_private_image&&x.source_kind!=='generated');
 if(!r||!r.drive_file_id||!r.sha256)return fail_('NOT_FOUND','Image not found.');
 try{const f=DriveApp.getFileById(r.drive_file_id);if(f.isTrashed())return fail_('UNAVAILABLE','Image unavailable.');const b=f.getBlob(),mime=b.getContentType().split(';')[0],bytes=b.getBytes();if(!/^image\/(jpeg|png|webp)$/.test(mime)||bytes.length>10000000)return fail_('UNAVAILABLE','Image unavailable.');const digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(x=>('0'+(x&255).toString(16)).slice(-2)).join('');if(digest!==r.sha256)return fail_('REVISED','Image source changed.');return {ok:true,mime:mime,data:Utilities.base64Encode(bytes)};}catch(_){return fail_('UNAVAILABLE','Image unavailable.');}
}


/** Serve only the fixed public datasets and reviewed map rasters already published by this app. */
function getAtlasAsset(request) {
  if (!request || typeof request !== 'object' || !['spatial','activity','raster'].includes(request.kind)) return fail_('INVALID','Unknown map resource.');
  if (request.kind === 'raster') {
    if (typeof request.id !== 'string' || request.id.length > 120) return fail_('INVALID','Invalid map image.');
    const images = atlasRasterImages_();
    if (!Object.prototype.hasOwnProperty.call(images,request.id)) return fail_('NOT_FOUND','Map image unavailable.');
    return {ok:true,version:BUILD_,encoding:'data-url',data:images[request.id]};
  }
  if (!['gzip','json'].includes(request.encoding)) return fail_('INVALID','Unknown map encoding.');
  const spatial = request.kind === 'spatial';
  return {ok:true,version:BUILD_,encoding:request.encoding,data:request.encoding==='gzip'?(spatial?spatialPayload_():activityPayload_()):(spatial?spatialData_():activityData_())};
}

/** Archive lists need enriched records, not the complete building and road geometry again. */
function getArchiveIndex() {
  const out = getArchive();
  out.records = Spatial.enrich(out.records,spatialData_());
  return out;
}

function spatialPayload_(){return __GZIP_SPATIAL__;}
function activityPayload_(){return __GZIP_ACTIVITY__;}
function atlasRasterImages_(){return __DATA_RASTERS__;}

function getRound54Image_(id){return fail_('NOT_INCLUDED','Archival image bytes are not distributed with the source release.');}

