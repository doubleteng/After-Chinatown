function archiveSeed_(){return __DATA_ARCHIVE__;}

function evidenceData_(){return __DATA_EVIDENCE__;}

let spatialData_cached;function spatialData_(){return spatialData_cached||(spatialData_cached=CassCorridorResearch87.applySpatial(applyHeatherSpatial81(MerchantHistory.applySpatial(JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(spatialPayload_()),"application/gzip")).getDataAsString())))));}

function timelineData_(){return __DATA_TIMELINE__;}

let activityData_cached;function activityData_(){return activityData_cached||(activityData_cached=JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(activityPayload_()),"application/gzip")).getDataAsString()));}

function page_(){return __HTML_MAP__; }

