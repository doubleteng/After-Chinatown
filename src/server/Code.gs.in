 function labelTier(r){if(r.label_tier)return r.label_tier;if(r.kind==='freeway'||r.width>=28)return 1;if(r.width>=18)return 2;if(r.width<=7)return 4;return 3;}
 function labelVisible(tier,distance,height){const ranges={1:[9500,8500],2:[3200,2300],3:[1000,650],4:[330,180]},r=ranges[tier]||ranges[3];return distance<r[0]&&height<r[1];}
 function labelPoints(r,surface){const pts=r.points||[];if(pts.length<2)return pts;const polygons=surface?(surface.segments||[{polygons:surface.polygons||[]}]).flatMap(s=>s.polygons):null,inside=(p,ring)=>{let hit=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const a=ring[i],b=ring[j];if((a[1]>p[1])!==(b[1]>p[1])&&p[0]<(b[0]-a[0])*(p[1]-a[1])/(b[1]-a[1])+a[0])hit=!hit;}return hit;},usable=p=>!polygons||polygons.some(poly=>inside(p,poly[0])&&!poly.slice(1).some(ring=>inside(p,ring)));const out=[];for(let i=1;i<pts.length;i++){const a=pts[i-1],b=pts[i],len=Math.hypot((b[0]-a[0])*82200,(b[1]-a[1])*111320),n=Math.max(1,Math.ceil(len/350));for(let j=0;j<n;j++){for(const f of surface?[.5,.35,.65,.2,.8,.05,.95]:[.5]){const t=(j+f)/n,p=[a[0]+t*(b[0]-a[0]),a[1]+t*(b[1]-a[1])];if(usable(p)){out.push(p);break;}}}}return out;}
 function continuous(r,year){return !!(r.continuity&&r.continuity.from<=year&&r.continuity.through>=2026&&r.continuity.sourceIds?.length>=2);}
 function segments(rows){return rows.flatMap(r=>(r.points||[]).slice(1).map((p,i)=>({road:r,a:r.points[i],b:p})));}
 function changes(data,year,district){return(data.roadEvents||[]).filter(r=>r.event_year!==null&&r.event_year!==undefined&&r.event_year<=year&&r.event_type!=='dedication'&&(!district||r.district===district));}
 const indexes=new WeakMap();
 function index(data){if(!indexes.has(data))indexes.set(data,new Map((data.roadEvents||[]).map(r=>[r.id,r])));return indexes.get(data);}
 function rightOfWay(data,year,district){const records=index(data);return(data.roadROW||[]).filter(r=>r.from<=year&&(r.to===null||year<=r.to)).map(r=>{const event=records.get(r.event_id);return event?{...event,id:r.id,event_id:event.id,polygons:r.polygons,area_m2:r.area_m2,status:'legal-reference'}:null;}).filter(r=>r&&(!district||r.district===district));}
 function evidence(data,year,point,limit=8){const distance=r=>{if(!point)return 0;let best=Infinity;const sx=111320*Math.cos(point[1]*Math.PI/180),sy=111320;
  for(const polygon of r.polygons||[])for(const ring of polygon)for(let i=1;i<ring.length;i++){const a=[(ring[i-1][0]-point[0])*sx,(ring[i-1][1]-point[1])*sy],b=[(ring[i][0]-point[0])*sx,(ring[i][1]-point[1])*sy],dx=b[0]-a[0],dy=b[1]-a[1],t=Math.max(0,Math.min(1,-(a[0]*dx+a[1]*dy)/(dx*dx+dy*dy||1)));best=Math.min(best,Math.hypot(a[0]+t*dx,a[1]+t*dy));}return best;};
  return(data.roadEvents||[]).filter(r=>r.event_year!=null&&r.event_year<=year).map(r=>({r,d:distance(r)})).sort((a,b)=>a.d-b.d||b.r.event_year-a.r.event_year).slice(0,limit).map(({r,d})=>({id:r.id,name:r.name,event_type:r.event_type,event_year:r.event_year,event_date:r.event_date,distance_m:Math.round(d),sourceIds:r.sourceIds,source_url:r.source_url,decision_url:r.decision_url,date_review:r.date_review,physical_state:r.physical_state}));}
 function physicalState(r,year){if(r.removal){if(year>=Number(r.removal.changed_by))return 'changed-by-observation';if(year>Number(r.removal.last_mapped))return 'removal-date-unresolved';return 'mapped-observation';}const y=Number(r.opening?.date.slice(0,4));if(year>=y)return r.opening.type==='opened_on'?'opening-documented':'in-service-documented';return r.opening?.type==='opened_on'?'before-documented-opening':'earlier-status-unresolved';}
 function physicalEvidence(data,year,point,limit=9){return(data.roadPhysicalReviews||[]).map(r=>({...r,selected_year_state:physicalState(r,year),distance_m:point?Math.round(Math.hypot((r.point[0]-point[0])*111320*Math.cos(point[1]*Math.PI/180),(r.point[1]-point[1])*111320)):0})).sort((a,b)=>a.distance_m-b.distance_m).slice(0,limit);}
 function context(data,year,point,district){const s=summary(data,year,district);return{year,surveys:s.surveys,observed:s.observed,reference:s.reference,legalFootprints:s.legalFootprints,changeTraces:s.changeTraces,nearbyLegalRecords:evidence(data,year,point),physicalReviews:physicalEvidence(data,year,point,5),registrationReviews:data.mapRegistrationReviews||[],method:data.roadRecordMethod,physicalReviewMethod:data.roadPhysicalReviewMethod};}
 return{labelPoints,changes,rightOfWay,evidence,physicalState,physicalEvidence,context,snapshot,snapshots,visible,summary,segments,continuous,labelTier,labelVisible};
})();
if(typeof module!=='undefined')module.exports=Roads;

