 if(spatial.addressReview){for(const k of r.sources)spatial.addressReview.sources[k]=CharlotteReference83.sources[k];spatial.addressReview.records[r.id]={...spatial.addressReview.records[r.id],address:r.address+' · '+r.name,inventoryAliases:r.aliases,sourceIds:r.sources};}}
 const review=spatial.roadAlignmentReview;if(review){Object.assign(review.buildingGeometries,CharlotteReference83.clearance.geometries);for(const [y,changes] of Object.entries(CharlotteReference83.clearance.years))review.buildingYears[y]={...(review.buildingYears[y]||{}),...changes};}
 spatial.charlotte83=CharlotteReference83.version;return spatial;
}

function mapOnlyHead84_(){return "<script>document.documentElement.dataset.mapOnly='true';\nwindow.addEventListener('keydown',function(event){\n const config=window.ATLAS_PAGE;\n if(event.key==='Escape'&&config?.mapOnly&&config.domainOrigin)window.top.postMessage({type:'afterchinatown:embed-escape'},config.domainOrigin);\n});\n(()=>{\n function init(){\n  if(!window.ATLAS_PAGE?.mapOnly)return;\n  const root=document.documentElement,panel=document.querySelector('section.window'),toolbar=panel?.querySelector('.atlas-toolbar'),actions=panel?.querySelector('.map-window-actions');\n  if(!panel||!toolbar||!actions)return;\n  const style=document.createElement('style');style.id='embed-workspace85';style.textContent=\"html[data-map-only=true]:not([data-compact-atlas=true]) .atlas-toolbar{padding:5px 9px;gap:5px;min-height:46px}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) .atlas-travel{flex:1 1 330px;min-width:250px}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) .atlas-address-wrap{min-width:160px}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) .map-window-actions{gap:4px;flex-wrap:nowrap}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) .map-window-actions .button{padding:5px 7px;min-height:32px}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) .embed-panel-toggle85[aria-expanded=true]{background:#35675b;color:white}\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) #atlas-controls74,\\nhtml[data-map-only=true]:not([data-compact-atlas=true]) #source-category-bar75{display:none!important;position:absolute!important;z-index:85;top:55px;left:auto;right:10px;bottom:auto;width:min(620px,calc(100% - 20px));max-width:calc(100% - 20px);max-height:calc(100% - 160px);margin:0;padding:10px;background:#fffef9;border:1px solid #bdc9b9;border-radius:7px;box-shadow:0 7px 26px #243d3930;overflow:auto}\\nhtml[data-map-only=true][data-embed-panel=layers]:not([data-compact-atlas=true]) #atlas-controls74,\\nhtml[data-map-only=true]