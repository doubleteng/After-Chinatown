/* Fixed, reviewed photo IDs only; no arbitrary Drive file reader. */
function getRound98Image_(id){return fail_('NOT_INCLUDED','Archival image bytes are not distributed with the source release.');}
function getHoverImage(id){if(/^R100_CASS2712_PHOTO_(2015|2017|2019|2022)$/.test(id))return getRound100Image_(id);if(/^R99_COLE_(FRONT|SIDE)_(2005|2014)$/.test(id))return getRound99Image_(id);if(id==="R98_CASS3124_2014_PHOTO")return getRound98Image_(id);if(typeof id==='string'&&id.startsWith('R59_'))return getRound59Image_(id);if(id==='R58_KIOSK_STREETVIEW')return getRound58Image_(id);if(typeof id==='string'&&id.startsWith('R57_'))return getRound57Image_(id);if(typeof id==='string'&&id.startsWith('R56_'))return getRound56Image_(id);if(typeof id==='string'&&id.startsWith('R55_'))return getRound55Image_(id);if(typeof id==='string'&&id.startsWith('R54_'))return getRound54Image_(id);
 if(typeof id!=='string'||id.length>160)return fail_('INVALID','Invalid record.');
 const r=archiveSeed_().records.find(x=>x.id===id),d=archiveHoverData_().records[id];
 if(!r||!d||!d.location||r.source_kind==='generated')return fail_('NOT_FOUND','Source unavailable.');
 if(d.drive_file_id){try{const f=DriveApp.getFileById(d.drive_file_id);if(f.isTrashed())return fail_('UNAVAILABLE','Image unavailable.');const b=f.getBlob(),mime=b.getContentType().split(';')[0],bytes=b.getBytes();if(!/^image\/(jpeg|png|webp)$/.test(mime)||bytes.length>10000000)return fail_('UNAVAILABLE','Image unavailable.');if(r.sha256){const digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(x=>('0'+(x&255).toString(16)).slice(-2)).join('');if(digest!==r.sha256)return fail_('REVISED','Image source changed.');}return {ok:true,mime:mime,data:Utilities.base64Encode(bytes)};}catch(_){}}
 if(id.startsWith('R31_EXISTING_')||(d.integrated_round===34||d.integrated_round===35||d.integrated_round===36||d.integrated_round===37||d.integrated_round===51||d.integrated_round===52))return fail_('UNAVAILABLE','Image unavailable.');
 return getArchiveImage(id);
}

/* Shared question dates. A street number must not move the historical timeline. */
const HistoryQuery=(()=>{
 const minYear=1900,maxYear=2026;
 const messages={
  BAD_INPUT:['Enter a question of 1–500 characters.','请输入 1–500 字的历史问题。'],
  MULTIPLE_YEARS:['Ask about one year at a time.','请每次询问一个年份。'],
  YEAR_INTERVAL:['Choose one exact year for this question; a decade cannot select one map view.','请指定一个确切年份；年代范围无法对应一个地图视图。'],
  BAD_YEAR:['The map covers 1900–2026. Browse the archive for earlier material.','地图涵盖 1900–2026 年。更早的资料可在档案中查阅。']
 };
 function message(code,language){return (messages[code]||messages.BAD_INPUT)[language==='zh'?1:0];}
 function resolve(value,currentYear){
  const question=typeof value==='string'?value.trim():'';
  if(!question||question.length>500)return {ok:false,code:'BAD_INPUT'};
  const normalized=question.replace(/[０-９]/g,c=>String(c.charCodeAt(0)-0xff10));
  const years=new Set();let interval=false;
  const tokens=normalized.matchAll(/(?:^|[^\d])((?:1\d|20|21)\d{2})(?!\d)/g);
  for(const match of tokens){
   const index=match.index+match[0].length-4,before=normalized.slice(0,index),after=normalized.slice(index+4);
   // Four digits inside identifiers are not calendar years. Chinese 年 is explicit.
   const explicit=/^\s*年(?!代)/.test(after);
   if(!explicit&&(/[A-Za-z_]$/.test(before)||/^[A-Za-z_]/.test(after)&&!/^s\b/i.test(after)))continue;
   const address=/^\s*(?:号|號)/.test(after)||
    /^\s*(?:Cass|Peterboro|Third|Porter|Bagley|Woodward|Michigan|Trumbull|Grand River)\b/i.test(after)||
    /^\s+(?:[A-Z][A-Za-z.'’\-]*\s+){1,4}(?:Street|St\.?|Avenue|Ave\.?|Road|Rd\.?|Boulevard|Blvd\.?|Drive|Dr\.?|Lane|Ln\.?|Way|Court|Ct\.?)\b/.test(after)||
    /(?:address|street\s+number|门牌(?:号)?|地址)\s*[:：#]?\s*$/i.test(before);
   if(address&&!explicit)continue;
   if(/^\s*(?:s\b|年代)/i.test(after))interval=true;
   years.add(Number(match[1]));
  }
  if(years.size>1)return {ok:false,code:'MULTIPLE_YEARS'};
  if(interval)return {ok:false,code:'YEAR_INTERVAL'};
  const year=years.size?[...years][0]:Number(currentYear);
  if(!Number.isInteger(year)||year<minYear||year>maxYear)return {ok:false,code:'BAD_YEAR'};
  return {ok:true,question,year,explicitYear:years.size===1};
 }
 return {minYear,maxYear,message,resolve};
})();
if(typeof module!=='undefined')module.exports=HistoryQuery;

/** Owner-only diagnostics. Never log credentials or generated image bytes. */
