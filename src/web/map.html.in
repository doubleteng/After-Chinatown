<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"}}</script>
<style>.archive-hover-controls{display:flex;align-items:center;gap:10px 16px;flex-wrap:wrap;padding:9px 18px;border-bottom:1px solid #d4dcd7;background:#f4f6f0;color:#25483f;font:12px/1.4 system-ui}.archive-hover-controls label{display:flex;align-items:center;gap:7px;margin:0}.archive-hover-controls select,.archive-hover-controls input[type=date]{font:inherit;padding:5px;border:1px solid #bacbc2;background:white;border-radius:5px;max-width:185px}.archive-hover-controls input[type=checkbox]{width:15px;height:15px;margin:0;accent-color:#35675b}.archive-hover-status{margin-left:auto;color:#587368}.archive-hover-layer{position:absolute;inset:0;pointer-events:none;z-index:18}.archive-hover-dot{position:absolute;transform:translate(-50%,-50%);border:2px solid #fff;border-radius:50%;background:#315e54;color:white;font:600 10px/1 system-ui;min-width:22px;width:auto;height:22px;padding:2px 5px;box-shadow:0 1px 5px #263e4970;pointer-events:auto;cursor:pointer}.archive-hover-dot{opacity:.30;transition:opacity 180ms ease}.archive-hover-dot.is-near,.archive-hover-dot:hover,.archive-hover-dot:focus-visible{opacity:1}.archive-hover-dot:hover,.archive-hover-dot:focus-visible{outline:3px solid #e6b7a6;outline-offset:2px}.archive-hover-card{position:absolute;pointer-events:auto;box-sizing:border-box;background:#fffef8;border:1px solid #9bb4a8;border-radius:10px;padding:14px;box-shadow:0 10px 35px #122f3540;color:#213e36;font:12px/1.5 system-ui;overflow:auto;overscroll-behavior:contain;z-index:2}.archive-hover-card h3{font:600 11.9px/1.25 system-ui;margin:8px 0}.archive-hover-card p{margin:7px 0}.archive-hover-card img{display:block;width:100%;max-height:240px;object-fit:contain;background:#e9ece6}.archive-hover-card a{color:#226655;text-decoration:underline}.archive-hover-top,.archive-hover-nav,.archive-hover-links{display:flex;gap:12px;justify-content:space-between;align-items:center}.archive-hover-card button{border:1px solid #becfc5;border-radius:5px;padding:5px 9px;background:#eef4ed;font:inherit;color:#254c42;cursor:pointer}.archive-hover-date{font-weight:600}.archive-hover-note,.archive-hover-credit{color:#617069;font-size:11px}.archive-hover-nav{margin-top:12px}.archive-hover-card summary{cursor:pointer}.archive-hover-controls [hidden],.archive-hover-layer[hidden],.archive-hover-dot[hidden],.archive-hover-card[hidden]{display:none!important}@media(max-width:600px){.archive-hover-controls{gap:8px;padding:9px 10px}.archive-hover-status{width:100%;margin:0}.archive-hover-card{padding:11px}.archive-hover-card img{max-height:180px}}
</style><style>.atlas-toolbar{flex-wrap:wrap}.atlas-travel{display:flex;align-items:center;gap:6px;flex:1;min-width:280px;max-width:560px;margin:0 12px;position:relative;font-size:12px}.atlas-address-wrap{position:relative;flex:1;min-width:150px}.atlas-travel input,.atlas-travel button{height:33px;border:1px solid #ccd1c4;border-radius:4px;background:#fffef9;padding:5px 8px}.atlas-travel input[type=search]{width:100%;min-width:0}.atlas-travel input[type=number]{width:72px}.atlas-travel button{white-space:nowrap}.atlas-travel #atlas-travel-go{background:#e5e8dc}.atlas-travel #atlas-travel-status{position:absolute;top:37px;left:0;max-width:100%;z-index:36;background:#fffef9;box-shadow:0 1px 4px #0002;padding:2px 6px;font-size:10px;pointer-events:none}.atlas-travel #atlas-travel-status:empty{display:none}#atlas-address-results{position:absolute;top:37px;left:0;width:max(100%,300px);max-width:min(520px,85vw);max-height:280px;overflow:auto;background:#fffef9;box-shadow:0 5px 20px #0003;z-index:40;border:1px solid #ccd1c4}#atlas-address-results button{display:block;width:100%;height:auto;text-align:left;border:0;border-radius:0;border-bottom:1px solid #e5e8dc;white-space:normal;padding:9px}#atlas-address-results button:hover,#atlas-address-results button[aria-selected=true]{background:#e5e8dc}@media(max-width:800px){.atlas-travel{order:3;max-width:none;flex-basis:100%;margin:8px 0}.atlas-travel #atlas-travel-status{position:static;max-width:140px;box-shadow:none}.atlas-travel input[type=number]{width:68px}}</style><style>.atlas-label[data-building-address]{white-space:pre-line!important;line-height:1.45;padding:9px 12px;font-size:12px;max-width:430px;overflow-wrap:anywhere;z-index:32;background:rgba(255,254,248,.98);border:1px solid #637b70;box-shadow:0 3px 12px #233f3324;pointer-events:none}.building-address-card{padding:10px 12px;background:#f3f4eb;border-left:3px solid #637b70;margin:10px 0}.building-address-card p{margin:5px 0}.building-address-card a{display:block;font-size:12px}</style><style>/* Mobile starts in the map; opening a sheet never resizes its canvas. */
.mobile-tools,.mobile-year-step,.mobile-year-label,#mobile-atlas-shell{display:none}
#mobile-map-sheet:not([open]){display:none}
.source-filter-panel>summary{display:none}
#map-options>summary{cursor:pointer;font-size:9.1px;padding:9px 0;min-height:40px}
#building-tag-rule{margin:6px 0;font-size:12px;color:var(--muted)}
.reading-record a,.building-address-card{overflow-wrap:anywhere}
html[data-compact-atlas=true],html[data-compact-atlas=true] body{width:100%;height:100%;overflow:hidden;overscroll-behavior:none}
html[data-compact-atlas=true] body{position:fixed;inset:0;background:#e1e5d9}
html[data-compact-atlas=true] body>header,html[data-compact-atlas=true] body>footer,html[data-compact-atlas=true] main>:not(.window){display:none}
html[data-compact-atlas=true] main{position:fixed;inset:0;max-width:none;margin:0;padding:0}
html[data-compact-atlas=true] .window,html[data-compact-atlas=true] .window.atlas-expanded{position:absolute;inset:0;width:100%;height:100%;max-height:none;display:block;margin:0;padding:0;border:0;border-radius:0;overflow:hidden;box-shadow:none}
html[data-compact-atlas=true] .window>:not(#unified-viewport){display:none!important}
html[data-compact-atlas=true] #unified-viewport{position:absolute;inset:0;width:100%;height:100%;min-height:0;max-height:none;aspect-ratio:auto;overflow:hidden;background:#e1e5d9;border:0}
html[data-compact-atlas=true] #scene{position:absolute;inset:0;width:100%;height:100%;touch-action:none;overscroll-behavior:none;outline:none}
html[data-compact-atlas=true] #scene>canvas,html[data-compact-atlas=true] #scene>svg{display:block;width:100%;height:100%;touch-action:none}
html[data-compact-atlas=true] #scene>.empty{display:grid;place-items:center;height:100%;margin:0;padding:24px;font-size:16px;line-height:1.6;text-align:center}
html[data-compact-atlas=true] .place-heading,html[data-compact-atlas=true] .scene-badge,html[data-compact-atlas=true] .scene-bottom{display:none}
html[data-compact-atlas=true] .basemap-credit{top:auto;left:8px;right:8px;bottom:calc(72px + env(safe-area-inset-bottom));width:fit-content;max-width:calc(100% - 16px);font-size:9px;line-height:1.3;padding:2px 4px;background:#f3f1e9e8;pointer-events:auto}
html[data-compact-atlas=true] #basemap-status{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
html[data-compact-atlas=true] .collision-hint{bottom:calc(126px + env(safe-area-inset-bottom));left:12px;right:12px;font-size:13px}
html[data-compact-atlas=true] #mobile-atlas-shell{display:block;position:fixed;inset:0;pointer-events:none;z-index:25;font:15px/1.3 system-ui,sans-serif}
#mobile-atlas-shell button{pointer-events:auto;min-height:46px;border:1px solid #bec8bf;background:#fffef9;color:#243d39;border-radius:12px;box-shadow:0 2px 8px #243d391c;padding:10px 16px;font-size:15px;font-weight:600;touch-action:manipulation}
#mobile-atlas-shell #mobile-open-info{position:absolute;left:calc(12px + env(safe-area-inset-left));top:calc(12px + env(safe-area-inset-top));font-family:Georgia,serif;font-weight:400;font-size:18px}
#mobile-map-zoom{position:absolute;right:calc(12px + env(safe-area-inset-right));top:calc(12px + env(safe-area-inset-top));display:grid;gap:6px}
#mobile-atlas-shell #mobile-map-zoom button{width:46px;height:46px;min-width:46px;padding:0;font-size:24px;font-weight:400}
#mobile-map-dock{position:absolute;bottom:calc(12px + env(safe-area-inset-bottom));left:calc(12px + env(safe-area-inset-left));right:calc(12px + env(safe-area-inset-right));display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
#mobile-atlas-shell #mobile-open-year{font-variant-numeric:tabular-nums;background:#243d39;color:#fffef9;border-color:#243d39;font-size:18px}
#mobile-atlas-shell #mobile-place-details{position:absolute;left:12px;bottom:calc(94px + env(safe-area-inset-bottom));min-height:42px;max-width:calc(100% - 24px);font-size:14px}
#mobile-map-sheet{position:fixed;inset:auto 0 0;width:100%;max-width:760px;margin:0 auto;max-height:calc(100% - 24px - env(safe-area-inset-top));height:auto;padding:0;border:1px solid #c9d0c7;border-bottom:0;border-radius:20px 20px 0 0;background:#fffef9;color:#243d39;box-shadow:0 -4px 28px #243d3933;overflow:hidden;overscroll-behavior:contain}
#mobile-map-sheet[open]{display:flex;flex-direction:column}
#mobile-map-sheet::backdrop{background:#1429253d}
#mobile-map-sheet[data-panel=search]{inset:calc(12px + env(safe-area-inset-top)) 0 auto;border-radius:16px;border-bottom:1px solid #c9d0c7;width:calc(100% - 24px)}
.mobile-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:1px solid #d9ded5;flex:none}
.mobile-sheet-head h2{font:600 12.6px/1.4 system-ui,sans-serif;margin:0}
.mobile-sheet-head button{min-width:60px;min-height:44px;padding:8px 12px;border:1px solid #c9d0c7;border-radius:9px;background:#f3f1e9;font-size:15px}
#mobile-sheet-body{padding:16px 16px calc(20px + env(safe-area-inset-bottom));overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;min-height:0;max-height:calc(82dvh - 76px);-webkit-overflow-scrolling:touch;font-size:16px;line-height:1.6}
#mobile-map-sheet[data-panel=details] #mobile-sheet-body{max-height:calc(90dvh - 76px)}
#mobile-map-sheet[data-panel=search] #mobile-sheet-body{max-height:calc(72dvh - 76px);padding-bottom:16px}
#mobile-map-sheet button,#mobile-map-sheet summary,#mobile-map-sheet input:not([type=checkbox]),#mobile-map-sheet select{min-height:44px;font-size:16px}
#mobile-map-sheet summary{font-size:11.2px}
#mobile-map-sheet input[type=checkbox]{width:22px;height:22px;flex:none}
#mobile-map-sheet input,#mobile-map-sheet textarea,#mobile-map-sheet select{font-size:16px;max-width:100%}
#mobile-map-sheet .atlas-travel{display:grid;grid-template-columns:minmax(0,1fr) 92px 60px;gap:10px;width:100%;min-width:0;max-width:none;margin:0}
#mobile-map-sheet .atlas-address-wrap{grid-column:1/-1;width:100%;min-width:0}
#mobile-map-sheet #atlas-address{height:48px;width:100%;font-size:16px}
#mobile-map-sheet #atlas-address-results{position:static;max-width:100%;max-height:32dvh;margin-top:6px;border-radius:8px;box-shadow:none}
#mobile-map-sheet #atlas-address-results button{height:auto;min-height:48px;text-align:left;white-space:normal;font-size:15px;padding:10px}
#mobile-map-sheet .mobile-year-label{display:block;align-self:center}
#mobile-map-sheet #atlas-travel-year{width:100%;grid-column:2}
#mobile-map-sheet #atlas-travel-go,#mobile-map-sheet #atlas-travel-stop{grid-column:3}
#mobile-map-sheet .atlas-travel:has(#atlas-travel-stop:not([hidden])) #atlas-travel-go{display:none}
#mobile-map-sheet #atlas-travel-status{position:static;grid-column:1/-1;max-width:none;font-size:14px;box-shadow:none;overflow-wrap:anywhere}
#mobile-map-sheet #atlas-travel-status:empty{display:none}
#mobile-map-sheet .timeline{border:0;padding:0;background:transparent}
#mobile-map-sheet .time-row{display:flex;align-items:center;gap:12px;flex-wrap:nowrap}
#mobile-map-sheet .time-row label{width:58px;flex:none;font-size:27px}
#mobile-map-sheet .timeline-track{flex:1;min-width:0;height:64px;margin:0}
#mobile-map-sheet #time-slider{height:42px;touch-action:none}
#mobile-map-sheet #time-slider::-webkit-slider-thumb{width:28px;height:28px;margin-top:-11px}
#mobile-map-sheet #time-slider::-moz-range-thumb{width:28px;height:28px}
#mobile-map-sheet .year-ticks{margin:0;height:20px}
#mobile-map-sheet .year-ticks button{min-height:20px;font-size:10px}
#mobile-map-sheet .mobile-year-controls{display:flex;gap:12px;margin:16px 0 0}
#mobile-map-sheet .mobile-year-step{display:block;flex:1;border:1px solid #ccd1c4;border-radius:9px;background:#f3f1e9}
#mobile-map-sheet .time-endpoints{margin-left:70px;font-size:12px}
#mobile-map-sheet .milestone-description,#mobile-map-sheet .map-coverage-warning{margin:12px 0 0;font-size:14px;line-height:1.5}
#mobile-map-sheet #map-options>summary{display:none}
#mobile-map-sheet .source-layer-control{display:grid;grid-template-columns:1fr;margin:0;padding:0;border:0;gap:4px}
#mobile-map-sheet .source-layer-control label{display:flex;align-items:center;gap:10px;min-height:44px;font-size:16px}
#mobile-map-sheet .source-layer-control .layer-title{display:none}
#mobile-map-sheet .legend{display:flex;flex-wrap:wrap;gap:10px 14px;font-size:13px;line-height:1.5;margin-top:20px}
#mobile-map-sheet .source-filter-panel{margin-top:20px;border-top:1px solid #ccd1c4;padding-top:12px}
#mobile-map-sheet .source-filter-panel>summary{display:list-item;font-size:11.2px;padding:8px 0}
#mobile-map-sheet .archive-hover-controls{display:flex;flex-wrap:wrap;padding:8px 0;gap:10px;font-size:14px}
#mobile-map-sheet .archive-hover-controls label{min-height:44px;display:flex;align-items:center;gap:8px}
#mobile-map-sheet .archive-hover-controls select,#mobile-map-sheet .archive-hover-controls input{min-width:0}
#mobile-map-sheet #regional-panel{padding:12px 0;max-width:100%;border:0}
#mobile-map-sheet .regional-controls{gap:8px;flex-wrap:wrap}
#mobile-map-sheet .regional-controls label{max-width:100%;flex-wrap:wrap}
#mobile-map-sheet .reading-grid,#mobile-map-sheet .provenance-grid,#mobile-map-sheet .credits-inner,#mobile-map-sheet .archive-links{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
#mobile-map-sheet .reading-head{display:block}
#mobile-map-sheet #reading{border:0;margin:0;padding:0}
#mobile-map-sheet .reading-grid aside{border:0;padding:0}
#mobile-map-sheet .reading-record p,#mobile-map-sheet .reading-record a,#mobile-map-sheet #history-answer{font-size:16px;line-height:1.65}
#mobile-map-sheet .reading-record h3{font-size:16.8px}
#mobile-map-sheet .building-address-card strong{font-size:17px}
#mobile-map-sheet .merchant-history button{padding:8px;font-size:14px}
#mobile-map-sheet .composer{margin-top:24px;padding:16px 0;border-top:1px solid #ccd1c4}
#mobile-map-sheet .composer-top,#mobile-map-sheet .composer-row{display:flex;flex-direction:column;align-items:stretch;gap:12px}
#mobile-map-sheet .composer label{font-size:16px}
#mobile-map-sheet .composer .button{max-width:none}
#mobile-map-sheet .small,#mobile-map-sheet .utility{font-size:13px}
#mobile-map-sheet .journey{display:flex;flex-wrap:wrap;gap:8px;min-width:0;margin:16px 0}
#mobile-map-sheet .journey span{display:none}
#mobile-map-sheet .journey button{border:1px solid #ccd1c4;border-radius:9px;padding:8px 12px;flex:1 0 auto;font-size:15px}
#mobile-map-sheet .scene-actions{display:flex;max-width:100%;flex-wrap:wrap;gap:8px;margin:16px 0}
#mobile-map-sheet .top-links{display:flex;flex-wrap:wrap;align-items:center;font-size:9.8px;gap:8px 20px;border-block:1px solid #ccd1c4;padding:12px 0}
#mobile-map-sheet .top-links a{display:inline-flex;align-items:center;min-height:44px}
#mobile-map-sheet .intro{display:block;margin:24px 0;padding:0}
#mobile-map-sheet .intro h1{font-size:22.4px}
#mobile-map-sheet .intro p,#mobile-map-sheet .project-subtitle{font-size:11.2px;line-height:1.6;max-width:none}
#mobile-map-sheet h2{font-size:18.2px}
#mobile-map-sheet .mobile-sheet-head h2{font-size:12.6px}
#mobile-map-sheet #mobile-gesture-help{font-size:15px;line-height:1.6;margin:0}
html[data-compact-atlas=true] .archive-hover-card{font-size:14px;max-width:calc(100vw - 24px)}
html[data-compact-atlas=true] .archive-hover-card button,html[data-compact-atlas=true] .archive-hover-card summary{min-height:44px;min-width:44px}
html[data-compact-atlas=true] .archive-hover-dot{min-width:36px;height:36px;font-size:12px}
html[data-compact-atlas=true] .atlas-label.story-place{max-width:calc(100vw - 32px);font-size:12px;min-height:36px}
html[data-compact-atlas=true] .atlas-label[data-building-address]{font-size:13px;max-width:calc(100vw - 32px)}
html[data-compact-atlas=true] #heat-legend{left:12px;right:auto;bottom:calc(142px + env(safe-area-inset-bottom));max-width:210px;font-size:11px}
html[data-compact-atlas=true] #regional-detail{left:12px;right:12px;top:124px;max-height:45%;overflow:auto;max-width:none}
html[data-compact-atlas=true] #crop-panel{z-index:35;overflow:auto}
@media (max-height:500px){#mobile-sheet-body{max-height:calc(100dvh - 92px)}#mobile-map-sheet[data-panel=search] #mobile-sheet-body{max-height:calc(100dvh - 92px)}}
</style><script>__SCRIPT_map-01.js.in__</script><style id="layout74">/* Reading hierarchy: map, selection, then supporting material. */
:root{--muted:#58675e}
body{font-size:15px;line-height:1.65}
summary{cursor:pointer}
summary:focus-visible{outline:3px solid var(--rust);outline-offset:3px}
header{padding:12px 28px;min-height:60px}
.top-links{align-items:center;gap:12px 22px;font-size:9.8px;flex-wrap:wrap}
.top-links a{padding:5px 0}
.wordmark{font-size:16.1px;white-space:nowrap}
main{max-width:1680px;padding:18px 28px 28px}
.intro{margin:0 0 16px;align-items:center}
.intro h1{font-size:21px;line-height:1.15}
.intro .eyebrow{font-size:7.7px;margin:0 0 4px;max-width:none}
.intro .project-subtitle{font-size:10.5px;line-height:1.5;margin:5px 0 0;max-width:none;color:var(--ink)}
.small{font-size:13px;line-height:1.6}
.window{margin-bottom:20px;border-radius:6px}
.atlas-toolbar{padding:9px 14px;gap:10px 16px}
.journey{gap:4px}
.journey span,.journey button:disabled{display:none}
.journey button{font-size:14px;min-height:40px;padding:7px 11px}
.atlas-travel{font-size:14px;max-width:590px;margin:0;min-width:270px}
.atlas-travel input,.atlas-travel button{height:40px}
.atlas-travel input[type=number]{width:80px}
.atlas-travel #atlas-travel-status,#atlas-address-results{top:44px}
.atlas-travel #atlas-travel-status{font-size:12px}
.map-window-actions button{font-size:13px;min-height:40px}
.scene-wrap{height:clamp(380px,62svh,760px);min-height:0}
.place-heading{max-width:400px;top:42px}
.place-heading strong{font-size:16.1px;line-height:1.25}
.place-heading p{font-size:8.4px;line-height:1.5}
.scene-bottom .hint{font-size:11px;line-height:1.5;max-width:360px}
.timeline{padding:10px 16px 8px}
.time-row label{font-size:30px;width:70px}
.time-endpoints{font-size:11px;height:16px}
.map-coverage-warning{font-size:12px;line-height:1.45;margin:5px 0 0}
.milestone-description{font-size:13px;line-height:1.45;margin:3px 0 0 85px;min-height:0}
.atlas-controls74{display:grid;grid-template-columns:1fr 1fr;align-items:start;border-top:1px solid var(--line);background:#f6f6ee}
.atlas-controls74>details{margin:0;padding:0;min-width:0;border:0}
.atlas-controls74>details+details{border-left:1px solid var(--line)}
.atlas-controls74 #map-options>summary,.atlas-controls74 #source-filter-panel>summary{display:list-item;min-height:46px;margin:0;padding:11px 16px;font-size:9.8px;font-weight:600;background:none}
.atlas-controls74 #map-options>p,.atlas-controls74 .source-layer-control,.atlas-controls74 .legend{margin-left:16px;margin-right:16px}
.atlas-controls74 #building-tag-rule{font-size:13px;line-height:1.5;margin-top:4px}
.atlas-controls74 .source-layer-control{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 14px;padding-top:10px;font-size:14px}
.atlas-controls74 .layer-title{display:none}
.atlas-controls74 .source-layer-control label{min-height:38px;gap:8px;line-height:1.35}
.source-layer-control input{width:19px;height:19px;flex:none}
.atlas-controls74 .legend{font-size:12px;line-height:1.5;gap:8px 16px;margin-block:14px 16px}
.atlas-controls74 .legend a{margin-left:0}
.atlas-controls74 .archive-hover-controls{font-size:14px;padding:8px 16px 16px;gap:10px}
.atlas-controls74 .archive-hover-controls input,.atlas-controls74 .archive-hover-controls select,.atlas-controls74 .archive-hover-controls button{font-size:14px}
.atlas-controls74 .archive-hover-status{width:100%;margin:0;font-size:12px}
.atlas-controls74 .source-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.atlas-controls74 .source-category-option{font-size:13px;min-height:40px;line-height:1.4}
.atlas-controls74 .source-category-option input{width:19px;height:19px}
.atlas-controls74 .source-category-swatch{flex:none}
.window>#reading,.window>#question-panel{border:0;border-top:1px solid var(--line);padding:0;margin:0;background:var(--card)}
.reading-head,.question-panel-head{display:flex;align-items:center;gap:14px;min-height:54px;margin:0;padding:12px 16px;list-style:none}
.reading-head::-webkit-details-marker,.question-panel-head::-webkit-details-marker{display:none}
.reading-head:before,.question-panel-head:before{content:'+';width:16px;flex:none;font:20px/1 system-ui;color:var(--rust)}
details[open]>.reading-head:before,details[open]>.question-panel-head:before{content:'−'}
.reading-head h2,.question-panel-head strong{font:600 11.2px/1.45 system-ui;margin:0;flex:none}
#reading-context{font-size:13px;margin-left:auto;text-align:right;max-width:65%;line-height:1.5}
#reading>.reading-grid{padding:6px 22px 22px;grid-template-columns:minmax(0,1.8fr) minmax(250px,1fr);gap:30px}
#reading:not(.has-selection)>.reading-grid{display:block;max-width:75ch}
#reading:not(.has-selection) .reading-grid aside{display:none}
.reading-grid p,.reading-record p{font-size:15px;line-height:1.75;max-width:78ch}
.reading-grid .small{font-size:13px;line-height:1.6}
.reading-grid h3{font-size:16.1px;line-height:1.3;margin-bottom:10px}
.reading-grid aside{padding-left:22px}
.reading-record{padding:18px 0 8px}
.reading-record:first-child{border-top:0;padding-top:10px}
.reading-record a{overflow-wrap:anywhere}
.reading-record .citation{font-size:12px;line-height:1.5}
.reading-grid .gap{font-size:14px}
.reading-grid .building-address-card p,.reading-grid .building-address-card a{font-size:13px;line-height:1.6}
#question-panel .composer{padding:4px 22px 18px;background:var(--card);border:0}
.composer label{font-size:15px;font-weight:600}
.composer-top select{font-size:14px;padding:6px 8px;border:1px solid var(--line);background:var(--card)}
.composer textarea{font-size:15px;line-height:1.6;min-height:86px}
.composer .button{font-size:14px;min-height:44px}
.composer .utility{font-size:12px}
#question-panel>.contextual{margin:0;padding:14px 22px;border-top:1px solid var(--line);font-size:14px}
.question-panel-hint{margin-left:auto;font-size:13px;color:var(--muted)}
.archive-links{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:0 0 18px;margin:0}
.archive-links a{font:600 15px/1.5 system-ui}
.archive-links p{display:none}
.archive-links:not(.has-selection)>div:first-child{display:none}
.resource-notes74{display:grid;grid-template-columns:1fr 1fr;gap:0 30px;border-block:1px solid var(--line)}
.resource-notes74>details{margin:0;padding:0;border:0;min-width:0}
.resource-notes74>details>summary{padding:15px 0;min-height:52px;font-size:10.5px;font-weight:600}
.resource-notes74>details[open]{padding-bottom:18px}
.resource-notes74 p{font-size:15px;line-height:1.75;max-width:72ch;margin:0 0 12px}
.resource-notes74 .small,.resource-notes74 .map-evidence,.resource-notes74 .road-evidence{font-size:13px}
.resource-notes74 #project-context h2{font-size:16.8px;line-height:1.3;margin:4px 0 14px}
.credits{padding:18px 28px;background:var(--paper);border:0}
.credits-inner{max-width:1624px;display:block}
.credits .authors{font-size:14px;margin:0}
.credits .authors br{display:none}
.credits .authors strong{margin-left:8px}
.build{max-width:1624px;font:11px/1.5 system-ui;margin-top:10px;color:var(--muted)}
.map-coverage-warning,.milestone-description{overflow-wrap:anywhere}
.window.atlas-expanded>.atlas-controls74,.window:fullscreen>.atlas-controls74{flex-shrink:0;max-height:36dvh;overflow:auto}
.window.atlas-expanded>#reading,.window.atlas-expanded>#question-panel,.window:fullscreen>#reading,.window:fullscreen>#question-panel{flex-shrink:0;max-height:36dvh;overflow:auto}
.window.atlas-expanded>.timeline,.window:fullscreen>.timeline{flex-shrink:0}
@media(min-width:761px){.atlas-controls74:has(>details[open]){grid-template-columns:1fr}.atlas-controls74:has(>details[open])>details+details{border-left:0;border-top:1px solid var(--line)}.atlas-controls74:has(>details[open]) .source-layer-control{grid-template-columns:repeat(4,minmax(0,1fr))}.atlas-controls74:has(>details[open]) .source-category-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.atlas-controls74:has(>details[open]) .legend{max-width:1200px}}
@media(min-width:761px) and (max-width:1100px){.atlas-toolbar{display:grid;grid-template-columns:1fr auto}.atlas-travel{grid-row:2;grid-column:1/-1;max-width:none;width:100%;margin:0}.atlas-controls74:has(>details[open]) .source-layer-control{grid-template-columns:repeat(3,minmax(0,1fr))}.place-heading strong{font-size:14.7px}}
@media(max-width:760px){.resource-notes74{grid-template-columns:1fr}#reading>.reading-grid{grid-template-columns:1fr;gap:20px}.reading-grid aside{border:0;padding:0}.reading-head{flex-wrap:wrap;gap:8px}.reading-head #reading-context{margin-left:30px;max-width:100%;text-align:left;width:100%}.question-panel-hint{display:none}}
/* Mobile keeps its full-height map and uses the existing modal sheets. */
html[data-compact-atlas=true] .scene-wrap{height:100%;min-height:0}
#mobile-map-sheet #reading>.reading-head{display:none}
#mobile-map-sheet #reading>.reading-grid{display:grid;padding:0;grid-template-columns:1fr;gap:22px}
#mobile-map-sheet #question-panel{margin-top:18px;border-top:1px solid var(--line)}
#mobile-map-sheet #question-panel>.question-panel-head{padding:12px 0;font-size:16px}
#mobile-map-sheet #question-panel .composer{padding:8px 0;margin-top:0;border:0}
#mobile-map-sheet #question-panel>.contextual{padding:12px 0;font-size:15px}
#mobile-map-sheet .journey button:disabled{display:none}
#mobile-map-sheet #project-context{padding:0;margin:18px 0}
#mobile-map-sheet #project-context>summary,#mobile-map-sheet #method>summary{font-weight:600;font-size:11.2px;padding:12px 0}
#mobile-map-sheet #project-context p,#mobile-map-sheet #method p{font-size:16px;line-height:1.7}
#mobile-map-sheet .archive-links{display:flex;padding:16px 0;gap:16px}
#mobile-map-sheet .archive-links a{font-size:16px}
#mobile-map-sheet .credits{padding:16px 0}
#mobile-map-sheet .credits .authors{font-size:14px}
</style><style id="source-bar75">/* One row inside the map; controls never resize the scene or join the render loop. */
.source-category-bar75{position:absolute;top:12px;left:12px;right:12px;z-index:20;max-width:max-content;padding:4px 6px;background:#fffef9f5;border:1px solid #c7cdc2;border-radius:9px;box-shadow:0 2px 8px #243d391a;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;touch-action:pan-x;scrollbar-width:thin;scrollbar-color:#afb8ac transparent;color:#243d39}
.source-category-bar75 .source-category-grid{display:flex;align-items:center;flex-wrap:nowrap;gap:3px;border:0;margin:0;padding:0;min-width:max-content}
.source-category-bar75 .source-category-grid legend{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.source-category-bar75 .source-category-option{display:flex;align-items:center;gap:6px;min-height:36px;padding:5px 8px;margin:0;border:1px solid transparent;border-radius:6px;font:13px/1.35 system-ui,sans-serif;white-space:nowrap;cursor:pointer;touch-action:pan-x}
.source-category-bar75 .source-category-option:hover{background:#f0f1e9}
.source-category-bar75 .source-category-option:has(input:checked){background:#e9eee6;border-color:#bdc9b9}
.source-category-bar75 .source-category-option:focus-within{outline:2px solid #a65f41;outline-offset:-2px}
.source-category-bar75 .source-category-option input{width:17px;height:17px;margin:0;flex:none;accent-color:#35675b;cursor:pointer}
.source-category-bar75 .source-category-option i{width:10px;height:10px;border-radius:50%;flex:none;box-shadow:0 0 0 1px #243d3920}
.scene-wrap:has(.source-category-bar75)>.scene-badge{top:70px}
.scene-wrap:has(.source-category-bar75)>.place-heading{top:107px}
html[data-compact-atlas=true] .source-category-bar75{top:calc(70px + env(safe-area-inset-top));left:calc(12px + env(safe-area-inset-left));right:calc(70px + env(safe-area-inset-right));max-width:none;padding:3px;scrollbar-width:none}
html[data-compact-atlas=true] .source-category-bar75::-webkit-scrollbar{display:none}
html[data-compact-atlas=true] .source-category-bar75 .source-category-option{min-height:44px;font-size:14px;padding:7px 9px;gap:7px}
html[data-compact-atlas=true] .source-category-bar75 .source-category-option input{width:20px;height:20px}
@media(prefers-reduced-transparency:reduce){.source-category-bar75{background:#fffef9}}
</style><style id="source-marker-title-style76">/* Keep the purpose visible while the category row scrolls. */
.source-category-bar75{display:flex;align-items:center;gap:8px;max-width:calc(100% - 24px);overflow:visible}
.source-bar-title76{flex:none;padding:0 5px;font:600 9.1px/1.4 system-ui,sans-serif;color:#243d39;white-space:nowrap}
.source-category-scroll76{min-width:0;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;touch-action:pan-x;scrollbar-width:thin;scrollbar-color:#afb8ac transparent}
.source-category-scroll76 .source-category-grid{width:max-content}
html[data-compact-atlas=true] .source-category-bar75{flex-direction:column;align-items:stretch;gap:2px;max-width:none}
html[data-compact-atlas=true] .source-bar-title76{font-size:8.4px;padding:3px 8px 0}
html[data-compact-atlas=true] .source-category-scroll76{scrollbar-width:none}
html[data-compact-atlas=true] .source-category-scroll76::-webkit-scrollbar{display:none}
.source-category-option span{font-size:12px}
.source-definitions76{flex-basis:100%;margin:2px 0 0;font-size:13px}
.source-definitions76 dl{display:grid;grid-template-columns:minmax(145px,190px) 1fr;gap:8px 14px;max-height:240px;overflow:auto;padding:10px 5px}
.source-definitions76 dt{font-weight:600}.source-definitions76 dd{margin:0;max-width:80ch}
@media(max-width:700px){.source-definitions76 dl{display:block}.source-definitions76 dd{margin:2px 0 14px}.source-category-option span{font-size:12px}}
.source-category-bar75 .source-category-option{padding:4px 6px;gap:5px}
.source-category-bar75 .source-category-option span{white-space:pre-line;line-height:1.3}
.source-bar-title76{width:108px;white-space:normal;font-size:8.4px}
html[data-compact-atlas=true] .source-bar-title76{width:auto}
</style><style id="visibility-layout78">/* A real row above the viewport: never cover cards, place names or geometry. */
.source-category-bar75{position:relative;inset:auto;z-index:8;max-width:none;width:100%;min-width:0;flex:none;display:flex;align-items:center;gap:8px;padding:6px 12px;border:0;border-bottom:1px solid var(--line);border-radius:0;box-shadow:none;background:var(--card);overflow:hidden}
.source-bar-title76{width:110px;flex:none;font-size:8.4px;line-height:1.35}
.source-category-scroll76{flex:1;min-width:0}
.source-category-bar75 .source-category-grid{min-width:max-content}
.source-category-bar75 .source-category-option{min-height:42px}
.scene-wrap>.scene-badge{top:14px}
.scene-wrap>.place-heading{top:42px}
.atlas-label.geography{font-size:12px;border-color:#a7bab6;color:#30535c;background:#f7fbf5dc;pointer-events:none}
.scene-bottom .hint{max-width:440px}
.coastal-key78{font-size:12px;line-height:1.55;margin:8px 16px 12px;color:var(--muted)}
.coastal-key78 a{margin-right:12px;white-space:nowrap}
.coastal-key78 .border-swatch{display:inline-block;width:22px;border-top:2px dashed #995870;vertical-align:middle;margin:0 5px}
.coastal-key78 .shore-swatch{display:inline-block;width:22px;border-top:2px solid #386f7c;vertical-align:middle;margin:0 5px}
html[data-compact-atlas=true] .window,html[data-compact-atlas=true] .window.atlas-expanded{display:flex;flex-direction:column}
