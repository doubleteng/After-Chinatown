<header><span class="wordmark">After Chinatown</span><nav class="top-links" aria-label="Main navigation"><a href="#project-context" target="_self">About</a><button id="language-switch" class="button quiet" type="button" aria-label="Switch to Chinese">中文</button><a id="nav-archive" target="_blank" rel="noopener noreferrer">Browse the archive ↗</a><a id="research-admin-entry" href="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec" target="_blank" rel="noopener noreferrer" >Admin login</a><span id="draft-label" class="draft">Development study</span></nav></header>
<main><div class="intro"><div><p class="eyebrow">Detroit / Research prototype</p><h1>After Chinatown</h1><p class="project-subtitle">Reconstructing Chinese American Urban Memory in Detroit</p></div></div>
<section class="window" aria-label="Interactive historical 3D atlas and reconstruction">
<div class="atlas-toolbar"><nav class="journey" aria-label="View within this scene"><button id="tab-regional" type="button">Regional heat map</button><span>·</span><button id="tab-context" type="button" class="active">3D map</button><span>›</span><button id="tab-street" type="button" disabled>Street view</button><span>›</span><button id="tab-model" type="button" disabled>Detailed model</button><span>›</span><button id="tab-photo" type="button" disabled>Speculative photo</button></nav><form id="atlas-travel-form" class="atlas-travel" role="search" aria-label="Travel to an address and year"><div class="atlas-address-wrap"><input id="atlas-address" type="search" role="combobox" aria-label="Address or building name" aria-autocomplete="list" aria-controls="atlas-address-results" aria-expanded="false" autocomplete="off" placeholder="Address or building name"><div id="atlas-address-results" role="listbox" hidden></div></div><label id="mobile-year-label" class="mobile-year-label" for="atlas-travel-year" data-no-translate>Year</label><input inputmode="numeric" id="atlas-travel-year" aria-label="Destination year" type="number" min="1900" max="2026" step="1" value="1921" required><button id="atlas-travel-go" type="submit">Go</button><button id="atlas-travel-stop" type="button" hidden>Stop</button><span id="atlas-travel-status" role="status" aria-live="polite"></span></form><div id="map-selection-state" hidden aria-hidden="true"><input id="area" type="hidden" value=""><input id="year" type="number" min="1900" max="2026" value="1921"><input id="radius" type="hidden" value="500"></div></div>
<div id="regional-panel" class="regional-panel" hidden data-no-translate>
<div class="regional-controls"><strong data-en="Detroit region · Heatmap" data-zh="底特律区域 · 热力图" >Detroit region · Heatmap</strong><label><span data-en="Group" data-zh="族群" >Group</span><select id="regional-level"><option data-en="Chinese American population" data-zh="华裔人口" value="chinese">Chinese American population</option><option data-en="East Asian · partial" data-zh="东亚（部分口径）" value="east">East Asian · partial</option><option data-en="Asian" data-zh="亚裔" value="asian">Asian</option></select></label><label><input id="regional-pop" type="checkbox" checked><span data-en="Residents" data-zh="居民" >Residents</span></label><label><input id="regional-activity" type="checkbox" checked><span data-en="Activity" data-zh="活动" >Activity</span></label><label><input id="regional-centers" type="checkbox" checked><span data-en="Centers & direction" data-zh="中心与方向">Centers & direction</span></label><label><span data-en="Opacity" data-zh="透明度" >Opacity</span><input id="heat-opacity" type="range" min="20" max="100" value="75" aria-label="Heatmap opacity"><output id="heat-opacity-value">75%</output></label></div>
