<!doctype html>
<html lang="en"><head><base target="_blank"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>After Chinatown | Detroit</title>
<style>
:root{--paper:#f3f1e9;--card:#fffef9;--ink:#243d39;--muted:#69736b;--line:#ccd1c4;--rust:#a65f41;--soft:#e5e8dc}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.55 system-ui,sans-serif}button,input,select,textarea{font:inherit;color:inherit}button,a,summary{touch-action:manipulation}button{cursor:pointer}button:disabled{opacity:.42;cursor:not-allowed}a{color:inherit;text-underline-offset:4px}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid var(--rust);outline-offset:2px}h1,h2,h3{font-family:Georgia,serif;font-weight:400;line-height:1.13}h1{font-size:25.9px;margin:0}h2{font-size:21px;margin:0 0 14px}h3{font-size:15.4px;margin:0 0 12px}p{margin:0 0 12px}header{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:18px 28px;border-bottom:1px solid var(--line)}.wordmark{font:16.8px Georgia,serif}.top-links{display:flex;gap:18px;font-size:8.4px}.draft{font:7px monospace;color:var(--rust);border:1px solid;padding:3px 5px}.eyebrow{font:7px/1.4 monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--rust)}main{max-width:1540px;margin:auto;padding:22px 28px 50px}.intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin:0 0 20px}.intro p{max-width:450px;color:var(--muted);font-size:9.1px;margin:0}.button{min-height:40px;border:1px solid var(--ink);border-radius:4px;padding:9px 14px;background:var(--ink);color:var(--card);font-size:12px}.quiet{background:var(--card);color:var(--ink);border-color:var(--line)}.small{font-size:11px;color:var(--muted)}.window{border:1px solid var(--line);background:var(--card);border-radius:5px;overflow:hidden;margin-bottom:36px}.atlas-toolbar{padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid var(--line)}.journey{display:flex;gap:4px;align-items:center}.journey button{border:0;background:none;padding:8px 11px;font-size:12px;color:var(--muted)}.journey button.active{background:#e7eade;border-radius:3px;color:var(--ink)}.journey span{color:#929a8a;font-size:12px}select,input[type=number]{border:1px solid var(--line);background:var(--card);padding:6px 8px;border-radius:3px}.scene-wrap{height:min(66vh,690px);min-height:490px;position:relative;background:#e1e5d9;overflow:hidden}#scene{position:absolute;inset:0;overflow:hidden;z-index:0;isolation:isolate}#scene canvas,#scene svg{display:block;width:100%;height:100%;touch-action:none}.scene-badge{position:absolute;left:18px;top:16px;max-width:60%;pointer-events:none;font:10px monospace;background:#fffef3e8;padding:7px 9px;z-index:2}.place-heading{position:absolute;left:20px;top:55px;max-width:52%;pointer-events:none;z-index:2;text-shadow:0 1px #f3f1e9}.place-heading strong{font:21.7px Georgia,serif;display:block}.place-heading p{font-size:7.7px;margin:7px 0;max-width:360px}.atlas-labels{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}.atlas-label{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;font-size:11px;padding:4px 7px;background:#fffef6ed;border:1px solid #c4cbbbbb;border-radius:3px;pointer-events:auto;max-width:220px;overflow:hidden;text-overflow:ellipsis}.atlas-label.area{font:18px Georgia,serif;border:0;border-left:3px solid var(--rust);padding:7px 12px;box-shadow:0 3px 16px #293e3612}.atlas-label.street{background:transparent;border:0;font:10px monospace;pointer-events:none;color:#697765;text-shadow:0 1px #edf0e6}.atlas-label.photo{font-size:10px;border-radius:20px;background:#2b5148;color:white;padding:3px 8px}.scene-bottom{position:absolute;bottom:16px;left:18px;right:18px;display:flex;justify-content:space-between;align-items:end;gap:15px;pointer-events:none;z-index:4}.scene-bottom .button,.scene-bottom input{pointer-events:auto}.scene-bottom .hint{font-size:10px;background:#fffef2ed;padding:7px 9px;max-width:370px}.scene-actions{display:flex;gap:7px;align-items:center;pointer-events:auto;flex-wrap:wrap;justify-content:end;max-width:60%}.scene-actions .button{box-shadow:0 2px 8px #1b302114}.scene-actions label{display:flex;align-items:center;gap:6px;background:var(--card);font-size:10px;padding:6px 8px;border-radius:3px}.scene-actions input{max-width:95px}.empty{padding:16px;font-size:12px;color:var(--muted)}#rendered-result{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#253a33;z-index:2}#crop-panel{position:absolute;inset:0;background:#f6f3eafc;z-index:6;display:flex;align-items:center;justify-content:center;padding:65px 20px 72px;flex-direction:column}.crop-top{position:absolute;top:16px;left:20px;right:20px;display:flex;align-items:start;justify-content:space-between;gap:12px}.crop-top strong{font:23px Georgia,serif}.crop-top p{font-size:11px;margin-top:5px}#crop-canvas{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;touch-action:none}.crop-actions{position:absolute;bottom:16px;left:20px;right:20px;display:flex;gap:10px;align-items:center;justify-content:end}#crop-message{margin:0 auto 0 0;font-size:11px;max-width:55%}.timeline{padding:12px 18px;border-top:1px solid var(--line)}.time-row{display:flex;gap:15px;align-items:center}.time-row label{font:27px Georgia,serif;color:var(--rust);width:70px;flex-shrink:0}#time-slider{width:100%;accent-color:var(--rust);margin:0}.year-ticks{display:flex;justify-content:space-between;gap:4px;margin:2px 0 6px 85px}.year-ticks button{border:0;background:none;color:var(--muted);font:10px monospace;padding:4px}.year-ticks button.active{color:var(--rust);font-weight:bold}.temporal-status{font-size:11px;display:flex;gap:14px;flex-wrap:wrap;margin-top:4px}.legend{font-size:10px;color:var(--muted);margin-top:7px;display:flex;gap:14px;flex-wrap:wrap}.legend i{display:inline-block;width:9px;height:9px;background:#477066;margin-right:4px}.legend i.unknown{background:transparent;border:1px dashed #919c87}.legend i.removed{background:#b36b44}.composer{padding:15px 18px;background:#eff0e5;border-top:1px solid var(--line)}.composer-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:8px}.composer label{font-size:12px}.composer-top select{font-size:11px;background:transparent;border:0;padding:0}.composer-row{display:flex;gap:12px}.composer textarea{flex:1;min-width:0;min-height:66px;resize:vertical;border:1px solid var(--line);background:var(--card);padding:12px;border-radius:4px;font-size:13px}.composer-row .button{max-width:190px;min-width:140px}.messages{font-size:12px;color:var(--rust);margin:10px 0 0}.utility{display:flex;justify-content:space-between;gap:12px;margin-top:10px;font-size:10px;color:var(--muted)}.utility details{max-width:55%}.utility summary{cursor:pointer}.utility p{margin:8px 0 0}.interpretation{border-bottom:1px solid var(--line);padding-bottom:26px}.reading-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:20px}.reading-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:36px}.reading-grid aside{border-left:1px solid var(--line);padding-left:24px}.reading-record{padding:15px 0;border-top:1px solid var(--line)}.reading-record p{font-size:13px}.citation{display:inline-block;font:10px monospace;background:#e4e8d9;padding:3px 6px;margin:3px 5px 3px 0}.gap{border-left:2px solid var(--rust);padding:8px 12px;background:#eee7db;font-size:12px}.archive-links{padding:28px 0;display:grid;grid-template-columns:1fr 1fr;gap:30px}.archive-links a{font:23px Georgia,serif}.archive-links p{font-size:12px;color:var(--muted);margin-top:10px}.method{padding:18px 0;font-size:12px;border-top:1px solid var(--line)}.method summary{cursor:pointer}.method p{margin:14px 0;max-width:900px}.credits{background:#e7e9dd;padding:30px;border-top:1px solid var(--line)}.credits-inner{max-width:1450px;margin:auto;display:grid;grid-template-columns:1fr 1.6fr;gap:36px}.credits h2{font-size:17.5px}.credits .description{font:20px/1.5 Georgia,serif}.credit-note{font-size:12px;color:var(--muted)}.build{display:flex;justify-content:space-between;margin:24px auto 0;max-width:1450px;font:10px monospace}.provenance{margin-bottom:28px;border-bottom:1px solid var(--line);padding-bottom:24px}.provenance-grid{display:grid;grid-template-columns:200px 1fr;gap:24px}.provenance img{width:100%;border:1px solid var(--line)}.provenance p{font-size:13px}.reference-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}.reference-choice{border:1px solid var(--line);padding:10px;display:flex;gap:6px;font-size:11px}.reference-choice small{display:block;color:var(--muted)}.contextual{margin:20px 0;font-size:12px}.downloads{display:flex;gap:18px;font-size:12px;margin:14px 0}.model-adjust{display:flex;gap:15px;font-size:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:900px){.intro p{max-width:300px}.atlas-toolbar{align-items:end}.journey button{padding:8px}.place-heading strong{font-size:18.9px}.scene-wrap{min-height:500px}.reference-list{grid-template-columns:1fr 1fr}}
@media(max-width:600px){header{padding:15px}.wordmark{font-size:14.7px}.top-links{font-size:7px;gap:10px}main{padding:18px 10px 35px}.intro{display:block;padding:0 6px}.intro h1{font-size:21.7px}.intro p{max-width:100%;margin-top:10px;font-size:8.4px}.atlas-toolbar{padding:8px 10px;flex-wrap:wrap}.journey{width:100%;justify-content:space-between}.journey button{font-size:11px}#radius{font-size:11px}.scene-wrap{height:510px;min-height:0}.scene-badge{font-size:9px;max-width:85%;left:12px;top:10px}.place-heading{left:13px;top:45px;max-width:90%}.place-heading strong{font-size:16.8px}.place-heading p{max-width:240px}.scene-bottom{left:10px;right:10px;bottom:10px;flex-wrap:wrap;gap:6px}.scene-bottom .hint{max-width:100%;font-size:9px}.scene-actions{max-width:100%;gap:5px;margin-left:auto}.scene-actions .button{padding:8px 9px;font-size:10px;min-height:36px}.scene-actions label{font-size:9px}.time-row{gap:8px}.time-row label{font-size:23px;width:50px}.timeline{padding:10px}.year-ticks{margin-left:58px}.year-ticks button{font-size:8px;padding:3px 1px}.temporal-status,.legend{font-size:9px;gap:7px}.composer{padding:12px}.composer-row{flex-direction:column}.composer-row .button{max-width:none;min-height:42px}.utility{flex-direction:column;gap:6px}.utility details{max-width:100%}.reading-grid,.credits-inner,.archive-links{grid-template-columns:1fr;gap:20px}.reading-grid aside{border:0;padding:0}.reading-head{align-items:start;flex-direction:column;gap:5px}.provenance-grid{grid-template-columns:1fr}.provenance img{max-width:220px}.reference-list{grid-template-columns:1fr}.credits{padding:25px 18px}.credits .description{font-size:18px}.crop-top{left:12px;right:12px}.crop-top strong{font-size:20px}#crop-panel{padding:90px 12px 105px}.crop-actions{bottom:10px;left:12px;right:12px;flex-wrap:wrap}#crop-message{max-width:100%;width:100%}.atlas-label.area{font-size:14px}.atlas-label.street{font-size:8px}.atlas-label.photo{font-size:9px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
.road-evidence{font-size:11px;margin:6px 0}.road-evidence summary{cursor:pointer}.road-evidence p{margin:8px 0}.road-evidence a{margin-right:12px}.source-layer-control input{width:17px;height:17px;accent-color:var(--rust)}.source-layer-control{display:flex;flex-wrap:wrap;gap:14px;align-items:center;font-size:11px;margin-top:8px}.source-layer-control label{display:flex;align-items:center;gap:6px}.early-context{border-left:2px solid var(--rust);padding:5px 12px;margin-top:8px;font-size:12px}.year-ticks{overflow-x:auto;gap:10px}.year-ticks button{flex-shrink:0;min-width:38px}.map-evidence{display:flex;flex-wrap:wrap;gap:14px;font-size:11px;margin-top:7px}.street-basemap{position:absolute;inset:0;pointer-events:none;opacity:.84}.street-basemap *{pointer-events:none!important}#scene>canvas,#scene>svg{position:absolute;inset:0;z-index:1;background:transparent!important}.basemap-credit{position:absolute;bottom:0;left:0;right:0;z-index:5;background:#fffef2ec;padding:2px 10px;font-size:9px;display:flex;gap:12px;justify-content:space-between}.scene-bottom{bottom:29px}

.year-ticks{position:relative;display:block;height:58px;margin-right:7px;margin-left:92px}.year-ticks button{position:absolute;transform:translateX(-50%);min-width:14px;padding:0;background:none;border:0;line-height:1.1}.archive-dot{display:block;background:#bd7758;width:7px;height:7px;margin:2px auto;border-radius:50%;border:1px solid #fff}.year-ticks button.active .archive-dot{background:#2a524a;outline:2px solid #2a524a}.archive-year{font:9px monospace}.snap-options{display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:11px;margin:4px 0 10px}.snap-options label{display:flex;gap:5px;align-items:center}.snap-options span{color:var(--muted)}.atlas-label.landmark{font-size:10px;border-left:3px solid #e0784b;max-width:190px;background:#fffefaee}.atlas-label.landmark[data-present-landmark]{border:1px dashed #ae6a42}.survival-tag{display:inline-block;border:1px solid #6c897b;border-radius:4px;padding:5px 8px;color:#36564c;background:#e6eee5}.legend i{background:#f0f1ef;border:1px solid #98a598}.legend i.chinatown{background:#de7143;border:0}
@media(max-width:600px){.year-ticks{margin-left:65px;height:64px}.archive-year{font-size:8px}.snap-options{font-size:10px;gap:6px}.atlas-label.landmark{max-width:135px;font-size:9px}}

/* Compact map controls: milestones, three independent layers, one legend. */
.year-ticks{height:27px;overflow:visible;margin:4px 7px 0 85px}.year-ticks button{top:0!important;min-width:12px;width:14px;padding:0;height:24px}.archive-dot{width:8px;height:8px;margin:2px auto}.archive-year{position:absolute;top:13px;left:50%;transform:translateX(-50%);font:10px monospace}.time-endpoints{display:flex;justify-content:space-between;margin-left:85px;font:9px monospace;color:var(--muted);height:12px}.source-layer-control{margin:10px 0 0;gap:10px 20px;padding-top:10px;border-top:1px solid var(--line);font-size:12px}.layer-title{font-weight:600}.legend{align-items:center;font-size:11px;gap:8px 16px;margin-top:10px}.legend a{margin-left:auto}.legend i{width:11px;height:11px;background:#f5f5f2}.legend i.chinatown{background:#e89cae}.legend i.unknown{background:#e1e3df;border:1px dashed #9baba0}.legend i.road-past{background:#add8eb;border:0;height:5px;vertical-align:middle}.legend i.road-present{background:#24588b;border:0;height:5px;vertical-align:middle}.collision-hint{position:absolute;left:18px;bottom:78px;background:#fffef7f5;border:1px solid #c9bcac;padding:8px 12px;border-radius:4px;z-index:5;font-size:12px;pointer-events:none}.scene-badge{font:11px system-ui,sans-serif;padding:4px 7px}.place-heading{top:46px}.place-heading strong{font-size:18.9px}.basemap-credit{justify-content:flex-start;gap:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.time-row label{font-variant-numeric:tabular-nums}.source-layer-control input{accent-color:#496f65}.method{margin-top:24px}.method #map-evidence{margin:14px 0}.method summary{cursor:pointer}.road-evidence #road-source-list p{max-width:850px}
@media(max-width:600px){.year-ticks,.time-endpoints{margin-left:58px}.year-ticks{height:25px}.archive-year{font-size:9px}.source-layer-control{font-size:11px;gap:8px 12px}.layer-title{width:100%}.legend{font-size:10px;gap:7px 12px}.legend a{margin-left:0}.place-heading strong{font-size:16.1px}.collision-hint{left:10px;bottom:112px;font-size:11px;max-width:90%}}
/* Milestones share the slider track; dates appear on hover or selection. */
.timeline-track{position:relative;flex:1;min-width:0;height:30px}.timeline-track #time-slider{position:absolute;inset:0;height:30px;z-index:1}.timeline-track .year-ticks{position:absolute;inset:0 8px;height:30px;margin:0;pointer-events:none;z-index:2}.timeline-track .year-ticks button{top:50%!important;transform:translate(-50%,-50%);width:9px;min-width:9px;height:12px;pointer-events:auto;padding:0}.timeline-track .archive-dot{width:7px;height:7px;margin:auto;background:#b67456;border:1px solid #fffef9}.timeline-track .archive-year{display:none}.timeline-track .year-ticks button:focus-visible{outline-offset:5px}.time-endpoints{margin-top:0}.milestone-description{min-height:20px;margin:5px 0 0 85px;font-size:11px;color:var(--muted)}.milestone-description a{color:var(--ink)}.legend i.heritage{background:#f2df9b}.legend i.unknown{background:rgba(245,245,242,.75);border:1px dashed #89918b}.legend i.removed{background:transparent;border:1px solid #b26e4a}.legend i.freeway{background:#c84646;height:5px;border:0}.legend i.rail{background:#666474;height:5px;border:0}.legend i.water{background:#b8dce0;border:0}.legend i.shore{background:#609498;height:3px;border:0}.legend i.border{height:0;border:0;border-top:2px dashed #886b9b}.legend i.land{background:#e1e5d9}.legend i.photo{background:#2d6258;border:0;border-radius:50%}.legend i.selection{background:transparent;border:1px solid #a65f41}.legend i.activity{width:26px;background:linear-gradient(90deg,#f5d7e3,#e8aac2,#d87099);border:0}.legend i.map-key{background:linear-gradient(90deg,#eadbb3,#decebd);border:0}.atlas-label.landmark{border-left:3px solid #f2df9b}.atlas-label.street{background:#f4f3e6c4;border-radius:2px;padding:1px 3px;max-width:280px;letter-spacing:.015em}.place-heading strong{font-size:14px}.atlas-label.area{font-size:16px;border-left:0}.atlas-label.geography{background:transparent;border:0;color:#436e79;font-style:italic;pointer-events:none}.atlas-label.rail{border-left:3px solid #666474;font-size:10px}.legend{gap:7px 14px;font-size:10px}.source-layer-control{flex-wrap:wrap}
@media(max-width:600px){.milestone-description{margin-left:58px;font-size:10px}.timeline-track .year-ticks button{width:6px;min-width:6px}.timeline-track .archive-dot{width:5px;height:5px}.atlas-label.street{font-size:9px}.legend{font-size:9px}.place-heading strong{font-size:12.6px}}

.regional-panel{padding:14px 18px;border-bottom:1px solid var(--line);background:#f9f9ef}.regional-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:9px}.regional-controls strong{font:17px Georgia,serif;margin-right:auto}.regional-controls label{display:flex;gap:6px;align-items:center;font-size:11px}.regional-controls select{max-width:210px;font-size:11px}.regional-controls button{font-size:10px;min-height:31px;padding:5px 9px}#regional-status{font-size:12px;margin:3px 0}#regional-warning{max-width:1000px;margin:5px 0}.regional-legends{display:flex;gap:30px;font-size:10px;margin:10px 0}.regional-legends>div{width:260px}.regional-legends b,.regional-legends small{display:block}.regional-scale{height:10px;margin:4px 0}.population-scale{background:linear-gradient(90deg,#f3f5ed 0% 14.28%,#d7e9dd 14.28% 28.57%,#b2d6c6 28.57% 42.86%,#7fb9a8 42.86% 57.14%,#479681 57.14% 71.43%,#20735e 71.43% 85.71%,#064b3d 85.71%)}.activity-scale{background:linear-gradient(90deg,#fff2dc,#e6a969,#cd7352,#ae224d)}.regional-method{font-size:11px;max-width:1050px}.regional-method summary{cursor:pointer}.regional-method p{margin:9px 0}#regional-shell{position:absolute;inset:0;z-index:15;background:#e5eae2}#regional-map{position:absolute;inset:0}#regional-loading{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);padding:15px;background:#fffef9;z-index:700}#regional-detail{position:absolute;right:14px;top:14px;width:285px;max-height:calc(100% - 65px);overflow:auto;z-index:700;background:#fffef9f5;padding:16px;border:1px solid var(--line);box-shadow:0 6px 24px #19372c26;font-size:11px}#regional-detail button{float:right;border:0;background:none;font-size:22px}#regional-detail h3{font-size:14px;margin-right:20px}#regional-detail p{margin:8px 0}.regional-heat{position:absolute;inset:0;z-index:430;pointer-events:none!important}@media(max-width:650px){.regional-panel{padding:10px}.regional-controls{gap:7px}.regional-controls strong{width:100%;font-size:16px}.regional-controls label{font-size:10px}.regional-legends{gap:15px}.regional-legends>div{width:50%}#regional-detail{width:240px;top:10px;right:10px;max-height:350px}}
.regional-reference-list{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.regional-reference-list button{background:#eee8f5;border:1px solid #cfbddc;padding:7px 10px;color:#53366b;font-size:11px;text-align:left}.regional-coverage{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr));gap:4px;margin:10px 0}.regional-coverage button{font-size:10px;padding:6px 3px;border:1px solid #d5dbd4;background:#f3f3ec;min-height:32px}.regional-coverage button.has-pop{background:#b2d6c6}.regional-coverage button.has-reference{background:#e5d9ed}.regional-coverage button[aria-current=true]{outline:2px solid #173b2d}.regional-city-icon{background:#eee7f4;border:1px solid #9271aa;border-radius:3px;padding:3px 5px;white-space:nowrap;width:max-content!important;color:#52346a;font:10px sans-serif}

.heat-underlay{z-index:2!important;pointer-events:none!important}.historical-basemap{z-index:1}.current-basemap{z-index:0}#scene>canvas,#scene>svg{position:relative;z-index:3}.heat-opacity{display:flex;align-items:center;gap:10px;font-size:12px;margin:8px 0}.heat-opacity input{width:160px}#heat-legend{position:absolute;z-index:9;left:18px;bottom:78px;width:265px;max-width:calc(100% - 36px);padding:11px 13px;background:#fffef9f5;border:1px solid #c8d3ca;border-radius:5px;box-shadow:0 3px 14px #23433320;font:12px/1.5 system-ui;color:#193a34;pointer-events:auto}#heat-legend strong{font-size:15px}#heat-legend p{margin:5px 0}#heat-legend .legend-bins{display:grid;grid-template-columns:repeat(7,1fr);margin:9px 0 2px}#heat-legend .legend-bins i{height:12px;border-right:1px solid #fff}#heat-legend .legend-ticks{display:flex;justify-content:space-between;font:10px ui-monospace,monospace}#heat-legend .missing-key{display:inline-block;width:14px;height:10px;background:repeating-linear-gradient(45deg,#a8aca9 0 3px,#ddd 3px 5px);margin-right:5px}#heat-legend button{font:11px system-ui;padding:4px 7px;margin-top:5px;border:1px solid #b7c8bd;background:#fffef9}.atlas-label.story-place,.atlas-label.interchange{background:#fffef3f5;border:1px solid #795737;color:#45332e;font:11px system-ui;padding:5px 8px;max-width:230px;white-space:normal;box-shadow:0 2px 6px #193a3430}.atlas-label.story-place:before{content:'● ';color:#b04475}.atlas-label.interchange{border-color:#b4554d;color:#842f32}.regional-panel{max-height:280px;overflow:auto}.regional-controls input[type=range]{width:105px}.regional-controls output{font-size:11px}.regional-legends{display:none}#regional-detail{z-index:20}#heat-legend small{color:#4d6057}.story-place[data-uncertain=true]{border-style:dashed}.atlas-labels{z-index:6}.atlas-label.story-place,.atlas-label.interchange{white-space:nowrap;max-width:320px;overflow:visible}.atlas-label.story-place:after,.atlas-label.interchange:after{content:'';position:absolute;left:calc(50% + var(--leader-x,0px));top:var(--leader-top,100%);bottom:var(--leader-bottom,auto);height:var(--leader-height,0px);border-left:1px solid #79573799;pointer-events:none}.scene-wrap:has(#scene[data-regional-view=true]) .place-heading,.scene-wrap:has(#scene[data-regional-view=true]) .scene-badge{display:none}.map-coverage-warning{font-size:11px;color:#735339;margin:5px 0}
.atlas-label.activity-center,.atlas-label.population-center{font-size:11px;background:#fff8ebf5;border:1px solid #ad532d;color:#743410;max-width:300px;overflow:visible}.atlas-label.population-center{border-color:#482619;color:#482619}.atlas-label.activity-center::after,.atlas-label.population-center::after{content:"";position:absolute;left:calc(50% + var(--leader-x,0px));top:var(--leader-top,100%);bottom:var(--leader-bottom,auto);height:var(--leader-height,0px);border-left:1px solid #ad532d;pointer-events:none}.county-counts{display:flex;gap:3px 10px;flex-wrap:wrap;font-size:10px;margin:5px 0 8px}.carried-data{color:#a84017;font-weight:600}.activity-scale{background:linear-gradient(90deg,#fcdee900,#f898ba88,#e74888d0,#be1c63eb)!important}#heat-legend{width:300px;max-width:calc(100% - 32px);font-size:11px}#heat-legend p{margin:6px 0}#heat-legend .legend-ticks{font-size:9px}.regional-coverage .has-pop{background:#fdd49e;color:#713210;border-color:#e49b69}
#scene[data-heat-visible=true] .current-basemap{filter:grayscale(1);opacity:.42}#scene[data-heat-visible=true] .historical-basemap{opacity:.68}

.intro>div{flex:1;min-width:0}.intro>p{flex:0 1 340px}.intro .project-subtitle{max-width:760px;font-size:14.7px;line-height:1.35;color:var(--ink);margin-top:10px}.intro h1{font-size:29.4px}.top-links{align-items:center}@media(max-width:600px){.intro .project-subtitle{font-size:12.6px}.intro h1{font-size:23.8px}.top-links{gap:10px;flex-wrap:wrap;justify-content:flex-end}}

.map-window-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-left:auto}.map-window-actions .button{min-height:33px;padding:6px 9px;white-space:nowrap;font-size:11px}.map-window-message{font-size:11px;max-width:260px}.atlas-toolbar{flex-wrap:wrap}.window.atlas-expanded,.window:fullscreen{position:fixed;inset:0;width:100%;height:100vh;height:100dvh;z-index:10000;margin:0;border-radius:0;display:flex;flex-direction:column;overflow:hidden}.window.atlas-expanded>.scene-wrap,.window:fullscreen>.scene-wrap{flex:1 1 auto;min-height:180px;height:auto}.window.atlas-expanded>.atlas-toolbar,.window.atlas-expanded>.archive-hover-controls{flex-shrink:0}.window.atlas-expanded>.timeline{flex:0 1 auto;max-height:30vh;overflow:auto}.window.atlas-expanded>.regional-panel{max-height:24vh}.window.atlas-expanded>.composer{display:none}.archive-hover-all{border:1px solid var(--line);background:var(--card);border-radius:3px;padding:4px 8px;font-size:11px}@media(max-width:600px){.map-window-actions{margin-left:0;width:100%;justify-content:flex-end}.window.atlas-expanded>.atlas-toolbar{padding:5px 8px;gap:5px}.window.atlas-expanded>.archive-hover-controls{padding:5px 8px;gap:5px 9px}.window.atlas-expanded>.timeline{max-height:25vh}.window.atlas-expanded .scene-wrap{min-height:120px}}

/* A full-height drag target, with aligned 24 px thumb and milestone centers. */
.timeline-track{height:44px;touch-action:none;user-select:none;cursor:ew-resize}
.timeline-track #time-slider{height:44px;appearance:none;-webkit-appearance:none;background:transparent;cursor:ew-resize;touch-action:none}
.timeline-track #time-slider::-webkit-slider-runnable-track{height:6px;background:#ccd1c4;border-radius:6px}
.timeline-track #time-slider::-moz-range-track{height:6px;background:#ccd1c4;border-radius:6px}
.timeline-track #time-slider::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:24px;height:24px;margin-top:-9px;border:3px solid var(--card);border-radius:50%;background:var(--rust);box-shadow:0 0 0 1px var(--rust)}
.timeline-track #time-slider::-moz-range-thumb{box-sizing:border-box;width:24px;height:24px;border:3px solid var(--card);border-radius:50%;background:var(--rust);box-shadow:0 0 0 1px var(--rust)}
.timeline-track .year-ticks{inset:0 12px;height:44px}
.timeline-track[data-snapped-year] #time-slider::-webkit-slider-thumb{background:#2a524a;box-shadow:0 0 0 4px #2a524a33}
.timeline-track[data-snapped-year] #time-slider::-moz-range-thumb{background:#2a524a;box-shadow:0 0 0 4px #2a524a33}
.timeline-track #time-slider:disabled{cursor:not-allowed;opacity:.45}

/* Building identity and dated occupants remain readable at street scale. */
.atlas-label[data-building-address]{max-width:390px;white-space:normal;line-height:1.35;text-align:left}
.merchant-history{margin:20px 0;border-top:1px solid var(--line);padding-top:16px}
.merchant-history h3{font-size:14px}.merchant-phase{border-left:2px solid var(--line);padding:8px 12px;margin:8px 0}
.merchant-phase[data-active="true"]{border-color:var(--rust);background:var(--soft)}
.merchant-phase button{display:block;border:0;border-bottom:1px dotted var(--rust);padding:2px 0;margin-bottom:5px;background:none;color:var(--rust);font-size:12px}
.merchant-phase strong{display:block}.merchant-phase p{font-size:12px;margin:5px 0}.merchant-phase a{display:block;font-size:11px;margin:4px 0}

.source-category-grid{flex-basis:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:6px 18px;border:0;margin:4px 0 0;padding:8px 0 0;border-top:1px solid var(--line)}
.source-category-grid legend{font-weight:600;padding:0 0 5px}.source-category-option{display:flex;align-items:center;gap:8px;min-height:30px}.source-category-option i{width:10px;height:10px;border-radius:50%;flex:none}
.archive-hover-dot{background:var(--source-color,#167e83)!important;border:2px solid #fffdf7!important;color:white!important;opacity:.8!important;box-shadow:0 1px 3px #24332b45}
.archive-hover-dot.is-near,.archive-hover-dot:focus-visible{opacity:1!important;outline:2px solid var(--source-color,#167e83);outline-offset:2px}.source-category-caption{font-size:12px;font-weight:600;margin:0 0 5px}
#source-filter-panel>summary{display:list-item;cursor:pointer;padding:8px 16px;font-size:9.1px}#source-filter-panel .archive-hover-controls{flex-wrap:wrap}#source-filter-panel:not([open])>.archive-hover-controls{display:none}
@media(max-width:700px){.source-category-grid{grid-template-columns:1fr}.source-category-option{min-height:44px;font-size:15px}.source-category-option input{width:20px;height:20px}}

</style>
