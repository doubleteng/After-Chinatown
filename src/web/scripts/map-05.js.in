2763489156097],[-83.05397008895874,42.32762080531493],[-83.05398914337158,42.32762080531493],[-83.05400184631348,42.32764428238991],[-83.05398279190064,42.327648977803854],[-83.05398279190064,42.327677150280174],[-83.05413522720337,42.3278743572611],[-83.05416698455811,42.32788374805429],[-83.0541923904419,42.327954178958564],[-83.05541822433472,42.329531810547586],[-83.05541187286377,42.3295458963657],[-83.05543092727662,42.3295458963657],[-83.0555770111084,42.329747792745394],[-83.05561511993409,42.329757183258906],[-83.05561511993409,42.329794745298955]]}];window.ACTIVITY_DATA=null;window.TIMELINE_DATA=__DATA_TIMELINE__;window.CURATED_ARCHIVE=__DATA_ARCHIVE__;window.CURATED_EVIDENCE={version:"2026-09-07.7",sources:[{id:"O01",title:"Merchants Association at 1341 Third Street",date:"1939-04-24",note:"Archive date; temporary convention decorations.",credit:"Detroit Public Library · Burton Historical Collection / Detroit Free Press",url:"https://digitalcollections.detroitpubliclibrary.org/bh028310",image:"https://digitalcollections.detroitpubliclibrary.org/sites/default/files/service/59/50/bh028310--service.jpg"},{id:"O02",title:"Third Street: association rooms and storefronts",date:"1950-04-18",note:"Date issued / newspaper stamp; exposure date is not independently established.",credit:"Detroit Public Library · Burton Historical Collection / Detroit Free Press",url:"https://digitalcollections.detroitpubliclibrary.org/bh028309",image:"https://www.arcgis.com/sharing/rest/content/items/66fbeec68dba4b5f98f0ff2560586a4d/resources/2EwfnHppUoOdeF-6i6jmq.jpeg"},{id:"N01",title:"Cass Avenue: Shanghai, market and Chung’s",date:"1963-10-14",note:"Date issued / newspaper stamp; dimensions have not been measured.",credit:"Detroit Public Library · Burton Historical Collection / Detroit Free Press",url:"https://digitalcollections.detroitpubliclibrary.org/bh028311",image:"https://www.arcgis.com/sharing/rest/content/items/66fbeec68dba4b5f98f0ff2560586a4d/resources/bzCY97KIAXUhiquQ8j8Je.jpeg"},{id:"N02",title:"Celebration at Cass and Peterboro",date:"1963-05-15",note:"Reuther catalog date. Do not merge this with the May 12 opening date reported by the city.",credit:"Walter P. Reuther Library, Wayne State University / Detroit News",url:"https://reuther.wayne.edu/node/9940",image:"https://reuther.wayne.edu/files/images/79744.preview.jpg"},{id:"M01",title:"Sanborn map · Volume 1, sheet 15",date:"1921",note:"An earlier parcel baseline, not evidence of unchanged buildings in 1950.",credit:"Library of Congress / Sanborn Map Company",url:"https://www.loc.gov/resource/g4114dm.g03985192101/?sp=20",image:null},{id:"R01",title:"Locating Detroit’s original Chinatown",date:"2022",note:"Secondary map overlay; approximate location, not a surveyed parcel.",credit:"DETROITography · Alex B. Hill",url:"https://detroitography.com/2022/04/29/map-detroits-original-chinatown/",image:null},{id:"R02",title:"Cass Corridor’s Chinatown",date:"City historical account",note:"Historical synthesis; preserves an unresolved Cass Avenue address discrepancy.",credit:"City of Detroit · Historic Designation Advisory Board",url:"https://storymaps.arcgis.com/stories/66fbeec68dba4b5f98f0ff2560586a4d",image:null},{id:"N03",title:"The New Chinatown · newspaper page",date:"1963-11-03",note:"A newspaper page republished by the city StoryMap; lists 3153 Cass, conflicting with the city’s 3143 Cass address.",credit:"Detroit Free Press Sunday Magazine · Kathie Norman / City of Detroit StoryMap",url:"https://storymaps.arcgis.com/stories/66fbeec68dba4b5f98f0ff2560586a4d",image:"https://www.arcgis.com/sharing/rest/content/items/66fbeec68dba4b5f98f0ff2560586a4d/resources/1nMdk6ym_64-dtTeIuICL.jpeg"}],claims:[{id:"O-A",scene:"old-1950",text:"The photograph cataloged in 1950 shows a three-storey building with shops at street level and upper-floor windows.",sources:["O02"],textZh:"1950 年编目的照片显示一栋三层建筑，底层设店铺，上部两层开窗。"},{id:"O-B",scene:"old-1950",text:"Wah Lee, Lun Fat, Lun Yick and Chung’s can be identified in the storefront sequence in the photograph.",sources:["O02"],textZh:"照片中的沿街店铺可以识别出 Wah Lee、Lun Fat、Lun Yick 和 Chung’s。"},{id:"O-C",scene:"old-1950",text:"The facade carries Merchants Association signage, linking association rooms and commercial storefronts within the same building.",sources:["O02"],textZh:"立面上可见商会标识，表明社团空间与底层商业店面位于同一栋建筑。"},{id:"O-D",scene:"old-1950",text:"Bunting, parked cars and pedestrians are visible in the 1950-cataloged photograph. It does not establish people’s identities or the reason for that particular gathering.",sources:["O02"],textZh:"1950 年编目的照片中可见彩饰、停放车辆和行人，但无法确定人物身份或该次活动的具体缘由。"},{id:"O-E",scene:"old-1950",text:"A separate 1939 archive record identifies the Merchants Association building at 1341 Third Street and shows convention decorations. Its date must not be transferred to the 1950 photograph.",sources:["O01"],textZh:"另一份 1939 年馆藏记录将商会建筑标为 1341 Third Street，并显示会议装饰；不能把该日期移用于 1950 年照片。"},{id:"O-F",scene:"old-1950",text:"The 1921 Sanborn sheet is an earlier street and parcel reference. This prototype has not georeferenced it or measured a 1950 building footprint.",sources:["M01","R01"],textZh:"1921 年 Sanborn 图是更早的街道与地块资料。此原型尚未对其配准，也没有测量 1950 年的建筑轮廓。"},{id:"N-A",scene:"new-1963",text:"The 1963-cataloged Cass Avenue photograph shows a two-storey Merchants Association building with a Shanghai Chop Suey sign.",sources:["N01"],textZh:"1963 年编目的 Cass Avenue 照片显示一栋两层商会建筑及 Shanghai Chop Suey 招牌。"},{id:"N-B",scene:"new-1963",text:"The photograph places a market frontage between the Shanghai building and Chung’s farther along the street.",sources:["N01"],textZh:"照片显示市场店面位于 Shanghai 建筑与更远处的 Chung’s 之间。"},{id:"N-C",scene:"new-1963",text:"The City of Detroit historical account dates the start of the move to Cass Avenue and Peterboro to 1963 and the association building’s opening to May 12, 1963.",sources:["R02"],textZh:"底特律市历史专题将迁往 Cass Avenue 与 Peterboro 的起始年份记为 1963，并将商会大楼开幕记为 1963 年 5 月 12 日。"},{id:"N-D",scene:"new-1963",text:"The city account gives 3143 Cass for the association building and 3177 Cass for Chung’s. A 1963 newspaper item gives 3153 Cass for the association; this address discrepancy remains unresolved.",sources:["R02","N03"],textZh:"市政府专题将商会地址写为 3143 Cass、Chung’s 写为 3177 Cass；一份 1963 年报刊将商会写为 3153 Cass，该门号差异尚未解决。"},{id:"N-E",scene:"new-1963",text:"The Reuther Library catalogs a celebration at Cass and Peterboro on May 15, 1963. That catalog date and the city’s May 12 opening date are retained separately.",sources:["N02","R02"],textZh:"Reuther 图书馆将 Cass 与 Peterboro 的庆祝照片编目为 1963 年 5 月 15 日；该日期与市政府记载的 5 月 12 日开幕日期分别保留。"},{id:"N-F",scene:"new-1963",text:"The Cass photograph records pedestrians and parked vehicles. The moving figures in this prototype are illustrative, not reconstructions of named individuals.",sources:["N01"],textZh:"Cass 照片记录了行人与停放车辆。本原型的运动人物仅为示意，不代表具名历史人物。"}],scenes:[{id:"old-1950",district:"old",year:1950,title:"Original Chinatown",titleZh:"旧唐人街",subtitle:"Third Street · association rooms above a commercial street",subtitleZh:"Third Street · 商会与沿街商铺",center:[42.3305,-83.0575],radius:180,coordinateNote:"Approximate area around the former Third / Porter street network, located from the DETROITography overlay; not a measured building coordinate.",coordinateSources:["R01"],primary:"O02",sources:["O02","O01","M01","R01"],summary:"A merchant association and a row of shops share one facade. Read the relationship between collective institutions, storefronts and everyday street space.",summaryZh:"商会与多家店铺共享同一立面，展现社团机构、商业店面与日常街道空间的联系。",elements:[{id:"merchants",name:"Merchants Association",nameZh:"华人工商会",x:0,width:48,height:13.2,depth:12,kind:"building",claims:["O-A","O-C","O-E","O-F"]},{id:"wahlee",name:"Wah Lee Co.",nameZh:"Wah Lee 商铺",x:-18,width:11,kind:"store",claims:["O-B"]},{id:"lunfat",name:"Lun Fat",nameZh:"Lun Fat 商铺",x:-6,width:11,kind:"store",claims:["O-B"]},{id:"lunyick",name:"Lun Yick",nameZh:"Lun Yick 商铺",x:6,width:11,kind:"store",claims:["O-B"]},{id:"chungs",name:"Chung’s",nameZh:"Chung’s 餐厅",x:18,width:11,kind:"store",claims:["O-B"]}]},{id:"new-1963",district:"new",year:1963,title:"Relocated Chinatown",titleZh:"迁移后的唐人街",subtitle:"Cass Avenue · a new collection of community places",subtitleZh:"Cass Avenue · 迁移后的社区场所",center:[42.343715,-83.059993],radius:160,coordinateNote:"Approximate area centered on the association marker in the city StoryMap; that point is not a surveyed footprint.",coordinateSources:["R02"],primary:"N01",sources:["N01","N02","R02","N03"],summary:"The association, Shanghai restaurant, a market and Chung’s form a new street sequence. The 1963 sources make relocation visible at the scale of buildings and public space.",summaryZh:"商会、Shanghai 餐厅、市场与 Chung’s 形成新的街道序列，1963 年资料从建筑与公共空间的尺度记录迁移。",elements:[{id:"merchants",name:"Association / Shanghai",nameZh:"商会 / Shanghai 餐厅",x:-17,width:21,height:10,depth:12,kind:"building",claims:["N-A","N-C","N-D"]},{id:"market",name:"Market frontage",nameZh:"市场店面",x:2,width:16,height:7.5,depth:10,kind:"building",claims:["N-B"]},{id:"chungs",name:"Chung’s",nameZh:"Chung’s 餐厅",x:19,width:15,height:7,depth:10,kind:"building",claims:["N-B","N-D"]}]}],method:{geometry:"All numeric widths, depths, heights and distances are modeling assumptions. Photographs support building identity, visible storey counts and relative frontage sequence; this is not a survey or photogrammetric reconstruction.",figures:"Anonymous schematic figures illustrate street use. Motion, clothing colors and positions are not recovered historical facts.",ai:"Gemini reads a curated evidence set and selects a scene focus and viewpoint. Geometry comes from the reviewed scene dataset, not arbitrary generated code."}};window.ARCHIVE_HOVER_DATA=__DATA_HOVER__;window.ADDRESS_REVIEW86=__DATA_ADDRESS_REVIEW__;
/* Address evidence and research scope are separate from coordinate approval. */
const AddressReview86 = (() => {
  const data=window.ADDRESS_REVIEW86;
  const entries=new Map(data.records.map(r=>[r.map_id,r]));
  let selected='all';
  const labels={all:['All sources','全部史料'],reviewed:['This batch · 13 address-verified sources','本批 · 13 项地址已核资料'],core:['Core places · 8','核心地点 · 8'],association:['Business / interior associations · 2','营业地／室内关联 · 2'],context:['Neighborhood context · 3','周边背景 · 3']};
  const colors={core:'#35675a',association:'#a77520',context:'#596ba1'};
  const zh=()=>window.AtlasI18n?.language()==='zh';
  const tr=(a,b)=>zh()?b:a;
  function matches(id){if(selected==='all')return true;const r=entries.get(id);return !!r&&r.map_point&&(selected==='reviewed'||r.scope===selected);}
  function key(id){return selected==='all'?'':entries.get(id)?.scope||'';}
  function decorate(button,id){const r=entries.get(id);if(selected==='all'||!r)return;button.style.setProperty('--source-color',colors[r.scope]||'#777');button.dataset.reviewScope=r.scope;button.title=tr(...r.scope_label);}
  function make(tag,text){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;}
  function link(text,url){const a=make('a',text);a.href=url;a.target='_blank';a.rel='noopener';return a;}
  function details(r){const d=make('details');d.append(make('summary',r.canonical_id+' · '+r.address));d.append(make('p',r.title_zh),make('p',r.date_label_zh),make('p',r.location_basis_zh),make('p',tr(r.warning,r.warning_zh)));d.append(link(tr('Original source ↗','原始来源 ↗'),r.source_url));return d;}
  function controls(host,refresh){
    const section=make('section');section.id='address-review86';section.dataset.noTranslate='';
    const row=make('div');row.className='address-review86-controls';
    const label=make('label',tr('Address review · 3 Oct 2026','地址核验 · 2026-10-03'));label.htmlFor='address-review86-filter';
    const select=make('select');select.id='address-review86-filter';
    for(const [value,pair] of Object.entries(labels)){const o=make('option',tr(...pair));o.value=value;select.append(o);}select.value=selected;
    select.onchange=()=>{selected=select.value;refresh(selected!=='all');};
    row.append(label,select,link(tr('Review queue ↗','人工核验队列 ↗'),data.queue_url));section.append(row);
    section.append(make('p',tr('Address evidence is verified; existing map anchors remain approximate. Markers identify depicted or associated places, not camera positions. Selecting this batch shows all source dates; unknown dates stay unknown.','地址证据已核；沿用地图参考点，地块和拍摄机位尚未测定。切换本批会显示全部资料年代；未知日期仍保留未知。')));
    const pending=make('details');pending.append(make('summary',tr('Pending / outside-core list: 2 image-location links; 14 outside-core records','待核与范围外清单：2 项图像关联待补证；14 项核心范围外记录')));
    for(const r of data.records.filter(r=>r.scope==='pending'||r.scope==='outside'))pending.append(details(r));
    for(const r of data.outside_queue.filter(r=>r['Canonical ID']!=='X01')){
      const d=make('details');d.append(make('summary',r['Canonical ID']+' · '+r['地址候选']),make('p',r['影像 / 对象']),make('p',r['必须保留的警告']),link(tr('Source ↗','来源 ↗'),r['Source URL']));pending.append(d);
    }
    section.append(pending);host.append(section);
  }
  function card(host,id){const r=entries.get(id);if(!r)return;const p=make('p',r.canonical_id+' · '+tr(...r.scope_label));p.className='address-review86-badge';host.append(p);}
  return {matches,key,decorate,controls,card};
})();

const ArchiveHover=(()=>{const e=[{"id":"municipal","en":"Municipal building records","zh":"市政建筑记录","color":"#355b9d","default":false,"description":"Government building decisions, tax and parcel records, heritage designations, permits and public demolition, alteration or construction.","descriptionZh":"政府建筑决议、税务地籍、保护认定、许可，以及政府主导的拆除、改建与新建。"},{"id":"property","en":"Commercial property records","zh":"商业房产记录","color":"#a85b16","default":false,"description":"Commercial property listings, sales, transfers and letting records, including listing photographs. A listing is not a verified deed.","descriptionZh":"商业网站的房屋买卖、转手、招租和挂牌资料，含挂牌配图；挂牌信息不等于已核实的产权契据。"},{"id":"commerce","en":"Business use & occupancy","zh":"商业业态记录","color":"#237849","default":false,"description":"Occupants, business types, openings, closures, renaming and changes of building use; these do not by themselves date construction or demolition.","descriptionZh":"建筑租户、经营类别、开业、停业、改名及用途变化；这些日期不直接等于建造或拆除日期。"},{"id":"transport","en":"Municipal transport records","zh":"市政交通记录","color":"#b63c42","default":false,"description":"Road, freeway, bridge and railway planning, funding, construction, opening, removal and engineering records; proposals remain distinct from completed works.","descriptionZh":"道路、高架、桥梁与轨道的规划、拨款、施工、通车、拆除及工程记录；提案与实际完工分开。"},{"id":"news","en":"News","zh":"新闻","color":"#8b4697","default":false,"description":"Newspaper and media reporting of events. Focused business-use and transport records are filed under those subjects; their publication source is retained.","descriptionZh":"报纸与媒体的事件报道；专门记录商铺用途或交通工程的条目归入相应类别，同时保留报道来源。"},{"id":"community","en":"Online leads","zh":"网友线索","color":"#687442","default":false,"description":"Online contributions and unverified leads. Named first-person testimony belongs to oral history; verified images retain image provenance.","descriptionZh":"网友提供的线索及尚待核实的网络信息；具名亲历叙述归入口述历史，已确认图像保留其影像来源。"},{"id":"history","en":"Historical archives","zh":"历史档案","color":"#775039","default":tru