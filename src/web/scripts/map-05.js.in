function applyBlockSpatial82(spatial){applyCharlotteSpatial83(spatial);
 if(spatial.block82===BlockReference82.version)return spatial;
 for(const r of BlockReference82.buildings){const b=spatial.buildings.find(b=>b.id===r.id);if(!b)continue;
 b.reviewed_name=r.name;b.name=r.name;b.architectureCompleteYear=r.year;b.height=r.height;b.sourceIds=[...(b.sourceIds||[]),...r.sources];
 if(spatial.addressReview){for(const k of r.sources)spatial.addressReview.sources[k]=BlockReference82.sources[k];spatial.addressReview.records[r.id]={...spatial.addressReview.records[r.id],address:r.address+' · '+r.name,inventoryAliases:r.aliases,sourceIds:r.sources};}}
 const review=spatial.roadAlignmentReview;if(review){Object.assign(review.buildingGeometries,BlockReference82.clearance.geometries);for(const [y,changes] of Object.entries(BlockReference82.clearance.years))review.buildingYears[y]={...(review.buildingYears[y]||{}),...changes};}
 spatial.block82=BlockReference82.version;return spatial;
}
