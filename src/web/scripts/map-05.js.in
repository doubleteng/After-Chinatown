16/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/2/","entity":"","referenceYear":2016,"heightReference":12.8},{"id":"R87_51","ids":["semcog-8142286"],"name":"Strathmore Hotel","address":"70 W. Alexandrine","construction":1924,"approximate":false,"use":"Apartment hotel; subsequently converted to apartments.","useZh":"公寓式旅馆，后来改作公寓。","category":"municipal","sources":[{"title":"NPS · Willis–Selden Historic District nomination, 1997","url":"https://catalog.archives.gov/medialive/43/3386/25338643/content/electronic-records/rg-079/NPS_MI/97001478.pdf","category":"municipal"}],"coordinates":[-83.06137146750018,42.3504719179271],"scope":"Cass Corridor context","article":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/2/","entity":"","referenceYear":1997,"model":{"id":"cass87-strathmore","kind":"hotel","floors":8,"height":27.2,"body":27.2,"facing":[0.47285,0.88114],"from":1924,"through":2026,"bays":7,"color":"#967354","referenceYear":1997,"sources":["R87_51"],"dateBasis":"construction","constructionApproximate":false},"heightReference":27.2},{"id":"R87_33","ids":["semcog-8132911"],"name":"2701 Cass Avenue · brick garage / warehouse","address":"2701 Cass Avenue","construction":1946,"approximate":false,"use":"Single-storey brick commercial building with a recessed loading door. Reported vacant in January 2016. Original business use remains unconfirmed.","useZh":"单层砖砌商业建筑，中央设内凹装卸门。2016 年 1 月报道为空置；原始经营用途仍待核实。","category":"municipal","sources":[{"title":"SEMCOG 2024 building inventory · reported construction 1946","url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84","category":"municipal"},{"title":"Motor City Muckraker · exterior published 19 January 2016","url":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/2/","category":"news"},{"title":"LoopNet · user-supplied construction excerpt (page not independently inspected)","url":"https://www.loopnet.com/property/2701-cass-ave-detroit-mi-48201/26163-02002267/","category":"property"}],"coordinates":[-83.0583461300283,42.340595494883274],"scope":"Cass Corridor context","article":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/2/","entity":"cass87-R87_33","referenceYear":2016,"warning":"1946 is a reported SEMCOG inventory construction year, consistent with the user-supplied LoopNet excerpt; the LoopNet page was not independently readable. Later photographs guide a continuity-based facade reconstruction, not a surveyed 1946 elevation. Exact opening dimensions, height and original use remain unverified. Graffiti and undated temporary boarding are omitted; no current vacancy is asserted.","warningZh":"1946 年为 SEMCOG 清册记录的建造年，与用户提供的 LoopNet 摘录一致；本次未能独立读取 LoopNet 页面。后期照片用于连续性参考重建，不是 1946 年实测立面。开口尺寸、高度和原始用途待核实。未复原涂鸦及年代不明的临时封窗，也不据 2016 年空置报道判断现状。","model":{"id":"cass87-cass2701","kind":"garage92","floors":1,"height":7.75,"body":7,"facing":[0.921,-0.39],"from":1946,"through":2026,"bays":3,"color":"#9a5848","referenceYear":2016,"dateBasis":"construction","constructionApproximate":false,"sources":["R87_33"]}},{"id":"R93_3443","ids":["semcog-8136471"],"name":"3443 Cass Avenue · Canine to Five","address":"3443 Cass Avenue","construction":1949,"approximate":false,"use":"Canine to Five opened in 2005. D MET completed the fiber-cement facade renovation in April 2011. Original 1949 use remains unconfirmed.","useZh":"Canine to Five 于 2005 年开业；D MET 于 2011 年 4 月完成纤维水泥板立面改造。1949 年原始用途未确认。","category":"municipal","sources":[{"title":"D MET · facade renovation completed April 2011","url":"https://www.dmetstudio.com/client-list-1","category":"architecture"},{"title":"D MET · before/after photographs and project description, page 10","url":"https://www.motorcitymatch.com/wp-content/uploads/2016/08/D_MET_Projects_16_0130_MCM.pdf","category":"architecture"},{"title":"SEMCOG · original building 1949; separate addition 2018","url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84","category":"municipal"},{"title":"Canine to Five · Midtown location opened in 2005","url":"https://www.caninetofive.com/locations/midtown-detroit/","category":"business"},{"title":"Canine to Five · 2019 expansion retrospective","url":"https://www.caninetofive.com/2019-by-the-numbers/","category":"business"},{"title":"LoopNet · property parcel and supplied construction reference","url":"https://www.loopnet.com/property/3443-cass-ave-detroit-mi-48201/26163-020022447/","category":"property"}],"coordinates":[-83.06073609295365,42.344925745534674],"scope":"Cass Corridor context","article":"https://www.dmetstudio.com/client-list-1","supplement":true,"entity":"cass87-R93_3443","referenceYear":2011,"heightReference":5.2,"warning":"1949 is the reported SEMCOG construction year for the original northern building, consistent with the supplied property record. D MET documents facade renovation completed April 2011. The pre-2011 brick facade is a continuity-based reconstruction from the architect’s BEFORE photograph, not proof of the exact 1949 appearance. The separate southern footprint retains its 2018 inventory date; the operator reports expansion during 2019. Original use, intervening alterations and precise dimensions remain unresolved.","warningZh":"1949 年是北侧原建筑的 SEMCOG 清册建造年，与用户提供的房产记录一致。D MET 确认立面改造于 2011 年 4 月完成。此前砖立面依据设计方改造前照片作连续性参考重建，不是 1949 年原貌的直接证据。南侧独立扩建轮廓保留清册的 2018 年日期；经营者记载 2019 年扩建。原始用途、中间改造和实测尺寸仍待核实。","model":{"id":"cass87-cass3443","kind":"canine93","floors":1,"height":5.2,"body":5.2,"facing":[0.921,-0.39],"from":1949,"through":2026,"bays":10,"color":"#ab926c","referenceYear":2011,"dateBasis":"construction","constructionApproximate":false,"sources":["R93_3443"],"renovationYear":2011}},{"id":"R87_15","ids":["semcog-8900602","semcog-8135000"],"name":"3113 & 3117 Cass Avenue · former houses","address":"3113 / 3117 Cass Avenue","aliases":["3113 Cass","3113 Cass Avenue","3117 Cass","3117 Cass Avenue"],"buildingNames":{"semcog-8900602":"3113 Cass Avenue · former house","semcog-8135000":"3117 Cass Avenue · former house"},"construction":1880,"approximate":false,"use":"Residential houses on one parcel. Listed for sale in 2014; reported vacant in January 2016; demolition recorded in 2016. No verified Chinatown institutional use.","useZh":"同一地块内两栋住宅。2014 年房产挂牌；2016 年 1 月报道空置，同年清册记拆除。没有已核实的唐人街机构用途。","category":"news","sources":[{"title":"SEMCOG · two building IDs; shared parcel; 1880 / 2016","url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84","category":"municipal"},{"title":"Realcomp / Realtor.com · 3113 listing and permit history","url":"https://www.realtor.com/realestateandhomes-detail/3113-Cass-Ave_Detroit_MI_48201_M40407-78379","category":"property"},{"title":"Motor City Muckraker · two houses, January 19, 2016","url":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/","category":"news"},{"title":"Library of Congress · 1897 Sanborn map collection","url":"https://www.loc.gov/item/sanborn03985_005/","category":"map"}],"coordinates":[-83.05972016004065,42.34322874272194],"scope":"Cass Corridor context","article":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/","entity":"cass87-R87_15","referenceYear":2016,"heightReference":11.6,"warning":"Two separate houses, 3113 and 3117 Cass, share parcel 02-002255 in the SEMCOG inventory; the 2016 article groups them under 3113. Both have reported 1880 construction and 2016 demolition. The inventory’s raw date is April 19, 2016, while the listing reports a May 5 demolition permit for 3113; neither is adopted as a verified completion day. Annual scenes show year-end status, so the houses disappear in 2016 although the January article documented them standing. Three facade levels are visible in photographs; SEMCOG counts 3113 as two storeys and 3117 as three. Exact 1880 appearance, metric heights and rear elevations remain uncertain; the intact southern dormer is interpretive. No documented Chinatown business or association use has been established for these houses.","warningZh":"3113 与 3117 Cass 是两栋独立住宅，SEMCOG 记为同一地块 02-002255；2016 年文章合称 3113。两栋均记 1880 年建造、2016 年拆除。清册原始日期为 2016-04-19，房产页面的 3113 拆除许可为 2016-05-05；均不作为已核实完工日。地图显示年末状态，故 2016 年移除体量，不能据此否认当年 1 月仍存。照片可见三个立面层次，清册却分别记 3113 两层、3117 三层。1880 年原貌、实测高度和背面未确认；南栋完整尖顶为解释性复原。未查实两栋的唐人街商户或社团用途。","events":[{"id":"R94_HOUSES_BUILT","date":"1880","type":"construction","category":"municipal","label":"Construction · both houses","labelZh":"建造 · 两栋住宅","text":"SEMCOG records 1880 for both independent building IDs; Realcomp also lists 1880 for 3113. This is a reported construction year, not an original permit.","textZh":"SEMCOG 两个独立建筑 ID 均记 1880；Realcomp 的 3113 记录亦为 1880。属于清册建造年，并非原始建造许可。","url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84"},{"id":"R94_HOUSES_MAP","date":"1897","type":"observed","category":"map","label":"Mapped residential footprints","labelZh":"历史地图 · 住宅轮廓","text":"Existing registered 1897 Sanborn traces overlap the two later address-matched envelopes. Registration and outline simplification remain approximate.","textZh":"既有 1897 年 Sanborn 配准轮廓与两栋门牌匹配轮廓相叠；配准及轮廓简化仍有误差。","url":"https://www.loc.gov/item/sanborn03985_005/"},{"id":"R94_3113_LISTING","date":"2014-03-05","type":"property","category":"property","label":"3113 Cass · property listed","labelZh":"3113 Cass · 房产挂牌","text":"Realcomp history: listed March 5, 2014 for $200,000; removed March 14, relisted July 19, removed July 21. A listing is not a completed sale or occupancy record.","textZh":"Realcomp：2014-03-05 挂牌 20 万美元，3 月 14 日撤下；7 月 19 日再次挂牌，7 月 21 日撤下。挂牌不代表成交或有人居住。","url":"https://www.realtor.com/realestateandhomes-detail/3113-Cass-Ave_Detroit_MI_48201_M40407-78379"},{"id":"R87_15","date":"2016-01-19","type":"observed","category":"news","label":"Vacancy and deterioration reported","labelZh":"新闻 · 空置及损坏报道","text":"Motor City Muckraker publishes the two-house photograph under 3113 Cass and reports prolonged vacancy and poor condition. Publication date is not the photograph capture date or abandonment start.","textZh":"Motor City Muckraker 以 3113 Cass 刊载两栋住宅照片，报道长期空置及状况较差。发表日不是照片拍摄日或弃置起始日。","url":"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/"},{"id":"R94_3113_PERMIT","date":"2016-05-05","type":"permit","category":"municipal","label":"3113 Cass · demolition permit issued","labelZh":"3113 Cass · 拆除许可签发","text":"Realtor.com permit history lists a residential demolition permit as issued on May 5, 2016. Duplicated page rows are treated as one permit event; issuance is not completion.","textZh":"Realtor.com 许可历史列 2016-05-05 住宅拆除许可，状态为已签发。网页重复行合并为一个事件；签发不等于拆除完工。","url":"https://www.realtor.com/realestateandhomes-detail/3113-Cass-Ave_Detroit_MI_48201_M40407-78379"},{"id":"R94_HOUSES_DEMOLITION","date":"2016","type":"demolition","category":"municipal","label":"Demolition · year recorded","labelZh":"拆除 · 清册记录年份","text":"SEMCOG records demolition in 2016 for both buildings. Exact completion day remains unresolved; the map uses year-end status and removes both volumes from 2016.","textZh":"SEMCOG 两栋建筑均记 2016 年拆除；确切完工日未定。地图按年末状态，自 2016 年移除两栋体量。","url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84"}],"model":{"id":"cass87-cass3113-3117","kind":"houses94","floors":3,"height":11.6,"body":7.2,"facing":[0.921,-0.39],"from":1880,"through":2015,"bays":2,"color":"#854735","referenceYear":2016,"dateBasis":"construction","constructionApproximate":false,"sources":["R87_15"]}}],byId=new Map(records.flatMap(r=>r.ids.map(id=>[id,r])));
 function applySpatial(s){
  for(const r of records){
   const matches=s.buildings.filter(b=>r.ids.includes(b.id));
   const b=matches[0];if(!b)continue;
   for(const item of matches){
    item.cassResearch87=r.id;item.reviewed_name=r.buildingNames?.[item.id]||r.name;
    if(item.inventory){
     if(!Object.prototype.hasOwnProperty.call(item.inventory,'reported_built87'))item.inventory.reported_built87=item.inventory.built;
     if(r.construction)item.inventory.built=Array.isArray(r.construction)?r.construction[1]:r.construction;
     else if(!r.construction)item.inventory.built=null;
    }
    if(r.model){item.height=r.model.height;item.height_basis='Documented storey count; illustrative floor heights, not measured.';}
    item.sourceIds=[...new Set([...(item.sourceIds||[]),r.id])];
   }
   const key='cass87-'+r.id;
   s.anchors[key]={point:b.center,basis:'Verified address associated with existing registered footprint; no new geocoding.',uncertainty_m:25,source_url:r.sources[0].url,district:'new',aliases:(r.aliases||[r.address]).map(x=>x.toLowerCase()),building_ids:r.ids};
   s.record_anchors[r.id]=key;for(const event of r.events||[])s.record_anchors[event.id]=key;
  }
  return s;
 }
 function dateLabel(r,zh){if(!r.construction)return zh?'建造时间未确认':'Construction unconfirmed';return (r.approximate?(zh?'约 ':'c. '):'')+(Array.isArray(r.construction)?r.construction.join('–'):r.construction)+(zh?' 年建':' construction');}
 function panel(b,year,zh){const r=byId.get(b.id);if(!r)return null;const box=document.createElement('section');box.className='merchant-history cass-research87';box.setAttribute('data-no-translate','');
 const p=(tag,text)=>{const e=document.createElement(tag);e.textContent=text;box.append(e);return e;};
 p('h4',zh?'建筑与用途 · 已核实资料':'Building & use · verified evidence');
 p('p',r.address+' · '+dateLabel(r,zh));p('p',zh?r.useZh:r.use);
 if(r.model){const m=r.model,approx=r.approximate?(zh?'约 ':'c. '):'';
  p('p',m.dateBasis==='construction'?(zh?`细化模型自 ${approx}${m.from} 年起显示，以建造时间为准。${m.referenceYear} 年为外观资料参考年份。`:`Detailed model shown from ${approx}${m.from}, based on construction. Exterior evidence reference: ${m.referenceYear}.`):(zh?`建造年待核实；模型从 ${m.from} 年的已核实建筑记录起显示，该年不是建造年。`:`Construction year unconfirmed; model begins with the verified ${m.from} observation, not a construction date.`));
 }
 if(r.events?.length){p('h4',zh?'分类时间线':'Classified timeline');for(const event of r.events){p('strong',event.date+' · '+(zh?event.labelZh:event.label));p('p',zh?event.textZh:event.text);const link=p('a',zh?'来源 ↗':'Source ↗');link.href=event.url;link.target='_blank';link.rel='noopener noreferrer';link.style.display='block';}} if(r.warning)p('p',zh?r.warningZh:r.warning);p('small',r.scope.includes('core')?(zh?'Chinatown 核心关联':'Chinatown core association'):(zh?'Cass Corridor 周边背景':'Cass Corridor context'));
 p('p',r.supplement?(zh?'补充核验记录；建筑轮廓沿用既有地图配准，高度和窗距为比例推估。':'Supplementary evidence record. Existing registered footprints retained; heights and window spacing are proportional estimates.'):(zh?'2016 年空置是当年报道，不代表现状。建筑轮廓沿用既有地图配准；高度、窗距为示意。':'Vacancy was reported in 2016; it is not a current-status claim. Registered footprints are retained; heights and window spacing are illustrative.'));
 for(const s of r.sources){const a=p('a',s.title+' ↗');a.href=s.url;a.target='_blank';a.rel='noopener noreferrer';a.style.display='block';}
 const a=p('a',r.supplement?(zh?'设计方项目记录 ↗':'Architect’s project record ↗'):(zh?'2016 年文章（对应页）↗':'2016 article · corresponding page ↗'));a.href=r.article;a.target='_blank';a.rel='noopener noreferrer';
 return box;
 }
 return {records,byId,applySpatial,panel,dateLabel};
})();

