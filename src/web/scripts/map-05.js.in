 if(spatial.charlotte83===CharlotteReference83.version)return spatial;
 for(const r of CharlotteReference83.buildings){const b=spatial.buildings.find(b=>b.id===r.id);if(!b)continue;
 b.reviewed_name=r.name;b.name=r.name;b.architectureCompleteYear=r.year;b.height=r.height;b.sourceIds=[...(b.sourceIds||[]),...r.sources];
 if(spatial.addressReview){for(const k of r.sources)spatial.addressReview.sources[k]=CharlotteReference83.sources[k];spatial.addressReview.records[r.id]={...spatial.addressReview.records[r.id],address:r.address+' · '+r.name,inventoryAliases:r.aliases,sourceIds:r.sources};}}
