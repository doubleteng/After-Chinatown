 const eyeHeight=1.65,defaultLens=43,minLens=28,maxLens=50,pitchLimit=65*Math.PI/180;
 const clamp=(v,low,high)=>Math.max(low,Math.min(high,v));
 function vector(yaw,pitch){return {x:Math.sin(yaw)*Math.cos(pitch),y:Math.sin(pitch),z:-Math.cos(yaw)*Math.cos(pitch)};}
 function lens(camera,focal){camera.filmGauge=36;camera.zoom=1;camera.setFocalLength(clamp(focal,minLens,maxLens));}
 function hint(street,compact,zh,focal=defaultLens){
  if(street)return zh?(compact?'人眼视角 · 拖动环视 · 双指调焦 28–50mm':Math.round(focal)+'mm · WASD 移动 · Shift ×4 · Q 上升／E 下降 · 按住左键拖动环视 · 滚轮调焦 28–50mm'):(compact?'Eye level · drag to look · pinch 28–50 mm':Math.round(focal)+' mm · WASD move · Shift ×4 · Q up / E down · left-drag to look · wheel 28–50 mm');
  return zh?'WASD 移动 · Shift ×4 · Q 上升／E 下降 · 拖动旋转 · 滚轮缩放 · 双击进入街景':'WASD move · Shift ×4 · Q up / E down · drag to orbit · scroll to zoom · double-click for street view';
 }
 function bind({element,host,camera,controls,THREE,isStreet,canInteract,beforeMove,onMove,compact,language}){
  let street=false,focal=defaultLens,drag=null,pinch=0;const pointers=new Map(),direction=new THREE.Vector3();
  const saved={minPolarAngle:controls.minPolarAngle,maxPolarAngle:controls.maxPolarAngle,minDistance:controls.minDistance,enableRotate:controls.enableRotate,enablePan:controls.enablePan,enableZoom:controls.enableZoom,fov:camera.fov,filmGauge:camera.filmGauge,zoom:camera.zoom};
  function optics(){host.dataset.cameraMode=street?'street':'orbit';host.dataset.cameraLensMm=street?focal.toFixed(2):'';host.dataset.cameraVerticalFov=camera.fov.toFixed(3);host.dataset.cameraHorizontalFov=(2*Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect)*180/Math.PI).toFixed(3);}
  function labels(){const zh=language()==='zh',photo=document.getElementById('rendered-result');if(photo&&!photo.hidden){const el=document.getElementById('view-hint');if(el)el.textContent=zh?'生成的解释性图像，并非历史照片':'Generated interpretation · not an archival photograph';return;}for(const id of ['view-hint','mobile-map-hint']){const el=document.getElementById(id);if(!el)continue;if(id==='mobile-map-hint'&&!street){el.textContent=MobileAtlas.hint();continue;}el.dataset.noTranslate='';el.textContent=hint(street,compact(),zh,focal);}}
  function cancel(){drag=null;pointers.clear();pinch=0;}
  function sync(mode){if(mode==='photo')return;const next=mode==='street';if(next!==street){street=next;cancel();if(street){focal=defaultLens;controls.minPolarAngle=Math.PI/2-pitchLimit;controls.maxPolarAngle=Math.PI/2+pitchLimit;controls.minDistance=1;controls.enableRotate=false;controls.enablePan=false;controls.enableZoom=false;lens(camera,focal);}else{Object.assign(controls,{minPolarAngle:saved.minPolarAngle,maxPolarAngle:saved.maxPolarAngle,minDistance:saved.minDistance,enableRotate:saved.enableRotate,enablePan:saved.enablePan,enableZoom:saved.enableZoom});camera.fov=saved.fov;camera.filmGauge=saved.filmGauge;camera.zoom=saved.zoom;camera.updateProjectionMatrix();}}optics();labels();}
  function resize(){if(street)lens(camera,focal);else camera.updateProjectionMatrix();optics();}
  function zoom(delta){if(!isStreet()||!canInteract())return;beforeMove();focal=clamp(focal+delta,minLens,maxLens);lens(camera,focal);optics();labels();onMove();}
  function look(dx,dy){camera.getWorldDirection(direction);const yaw=Math.atan2(direction.x,-direction.z)+dx*.003,pitch=clamp(Math.asin(clamp(direction.y,-1,1))-dy*.003,-pitchLimit,pitchLimit),next=vector(yaw,pitch),distance=clamp(camera.position.distanceTo(controls.target),10,40);controls.target.set(camera.position.x+next.x*distance,camera.position.y+next.y*distance,camera.position.z+next.z*distance);controls.update();onMove();host.dataset.cameraPitchDegrees=(pitch*180/Math.PI).toFixed(3);}
  element.addEventListener('pointerdown',event=>{
   if(!isStreet()||!canInteract()||event.button!==0)return;beforeMove();element.focus({preventScroll:true});pointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
   if(pointers.size===1)drag={id:event.pointerId,x:event.clientX,y:event.clientY};else{drag=null;const [a,b]=[...pointers.values()];pinch=Math.hypot(a.x-b.x,a.y-b.y);}
   element.setPointerCapture?.(event.pointerId);event.preventDefault();
  });
  element.addEventListener('pointermove',event=>{
   if(!isStreet()||!canInteract()||!pointers.has(event.pointerId))return;
   pointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
   if(pointers.size===2){const [a,b]=[...pointers.values()],distance=Math.hypot(a.x-b.x,a.y-b.y);if(pinch>0&&distance>0)zoom(focal*(distance/pinch-1));pinch=distance;event.preventDefault();return;}
   if(!drag||event.pointerId!==drag.id)return;look(event.clientX-drag.x,event.clientY-drag.y);drag.x=event.clientX;drag.y=event.clientY;event.preventDefault();
  });
  function release(event){pointers.delete(event.pointerId);drag=null;pinch=0;}
  element.addEventListener('pointerup',release);element.addEventListener('pointercancel',release);element.addEventListener('lostpointercapture',release);
  element.addEventListener('wheel',event=>{if(!isStreet()||!canInteract()||event.ctrlKey)return;event.preventDefault();zoom(event.deltaY<0?.7:-.7);},{passive:false});
  window.addEventListener('blur',cancel);document.addEventListener('visibilitychange',()=>{if(document.hidden)cancel();});window.addEventListener('atlas-language-changed',labels);
  function resetLens(){focal=defaultLens;lens(camera,focal);optics();labels();}
  return {sync,resize,zoom,cancel,look,labels,resetLens,restoreLens:frame=>{focal=clamp(36/(Math.max(frame.aspect,1)*2*Math.tan(frame.fov*Math.PI/360)),minLens,maxLens);lens(camera,focal);optics();labels();}};
 }
 return {eyeHeight,defaultLens,minLens,maxLens,pitchLimit,vector,lens,hint,bind};
})();
/* Reuse scene geometry. A spatial index limits each label ray to nearby models. */
/* One line-of-sight rule for every world-anchored tag and source marker. */
const LabelVisibility78=(()=>{
 function create({THREE,camera,host}){
  const size=96,grid=new Map(),ray=new THREE.Raycaster(),direction=new THREE.Vector3(),hit=new THREE.Vector3(),seen=new Set(),candidates=[],hits=[],wide=[];
  let revision=0,signature='',frame=0,queries=0,meshTests=0,pending=true,items=[],extra=[];
  function invalidate(){revision++;signature='';}
  function shown(object){for(let p=object;p;p=p.parent)if(!p.visible)return false;return true;}
  function reset(next,additional=[]){items=next;extra=additional;grid.clear();pending=true;invalidate();host.dataset.labelIndexState='deferred';}
  function index(){
   if(!pending)return;pending=false;grid.clear();wide.length=0;const rows=[];
   for(const item of items){if(!item.mesh||!item.status.showVolume)continue;rows.push({item,box:item.hoverBox.clone().expandByScalar(2)});}
   for(const object of extra){if(!object)continue;object.updateWorldMatrix(true,true);object.traverse(mesh=>{if(!mesh.isMesh||!mesh.geometry)return;const box=new THREE.Box3().setFromObject(mesh);if(!box.isEmpty())rows.push({object:mesh,box});});}
   for(const row of rows){const cells=(Math.floor(row.box.max.x/size)-Math.floor(row.box.min.x/size)+1)*(Math.floor(row.box.max.z/size)-Math.floor(row.box.min.z/size)+1);if(cells>4096){wide.push(row);continue;}for(let x=Math.floor(row.box.min.x/size);x<=Math.floor(row.box.max.x/size);x++)for(let z=Math.floor(row.box.min.z/size);z<=Math.floor(row.box.max.z/size);z++){const key=x+','+z;if(!grid.has(key))grid.set(key,[]);grid.get(key).push(row);}}
   host.dataset.labelOccluders=String(rows.length);host.dataset.labelIndexState='ready';
  }
  function begin(){
   const p=camera.position,q=camera.quaternion,key=[revision,p.x,p.y,p.z,q.x,q.y,q.z,q.w,camera.fov,camera.aspect].join('|');
   if(key!==signature){signature=key;frame++;}queries=0;meshTests=0;
  }
  function collect(to){
   const from=camera.position,dx=to.x-from.x,dz=to.z-from.z;let x=Math.floor(from.x/size),z=Math.floor(from.z/size);
   const endX=Math.floor(to.x/size),endZ=Math.floor(to.z/size),sx=Math.sign(dx),sz=Math.sign(dz),stepX=dx?size/Math.abs(dx):Infinity,stepZ=dz?size/Math.abs(dz):Infinity;
   let tx=dx?((sx>0?(x+1)*size:x*size)-from.x)/dx:Infinity,tz=dz?((sz>0?(z+1)*size:z*size)-from.z)/dz:Infinity;
   seen.clear();candidates.length=0;for(const row of wide)if(row.box.containsPoint(from)||ray.ray.intersectBox(row.box,hit)&&hit.distanceTo(from)<=ray.far+2)candidates.push(row);
   for(let n=0;n<4096;n++){
    for(const row of grid.get(x+','+z)||[]){if(seen.has(row))continue;seen.add(row);if(row.box.containsPoint(from)||ray.ray.intersectBox(row.box,hit)&&hit.distanceTo(from)<=ray.far+2)candidates.push(row);}
    if(x===endX&&z===endZ)break;
    if(tx<tz){x+=sx;tx+=stepX;}else if(tz<tx){z+=sz;tz+=stepZ;}else{x+=sx;z+=sz;tx+=stepX;tz+=stepZ;}
   }
  }
  function visible(label){
   if(!signature)begin();const p=label.p;
   if(label.occlusionFrame===frame&&label.occlusionX===p.x&&label.occlusionY===p.y&&label.occlusionZ===p.z)return label.occlusionVisible;
   function result(value){label.occlusionFrame=frame;label.occlusionX=p.x;label.occlusionY=p.y;label.occlusionZ=p.z;label.occlusionVisible=value;return value;}
   index();queries++;direction.subVectors(p,camera.position);const distance=direction.length();
   if(distance<.05)return result(true);ray.set(camera.position,direction.multiplyScalar(1/distance));ray.near=.025;ray.far=Math.max(.025,distance-.04);collect(p);
   for(const row of candidates){
    if(!shown(row.item?row.item.group:row.object))continue;
    const meshes=row.item?row.item.group.children.filter(m=>m.isMesh&&m.visible):[row.object];
    for(const mesh of meshes){const materials=Array.isArray(mesh.material)?mesh.material:[mesh.material];if(materials.every(m=>!m.visible||m.opacity<=0))continue;meshTests++;hits.length=0;ray.intersectObject(mesh,false,hits);if(hits.some(h=>{const m=materials[h.face?.materialIndex||0]||materials[0];return m.visible&&m.opacity>0;}))return result(false);}
   }
   return result(true);
  }
  function owners(){} // Compatibility only: there are no owner or tag-category exemptions.
  function stats(){host.dataset.labelVisibility='all-map-tags-model-occlusion';host.dataset.labelRays=String(queries);host.dataset.labelMeshTests=String(meshTests);}
  return {reset,invalidate,begin,visible,owners,stats};
 }
 return {create};
})();
