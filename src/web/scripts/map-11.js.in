 window.addEventListener('atlas-point',e=>{const oldMode=state.viewMode;updateSelection(e.detail.point,e.detail.sourceId,e.detail.flight!==false);if(e.detail.flight===false)setTab(oldMode==='context'?'context':'street',false);});window.addEventListener('atlas-outside',()=>{$('generation-message').textContent='Choose a point within either study area or its mapped surroundings.';});
 window.addEventListener('atlas-area',e=>{const a=data.areas.find(x=>x.id===e.detail.district);if(!a||state.busy||state.renderBusy)return;$('area').value=a.id;updateSelection(a.center,null,false);setTab('context',false);viewer().then(v=>v.overview(a.id));});
 function showOverview(){if(state.busy||state.renderBusy)return;setTab('context',false);$('area').value='';viewer().then(v=>v.overview(null));timeStatus();};

 function changeYear(value){if(state.busy||state.renderBusy)return;$('year').value=value;$('atlas-travel-year').value=value;if(!$('year').validity.valid)return;const oldMode=state.viewMode;if(state.context){updateSelection(state.context.point,state.primary,false);setTab(oldMode==='context'?'context':'street',false);}else viewer().then(v=>v.setYear(Number(value)));timeStatus();}
 window.addEventListener('atlas-regional-closed',()=>changeYear(Number($('year').value)));
 MobileAtlas.install({changeYear});
 // Address travel uses the local evidence/address index and never guesses an unmatched location.
 const searchInput=$('atlas-address'),searchYear=$('atlas-travel-year'),searchResults=$('atlas-address-results'),travelStatus=$('atlas-travel-status');
 const addressIndex=AddressJourney.index(data,window.CURATED_ARCHIVE.records,window.ARCHIVE_HOVER_DATA,timeline);
 let selectedAddress=null,travelRevision=0,travelActive=false,activeResult=-1,shownResults=[];
 function stopTravel(){travelRevision++;if(travelActive){viewer().then(v=>v.cancelTimeFlight());timeStatus();}travelActive=false;$('atlas-travel-stop').hidden=true;$('atlas-travel-go').disabled=false;}
 function results(){selectedAddress=null;activeResult=-1;shownResults=AddressJourney.search(addressIndex,searchInput.value);searchResults.replaceChildren();for(const [i,item] of shownResults.entries()){const btn=make('button',item.name);btn.type='button';btn.setAttribute('role','option');btn.id='atlas-address-result-'+i;btn.onclick=()=>{selectedAddress=item;searchInput.value=item.name;searchResults.hidden=true;searchInput.setAttribute('aria-expanded','false');searchInput.removeAttribute('aria-activedescendant');searchInput.focus();};searchResults.append(btn);}searchResults.hidden=!shownResults.length;searchInput.setAttribute('aria-expanded',String(shownResults.length>0));}
 searchInput.addEventListener('input',results);searchInput.addEventListener('keydown',e=>{if(e.key==='Escape'){searchResults.hidden=true;searchInput.setAttribute('aria-expanded','false');stopTravel();return;}if(['ArrowDown','ArrowUp'].includes(e.key)&&shownResults.length){e.preventDefault();activeResult=(activeResult+(e.key==='ArrowDown'?1:-1)+shownResults.length)%shownResults.length;Array.from(searchResults.children).forEach((b,i)=>b.setAttribute('aria-selected',String(i===activeResult)));searchInput.setAttribute('aria-activedescendant','atlas-address-result-'+activeResult);}if(e.key==='Enter'&&activeResult>=0&&!searchResults.hidden){e.preventDefault();searchResults.children[activeResult].click();}});
 document.addEventListener('pointerdown',e=>{if(!$('atlas-travel-form').contains(e.target)){searchResults.hidden=true;searchInput.setAttribute('aria-expanded','false');}});
 $('atlas-travel-stop').onclick=()=>{stopTravel();travelStatus.textContent=AtlasI18n.language()==='zh'?'已停止，保留当前地点与年份。':'Stopped at the current location and year.';};
 for(const id of ['time-slider','year','tab-regional','tab-street','tab-model','tab-context'])$(id).addEventListener('pointerdown',()=>{if(travelActive)stopTravel();});
 $('atlas-travel-form').onsubmit=async e=>{
  e.preventDefault();if(state.busy||state.renderBusy){travelStatus.textContent='Wait for the current model operation to finish.';return;}
  const parsed=AddressJourney.parse(searchInput.value,searchYear.value);if(!parsed.ok){travelStatus.textContent=parsed.error;return;}
  const matches=selectedAddress?[selectedAddress]:AddressJourney.search(addressIndex,parsed.address);
  if(!matches.length){travelStatus.textContent=AtlasI18n.language()==='zh'?'未找到已定位的地址。请使用下拉结果中的门牌或建筑名。':'No mapped address found. Choose an indexed address or building name.';return;}
  const chosen=matches[0];if(!selectedAddress&&matches.length>1&&matches[0].score===matches[1].score){results();travelStatus.textContent='Choose a location from the matching addresses.';return;}
  stopTravel();const rev=travelRevision;searchResults.hidden=true;searchInput.setAttribute('aria-expanded','false');searchYear.value=parsed.year;searchInput.value=chosen.name;selectedAddress=chosen;
  const v=await viewer();if(rev!==travelRevision)return;
  if(MobileAtlas.compact()){if(!$('regional-panel').hidden)$('regional-close').click();$('year').value=parsed.year;updateSelection(chosen.point,null,false);setTab('context',false);await Promise.resolve();v.inspectAt(chosen.point);$('mobile-place-details').disabled=false;travelStatus.textContent=chosen.name+' · '+parsed.year+(AtlasI18n.language()==='zh'?' · 已到达':' · Arrived');$('scene').dataset.travelDestination=chosen.point.join(',');$('scene').dataset.travelState='arrived';searchInput.blur();MobileAtlas.syncYear();MobileAtlas.close();return;}
  if(!$('regional-panel').hidden)$('regional-close').click();setTab('context',false);state.context=null;v.clearModel();travelActive=true;$('atlas-travel-stop').hidden=false;$('atlas-travel-go').disabled=true;
  const start=Number($('year').value);travelStatus.textContent=chosen.name+' · '+start+' → '+parsed.year;
  try{const completed=await v.timeFlight(chosen.point,parsed.year,y=>{if(rev!==travelRevision)return;$('year').value=y;$('time-slider').value=y;$('year-display').textContent=y;travelStatus.textContent=chosen.name+' · '+y+' → '+parsed.year;$('scene').dataset.travelYear=String(y);});
   if(rev!==travelRevision)return;travelActive=false;$('atlas-travel-stop').hidden=true;$('atlas-travel-go').disabled=false;timeStatus();
   if(completed){updateSelection(chosen.point,null,false);setTab('context',false);travelStatus.textContent=chosen.name+' · '+parsed.year+(AtlasI18n.language()==='zh'?' · 已到达':' · Arrived');$('scene').dataset.travelDestination=chosen.point.join(',');}else travelStatus.textContent='Travel stopped.';
  }catch(err){if(rev===travelRevision){stopTravel();travelStatus.textContent='Could not finish the map animation. '+err.message;}}
 };

 let yearTimer=null;$('year').onchange=()=>{clearTimeout(yearTimer);changeYear(Number($('year').value));};
 const slider=$('time-slider'),track=slider.closest('.timeline-track');
 let dragPointer=null,snappedYear=null,dragYear=Number(slider.value),dragTimer=null;
 function previewYear(result){
  dragYear=result.year;snappedYear=result.snapped;slider.value=dragYear;$('year-display').textContent=dragYear;
  if(snappedYear===null)delete track.dataset.snappedYear;else track.dataset.snappedYear=snappedYear;
  const row=snapRows.find(r=>r.year===dragYear),zh=AtlasI18n.language()==='zh';
  slider.setAttribute('aria-valuetext',dragYear+(row?' · '+(zh?row.zh:row.title):''));
  document.querySelectorAll('#year-ticks button').forEach(b=>b.classList.toggle('active',Number(b.dataset.year)===dragYear));
 }
 function commitDrag(){clearTimeout(dragTimer);dragTimer=null;changeYear(dragYear);}
 function moveTimeline(e){
  const rect=slider.getBoundingClientRect(),width=Math.max(1,rect.width-24);
  const raw=1900+(e.clientX-rect.left-12)/width*126;
  previewYear(TimelineSnap.drag(raw,snapRows,width,1900,2026,snappedYear));
  if(!MobileAtlas.compact()&&dragTimer===null)dragTimer=setTimeout(commitDrag,120);
 }
 track.addEventListener('pointerdown',e=>{
  if(slider.disabled||dragPointer!==null||e.isPrimary===false||(e.pointerType==='mouse'&&e.button!==0))return;
  e.preventDefault();clearTimeout(yearTimer);dragPointer=e.pointerId;snappedYear=null;
  slider.focus({preventScroll:true});track.setPointerCapture(e.pointerId);moveTimeline(e);
 },{capture:true});
 track.addEventListener('pointermove',e=>{if(e.pointerId===dragPointer){e.preventDefault();moveTimeline(e);}});
 function finishTimeline(e){
  if(e.pointerId!==dragPointer)return;
  if(e.type==='pointerup')moveTimeline(e);
  const id=dragPointer;dragPointer=null;commitDrag();
  if(track.hasPointerCapture(id))track.releasePointerCapture(id);
 }
 for(const type of ['pointerup','pointercancel','lostpointercapture'])track.addEventListener(type,finishTimeline);
 // Suppress a synthetic mouse click on the starting milestone after a drag.
 // Keyboard activation of milestone buttons remains available.
 track.addEventListener('click',e=>{if(e.detail>0){e.preventDefault();e.stopPropagation();}},{capture:true});
 slider.oninput=()=>{clearTimeout(yearTimer);previewYear({year:Number(slider.value),snapped:null});if(!MobileAtlas.compact())yearTimer=setTimeout(()=>changeYear(Number(slider.value)),120);};
 slider.onchange=()=>{clearTimeout(yearTimer);changeYear(Number(slider.value));};

 $('question').oninput=()=>{if(state.inputMode==='history'){state.questionDraft=$('question').value;askRevision++;}else state.renderDraft=$('question').value;};
 $('question-form').onsubmit=async e=>{
  e.preventDefault();
  if(state.historyPending||state.busy||state.renderBusy||!state.context||!$('question').reportValidity())return;
  if(state.inputMode==='render'){state.renderDraft=$('question').value.trim();await generatePhoto();return;}
  clearTimeout(yearTimer);
  if(!$('year').reportValidity())return;
  const parsed=HistoryQuery.resolve($('question').value,Number($('year').value));
  if(!parsed.ok){$('question-message').textContent=HistoryQuery.message(parsed.code,window.AtlasI18n?.language());return;}
  const question=parsed.question;state.questionDraft=question;
  if(parsed.year!==state.context.year)changeYear(parsed.year);
  state.context.question=question;
  const rev=++askRevision,context=JSON.parse(JSON.stringify(state.context)),language=window.AtlasI18n?.language()||'en';
  const current=()=>rev===askRevision&&Spatial.same(context,state.context)&&language===(window.AtlasI18n?.language()||'en')&&state.inputMode==='history'&&question===$('question').value.trim();
  state.historyPending=true;state.answer=null;readStreet();controls();
  $('question-message').textContent='Reading the evidence for this place and year…';
  try{
   const result=await call('askAtLocation',{context,question,language});
   if(!current()||!Spatial.same(result.context,state.context))return;
   state.answer=Object.assign({},result,{question,language});readStreet();
   $('question-message').textContent='Your source-linked interpretation is ready below.';
  }catch(error){if(current())$('question-message').textContent=error.message;}
  finally{
   state.historyPending=false;
   if(!current()&&$('question-message').textContent===AtlasI18n.translate('Reading the evidence for this place and year…'))$('question-message').textContent='Your selection or question changed. Submit again to read the current selection.';
   controls();
  }
