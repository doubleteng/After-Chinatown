 let cropImage=null,crop=null,origin=null,cropEpoch=0;const canvas=$('crop-canvas'),cx=canvas.getContext('2d');
 function drawCrop(){if(!cropImage)return;cx.drawImage(cropImage,0,0,canvas.width,canvas.height);if(crop){cx.strokeStyle='#d26b38';cx.lineWidth=3;cx.strokeRect(crop.x,crop.y,crop.w,crop.h);}}
 function pos(e){const r=canvas.getBoundingClientRect();return {x:Math.max(0,Math.min(canvas.width,(e.clientX-r.left)*canvas.width/r.width)),y:Math.max(0,Math.min(canvas.height,(e.clientY-r.top)*canvas.height/r.height))};}
 canvas.onpointerdown=e=>{origin=pos(e);canvas.setPointerCapture(e.pointerId);};canvas.onpointermove=e=>{if(!origin)return;const p=pos(e);crop={x:Math.min(p.x,origin.x),y:Math.min(p.y,origin.y),w:Math.abs(p.x-origin.x),h:Math.abs(p.y-origin.y)};drawCrop();};canvas.onpointerup=()=>{origin=null;if(crop&&(crop.w<30||crop.h<30))crop=null;modelRequest=null;drawCrop();};canvas.onpointercancel=()=>{origin=null;};$('reset-crop').onclick=()=>{crop=null;modelRequest=null;drawCrop();};
 $('close-crop').onclick=()=>{$('crop-panel').hidden=true;cropEpoch++;};
 $('prepare-model').onclick=async()=>{if(!state.primary)return;const id=state.primary,rev=state.revision,attempt=++cropEpoch;cropImage=null;crop=null;modelRequest=null;canvas.hidden=true;$('crop-message').textContent='Loading the archival photograph…';$('crop-source-line').textContent=recordLabel(currentRecord());$('crop-panel').hidden=false;controls();try{const r=await call('getArchiveImage',id),im=new Image();await new Promise((a,b)=>{im.onload=a;im.onerror=()=>b(new Error('The photograph could not be displayed.'));im.src='data:'+r.mime+';base64,'+r.data;});if(rev!==state.revision||attempt!==cropEpoch)return;cropImage=im;const s=Math.min(1100/im.width,750/im.height,1);canvas.width=Math.round(im.width*s);canvas.height=Math.round(im.height*s);canvas.hidden=false;drawCrop();$('crop-message').textContent='Choose one building. Generating submits one request from the shared daily allowance.';}catch(e){$('crop-message').textContent=e.message;}controls();};
 function cropped(){const r=crop||{x:0,y:0,w:canvas.width,h:canvas.height},out=document.createElement('canvas');out.width=Math.round(r.w);out.height=Math.round(r.h);out.getContext('2d').drawImage(cropImage,r.x*cropImage.width/canvas.width,r.y*cropImage.height/canvas.height,r.w*cropImage.width/canvas.width,r.h*cropImage.height/canvas.height,0,0,out.width,out.height);return out.toDataURL('image/jpeg',.88);}
 async function showModel(job,rev){const token=job.token,r=await call('getModelBytes',token);if(rev!==state.revision||token!==state.token)return;const source=state.records.find(x=>x.id===r.sourceId);if(!source?.spatial)throw new Error('This saved model needs an evidence-backed map location before it can join the spatial study.');const bytes=Uint8Array.from(atob(r.data),x=>x.charCodeAt(0));if(state.modelUrl)URL.revokeObjectURL(state.modelUrl);state.modelUrl=URL.createObjectURL(new Blob([bytes],{type:'model/gltf-binary'}));$('download-model').href=state.modelUrl;$('saved-model').href=url({job:token});state.job=r;const loaded=await (await viewer()).load(bytes.buffer,source);if(!loaded||rev!==state.revision)return;state.modelLoaded=true;state.busy=false;$('model-adjust').hidden=false;await setTab('model',false);invalidate();$('generation-message').textContent='Model fitted to the selected building footprint. Adjust the alignment offset if its front faces the wrong way, then confirm the camera. Placement and scale remain approximate.';controls();if(r.renderReady)displayRender(await call('getRenderedImage',token));}
 async function poll(token,rev,attempt=0){try{const r=await call('pollModel',token);if(rev!==state.revision||token!==state.token)return;state.job=r;$('generation-message').textContent='Building the detailed model · '+r.progress+'%';if(r.modelReady){await showModel(r,rev);return;}if(['FAILED','CANCELED','SUBMISSION_UNCERTAIN'].includes(r.status)){state.busy=false;$('generation-message').textContent=r.error||'The model request could not be confirmed. Open the saved study before retrying.';controls();return;}setTimeout(()=>poll(token,rev),10000);}catch(e){if(rev===state.revision){if(['BUSY','POLL_FAILED'].includes(e.code)&&attempt<4){$('generation-message').textContent='The saved task is busy. Checking its status again shortly…';setTimeout(()=>poll(token,rev,attempt+1),10000);return;}state.busy=false;$('generation-message').textContent=e.message;controls();}}}
 $('start-model').onclick=async()=>{if(!cropImage||state.busy)return;state.busy=true;controls();$('crop-panel').hidden=true;$('generation-message').textContent='Submitting one detailed model request…';const rev=state.revision;try{modelRequest=modelRequest||crypto.randomUUID();const r=await call('startModel',{sourceId:state.primary,image:cropped(),context:state.context,requestId:modelRequest});state.token=r.token;state.job=r;$('saved-model').href=url({job:r.token});$('model-adjust').hidden=false;await availability();poll(r.token,rev);}catch(e){state.busy=false;$('generation-message').textContent=e.message;await availability();}controls();};
 $('confirm-view').onclick=async()=>{try{state.confirmed=await (await viewer()).capture();inputMode('render');$('generation-message').textContent='View confirmed. Add your direction below, then generate the speculative photo.';controls();}catch(e){$('generation-message').textContent=e.message;}};
 function displayRender(r){const src='data:'+r.mime+';base64,'+r.data;$('rendered-result').src=src;$('download-render').href=src;$('download-render').hidden=false;state.job.renderReady=true;state.job.renderStatus='SUCCEEDED';state.renderEvidence=r;if(r.token){state.token=r.token;state.job.token=r.token;$('saved-model').href=url({job:r.token});}
 $('provenance-section').hidden=false;const root=$('render-provenance');root.replaceChildren(make('p','Target year: '+r.sceneYear+'. The confirmed 3D view was supplied as a composition reference, with archival photographs for visible detail.'));
 root.append(make('p','Compare the generated image with the camera reference: generation may change geometry or framing. It is not a measured reconstruction.'));root.append(make('h3','Your contribution'),make('p',r.userPrompt||'No separate creative direction was saved with this earlier study.'));
 root.append(make('h3','Photographic evidence'));for(const ref of r.references||[]){const p=make('p');p.append(link(ref.url,ref.title+' · '+ref.date));if(ref.relationship)p.append(make('small',' — '+ref.relationship));root.append(p);}
 if(r.textEvidence?.length){root.append(make('h3','Written sources'));for(const t of r.textEvidence){const p=make('p');p.append(link(t.url||state.records.find(x=>x.id===t.id)?.source_url,t.title+' · '+t.date));root.append(p);}}
 root.append(make('h3','Inference and critical fabulation'),make('p','Unmeasured depth, concealed surfaces, material colours, atmosphere and any invented figures remain conjectural. The input record explains how the image was requested; it does not verify every generated detail.'));
 if(r.temporalEvidence){root.append(make('p','Timeline: '+r.temporalEvidence.year+' · '+r.temporalEvidence.demolished+' documented removals · '+r.temporalEvidence.unresolved+' unresolved building states.'));}
 if(r.userPrompt){state.renderDraft=r.userPrompt;if(state.inputMode==='render')$('question').value=r.userPrompt;}
 if(r.viewImage)$('capture-preview').src='data:'+r.viewImage.mime+';base64,'+r.viewImage.data;$('capture-preview').hidden=!r.viewImage&&!state.confirmed;
 $('generation-message').textContent='Speculative photograph saved. Its sources and your contribution are recorded below.';setTab('photo',false);readStreet();}
 async function checkRender(){const r=await call('getRenderStatus',state.token);state.job=r;if(r.renderReady)displayRender(await call('getRenderedImage',state.token));else $('generation-message').textContent=r.renderError||'The result is not confirmed yet. No automatic paid retry has been made.';controls();}
 $('check-render').onclick=()=>checkRender().catch(e=>$('generation-message').textContent=e.message);
 async function generatePhoto(){if(!state.confirmed||state.renderBusy)return;state.renderBusy=true;controls();referenceChoices();$('generation-message').textContent='Generating the confirmed view from the selected photographs and archival context…';try{renderRequest=renderRequest||crypto.randomUUID();const r=await call('renderModel',{token:state.token,image:state.confirmed,referenceIds:state.references,sceneYear:state.context.year,context:state.context,requestId:renderRequest,retryConfirmed:!!state.job.renderRetryable,newRender:!!state.job.renderReady,userPrompt:state.renderDraft});displayRender(r);renderRequest=null;}catch(e){if(e.token){state.token=e.token;state.job.renderReady=false;$('saved-model').href=url({job:e.token});}$('generation-message').textContent=e.message;if(e.renderStatus==='NOT_STARTED'){state.job.renderStatus='NOT_STARTED';renderRequest=null;}else{try{await checkRender();if(['FAILED','LEGACY_FAILED','NOT_STARTED'].includes(state.job.renderStatus)){renderRequest=null;if(state.job.renderStatus==='NOT_STARTED')$('generation-message').textContent=e.message;}}catch(_){state.job.renderStatus='UNCERTAIN';$('generation-message').textContent='The result could not be confirmed. Check generation status before submitting another request.';}}}finally{state.renderBusy=false;await availability();referenceChoices();controls();}}
 async function restore(token){try{const r=await call('getRenderStatus',token),source=state.records.find(x=>x.id===r.sourceId);if(!source?.spatial){$('generation-message').textContent='The saved source needs a map location before it can be restored here.';return;}const c=r.context||{point:source.spatial.point,radius:500,year:Number((r.sourceDate||'').match(/(?:18|19|20)\d{2}/)?.[0]||1950)};if(c.year<1900||c.year>2026){$('generation-message').textContent='The map covers 1900–2026. Browse the archive for earlier material.';return;}$('year').value=c.year;$('radius').value=c.radius;updateSelection(c.point,r.sourceId);state.token=token;state.job=r;state.busy=true;controls();if(r.modelReady)await showModel(r,state.revision);else poll(token,state.revision);}catch(e){$('generation-message').textContent=e.message;}}
 installStreetComposer102({
  mode:()=>state.viewMode,year:()=>Number($('year').value),context:()=>state.context?JSON.parse(JSON.stringify(state.context)):null,
  lock:value=>{state.renderBusy=value;controls();$('atlas-travel-go').disabled=value;$('atlas-travel-year').disabled=value;$('atlas-address').disabled=value;},
  snapshot:async()=>{if(state.viewMode!=='street')throw new Error('Enter street view before generating.');return (await viewer()).streetFrame102();},
  prepare:async(year,frame,context)=>{
   const locked=state.renderBusy;state.renderBusy=false;$('year').value=year;$('atlas-travel-year').value=year;$('radius').value=context.radius;
   updateSelection(context.point,null,false);state.renderBusy=locked;const v=await viewer();await new Promise(resolve=>requestAnimationFrame(resolve));await setTab('street',false);v.restoreStreet102(frame);timeStatus();controls();
  },
  capture:async()=>{const v=await viewer();return {camera:v.streetFrame102(),image:await v.capture(),visibleBuildings:v.visibleBuildings103()};},
  show:async url=>{$('rendered-result').src=url;await setTab('photo',false);(await viewer()).photo102(true);},
  return:async(frame)=>{const v=await viewer();v.photo102(false);await setTab('street',false);if(frame)v.restoreStreet102(frame);},
  markers:async(rows,enabled)=>(await viewer()).reconstructionMarkers102(rows,enabled)
 });
