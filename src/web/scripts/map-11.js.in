 const params={page:'archive',place:state.context.district,year:state.context.year,lat:state.context.point[1],lon:state.context.point[0],radius:state.context.radius};$('context-archive').href=url(params);$('archive-context-note').textContent='Open source-date matches for this point and '+state.context.radius+' m radius; the archive page also lets you broaden the dates.';
 }
 function updateSelection(point,preferred,flight=true){if(state.busy||state.renderBusy)return;if(!$('year').reportValidity())return;let c;try{c=Spatial.context({point,radius:Number($('radius').value),year:Number($('year').value),question:state.questionDraft},data);}catch(e){$('generation-message').textContent='Choose a point within either study area or its mapped surroundings.';return;}state.context=c;state.revision++;askRevision++;state.answer=null;resetGeneration(flight?'street':state.viewMode==='context'?'context':'street');state.nearby=Spatial.nearby(state.records,c);const primary=preferred&&state.nearby.find(x=>x.record.id===preferred)||state.nearby.find(x=>x.record.generation_eligible)||state.nearby[0];state.primary=primary?.record.id||null;state.references=state.nearby.filter(x=>x.record.id!==state.primary).sort((a,b)=>a.uncertainty-b.uncertainty||a.distance-b.distance).slice(0,3).map(x=>x.record.id);$('area').value=c.district;$('mobile-place-details').disabled=false;$('selection-title').textContent=contextTitle();$('selection-detail').textContent=state.nearby.length+' photos · '+c.radius+' m · ±5 years';$('question-message').textContent='';renderSources();readStreet();timeStatus();const rev=state.revision;viewer().then(v=>{if(rev===state.revision)v.select(c,{flight});}).catch(e=>$('view-mode').textContent=e.message);controls();}
 function drawMarkers(){$('location-coverage').textContent='Photos: selected year ±5 years';viewer().then(v=>v.markers(state.records)).catch(()=>{});}
