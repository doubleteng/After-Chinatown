 async function initialSelection(){
  if(cfg.streetJob)return;
  if(cfg.job){await restore(cfg.job);return;}
  if(state.context)return;
  const initialYear=Math.max(1900,Math.min(2026,cfg.selection?.year||cfg.year||Number($('year').value)));
  $('year').value=String(initialYear);$('atlas-travel-year').value=String(initialYear);
  $('time-slider').value=String(initialYear);$('year-display').textContent=String(initialYear);
  setTab('context',false);
  if(cfg.selection){$('radius').value=cfg.selection.radius;updateSelection(cfg.selection.point,null,false);}
  else if(cfg.place){const area=data.areas.find(x=>x.id===cfg.place);if(area)updateSelection(area.center,null,false);}
  timeStatus();
  const v=await viewer();
  if(!state.context)v.setYear(initialYear);
  // Links may identify an area or point, but loading a link never enters
  // first-person mode. Street view requires the visitor's explicit action.
  v.overview(state.context?.district||null,0);
 }
 initialSelection();call('getArchiveIndex').then(out=>{if(!Array.isArray(out?.records))return;state.records=out.records;archiveTicks();drawMarkers();if(state.context){state.nearby=Spatial.nearby(state.records,state.context);const primary=state.nearby.find(x=>x.record.id===state.primary)||state.nearby.find(x=>x.record.generation_eligible)||state.nearby[0];state.primary=primary?.record.id||null;state.references=state.nearby.filter(x=>x.record.id!==state.primary).sort((a,b)=>a.uncertainty-b.uncertainty||a.distance-b.distance).slice(0,3).map(x=>x.record.id);$('selection-detail').textContent=state.nearby.length+' photos · '+state.context.radius+' m · ±5 years';renderSources();readStreet();timeStatus();controls();}}).catch(()=>{$('location-coverage').textContent+=' · showing curated sources';});
})().catch(()=>{});

/* Pure temporal and measurement rules. Never infer missing ethnic categories. */
var ActivityRules=(()=>{
 const colors=['#fff7ec','#fee8c8','#fdd49e','#fdbb84','#fc8d59','#e34a33','#a50f15'];
 const breaks=[0,.01,.1,1,10,100,1000];
 function number(v){return v!==null&&v!==''&&Number.isFinite(Number(v))&&Number(v)>=0?Number(v):null;}
 function sum(rows){if(!rows.length||rows.some(v=>number(v)===null))return null;return rows.reduce((a,b)=>a+Number(b),0);}
 function moe(rows){const v=sum(rows.map(x=>number(x)===null?null:x*x));return v===null?null:Math.sqrt(v);}
 function population(row,level,period){const keys=period?period.groups?.[level]:(level==='asian'?['asian']:level==='east'?['chinese','taiwanese','japanese','korean']:['chinese','taiwanese']);if(!keys)return {estimate:null,moe:null};return {estimate:sum(keys.map(k=>row[k]?.[0]??null)),moe:keys.length===1?number(row[keys[0]]?.[1]):moe(keys.map(k=>row[k]?.[1]??null))};}
 function period(periods,year){return periods.find(p=>year>=p.start&&year<=p.end)||null;}
 function bin(year){const a=Math.max(1900,Math.floor(year/5)*5);return [a,Math.min(a+4,2026)];}
 function candidates(periods,year,level){const eligible=periods.filter(p=>!level||p.groups?.[level]);const direct=eligible.filter(p=>p.start<=year&&p.end>=year).sort((x,y)=>(y.kind==='acs')-(x.kind==='acs')||y.end-x.end);if(direct.length)return direct;return eligible.filter(p=>p.end<year).sort((x,y)=>y.end-x.end||(y.kind==='acs')-(x.kind==='acs')).slice(0,1);}
 function activitySnapshot(rows,a,b,level,kind){const direct=inWindow(rows,a,b,level,kind);if(direct.length)return {rows:direct,from:a,to:b,carried:false};const dates=rows.filter(r=>r.levels.includes(level)&&(kind==='all'||r.kind===kind)).flatMap(r=>r.intervals.map(x=>Math.min(x[1],a-1))).filter(y=>y<a&&y>=1900).sort((x,y)=>y-x);for(const y of dates){const valid=inWindow(rows,y,y,level,kind);if(valid.length)return {rows:valid,from:y,to:y,carried:true};}return {rows:[],from:a,to:b,carried:false};}
 function totals(period,level){if(!period)return {total:null,counties:[]};const counties=(period.countyFeatures||period.features).map(f=>({county:f.properties.county,value:population(f.properties,level,period).estimate}));return {total:sum(counties.map(x=>x.value)),counties};}
 function inWindow(rows,a,b,level,kind){const seen=new Set();return rows.filter(r=>{if(seen.has(r.id)||!r.levels.includes(level)||(kind!=='all'&&r.kind!==kind))return false;const ok=r.intervals.some(([x,y])=>x<=b&&y>=a);if(ok)seen.add(r.id);return ok;});}
 function venues(rows,year,windowYears,level,kind){return inWindow(rows,year-windowYears+1,year,level,kind);}
 function color(density){if(density===null||!Number.isFinite(density))return '#a8aca9';let i=0;while(i<breaks.length-1&&density>=breaks[i+1])i++;return colors[i];}
 function kernel(distanceKm){return distanceKm<=4?Math.exp(-distanceKm*distanceKm/2)/(2*Math.PI):0;}
 function heatAlpha(value){return Math.round(220*(1-Math.exp(-Math.max(0,value)/.20)));}
 function heatColor(value){const stops=[[252,222,233],[248,152,186],[231,72,136],[190,28,99]],a=Math.min(1,Math.max(0,value/.5))*3,i=Math.min(2,Math.floor(a)),f=a-i;return stops[i].map((v,k)=>Math.round(v+(stops[i+1][k]-v)*f));}
 return {number,sum,moe,population,period,bin,candidates,activitySnapshot,totals,inWindow,venues,color,kernel,heatColor,heatAlpha,colors,breaks};
})();
if(typeof module!=='undefined')module.exports=ActivityRules;

window.RegionalMap=(()=>{'use strict';
 const $=id=>document.getElementById(id),R=ActivityRules;let D=null;
 let viewer,selectedPeriod=null,visible=false,loading=null,selectedDataId="",playTimer=null;
 const t=(en,zh)=>window.AtlasI18n?.language()==='zh'?zh:en;
 const el=(tag,text,cls)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n;};
 const fmt=n=>n===null?t('Unavailable','缺失'):Math.round(n).toLocaleString();
 function link(url,title){const a=el('a',title);a.href=url;a.target='_blank';a.rel='noopener noreferrer';return a;}
 function level(){return $('regional-level').value;}
 function currentYear(){return Number($('year').value);}
 function detail(title,lines,sources,storyState=null){selectedStory76=storyState;const p=$('regional-detail');p.hidden=false;p.replaceChildren();const b=el('button','×');b.type='button';b.setAttribute('aria-label',t('Close place details','关闭详情'));b.onclick=()=>p.hidden=true;p.append(b,el('h3',title));lines.forEach(v=>p.append(el('p',v)));sources.forEach(s=>p.append(link(s.url,s.title+' ↗'),el('br')));}
 function inspectTract(f){const p=f.properties,v=R.population(p,level(),selectedPeriod),density=v.estimate===null||!p.landKm2?null:v.estimate/p.landKm2;detail(p.name,[selectedPeriod.label+' · '+p.county,t('Residents: ','居民：')+fmt(v.estimate)+(selectedPeriod.kind==='acs'?' ± '+fmt(v.moe)+t(' (90% MOE)','（90% 误差范围）'):t(' (census count; sampling MOE not applicable)','（普查计数，无抽样误差项）')),t('Density: ','密度：')+(density===null?'—':density.toLocaleString(undefined,{maximumFractionDigits:4}))+t(' residents / land km²',' 人 / 陆地平方公里'),t(selectedPeriod.definition,selectedPeriod.definitionZh),p.areaReference?t('County totals divided by the same 2024 land area. Outlines are geographic references; this does not locate people within a county.','县总数使用同一 2024 年陆地面积计算密度。轮廓为地理参考，不能定位县内居民。'):t('Tract boundaries match this ACS release; boundary changes affect visual comparison.','小区边界对应该期 ACS；边界变化会影响视觉比较。'),selectedPeriod.kind==='acs'?t('Residence estimates, not visitors. Summed MOE is approximate; differences have not been tested for significance.','居住估计，不是访客。合计误差为近似值，跨期差异未经显著性检验。'):t('Historical classification and enumeration coverage limit comparison with modern surveys.','历史分类及统计覆盖限制了与现代调查的可比性。')],[{url:selectedPeriod.source,title:'U.S. Census Bureau · '+selectedPeriod.label}]);}
 function inspectCity(r){detail(r.city+' · '+r.year,[t('Asian and Pacific Islander: ','Asian and Pacific Islander（含太平洋岛民）：')+fmt(r.asianPacificIslander),t('Whole-city reference total. Separate historical classification; do not add to county counts or read this marker as a neighborhood heat spot.','全市参考总数，使用独立历史分类。不可与县总数相加，不表示标记附近有这些人口。'),t('Historic city boundaries and ward distributions have not been reconstructed. The marker only identifies the city.','尚未复原该年的市界和区内分布，标记仅用于识别城市。')],[{url:r.source,title:'U.S. Census · historical Table '+r.table}]);}
 function inspectVenue(r){detail(r.name,[r.address||t('Approximate public location','近似公共地点'),r.intervals.map(x=>x[0]===x[1]?String(x[0]):x.join('–')).join(', '),t(r.note,r.noteZh||r.note),t('Location precision: approximately ','位置精度：约 ')+r.uncertaintyM+' m',r.kind==='business'?t('Cuisine / public business evidence. Ownership and customer ethnicity are not inferred.','依据菜系或公开商业史料；不推断业主或顾客族裔。'):t('Documented public community venue. Attendance is not measured.','有公开记录的社群活动地点，未测量参与人数。')],r.sources);}
 let activeRows=[],activityState=null;
 function sourceLabel(p){return !p?'':p.label+(currentYear()>p.end?t(' · carried to ',' · 沿用至 ')+currentYear():'');}
 function inspectCenter(c){detail(t(c.name,c.nameZh)+' · '+c.year,[t(c.note,c.noteZh),t('Location precision: about ','位置精度：约 ')+c.uncertaintyM+' m'],[{url:c.source,title:t('Source','来源')}]);}
 function setYear(y){$('year').value=y;$('year').dispatchEvent(new Event('change'));render();}
 function stop(){if(playTimer)clearInterval(playTimer);playTimer=null;$('regional-play').textContent=t('Play','播放');}
 function coverage(){const host=$('regional-coverage');host.replaceChildren();const current=R.bin(currentYear())[0];for(let a=1900;a<=2025;a+=5){const b=Math.min(a+4,2026),hasPop=R.candidates(D.periods,a,level()).length>0,hasRef=D.cityReferences.some(r=>r.year>=a&&r.year<=b),n=R.inWindow(D.venues,a,b,level(),$('regional-kind').value).length;const btn=el('button',a+(n?' •':''),hasPop?'has-pop':hasRef?'has-reference':'');btn.type='button';btn.title=a+'–'+b+' · '+(hasPop?t('population','人口'):hasRef?t('city references only','仅城市参考'):t('no population data','人口缺失'))+' · '+n+t(' documented places','个地点');btn.setAttribute('aria-current',String(current===a));btn.onclick=()=>{stop();selectedDataId='';setYear(a);};host.append(btn);}}
 function localizeControls(){for(const e of document.querySelectorAll('#regional-panel [data-en]'))e.textContent=t(e.dataset.en,e.dataset.zh);$('regional-play').textContent=playTimer?t('Pause','暂停'):t('Play','播放');$('heat-opacity').setAttribute('aria-label',t('Heatmap opacity','热力透明度'));$('regional-bin').setAttribute('aria-label',t('Five-year interval','五年区间'));$('regional-period').setAttribute('aria-label',t('Population dataset','人口数据集'));}
 function render(){localizeControls();if(!visible||!viewer||!D)return;const y=currentYear(),[a,b]=R.bin(y),available=R.candidates(D.periods,y,level());if(!available.some(p=>p.id===selectedDataId))selectedDataId='';const p=available.find(x=>x.id===selectedDataId)||available[0]||null;selectedPeriod=p;
 const selector=$('regional-period');selector.replaceChildren();selector.append(new Option(t('Auto · latest source','自动 · 最近资料'),''));available.forEach(q=>selector.append(new Option(q.label,q.id)));selector.value=selectedDataId;$('regional-bin').value=String(a);
 $('regional-detail').hidden=true;
 const pop=$('regional-pop').checked,act=$('regional-activity').checked,county=$('regional-resolution').value==='county',features=p?(county?p.countyFeatures:p.features):[];

 const windowMode=$('regional-window').value,from=windowMode==='bin'?a:windowMode==='1'?y:Math.max(1900,y-9),to=windowMode==='bin'?b:y;
 activityState=R.activitySnapshot(D.venues,from,to,level(),$('regional-kind').value);activeRows=act?activityState.rows:[];
 const centers=$('regional-centers').checked?(D.communityCenters||[]).filter(c=>c.year<=y):[],links=$('regional-centers').checked?(D.centerLinks||[]).filter(c=>c.year<=y):[],populationCenters=pop&&$('regional-centers').checked&&p?.kind==='acs'?(D.populationCenters||[]).filter(c=>c.level===level()&&c.start<=p.start):[];
 viewer.centers({centers,populationCenters,inspect:inspectCenter});
 viewer.heat({key:[y,level(),p?.id,pop,act,county,windowMode,$('regional-kind').value,$('heat-opacity').value,$('regional-centers').checked].join('|'),centers,links,populationCenters,features:pop?features:[],period:p,level:level(),rows:activeRows,population:pop&&!!p,opacity:Number($('heat-opacity').value)/100});
  const cr=$('regional-references').checked?D.cityReferences.filter(r=>r.year>=a&&r.year<=b):[],list=$('regional-reference-list');list.replaceChildren();
 if(cr.length){list.append(el('span',t('Separate historical city totals · Asian + Pacific Islander:','独立历史城市总数 · Asian + Pacific Islander（含太平洋岛民）：')));for(const r of cr){const btn=el('button',r.city+' '+r.year+' · '+fmt(r.asianPacificIslander));btn.type='button';btn.onclick=()=>inspectCity(r);list.append(btn);}}
 const populationStatus=!pop?t('Residence layer off','居民图层已关闭'):p?(sourceLabel(p)+' · '+(!p.groups[level()]?t('selected category unavailable','所选族群缺失'):(county||p.resolution==='county'?t('3 county totals','3 个县总数'):features.length+t(' tracts','个普查小区')))):t('Population data unavailable in this interval','此区间人口数据缺失');
 $('regional-status').textContent=a+'–'+b+' · '+populationStatus+' · '+(act?`${activityState.from}–${activityState.to}${activityState.carried?t(' (carried)','（沿用）'):''} · ${activeRows.length} `+t('documented locations','处有记录的地点'):t('Activity layer off','活动图层已关闭'));
 $('activity-controls').hidden=!act;$('regional-warning').textContent=t('Fixed scales. Gaps use the latest earlier source.','固定色阶；空档沿用最近的既有资料。');coverage();legend(pop,act,p,activityState.from,activityState.to,county);
 }
 function legend(pop,act,p,from,to,county){const host=$('heat-legend');host.hidden=!visible;host.replaceChildren();host.append(el('strong',t('Population & activity · ','人口与活动 · ')+currentYear()),el('p',$('regional-level').selectedOptions[0].textContent));
  if(pop&&p){host.append(el('p',sourceLabel(p),currentYear()>p.end?'carried-data':''));const totals=R.totals(p,level());host.append(el('strong',fmt(totals.total)+t(' residents',' 位居民')),el('small',t(' · Wayne + Oakland + Macomb',' · Wayne + Oakland + Macomb')));const counts=el('div',undefined,'county-counts');for(const c of totals.counties)counts.append(el('span',c.county+' '+fmt(c.value)));host.append(counts,el('p',t('Residents / land km² · fixed scale','居民 / 陆地 km² · 固定色阶')));const bins=el('div',undefined,'legend-bins');R.colors.forEach(c=>{const n=el('i');n.style.background=c;bins.append(n);});host.append(bins);const ticks=el('div',undefined,'legend-ticks');['0','.01','.1','1','10','100','1,000+'].forEach(v=>ticks.append(el('span',v)));host.append(ticks,el('small',county||p.resolution==='county'?t('County averages; no neighborhood detail.','县级平均值，无法定位街区。'):t('Census tracts · hatched = missing','普查小区 · 斜线 = 缺失')));}
  if(pop&&!p)host.append(el('p',t('No earlier population data for this group.','此族群尚无较早的人口资料。')));
  if(act){host.append(el('p',from+(from===to?'':'–'+to)+(activityState.carried?t(' · carried activity',' · 沿用活动资料'):'')+' · '+activeRows.length+t(activeRows.length===1?' site':' sites',' 处地点')));const bar=el('div',undefined,'regional-scale activity-scale');host.append(bar,el('small',t('Pink: 0 → .5+ sites/km² · 1 km smoothing','粉色：0 → .5+ 处/km² · 1 km 平滑')));}
  if($('regional-centers').checked){host.append(el('p',t('Center halos: schematic · → relocation · ⇢ expansion','中心晕染为示意 · → 迁址 · ⇢ 扩展')));if(pop&&p?.kind==='acs')host.append(el('small',t('◆ ACS population center · distribution shift, not migrant counts.','◆ ACS 人口重心 · 分布变化，不代表迁移人数。')));}
  const fit=el('button',t('Show Detroit region','查看底特律区域'));fit.onclick=()=>viewer.region();host.append(el('p'),fit);
 }
 async function open(){
   visible=true;$('show-regional').checked=true;$('regional-panel').hidden=false;
   $('regional-status').textContent=t('Loading population and activity…','正在加载人口与活动资料…');
   try{const results=await Promise.all([window.SpatialViewerReady,AtlasAssets.activity()]);viewer=results[0];D=results[1];window.ACTIVITY_DATA=D;if(visible)render();}
   catch(_){if(visible)$('regional-status').textContent=t('The regional map could not load. Close and reopen it to retry.','区域地图未能加载，请关闭后重新打开。');}
  }
 function close(){stop();visible=false;$('show-regional').checked=false;$('regional-panel').hidden=true;$('heat-legend').hidden=true;$('regional-detail').hidden=true;viewer?.heat(null);viewer?.centers(null);}
 function inspectPoint(point){if(!visible)return false;const venue=activeRows.map(r=>({r,d:Spatial.distance(point,[r.lon,r.lat])})).sort((a,b)=>a.d-b.d)[0];if(venue&&venue.d<150){inspectVenue(venue.r);return true;}if($('regional-pop').checked&&selectedPeriod){const fs=$('regional-resolution').value==='county'?selectedPeriod.countyFeatures:selectedPeriod.features;const f=fs.find(f=>(f.geometry.type==='MultiPolygon'?f.geometry.coordinates:[f.geometry.coordinates]).some(p=>Spatial.inside(point,p[0])&&!p.slice(1).some(r=>Spatial.inside(point,r))));if(f){inspectTract(f);return true;}}return false;}
  $('show-regional').onchange=()=>$('show-regional').checked?open():close();$('tab-regional').onclick=open;$('regional-close').onclick=close;

 for(const id of ['regional-pop','regional-activity','regional-level','regional-window','regional-kind','regional-resolution','regional-references','regional-centers'])$(id).onchange=render;
 $('regional-fit').onclick=()=>viewer?.region();$('regional-local').onclick=()=>viewer?.overview('new');$('heat-opacity').oninput=()=>{$('heat-opacity-value').textContent=$('heat-opacity').value+'%';render();};
 for(let a=1900;a<=2025;a+=5)$('regional-bin').append(new Option(a+'–'+Math.min(a+4,2026),String(a)));
 $('regional-bin').onchange=()=>{stop();selectedDataId='';setYear(Number($('regional-bin').value));};
 $('regional-period').onchange=()=>{selectedDataId=$('regional-period').value;render();};
 $('regional-prev').onclick=()=>{stop();selectedDataId='';setYear(Math.max(1900,R.bin(currentYear())[0]-5));};
 $('regional-next').onclick=()=>{stop();selectedDataId='';setYear(Math.min(2025,R.bin(currentYear())[0]+5));};
 $('regional-play').onclick=()=>{if(playTimer){stop();return;}if(currentYear()>=2025)setYear(1900);$('regional-play').textContent=t('Pause','暂停');playTimer=setInterval(()=>{const next=R.bin(currentYear())[0]+5;if(next>2025){stop();return;}selectedDataId='';setYear(next);},1800);};
 $('regional-now').onclick=()=>{stop();selectedDataId='';setYear(2026);};
 window.addEventListener('atlas-language-changed',render);
 let selectedStory76=null;
 function showStory76(){if(!selectedStory76)return;const {place,active,year}=selectedStory76,zh=AtlasI18n.language()==='zh';detail((zh&&active.labelZh)||active.label||place.name,[String(year)+' · '+active.from+'–'+active.through,(zh&&active.noteZh)||active.note,(zh&&place.noteZh)||place.note||t('Approximate source location; footprint and height are separate evidence.','史料位置为近似值；建筑轮廓与高度另有证据。')],place.sources,selectedStory76);$('regional-detail').dataset.noTranslate='';}
 window.addEventListener('atlas-story-place',e=>{selectedStory76=e.detail;showStory76();});
 window.addEventListener('atlas-language-changed',()=>{if(selectedStory76&&!$('regional-detail').hidden)showStory76();});
 localizeControls();
 return {open,close,refresh:render,inspectPoint,isOpen:()=>visible};
})();
