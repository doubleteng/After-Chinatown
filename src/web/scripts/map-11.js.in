.setAttribute('data-no-translate','');card.append(note);}const referenceProfile=LandmarkArchitecture.profiles.find(p=>p.ids.includes(building.id)&&p.from>state.context.year);if(referenceProfile){const next=make('button',zh?'查看 '+referenceProfile.from+' 年外观参考':'View '+referenceProfile.from+' exterior reference');next.type='button';next.setAttribute('data-no-translate','');next.onclick=()=>changeYear(referenceProfile.from);card.append(next);}
