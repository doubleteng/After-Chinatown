/* Shared question dates. A street number must not move the historical timeline. */
const HistoryQuery=(()=>{
 const minYear=1900,maxYear=2026;
 const messages={
  BAD_INPUT:['Enter a question of 1–500 characters.','请输入 1–500 字的历史问题。'],
  MULTIPLE_YEARS:['Ask about one year at a time.','请每次询问一个年份。'],
  YEAR_INTERVAL:['Choose one exact year for this question; a decade cannot select one map view.','请指定一个确切年份；年代范围无法对应一个地图视图。'],
  BAD_YEAR:['The map covers 1900–2026. Browse the archive for earlier material.','地图涵盖 1880–2026 年。更早的资料可在档案中查阅。']
 };
 function message(code,language){return (messages[code]||messages.BAD_INPUT)[language==='zh'?1:0];}
 function resolve(value,currentYear){
  const question=typeof value==='string'?value.trim():'';
  if(!question||question.length>500)return {ok:false,code:'BAD_INPUT'};
  const normalized=question.replace(/[０-９]/g,c=>String(c.charCodeAt(0)-0xff10));
  const years=new Set();let interval=false;
  const tokens=normalized.matchAll(/(?:^|[^\d])((?:1\d|20|21)\d{2})(?!\d)/g);
  for(const match of tokens){
   const index=match.index+match[0].length-4,before=normalized.slice(0,index),after=normalized.slice(index+4);
   // Four digits inside identifiers are not calendar years. Chinese 年 is explicit.
   const explicit=/^\s*年(?!代)/.test(after);
   if(!explicit&&(/[A-Za-z_]$/.test(before)||/^[A-Za-z_]/.test(after)&&!/^s\b/i.test(after)))continue;
   const address=/^\s*(?:号|號)/.test(after)||
    /^\s*(?:Cass|Peterboro|Third|Porter|Bagley|Woodward|Michigan|Trumbull|Grand River)\b/i.test(after)||
    /^\s+(?:[A-Z][A-Za-z.'’\-]*\s+){1,4}(?:Street|St\.?|Avenue|Ave\.?|Road|Rd\.?|Boulevard|Blvd\.?|Drive|Dr\.?|Lane|Ln\.?|Way|Court|Ct\.?)\b/.test(after)||
    /(?:address|street\s+number|门牌(?:号)?|地址)\s*[:：#]?\s*$/i.test(before);
   if(address&&!explicit)continue;
   if(/^\s*(?:s\b|年代)/i.test(after))interval=true;
   years.add(Number(match[1]));
  }
  if(years.size>1)return {ok:false,code:'MULTIPLE_YEARS'};
  if(interval)return {ok:false,code:'YEAR_INTERVAL'};
  const year=years.size?[...years][0]:Number(currentYear);
  if(!Number.isInteger(year)||year<minYear||year>maxYear)return {ok:false,code:'BAD_YEAR'};
  return {ok:true,question,year,explicitYear:years.size===1};
 }
 return {minYear,maxYear,message,resolve};
})();
if(typeof module!=='undefined')module.exports=HistoryQuery;

const AddressJourney=(()=>{
 function normalize(s){return String(s||'').toLowerCase().replace(/[’']/g,'').replace(/\b2nd\b/g,'second').replace(/\b3rd\b/g,'third').replace(/\bave(?:nue)?\.?\b/g,' ').replace(/\bst(?:reet)?\.?\b/g,' ').replace(/\bblvd|boulevard\b/g,' ').replace(/\bdetroit|michigan|mi\b/g,' ').replace(/[^a-z0-9\u3400-\u9fff]+/g,' ').trim().replace(/\s+/g,' ');}
 function parse(address,year){let a=String(address||'').trim(),y=String(year||'').trim();const m=a.match(/(?:[,，;@]\s*|\s+(?:in|year)\s+)(\d{4})\s*年?$/i);if(m){y=m[1];a=a.slice(0,m.index).trim();}if(!a)return {ok:false,error:'Enter an address or building name.'};if(!/^\d{4}$/.test(y)||+y<1880||+y>2026)return {ok:false,error:'Choose a year from 1880 to 2026.'};return {ok:true,address:a,year:+y};}
 function index(data,records,hover,timeline){const items=[],seen=new Map();function add(name,point,id,rank=0){if(!name||!point||point.length!==2||!point.every(Number.isFinite))return;if(!/[a-z\u3400-\u9fff]/i.test(name)||/^(Source-map|mapped|source map|Building trace|Inventory building)/i.test(name))return;const key=normalize(name)+'|'+point.map(x=>x.toFixed(4)).join(',');if(seen.has(key))return;seen.set(key,true);items.push({name,point,id,rank,key:normalize(name)});}
 const ids=new Set(timeline.buildings.flatMap(e=>e.referenceModel?.envelopeIds||[]));for(const b of data.buildings){if(b.representation==='source-ink-only')continue;const ref=data.addressReview?.records?.[b.id];add(b.reviewed_name||b.name,b.center,b.id,ids.has(b.id)?20:0);if(ref){add(ref.address,b.center,b.id,ids.has(b.id)?22:ref.kind==='street'?-10:2);for(const name of ref.inventoryAliases||[])add(name,b.center,b.id,1);if(ref.kind==='street')add(ref.address+' · '+b.id,b.center,b.id,-15);}}
 for(const b of data.buildings)for(const alias of MerchantHistory.aliases(b))add(alias,b.center,b.id,32);
 for(const p of data.storyPlaces||[])add(p.name,p.point,p.id,15);for(const r of records){const h=hover.records[r.id];if(h?.location)add(h.location.place,h.location.point,h.location.building_id||r.id,10);}
 // Explicit alias derived from the verified tenant-address record.
 const bird=items.find(x=>x.id==='r56-cass3401');if(bird)add('Bird Town Pet Shop / Craig’s Coffee · 412 Peterboro',bird.point,bird.id,25);
 return items;}
 function search(items,q){q=normalize(q.replace(/(?:[,，;@]\s*|\s+(?:in|year)\s+)\d{4}\s*年?$/i,''));if(q.length<2)return [];const terms=q.split(' '),number=terms.find(x=>/^\d+$/.test(x));let out=[];for(const x of items){if(number&&!x.key.split(' ').includes(number))continue;if(!terms.every(t=>x.key.includes(t)))continue;out.push({...x,score:(x.key===q?100:x.key.startsWith(q)?65:40)+x.rank});}out.sort((a,b)=>b.score-a.score||a.name.length-b.name.length);const points=new Set();return out.filter(x=>{const k=x.point.map(v=>v.toFixed(4)).join(',');if(points.has(k))return false;points.add(k);return true;}).slice(0,8);}
 return {normalize,parse,index,search};
})();

(async()=>{'use strict';
 const $=id=>document.getElementById(id),cfg=window.ATLAS_PAGE,data=await window.SpatialDataReady,timeline=window.TIMELINE_DATA;
 const state={records:Spatial.enrich(window.CURATED_ARCHIVE.records,data),context:null,nearby:[],primary:null,references:[],answer:null,revision:0,token:null,job:{},modelLoaded:false,confirmed:null,busy:false,renderBusy:false,historyPending:false,config:{},modelUrl:null,viewMode:'context',inputMode:'history',questionDraft:'',renderDraft:'',renderEvidence:null};
 let modelRequest=null,renderRequest=null,askRevision=0;
 const make=(t,text,cls)=>{const e=document.createElement(t);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
 const call=(name,arg)=>new Promise((resolve,reject)=>{if(!window.google?.script?.run){reject(new Error('Server connection unavailable.'));return;}const r=google.script.run.withSuccessHandler(x=>x?.ok?resolve(x):reject(Object.assign(new Error(x?.message||'The request could not be completed.'),{code:x?.code,token:x?.token,renderStatus:x?.renderStatus,retryable:x?.retryable}))).withFailureHandler(()=>reject(new Error('The server request was interrupted. Check a saved task before submitting it again.')));arg===undefined?r[name]():r[name](arg);});
 const link=(url,label)=>{const a=make('a',label);if(/^https:\/\//.test(url||'')){a.href=url;a.target='_blank';a.rel='noopener noreferrer';}return a;};
 const url=params=>cfg.appUrl+'?'+new URLSearchParams(Object.assign({},cfg.preview?{preview:'1'}:{},params)).toString();
 const currentRecord=()=>state.records.find(r=>r.id===state.primary);
 const viewer=async()=>{if(!window.SpatialViewerReady)await new Promise((ok,no)=>{const start=Date.now(),t=setInterval(()=>{if(window.SpatialViewerReady){clearInterval(t);ok();}else if(Date.now()-start>20000){clearInterval(t);no(new Error('The 3D viewer has not loaded.'));}},100);});return window.SpatialViewerReady;};
 window.addEventListener('atlas-language-changed',()=>{const hadAnswer=!!state.answer||state.historyPending;askRevision++;state.answer=null;if(hadAnswer)$('question-message').textContent='Language changed. Submit your question again for an answer in this language.';readStreet();controls();});
 $('build-label').textContent=cfg.build;$('draft-label').hidden=!cfg.preview;
 for(const id of ['nav-archive','all-archive'])$(id).href=url({page:'archive'});
 $('context-archive').href=url({page:'archive'});
 $('map-method-link').onclick=e=>{e.preventDefault();if(MobileAtlas.compact())MobileAtlas.open('info',e.currentTarget);$('method').open=true;$('method').scrollIntoView({behavior:'smooth'});};
 for(const a of data.areas){const box=make('p');box.append(make('strong',a.name+'. '),document.createTextNode(a.note+' '));a.sources.forEach((u,i)=>box.append(link(u,'Place reference '+(i+1)+' ↗'),document.createTextNode(' ')));box.append(link(a.map_url,a.map_title+' ↗'));$('area-methods').append(box);}
 function contextTitle(){if(!state.context)return 'Select a place';const district=state.context.district;return (district==='old'?'Third Avenue / downtown':'Cass / Peterboro')+' · '+state.context.year;}
 function controls(){const source=currentRecord(),available=source?.generation_eligible&&state.nearby.some(x=>x.record.id===source.id),locked=state.busy||state.renderBusy,uncertain=['SUBMITTING','UNCERTAIN'].includes(state.job.renderStatus),renderMode=state.inputMode==='render';
 $('question-form').setAttribute('aria-busy',String(state.historyPending));$('ask').disabled=locked||state.historyPending||!state.context||(renderMode&&(!state.modelLoaded||!state.confirmed||!state.config.renderReady||uncertain||state.config.renderRequestsRemaining===0));$('ask').textContent=state.historyPending?'Reading sources…':renderMode?(state.job.renderRetryable?'Retry speculative photo generation':'Speculative photo generation'):'Ask this place';
 $('prepare-model').hidden=!state.context||state.modelLoaded||state.viewMode==='photo';$('prepare-model').disabled=!available||locked;
 $('start-model').disabled=!cropImage||locked||!state.config.modelReady||!state.config.storageReady||state.config.modelRequestsRemaining===0;
 $('confirm-view').hidden=!state.modelLoaded||state.viewMode==='photo';$('confirm-view').disabled=locked; $('confirm-view').textContent=state.confirmed?'View confirmed ✓':'Confirm this view';
 $('check-render').hidden=!uncertain;$('tab-street').disabled=!state.context||locked;$('tab-model').disabled=!state.modelLoaded||locked;$('tab-photo').disabled=!state.job.renderReady||locked;$('tab-context').disabled=locked;
 $('focus-scene').hidden=!state.context||state.viewMode==='photo';$('heading-control').hidden=!state.modelLoaded||state.viewMode==='photo';$('reset-alignment').hidden=$('heading-control').hidden;$('reset-alignment').disabled=locked;
 for(const id of ['show-regional','tab-regional','area','year','radius','model-heading','time-slider','prompt-mode','show-rendering','show-basemap','show-historical-map','show-roads','show-rail','show-road-labels','show-building-labels','show-chinatown-labels'])$(id).disabled=locked;
 document.querySelectorAll('#year-ticks button').forEach(b=>b.disabled=locked);document.querySelectorAll('.atlas-label').forEach(b=>{if(b.tagName==='BUTTON')b.disabled=locked;});viewer().then(v=>v.lock(locked)).catch(()=>{});
 }
 function inputMode(next){if(next==='render')$('question-panel').open=true;if(next===state.inputMode)return;askRevision++;if(state.inputMode==='history')state.questionDraft=$('question').value;else state.renderDraft=$('question').value;state.inputMode=next;$('prompt-mode').value=next;$('question').value=next==='history'?state.questionDraft:state.renderDraft;$('question').maxLength=next==='history'?500:1600;$('question').placeholder=next==='history'?'What did this place look like in 1935?':'Describe atmosphere, everyday activities, or a critical fabulation you want to explore.';$('prompt-label').textContent=next==='history'?'What would you like to know about this place?':'Your direction for the speculative photo';$('question-message').textContent='';controls();}
 $('prompt-mode').onchange=()=>inputMode($('prompt-mode').value);
 function invalidate(){if(state.confirmed)$('generation-message').textContent='View changed. Confirm the new camera before generating a photograph.';state.confirmed=null;renderRequest=null;controls();}
 window.addEventListener('reconstruction-view-changed',invalidate);
 async function availability(){try{state.config=await call('getGenerationStatus');const c=state.config;$('generation-allowance').textContent=c.modelRequestsRemaining+' / '+c.dailyModelLimit+' model requests and '+c.renderRequestsRemaining+' / '+c.dailyRenderLimit+' photo requests remain today, shared by all visitors. Resets at 00:00 UTC.';}catch(e){$('generation-allowance').textContent=e.message;}controls();}
 function resetGeneration(mode=state.viewMode==='context'?'context':'street'){state.token=null;state.job={};state.modelLoaded=false;state.confirmed=null;state.renderEvidence=null;state.viewMode=mode;modelRequest=null;renderRequest=null;cropEpoch++;$('crop-panel').hidden=true;$('provenance-section').hidden=true;$('rendered-result').hidden=true;$('model-adjust').hidden=true;$('download-render').hidden=true;$('render-provenance').replaceChildren();$('generation-message').textContent='';$('model-heading').value='0';if(state.modelUrl){URL.revokeObjectURL(state.modelUrl);state.modelUrl=null;}setTab(mode,false);}
 async function setTab(mode,move=true){state.viewMode=mode;for(const m of ['context','street','model','photo'])$('tab-'+m).classList.toggle('active',m===mode);$('rendered-result').hidden=mode!=='photo';document.querySelector('.basemap-credit').hidden=mode==='photo'||(!$('show-basemap').checked&&!$('show-historical-map').checked);$('atlas-labels').hidden=mode==='photo';$('place-heading').hidden=mode==='photo';
 $('scene-badge').textContent=mode==='photo'?'Speculative photo':mode==='model'?'Detailed model':mode==='street'?'Street view':'Historical map';
 $('view-hint').dataset.noTranslate='';$('view-hint').textContent=mode==='photo'?(AtlasI18n.language()==='zh'?'生成的解释性图像，并非历史照片':'Generated interpretation · not an archival photograph'):StreetCamera77.hint(mode==='street',MobileAtlas.compact(),AtlasI18n.language()==='zh',Number($('scene').dataset.cameraLensMm)||43);if(move)try{(await viewer()).mode(mode);}catch(e){$('view-mode').textContent=e.message;}controls();window.dispatchEvent(new CustomEvent('street-state102'));}
 for(const m of ['context','street','model','photo'])$('tab-'+m).onclick=()=>setTab(m);
 $('focus-scene').onclick=async()=>{try{(await viewer()).focus();}catch(e){$('view-mode').textContent=e.message;}};
 $('reset-alignment').onclick=async()=>{$('model-heading').value='0';(await viewer()).heading(0);};
 $('model-heading').oninput=async()=>{try{(await viewer()).heading(Number($('model-heading').value));}catch(e){$('view-mode').textContent=e.message;}};

 function timeStatus(){window.RegionalMap?.refresh();const y=Number($('year').value),d=$('area').value||null,info=Chronology.summary(data,timeline,y,d);$('year-display').textContent=String(y);MobileAtlas.syncYear();$('time-slider').value=Math.max(1900,y);const root=$('temporal-status');root.replaceChildren(make('span',info.documented+' dated observations · '+info.continuity+' documented continuity · '+info.demolished+' removed · '+info.unresolved+' unresolved'));
 const known=info.buildings.find(b=>b.status==='demolished');if(known)root.append(make('strong',known.name+' · '+known.label));else if(d==='new'&&y<1963)root.append(make('span','Before the 1963 Chinatown relocation'));
 const sources=$('map-evidence');sources.replaceChildren();
 if(!info.surveys.length)sources.append(make('p','No mapped building survey is available at or before this year.'));
 const seen=new Set();for(const survey of info.surveys){const key=survey.source_url;if(seen.has(key))continue;seen.add(key);const label=survey.kind==='inventory'?'2010–2024 building inventory ↗':survey.kind==='aerial'?survey.year+' aerial evidence ↗':survey.year+' map evidence ↗';sources.append(link(survey.source_url,label));}
 $('map-coverage').textContent=info.surveys.some(s=>s.kind==='inventory')?(y>2024?'2024 reference only; later building states are unverified.':'2010–2024 inventory: recorded life dates control visibility; earlier forms and heights remain approximate.'):'Partial map tracings. Empty space may be untraced; it does not establish vacant land. Between surveys, volumes retain the last mapped form.';
 $('semcog-credit').hidden=false;
 const aerial=info.surveys.some(s=>s.kind==='aerial');if(aerial)$('map-coverage').textContent='Selected visible roofs from the 2005 aerial image. Roof edges, ground footprints and heights differ. Empty space may be untraced; it does not establish vacant land.';
 const context=$('early-context');context.replaceChildren();const early=(timeline.contextSources||[]).find(c=>y>=c.year&&y<=c.to);context.hidden=y>=1884;
 if(y<1884){const zh=AtlasI18n.language()==='zh';context.setAttribute('data-no-translate','');context.append(make('strong',zh?'早期空间史 · 建筑图层尚有空缺':'Earlier spatial history · building layer unresolved'));if(early){context.append(link(early.url,(zh?early.zhTitle:early.title)+' ↗'),make('p',zh?early.zh:early.note));}else context.append(make('p',zh?'研究时间范围从 1800 年开始；早期具名建筑和明确标注为推测的体量，补充了尚不完整的历史地图层。空白表示尚无可靠模型数据，不能证明这里没有建筑。':'Research begins in 1800. Early named buildings and explicitly conjectural inventory references supplement partial historical map surveys. A blank layer means missing model evidence, not an empty landscape.'));}
 const references=info.buildings.filter(b=>b.referenceGeometry);if(references.length){$('map-coverage').append(document.createTextNode(' '+references.length+' landmark volumes use a dated reference form; presence follows individual life dates, while intervening alterations remain unresolved.'));sources.append(link('https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/Cass%20Park%20Final%20Report.pdf','Building histories and date conflicts ↗'));}
 const rasters=AtlasLayers.overlays(window.HISTORICAL_RASTERS,data,timeline,y);$('underlay-note').textContent=rasters.length?rasters.length+' registered historical images':'No registered historical image for this year';
 const zh=AtlasI18n.language()==='zh';$('extent-note').textContent=zh?'地图体量为不透明；现代清册推测的未知存续体量为 25% 透明。淡黄色表示有记录支持总存续超过 50 年，粉色优先表示该年的唐人街关联。':'Mapped masses are opaque. Uncertain inventory backcasts are 25% transparent. Pale yellow denotes a documented total building life over 50 years; dated Chinatown associations take color priority.';roadStatus();document.querySelectorAll('#year-ticks button').forEach(b=>b.classList.toggle('active',Number(b.dataset.year)===y));
 const milestone=$('milestone-description');milestone.replaceChildren();milestone.setAttribute('data-no-translate','');for(const r of AtlasLayers.milestoneAt(timeline,y))milestone.append(link(r.url,y+' · '+(zh?r.zh:r.title)+' ↗'));}

 function roadStatus(){const y=Number($('year').value),d=$('area').value||null,info=Roads.summary(data,y,d),root=$('road-source-list'),zh=AtlasI18n.language()==='zh';root.replaceChildren();root.setAttribute('data-no-translate','');$('road-status').setAttribute('data-no-translate','');
 $('road-status').textContent=!$('show-roads').checked?(zh?'历史道路已隐藏':'Historical roads hidden'):!info.rows.length?(zh?'该年尚无已提取的道路图层。空白不表示没有道路。':'No digitized road survey for this year. Blank space does not mean no roads.'):(zh?`道路：${info.observed} 段当年观测 · ${info.reference} 段参考走向 · ${info.legalFootprints} 块道路用地记录 · ${info.changeTraces} 处变更轮廓`:`Roads: ${info.observed} observed · ${info.reference} reference segments · ${info.legalFootprints} ROW footprints · ${info.changeTraces} change traces`);
 root.append(make('p',zh?'深蓝：有依据支持走向延续至今；不代表路宽、铺装或用途未改变。淡蓝：道路已变化或连续性尚未确认。外围 1912 年道路仅核对了图上具名走廊，采用现代中心线作近似定位；尚未复原消失的支路。路名按层级逐步显示：先主干道，再次干道，最后小街巷。':'Dark blue: supported long-lived alignment, not unchanged width, paving or use. Light blue: changed or continuity unresolved. Outer 1912 corridors use modern reference centerlines after name/network comparison; erased side streets remain incomplete. Road names appear by hierarchy: main routes first, minor streets and alleys at closer zoom.'));root.append(make('p',zh?'新增多边形保留市政府道路用地轮廓。填色范围包含有日期的道路用地及历次法律变更记录。时间轴按所选年末的法律记录显示，不代表道路实际开通、拆除或持续存在。部分废止只切除重叠范围；日期未知的记录不进入时间轴。高程、桥梁和下穿尚未重建。':'New polygons preserve municipal right-of-way (ROW) geometry. Filled surfaces include dated road records and earlier legal-change footprints. The timeline uses legal records through year-end, not physical opening, demolition or continuous survival. Partial vacations cut only the overlapping land. Undated records stay outside the timeline. Road elevations, bridges and cuttings remain unresolved.'));
 const pt=state.context?.point||data.areas.find(a=>a.id===d)?.center||data.areas[0].center,near=Roads.evidence(data,y,pt,6);root.append(make('p',zh?'街道断口已用具名历史走廊和相邻道路的延长线补接；推测连接不等于已核实的历史路口。高速主线、匝道和辅路已分开；下沉路槽与跨街桥按空间层次显示。点击道路史料圆点查看桥面宽度、净空及高程推算依据。历史路幅变化未逐段核实。':'Gaps are joined using historically named corridors and continuations of adjacent streets. Inferred links do not establish verified historical junctions. Freeway mainlines, ramps and frontage streets are separated. Depressed cuts and crossing bridges have distinct levels. Click road source dots for widths, clearances and derived grades; historical widening remains unresolved.'));root.append(make('strong',zh?'所选位置附近的道路记录':'Road records near your selection'));
 for(const r of near){const types=zh?{dedication:'划定／拓宽',vacation:'废止',easement:'地役权变更'}:{dedication:'dedication / widening',vacation:'vacation',easement:'easement change'};const p=make('p',`${r.event_date} · ${r.name} · ${types[r.event_type]} · ~${r.distance_m} m `);p.dataset.roadRecord=r.id;p.append(link(r.decision_url||r.source_url,zh?'原始记录 ↗':'Source record ↗'));root.append(p);}
 root.append(make('strong',zh?'实际通车与拆除核实':'Physical openings & removals'));
 for(const r of Roads.physicalEvidence(data,y,pt,9)){const date=r.opening?(r.opening.type==='in_service_by'?(zh?r.opening.date.slice(0,4)+' 年底前':'By end of '+r.opening.date.slice(0,4)):r.opening.date):(r.removal.last_mapped+'–'+r.removal.changed_by),p=make('p',date+' · '+(zh?r.zhName:r.name)+' — '+(zh?r.zh:r.note));p.dataset.physicalReview=r.id;p.append(document.createTextNode(' '),link(r.source_url,zh?'依据 ↗':'Evidence ↗'));if(r.comparison_url)p.append(document.createTextNode(' '),link(r.comparison_url,zh?'对照航拍 ↗':'Comparison aerial ↗'));root.append(p);}
 root.append(make('p',zh?'通车史料尚未对应到已精确配准的匝道几何，因此不会据此自动补画匝道。1950—2005 年的拆除区间表示证据间隔，不是道路一直存在至 2004 年。':'Opening records do not yet supply precisely registered ramp geometry, so they do not automatically draw ramps. A 1950–2005 removal interval marks a gap between observations, not survival through 2004.'));
 root.append(make('strong',zh?'地图位置核查':'Map placement checks'));
 for(const q of data.mapRegistrationReviews||[]){root.append(make('p',(zh?q.zh:q.note)));root.append(link(q.source_url,zh?'配准原图与控制点 ↗':'Registered source & control points ↗'));}
 root.append(link('https://detroitmi.gov/departments/department-public-works/maps-and-records',zh?'市政府道路档案与原图 ↗':'Municipal road archives & original plans ↗'));
