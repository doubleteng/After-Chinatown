 for(const source of picked){const card=make('article',undefined,'reading-record');card.append(make('h3',source.title),make('p','Source date: '+source.date+' · '+source.place,'small'),make('p',source.summary||'Read the original record for details.'),citations([source.id]));const curated=window.CURATED_EVIDENCE.claims.filter(c=>c.sources.includes(source.id.replace(/^existing_/,''))&&!/prototype|moving figures|not georeferenced/i.test(c.text)).slice(0,2);curated.forEach(c=>card.append(make('p',c.text)));r.append(card);}
