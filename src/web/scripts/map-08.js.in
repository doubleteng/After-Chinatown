  tri(pt(roofL,H,roofBottom),pt(roofL+.2,roofTop,roofBack),pt(roofL,H,-2),'#52604f');tri(pt(roofR,H,roofBottom),pt(roofR-.2,roofTop,roofBack),pt(roofR,H,-2),'#52604f');
  if(detail)for(let y=7.42;y<9.85;y+=.29){const t=(y-H)/(roofTop-H),d=roofBottom+(roofBack-roofBottom)*t;panel(roofL+.2*t,roofR-.2*t,y,y+.018,'#919787',d+.02);}
  const dormer=(roofL+roofR)/2,dw=Math.min(1.7,(roofR-roofL)*.75),dl=dormer-dw/2,dr=dormer+dw/2,dy=9.78,peak=11.45,frontD=.83;
  // Intact southern dormer is explicitly an interpretation; late collapse is confined to the photo phase.
