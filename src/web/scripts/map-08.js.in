  const length=Math.hypot(b.x-a.x,b.z-a.z);let nx=-(b.z-a.z)/length,nz=(b.x-a.x)/length;
  if((center.x-a.x)*nx+(center.z-a.z)*nz<0){nx=-nx;nz=-nz;}
  const signed=p=>(p[0]-a.x)*nx+(p[2]-a.z)*nz-review.seamMarginM;
  const original=mesh.geometry,g=original.index?original.toNonIndexed():original;
  const attributes=Object.keys(g.attributes),out=Object.fromEntries(attributes.map(k=>[k,[]]));
  let changed=false;const cutSegments101=[];
  const vertex=i=>Object.fromEntries(attributes.map(k=>{const attr=g.attributes[k];return [k,Array.from({length:attr.itemSize},(_,j)=>attr.array[i*attr.itemSize+j])]}));
  const mix=(a,b,t)=>Object.fromEntries(attributes.map(k=>[k,a[k].map((x,i)=>x+(b[k][i]-x)*t)]));
  for(let i=0;i<g.attributes.position.count;i+=3){
   const tri=[vertex(i),vertex(i+1),vertex(i+2)],poly=[],cuts=[];
   for(let j=0;j<3;j++){
    const p=tri[j],q=tri[(j+1)%3],dp=signed(p.position),dq=signed(q.position);
    if(dp>=0)poly.push(p);else changed=true;
    if((dp>=0)!==(dq>=0)){const cut=mix(p,q,dp/(dp-dq));poly.push(cut);cuts.push(cut.position);}
   }
   if(cuts.length===2&&building.id==="r52-cass3136"){
    const v=tri.map(p=>new THREE.Vector3(...p.position));
    const surface=new THREE.Vector3().subVectors(v[1],v[0]).cross(new THREE.Vector3().subVectors(v[2],v[0]));
    const direction=surface.cross(new THREE.Vector3(-nx,0,-nz));
    if(new THREE.Vector3().subVectors(new THREE.Vector3(...cuts[1]),new THREE.Vector3(...cuts[0])).dot(direction)<0)cuts.reverse();
    cutSegments101.push(cuts);
   }
   for(let j=1;j+1<poly.length;j++)for(const v of [poly[0],poly[j],poly[j+1]])for(const key of attributes)out[key].push(...v[key]);
  }
    // Close the cut plane. Sweep the oriented triangle/plane intersections so
  // overlapping trim boxes form one cap rather than coplanar competing faces.
  function appendClosedCap101(segments){
   const ux=(b.x-a.x)/length,uz=(b.z-a.z)/length,eps=1e-5;
   const edges=segments.map(([p,q])=>[{u:(p[0]-a.x)*ux+(p[2]-a.z)*uz,y:p[1]},{u:(q[0]-a.x)*ux+(q[2]-a.z)*uz,y:q[1]}]).filter(([p,q])=>Math.abs(p.y-q.y)>eps);
   const ys=[...new Set(segments.flatMap(s=>s.map(p=>Math.round(p[1]/eps)*eps)))].sort((p,q)=>p-q);
   const at=(edge,y)=>edge[0].u+(edge[1].u-edge[0].u)*(y-edge[0].y)/(edge[1].y-edge[0].y);
