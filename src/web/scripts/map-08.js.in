 / DHS",url:"https://www.detroithistorical.org/learn/online-research/collection/photo/print-photographic-fort-st-presbyterian-church-facing-east"},trinity:{label:"1930 · Detroit News / Reuther Library",url:"https://reuther.wayne.edu/node/7239"}};Object.assign(t,{chungs25:{label:"Chung’s · renovated exterior, June 2025 · Jena Brooker / BridgeDetroit",url:"https://www.bridgedetroit.com/detroit-restaurant-chinatown-chungs-tenant-search/"},chungsListing:{label:"3175 Cass · Showcase property listing; construction field is not proof of original fabric",url:"https://www.showcase.com/3175-cass-ave-detroit-mi-48201/34988364/"},woodstock25:{label:"Woodstock · developer history and exterior, published 10 December 2025",url:"https://www.ilitchnewshub.com/post/olympia-development-co-developer-program-selects-woodborn-partners-to-restore-the-woodstock"},mckay:{label:"McKay House · property photographs and undimensioned elevation",url:"https://www.thecorktowncollection.com/1450-6th"},mckayListing:{label:"1450 Sixth · Redfin listing, reported construction 1906",url:"https://www.redfin.com/MI/Detroit/1450-6th-St-48226/home/98332644"},workers:{label:"Workers Row House · photographs, elevation and claimed 1849 date",url:"https://www.thecorktowncollection.com/1430-6th"},workersListing:{label:"1430 Sixth · Zillow reports 1880; conflicts with property history",url:"https://www.zillow.com/homedetails/1430-6th-St-Detroit-MI-48226/88771510_zpid/"}});Object.assign(t,{cass3136:{label:"3136 Cass Avenue · photo reference",url:"https://www.compass.com/homedetails/3136-Cass-Ave-Detroit-MI-48201/1GJGOR_pid/"},cass3124:{label:"3124 Cass Avenue · photo reference",url:"https://www.compass.com/homedetails/3124-Cass-Ave-Detroit-MI-48201/1GJ9T7_pid/"},park3127:{label:"3127 Park Avenue · photo reference",url:"https://www.compass.com/homedetails/3127-Park-Ave-Detroit-MI-48201/1HEHB7_pid/"},cass3745:{label:"3745 Cass Avenue · photo reference",url:"https://www.eherg.com/locations/3745-cass-avenue"},porter1200:{label:"1200 Porter Street · photo reference",url:"https://www.oconnordetroit.com/property/1200-porter-street/"},bagley1221:{label:"1221 Bagley · Donovan House · photo reference",url:"https://corktownhistory.blogspot.com/2014/09/daniel-o-donovan-house-1221-bagley.html"},sixth1423:{label:"1423 Sixth Street · photo reference",url:"https://www.zillow.com/homedetails/1423-6th-St-Detroit-MI-48226/88509012_zpid/"},sixth1535:{label:"1535 Sixth Street · loft building · photo reference",url:"https://maxbroockdetroit.com/properties/1535-6th-street-unit-5-detroit-mi-48226-575603357"},cass2949:{label:"2949 Cass Avenue · designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/Cass%20Park%20Final%20Report.pdf"},cass2930:{label:"2930 Cass Avenue · designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/Cass%20Park%20Final%20Report.pdf"}});const o=[{id:"cass3136",ids:["r52-cass3136"],entity:"cass3136",name:"3136 Cass Avenue",nameZh:"3136 Cass Avenue",kind:"cass3136",through:2026,height:8.8,body:8,floors:2,bays:9,facing:[-.92188,.38749],sources:["cass3136"],from:2026},{id:"cass3124",ids:["r52-cass3124"],entity:"cass3124",name:"3124 Cass Avenue",nameZh:"3124 Cass Avenue",kind:"cass3124",through:2026,height:4.45,body:4.1,floors:1,bays:4,facing:[-.92188,.38749],sources:["cass3124"],from:2026},{id:"park3127",ids:["r52-park3127"],entity:"park3127",name:"3127 Park Avenue",nameZh:"3127 Park Avenue",kind:"park3127",through:2026,height:11,body:7.6,floors:2,bays:2,facing:[.86503,-.50171],sources:["park3127"],from:2026},{id:"cass3745",ids:["r52-cass3745"],entity:"cass3745",name:"3745 Cass Avenue",nameZh:"3745 Cass Avenue",kind:"cass3745",through:2026,height:6.8,body:5.3,floors:1,bays:3,facing:[.92162,-.3881],sources:["cass3745"],from:2023},{id:"porter1200",ids:["r52-porter1200"],entity:"porter1200",name:"1200 Porter Street",nameZh:"1200 Porter Street",kind:"porter1200",through:2026,height:9.55,body:7.1,floors:2,bays:3,facing:[.50511,.86305],sources:["porter1200"],from:2026},{id:"bagley1221",ids:["r52-bagley1221"],entity:"bagley1221",name:"1221 Bagley · Donovan House",nameZh:"1221 Bagley · Donovan House",kind:"bagley1221",through:2026,height:9.9,body:7.8,floors:2,bays:3,facing:[-.50634,-.86233],sources:["bagley1221"],from:2014},{id:"sixth1423",ids:["r52-sixth1423"],entity:"sixth1423",name:"1423 Sixth Street",nameZh:"1423 Sixth Street",kind:"sixth1423",through:2026,height:7.4,body:7,floors:2,bays:3,facing:[.8646,-.50245],sources:["sixth1423"],from:2026},{id:"sixth1535",ids:["r52-sixth1535"],entity:"sixth1535",name:"1535 Sixth Street · loft building",nameZh:"1535 Sixth Street · loft building",kind:"sixth1535",through:2026,height:22.4,body:21,floors:5,bays:4,facing:[.86664,-.49893],sources:["sixth1535"],from:2026},{id:"cass2949",ids:["r52-cass2949"],entity:"cass2949",name:"2949 Cass Avenue",nameZh:"2949 Cass Avenue",kind:"cass2949",through:2026,height:8.9,body:8.2,floors:2,bays:3,facing:[.91926,-.39364],sources:["cass2949"],from:2026},{id:"cass2930",ids:["r52-cass2930"],entity:"cass2930",name:"2930 Cass Avenue",nameZh:"2930 Cass Avenue",kind:"cass2930",through:2026,height:11.5,body:10.8,floors:3,bays:4,facing:[-.91926,.39364],sources:["cass2930"],from:2026},{id:"chungs-restored",ids:["semcog-8135176","new-map-39"],entity:"chungs-restored",name:"Former Chung’s · renovated exterior",nameZh:"原 Chung’s · 修缮后外观",kind:"chungs-restored",from:2025,through:2026,height:4.5,body:3.05,floors:1,bays:9,facing:[.4,.9165],sources:["chungs25","chungsListing"]},{id:"woodstock-west",ids:["r51-woodstock-west"],entity:"woodstock",name:"Woodstock · west building",nameZh:"Woodstock · 西栋",kind:"woodstock",from:2025,through:2026,height:13.1,body:11.5,floors:3,bays:3,facing:[-.4,-.9165],sources:["woodstock25"]},{id:"woodstock-east",ids:["r51-woodstock-east"],entity:"woodstock",name:"Woodstock · east building",nameZh:"Woodstock · 东栋",kind:"woodstock",from:2025,through:2026,height:13.1,body:11.5,floors:3,bays:3,facing:[-.4,-.9165],sources:["woodstock25"]},{id:"mckay",ids:["r51-mckay"],entity:"mckay",name:"McKay House · 1450 Sixth",nameZh:"McKay House · 1450 Sixth",kind:"mckay",from:2026,through:2026,height:9.4,body:7.9,floors:2,bays:5,facing:[-.854,.52],sources:["mckay","mckayListing"]},{id:"workers",ids:["r51-workers"],entity:"workers",name:"Workers Row House · 1430 Sixth",nameZh:"Workers Row House · 1430 Sixth",kind:"workers",from:2026,through:2026,height:8.1,body:5.9,floors:2,bays:3,facing:[-.854,.52],sources:["workers","workersListing"]},{id:"masonic-west",ids:["r16-masonic-west"],entity:"masonic",name:"Masonic Temple · Ritualistic tower",nameZh:"Masonic Temple · 仪式塔楼",kind:"masonic",from:1926,through:2026,height:64.008,body:51.5,floors:14,bays:5,facing:[.37,.93],sources:["cass","masonic"]},{id:"masonic-center",ids:["r16-masonic-center"],entity:"masonic",name:"Masonic Temple · auditorium",nameZh:"Masonic Temple · 礼堂",kind:"auditorium",from:1926,through:2026,height:25,body:24,floors:1,bays:6,facing:[.37,.93],sources:["cass","masonic"]},{id:"masonic-east",ids:["r16-masonic-east"],entity:"masonic",name:"Masonic Temple · Shrine wing",nameZh:"Masonic Temple · Shrine 楼翼",kind:"shrine",from:1926,through:2026,height:41,body:39,floors:10,bays:5,facing:[.37,.93],sources:["cass","masonic"]},{id:"fort-wayne",ids:["r16-fort-wayne"],entity:"fort-wayne",name:"Fort Wayne Hotel",nameZh:"Fort Wayne 酒店",kind:"hotel",from:1926,through:2026,height:40.2,body:38.8,floors:11,bays:11,facing:[.37,.93],sources:["cass","wayne"]},{id:"standard",ids:["r16-standard"],entity:"standard",name:"Standard Accident Insurance Building",nameZh:"Standard Accident 保险大楼",kind:"standard",from:1921,through:2026,height:32.3,body:31,floors:8,bays:14,facing:[-.37,-.93],sources:["cass","standard"]},{id:"kresge-center",ids:["r16-kresge-center"],entity:"kresge",name:"Kresge · central pavilion",nameZh:"Kresge · 中央高亭",kind:"kresge",from:1930,through:2026,height:26,body:21,floors:5,bays:9,facing:[.92,-.39],sources:["cass","kresge"]},{id:"kresge-north",ids:["r16-kresge-north"],entity:"kresge",name:"Kresge · north wing",nameZh:"Kresge · 北翼",kind:"kresge",from:1930,through:2026,height:20.5,body:16.5,floors:4,bays:8,facing:[.92,-.39],sources:["cass","kresge"]},{id:"kresge-south",ids:["r16-kresge-south"],entity:"kresge",name:"Kresge · south wing",nameZh:"Kresge · 南翼",kind:"kresge",from:1930,through:2026,height:20.5,body:16.5,floors:4,bays:8,facing:[.92,-.39],sources:["cass","kresge"]},{id:"union-main",ids:["r16-union-main"],entity:"union",name:"Fort Street Union Depot · headhouse",nameZh:"Fort Street Union Depot · 站房钟楼",kind:"depot",from:1902,through:1973,height:48,body:13.5,floors:3,bays:7,facing:[-.48,-.88],sources:["union"]},{id:"union-wing",ids:["r16-union-wing"],entity:"union",name:"Fort Street Union Depot · wing",nameZh:"Fort Street Union Depot · 站房楼翼",kind:"depot-wing",from:1902,through:1973,height:15,body:10,floors:2,bays:18,facing:[-.48,-.88],sources:["union"]},{id:"fort-church",ids:["landmark-fort-church"],entity:"fort-church",name:"Fort Street Presbyterian Church",nameZh:"Fort Street 长老会教堂",kind:"fort-church",from:1979,through:2026,height:80.772,body:15,floors:1,bays:6,facing:[-.5,-.87],sources:["fort","fortphoto"]},{id:"holy-trinity",ids:["landmark-holy-trinity"],entity:"holy-trinity",name:"Most Holy Trinity Church",nameZh:"Most Holy Trinity 教堂",kind:"trinity",from:1930,through:2026,height:49,body:14,floors:1,bays:7,facing:[-.5,-.87],sources:["trinity"]}];const n={masonic:["Three documented volumes, Gothic entrance and tower crown. Report gives a 210 ft (64.008 m) maximum; other elevations and openings are proportional. Complete exterior starts in 1926.","按史料区分三个体量、哥特式入口与塔冠。报告记载最高处 210 英尺（64.008 米）；其他高程和构件尺寸为比例推估。完整外观从 1926 年起显示。"],kresge:["Central pavilion, lower wings, giant pilasters and copper mansard roofs follow the designation report and 1946 photograph. Construction sources disagree (1927–1930); full exterior starts in 1930.","中央高亭、低楼翼、通高壁柱与铜质折坡屋顶依据保护报告及 1946 年照片。建成年代存在 1927–1930 年分歧，完整外观从 1930 年起显示。"],"fort-wayne":["Eleven-storey brick mass, stone lower floors, patterned upper band and parapet follow the designation report. Later storefront alterations are not reconstructed as the 1926 storefront.","十一层砖砌体量、底部石饰、上层装饰带和女儿墙依据保护报告；不把晚期改造的店面倒推为 1926 年原貌。"],standard:["Eight storeys, seven frontage bays, paired upper windows, stone base and stepped parapet follow the designation report and early photograph. 1920–1921 opening uncertainty is retained.","八层、七跨立面、上层双窗、石质基座和阶梯女儿墙依据保护报告与早期照片；保留 1920–1921 年建成年代分歧。"],union:["Three-storey headhouse, lower wing, steep roofs, dormers and clock tower interpreted from the 1902–1910 postcard. Tower height is an estimated proportion, not a survey. Closed in 1971; demolished in 1974.","三层站房、低楼翼、陡坡屋顶、老虎窗及钟楼依据 1902–1910 年明信片。钟楼高度为图像比例推估，并非测量值。1971 年停运，1974 年拆除。"],"fort-church":["Gothic nave, buttresses, asymmetric towers and 265 ft (80.772 m) principal spire. Detailed reference begins with the reviewed 1979 image; earlier fire and rebuilding phases remain base masses.","哥特式中殿、扶壁、不对称塔楼及 265 英尺（80.772 米）主尖塔。细化外观从已核看的 1979 年照片开始；更早的火灾与重建阶段保留基础体量。"],"holy-trinity":["Central entrance tower, steep spire, gabled nave and repeated pointed windows interpreted from the 1930 photograph. Earlier phases remain base masses.","中央入口塔、陡尖顶、双坡中殿与连续尖拱窗依据 1930 年照片；更早阶段保留基础体量。"]};Object.assign(n,{"chungs-restored":["Red roof and glazed Peterboro frontage follow the June 2025 report of completed renovation. The 2023 photograph records the boarded, pre-renovation state. 2023–2024 retain the pre-renovation building detail; no new tenant or business sign is inferred.","红色屋檐和 Peterboro 侧玻璃店面依据 2025 年 6 月修缮完成报道。2023 年照片为封板、修缮前状态；2023–2024 年保留过渡期基础体量，不推定新商户或营业招牌。"],woodstock:["Twin three-storey buildings, cornice, shaped parapet and grouped windows follow the exterior image published in December 2025; its exposure date is unconfirmed. Earlier years show base masses after the documented 1914 opening. Proposed renovation is not displayed as completed work.","双栋三层体量、檐口、装饰女儿墙及成组窗户依据 2025 年 12 月刊发的外观照片，拍摄日期未确认。1914 年启用后的早期年份显示基础体量；未把拟议修缮呈现为已建成状态。"],mckay:["Brick front, projecting window bays, paired pediments, cornice and entrance porch follow undated property images reviewed in 2026. Detailed view begins at the review year, not a claimed alteration date. Redfin reports 1906 construction; earlier geometry and later alterations are unverified.","砖立面、凸窗、双山花、檐口和入口门廊依据 2026 年核看的未定年房产照片。细化从核查年份显示，不代表该年改造。Redfin 填报建造年份 1906；早期形态及历次改造尚未核实。"],workers:["Timber siding, two-storey street wall, gable roof and door/window rhythm follow undated property photographs reviewed in 2026. The property history says 1849 and Zillow says 1880; the conflict is retained. The illustrative elevation is not a measured drawing.","木板墙、两层街墙、双坡顶和门窗排列依据 2026 年核看的未定年房产照片。物业历史称 1849 年、Zillow 称 1880 年，保留冲突。立面示意并非实测图纸。"]});Object.assign(n,{cass3136:["Compass reports 1920 and two storeys; APN 02002071 matches the supplied LoopNet record. Cream brick, projecting piers, cornice and partly infilled window bands follow the undated street photograph. The 2026 detail boundary is a review date, not a renovation date. The refined reference adds recessed pier panels, cornice dentils, the tile frieze, window sills and paired green entrances. Bay spacing and unphotographed portions remain proportional interpretations.","Compass 填报 1920 年、两层；地块号 02002071 与用户提供的 LoopNet 链接一致。浅色砖墙、壁柱、檐口和部分封堵窗带依据未定年街景。2026 是核查节点，不是改造年份。 本轮补充壁柱凹槽、檐口齿饰、瓷砖饰带、窗台和成对绿色入口；柱跨间距及照片未覆盖部分仍为比例推估。"],cass3124:["Property record reports 1948, one storey and 4,514 sq ft. White panel frontage, two rolling doors and small windows follow the undated street photograph. No historical tenant sign is inferred.","房产记录填报 1948 年、一层、4,514 平方英尺。白色板状立面、两处卷帘门与小窗依据未定年街景，不推定历史招牌。"],park3127:["Listing reports 1890. Photograph shows two main storeys, an attic dormer, brick bay, raised stone base and entrance porch. This corrects the simplified 1.5-storey inventory height only in the reviewed exterior phase.","房源填报 1890 年。照片显示两层主体、阁楼老虎窗、砖砌凸窗、石基座及入口门廊；仅在核查外观阶段修正底图简化的 1.5 层高度。"],cass3745:["Photographer history and reproduced period material identify a 1913 automobile business. The 2023 publication shows a white-painted low commercial front, broad fascia and taller rear portion. Worn advertising is not reconstructed as legible original lettering.","摄影者的建筑研究及转载史料记载 1913 年汽车业用途。2023 年刊发照片显示白色低层商业立面、宽檐带和较高后部；不将残损广告补写成确定的原始文字。"],porter1200:["Broker and Zillow report 1900. Two storeys, front gable, attic window, horizontal siding and offset porch follow the property photographs. The red/green finish is a recent photographic reference; its exposure date is unconfirmed.","经纪公司与 Zillow 填报 1900 年。两层、前山墙、阁楼窗、横向壁板和偏置门廊依据房产照片；红绿涂装仅作为近期影像参考，拍摄日期未确认。"],bagley1221:["Permit research cites 1878/1879 and a two-storey front addition in 1898; Redfin instead reports 1916. The later photo shows porch, pediment, balcony and siding. Details begin at the 2014 publication boundary, not at the original construction or addition date.","建筑许可研究记载 1878／1879 年及 1898 年两层前部扩建，Redfin 则填报 1916 年。后期照片显示门廊、山花、阳台与壁板；细节从 2014 年刊发节点显示，不倒推至初建或扩建年份。"],sixth1423:["Zillow reports 1880. The photograph supports the grey siding, entrance recess, porch columns, railings and raised base. Roof and uppermost facade are outside the image; their detailed form remains unresolved and is not invented.","Zillow 填报 1880 年。照片支持灰色壁板、凹入口、廊柱、栏杆与抬高基座；屋顶和最上部立面不在画面内，保留为未核实的简化体量。"],sixth1535:["Broker and Zillow report 1920. Five storeys, broad industrial window grids, brick piers and shaped parapet follow the exterior photograph. Unit floor area does not determine the whole building footprint. Rooftop advertising is omitted because its installation timeline is unverified.","经纪公司与 Zillow 填报 1920 年。五层体量、工业格窗、砖壁柱及造型女儿墙依据外观照片；单套公寓面积不用于推算整栋占地。屋顶广告安装年代未核实，未予重建。"],cass2949:["LoopNet reports 1920; the historic district report gives 1922 and Albert Kahn. Two storeys, three broad bays, red brick and projecting piers follow the report. The 1920–1922 range expresses conflicting records, not continuous construction. Current window infill is unresolved.","LoopNet 填报 1920 年，历史街区报告记载 1922 年及 Albert Kahn。两层、三跨、红砖和突出壁柱依据报告；1920–1922 表示记录冲突，并非连续施工期。现状封窗细节仍未核实。"],cass2930:["The designation report and property page agree on 1915 and three storeys. Four-bay brick frontage, upper windows and tile parapet band follow the report. Storefront glazing and later alterations remain schematic pending accessible close-up photography.","历史街区报告与房产页面均记载 1915 年、三层。四跨砖立面、上层窗户及女儿墙瓷砖带依据报告；店面玻璃与后期改造仍为示意，等待可核验近照。"]});o.unshift(...[{id:"woodward3100",ids:["r54-woodward3100"],entity:"woodward3100",name:"3100 Woodward Avenue · Crystal Lofts",nameZh:"3100 Woodward Avenue · Crystal Lofts",kind:"woodward3100",from:1915,through:2026,body:11.5,height:15,floors:2,bays:13,facing:[-.8958,.4445],sources:["woodward3100"]},{id:"woodward3139",ids:["r54-woodward3139"],entity:"woodward3139",name:"3139 Woodward Avenue",nameZh:"3139 Woodward Avenue",kind:"woodward3139",from:1911,through:2026,body:8,height:10.1,floors:2,bays:3,facing:[.8977,-.4406],sources:["woodward3139"]},{id:"watson112",ids:["r54-watson112"],entity:"watson112",name:"112 Watson Street · Lamar Residence",nameZh:"112 Watson Street · Lamar Residence",kind:"watson112",from:1912,through:2026,body:11.3,height:12,floors:3,bays:7,facing:[-.5,-.866],sources:["watson112"]}]);o.find(e=>e.id==="cass3136").from=1920;Object.assign(t,{woodward3100:{label:"3100 Woodward Avenue · Crystal Lofts · sources",url:"https://detroit1701.org/Crystal%20Ballroom.html"},woodward3139:{label:"3139 Woodward Avenue · sources",url:"https://www.oconnordetroit.com/property/3139-woodward-avenue-unit-5/"},watson112:{label:"112 Watson Street · Lamar Residence · sources",url:"https://www.realtor.com/realestateandhomes-detail/112-Watson-St-Apt-26_Detroit_MI_48201_M31238-89086"}});Object.assign(n,{woodward3100:["Property records and inventory report 1915; Ren Farley dates the ballroom opening/construction to 1919. Earlier geometry is a proportional reference, not an original elevation. Farley photographed renovation on 23 July 2007 and describes the added penthouse floor; his suggested 1936 facade date is explicitly conjectural. The same main facade reference appears from 1915; the independently documented roof addition appears from 2007. The 2007 boarded condition remains in the dated photograph tag. Unit area is not the building footprint.","房产记录与底图填报 1915 年；Ren Farley 将舞厅启用／建造记为 1919 年，保留两种记载。较早模型为比例参考，不是原始立面实测。2007 年 7 月 23 日照片记录修缮封板，作者记述屋顶加层；其关于 1936 年立面改造的说法是推测。主体立面自 1915 年起使用同一细化参考，有独立记录的屋顶加层自 2007 年加入；2007 年封板状态保留在该年照片 tag 中；单套面积不用于整栋占地。"],woodward3139:["Zillow, broker and inventory agree on 1911. Two-storey frontage, three broad upper window bays, pale tile surround, projecting cornice and nine parapet vents follow the broker exterior file labeled February 2024. Earlier detailed form is a later-facade reference; original storefront, glazing and decoration dates are unconfirmed. The same storefront reference is used from the 1911 construction date; installation dates of individual subdivisions remain unknown.","Zillow、经纪公司与底图均记载 1911 年。两层立面、三跨上层宽窗、浅色饰砖、突出檐口及九个女儿墙圆孔依据经纪公司标为 2024 年 2 月的外观图片。早期细化为后期立面参照推估，原始店面、窗型和装饰年代未确认；同一店面参考从 1911 年起显示，个别分隔的安装日期仍未知。"],watson112:["Zillow and another unit record report 1912; the inventory reports 1908, which is retained as a conflict. Three principal storeys above a raised basement, projecting central bay, paired recessed entrances, lintels and cornice follow the exterior photograph. Early detail is a later-form interpretation. The listing’s 2024 remodel field concerns a unit and does not establish a whole-building exterior change. The roof structure and blue doors are carried with the same exterior model from 1912; their individual installation dates are unconfirmed.","Zillow 与另一单元记录均填报 1912 年，底图为 1908 年，保留冲突。照片支持抬高半地下层上的三层主体、中央凸部、两处凹入口、窗楣与檐口；早期细化为后期形态参照推估。房源的 2024 年装修字段针对单元，不能证明整栋外观改造；屋顶小体量与蓝门随同一外观模型自 1912 年起显示，其各自安装日期未确认。"],cass3136:["Built in 1920 according to the property record. Detailed structural reference is displayed from 1920 onward: piers, floor bands and cornice are interpreted from the surviving frontage. Early openings and finishes are unresolved and shown neutrally; modern green entrances and infill are restricted to the undated exterior reference reviewed in 2026. 2026 is not a construction or alteration date.","房产记录为 1920 年建造。自 1920 年起连续显示壁柱、楼层饰带与檐口等结构细化；这些早期细节参照现存立面推估，历史门窗与饰面尚未证实，以中性退面表示。绿色入口与封窗细节仅用于 2026 年核查的未定年现存外观；2026 不是建造或改造日期。"]});const r={cass3124:{from:1948,photoFrom:2026},park3127:{from:1900,photoFrom:2026},cass3745:{from:1913,photoFrom:2023},porter1200:{from:1900,photoFrom:2026},bagley1221:{from:1900,photoFrom:2014},sixth1423:{from:1900,photoFrom:2026},sixth1535:{from:1920,photoFrom:2026},cass2949:{from:1922,photoFrom:2026},cass2930:{from:1915,photoFrom:2026},"woodstock-west":{from:1914,photoFrom:2025},"woodstock-east":{from:1914,photoFrom:2025},mckay:{from:1906,photoFrom:2026},workers:{from:1900,photoFrom:2026}};for(const e of o){const t=r[e.id];if(t){e.from=t.from;e.photoFrom=t.photoFrom}}const a={woodstock:["Structural and facade reference detail is available from 1914. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2025 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1914 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2025 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],mckay:["Structural and facade reference detail is available from 1906. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1906 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],workers:["Structural and facade reference detail is available from 1880. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1880 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],cass3124:["2014 primary exterior photograph confirms the light panel grid, square windows and flat parapet. Model detail is displayed from the recorded 1948 construction date; earlier finish and alteration dates remain inferred. Structural and facade reference detail is available from 1948. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","2014 年同期照片确认浅色分格立面、方窗及平女儿墙。细节从房产记录的 1948 年建造时间显示；早期饰面与改造年代仍为推测。自 1948 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],park3127:["Structural and facade reference detail is available from 1890. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1890 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],cass3745:["Structural and facade reference detail is available from 1913. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2023 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1913 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2023 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],porter1200:["Structural and facade reference detail is available from 1900. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1900 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],bagley1221:["Structural and facade reference detail is available from 1879. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2014 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year. The documented front porch/balcony addition is shown from 1898.","自 1879 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2014 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。 有记录的前部门廊／阳台增建从 1898 年起显示。"],sixth1423:["Structural and facade reference detail is available from 1880. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1880 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],sixth1535:["Structural and facade reference detail is available from 1920. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1920 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],cass2949:["Structural and facade reference detail is available from 1922. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1922 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"],cass2930:["Structural and facade reference detail is available from 1915. Earlier form, dimensions and openings are inferred from the surviving building; photo review/publication in 2026 does not date its construction. The same photographic reference finishes and openings are used throughout the standing life. Known additions and conflicting construction records remain separate; continuity is not confirmed year by year.","自 1915 年起显示结构与立面参考细化。早期形态、尺寸及开口依据存世建筑推估；2026 年是照片核查／刊发界限，不是建造年份。现状参考饰面与开口贯穿建筑存续期。已知加建与建造年份冲突分别保留，存续外观并非逐年核实。"]};for(const[e,t]of Object.entries(a)){n[e]=t}o.unshift(...[{id:"leland",entity:"leland",ids:["r55-leland"],name:"Detroit–Leland Hotel · 400 Bagley",nameZh:"Detroit–Leland Hotel · 400 Bagley",kind:"hotel55",from:1927,through:2026,body:64,height:65.5,floors:20,bays:17,facing:[.92,-.39],sources:["leland"]},{id:"shelby-original",entity:"shelby-original",ids:["r55-shelby-original"],name:"Fort Shelby Hotel · original building",nameZh:"Fort Shelby Hotel · original building",kind:"hotel55",from:1918,through:2026,body:34,height:35,floors:10,bays:11,facing:[-.51,-.86],sources:["shelby-original"]},{id:"shelby-tower",entity:"shelby-tower",ids:["r55-shelby-tower"],name:"Fort Shelby Hotel · 1927 Kahn tower",nameZh:"Fort Shelby Hotel · 1927 Kahn tower",kind:"hotel55",from:1927,through:2026,body:70,height:72,floors:21,bays:9,facing:[-.51,-.86],sources:["shelby-tower"]}]);Object.assign(t,{leland:{label:"Detroit–Leland Hotel · 400 Bagley · history and archival images",url:"https://historicdetroit.org/buildings/leland-hotel"},"shelby-original":{label:"Fort Shelby Hotel · original building · history and archival images",url:"https://historicdetroit.org/buildings/fort-shelby-hotel"},"shelby-tower":{label:"Fort Shelby Hotel · 1927 Kahn tower · history and archival images",url:"https://historicdetroit.org/buildings/fort-shelby-hotel"}});Object.assign(n,{leland:["Opened 20 April 1927; 20 storeys, brick and terra-cotta frontage. The inventory’s 1936 / 14-storey fields conflict with the building history and exterior image. Model bays, rusticated base, tall lobby arches and cornice follow archival images, with unmeasured proportions. The 1940s image is a later reference for 1927–1939; rooftop lettering and unverified later additions are omitted. A proposed 2018 redevelopment is not modeled as completed.","1927 年 4 月 20 日启用，20 层、砖与陶土饰面；底图的 1936 年／14 层字段与建筑史、外观图片冲突。模型依据档案图片表现窗跨、粗面基座、高拱窗和檐口，尺寸为比例推估。1940 年代照片用于较早阶段时标为后期参考；不复原年代不明的屋顶字牌，也不将 2018 年改造方案画成已完成。"],"shelby-original":["Original ten-storey block opened 6 June 1918; inventory lists 1916 and some project histories give 1917. The construction interval preserves these distinctions. A pre-tower archival image guides the paired windows, corner quoins, base and upper decorative band. The separate 1927 tower is absent in earlier years. Closure in 1974 was not demolition; reopening in December 2008 is recorded without inventing facade alteration dates.","原十层主体于 1918 年 6 月 6 日启用；底图记为 1916 年，另有项目史记为 1917 年，保留建造与启用的差别。加塔前档案照片支持成对窗、转角隅石、基座和上部饰带。1927 年塔楼单独建模，较早年份不出现。1974 年停业不等于拆除；2008 年 12 月重开单独记载，不据此虚构立面改造日期。"],"shelby-tower":["Albert Kahn tower added in 1927, independently from the 1918 hotel block. History counts 21 storeys; the inventory counts 22, likely a counting difference that remains unresolved. Archival imagery guides the window rhythm, contrasting upper floors, cornice and centered parapet; absolute height and rear details are inferred. The hotel’s 1974 closure and 2008 reopening do not remove the standing tower.","Albert Kahn 塔楼建于 1927 年，与 1918 年主体分别呈现。建筑史计 21 层、底图计 22 层，计数差异尚未解决。档案图片支持窗格、上部对比饰面、檐口和中央女儿墙；绝对高度与背面细节为推估。1974 年停业和 2008 年重开不会让仍存塔楼消失。"]});o.unshift(...[{id:"cass3401",entity:"cass3401",ids:["r56-cass3401"],name:"3401 Cass Avenue",nameZh:"3401 Cass Avenue",kind:"street56",from:1955,through:2026,body:5.5,height:5.7,floors:1,bays:4,facing:[.9219,-.3875],sources:["cass3401"]},{id:"burton3420",entity:"burton3420",ids:["r56-burton3420"],name:"Burton School · 3420 Cass",nameZh:"Burton School · 3420 Cass",kind:"street56",from:1913,through:2026,body:11.9,height:14.9,floors:3,bays:7,facing:[-.9219,.3875],sources:["burton3420"]},{id:"cass3107",entity:"cass3107",ids:["r56-cass3107"],name:"3107 Cass Avenue · former Charlotte Lounge",nameZh:"3107 Cass Avenue · former Charlotte Lounge",kind:"street56",from:1923,through:2023,body:4.35,height:4.95,floors:1,bays:2,facing:[.9219,-.3875],sources:["cass3107"]},{id:"watson78",entity:"watson78",ids:["r56-watson78"],name:"78 Watson Street · 78–94 Watson",nameZh:"78 Watson Street · 78–94 Watson",kind:"street56",from:1912,through:2026,body:26,height:26.7,floors:7,bays:9,facing:[-.5,-.866],sources:["watson78"]}]);Object.assign(t,{cass3136:{label:"cass3136 · building history / dated exterior reference",url:"https://www.google.com/maps/@42.3441924,-83.0599302,3a,75y,127.44h,90t/data=!3m8!1e1!3m6!1sjCheokb773XEXd_WfPX_3A!2e0!5s20260701T000000!7i16384!8i8192"},woodstock:{label:"woodstock · building history / dated exterior reference",url:"https://www.google.com/maps/@42.3440246,-83.0609392,3a,75y,201.69h,90t/data=!3m8!1e1!3m6!1sgwCJ1PM1KJ6vsQttKwsqkg!2e0!5s20241101T000000!7i16384!8i8192"},"cass3107-standing":{label:"cass3107-standing · building history / dated exterior reference",url:"https://www.google.com/maps/@42.3431915,-83.0593227,3a,75y,255.08h,90t/data=!3m8!1e1!3m6!1slWHnL8zAvVsvDcdYT8jTOA!2e0!5s20230901T000000!7i16384!8i8192"},"cass3107-absent":{label:"cass3107-absent · building history / dated exterior reference",url:"https://www.google.com/maps/@42.3432158,-83.0593356,3a,75y,255.08h,90t/data=!3m8!1e1!3m6!1stuuUD-g_CrGxaFnPS7kihQ!2e0!5s20241101T000000!7i16384!8i8192"},cass3401:{label:"cass3401 · building history / dated exterior reference",url:"https://www.iconictattoodetroit.com/about"},burton3420:{label:"burton3420 · building history / dated exterior reference",url:"https://detroit1701.org/Burton%20School.html"},"burton-photo":{label:"burton-photo · building history / dated exterior reference",url:"https://detroithistorical.wordpress.com/2011/11/08/back-to-school/"},"burton-theatre":{label:"burton-theatre · building history / dated exterior reference",url:"https://burtontheatre.com/"},watson78:{label:"watson78 · building history / dated exterior reference",url:"https://www.zillow.com/homedetails/78-Watson-St-Detroit-MI-48201/304759320_zpid/"},"woodstock-record":{label:"woodstock-record · building history / dated exterior reference",url:"https://www.apartmentfinder.com/Michigan/Detroit-Apartments/Woodstock-Apartments-jnt7mz5"},"woodstock-living":{label:"woodstock-living · building history / dated exterior reference",url:"https://www.apartmenthomeliving.com/apartment-finder/Woodstock-Apartments-Detroit-MI-48201-1880044"},cass3107:{label:"cass3107 · building history / dated exterior reference",url:"https://www.loopnet.com/property/3107-cass-ave-detroit-mi-48201/26163-02002256/"},"cass3107-history":{label:"cass3107-history · building history / dated exterior reference",url:"https://motorcitymuckraker.com/2016/01/19/photos-50-vacant-cass-corridor-buildings-whose-fate-likely-will-be-determined-in-2016/"}});Object.assign(n,{cass3136:["Completed 1920; the user’s architectural-history lead describes 1919–1920 construction for Kahn Realty by Albert Kahn. That attribution has not been independently verified from the inaccessible Facebook post. July 2026 Street View supports the two street elevations, projecting piers, recessed panels, green window bands, brick infill and dentil cornice. The same model is used in 1920–2026; dimensions are proportional, not surveyed.","1920 年完工；用户提供的建筑史线索记载 1919–1920 年由 Albert Kahn 为 Kahn Realty 设计建造，Facebook 原帖目前无法独立核验。2026 年 7 月街景支持两面临街立面、凸出柱墩、凹板、绿色窗带、砖砌封堵与檐口齿饰。1920–2026 年使用同一模型，尺寸为比例推估。"],woodstock:["Built/opened in 1914. ApartmentFinder lists four storeys and 80 units; November 2024 Street View shows three principal floors above a raised basement. Twin brick buildings, grouped front windows, long side window rows, cornice and shaped parapets are modeled from that view. Proposed renovation is not treated as completed construction.","1914 年建成／启用。ApartmentFinder 记四层、80 套；2024 年 11 月街景显示抬高半地下层以上的三层主体。模型补充双栋砖楼、正面成组窗、长侧墙窗列、檐口和曲线女儿墙。拟议修缮不作为已完成工程。"],cass3401:["The model begins in 1955 as instructed, matching the inventory. The tenant’s official history instead reports 1924; this remains an unresolved construction-date conflict. Its exterior photograph guides the one-storey corner storefront, stone piers, high transoms and decorated parapet. Iconic opened in September 2015; the modern tenant lettering is not projected into earlier years.","按用户指定与底图记载，自 1955 年启用模型。现商户官网另记 1924 年，保留建造年代冲突。官网外观照片支持单层转角店面、石饰柱、上部横窗与装饰女儿墙。Iconic 于 2015 年 9 月开业，不将现代商号文字回推到早年。"],burton3420:["Ren Farley’s building history dates Burton School to 1913, conflicting with the inventory’s 1966 field. Steve Shaw’s 1983 exterior photograph supports two classroom floors above a basement, tall grouped windows, brick corner walls and chimneys. Burton Theatre opened in autumn 2009 and closed in 2011; Cinema Detroit used this site in 2013–2015. Later whole-building abandonment is unverified. Closure does not remove the standing structure.","Ren Farley 建筑史记 Burton School 建于 1913 年，与底图 1966 年字段冲突。Steve Shaw 的 1983 年外观照支持半地下层之上的两层教室、成组高窗、砖砌转角墙与烟囱。Burton Theatre 于 2009 年秋开业、2011 年关闭；Cinema Detroit 于 2013–2015 年使用此址。之后整栋废弃尚未核实，停业不等于拆除。"],cass3107:["The user-supplied LoopNet construction year and inventory both give 1923. The former Charlotte Lounge is visibly standing in September 2023 Street View and absent in November 2024; removal is bounded between these captures, not assigned an invented exact date. The historical model retains its low brick shell, pilasters, parapet and boarded openings; it is removed by the end-of-2024 scene.","用户提供的 LoopNet 建造年份与底图均为 1923 年。原 Charlotte Lounge 在 2023 年 9 月街景仍存，2024 年 11 月已为空地；拆除限定在两次拍摄之间，不虚构具体日期。历史模型表现低层砖砌主体、柱墩、女儿墙与封板开口；2024 年末场景起移除体量。"],watson78:["Zillow and the inventory report 1912 construction. The 78–94 Watson inventory is a seven-storey building, not the single floor of a listed unit. Listing exterior photographs guide the paired brick wings, pale bay-window surrounds, recessed balcony stack, raised base, twin entrances and cornice. Photograph exposure dates are unknown; unit remodeling does not reset the building’s model start.","Zillow 与底图均记载 1912 年建造。78–94 Watson 为七层建筑，不能把房源中单套公寓的一层描述当成整栋高度。外观照支持双侧砖砌楼翼、浅色凸窗边框、中央阳台列、抬高基座、双入口与檐口。照片拍摄日未知，单元装修不重置模型的起始年份。"]});const s=["One detailed reference model is carried continuously from the recorded construction period through the building’s standing life. Photograph capture, publication and review dates do not delay detail. Present finishes are a modeling reference, not evidence of their original installation date. Independently dated additions and demolition remain separate.","同一套细化参考模型从有记录的建造时期连续显示至建筑存续结束；照片拍摄、刊发和核查日期不再限制细化开始年份。现状饰面用于模型参照，不代表其原始安装年代；有独立证据的加建与拆除仍分期处理。"];for(const e of o){if(e.through===2026){delete e.photoFrom;if(e.id==="fort-church")e.from=1855;if(e.id==="holy-trinity")e.from=1866;if(e.id==="chungs-restored")e.from=1963}}for(const e of["fort-church","holy-trinity"])n[e]=[n[e][0].replace(/Detailed reference begins[\s\S]*$|Earlier phases remain base masses\./,""),n[e][1].replace(/细化外观从[\s\S]*$|更早阶段保留基础体量。/,"")];n["chungs-restored"]=["The surviving red roof and glazed frontage are carried from the listing’s 1963 construction field through 2026. A 1921 envelope is separately retained as earlier evidence. The documented 2023–2025 renovation updates the history without suppressing facade detail.","按房源 1963 年建造字段至 2026 年连续呈现现存红顶与玻璃店面；1921 年地图轮廓作为更早证据另行保留。2023–2025 年修缮记入历史，不让立面细化消失。"];n.cass2930=["2930 Cass Avenue was built in 1915 for Riesterer’s drugstore and ten upstairs apartments. Bruce Harkness’s photograph, posted 22 March 2024 with an unknown capture date, shows the right-to-left sign 余風采堂. Ryan Loo identifies the Detroit Yee Fung Toy surname-association hall; Kyle Joe Hicks recalls old mail addressed to the organization. These are community testimonies corroborating the visible sign, not verified occupancy dates. The national association’s indexed official history lists a Detroit branch but does not independently establish this street address. Google Street View, July 2025, shows the same building with the four sign plaques absent. Exact association arrival/departure dates and specific Chinese residential households remain unknown. The model starts in 1915; this is not the association’s start date. The chapter’s own About Us page supplies organizational history but no exact founding year or Cass occupancy dates; its event pages document continued activity through 2026. A separate one-storey neighbor with Golden Dragon Restaurant and Chinese Vegetable Co. signs appears in the supplied photograph captioned 1976. Those storefronts are not part of this three-storey building; exact neighbor address and demolition date are unresolved.","2930 Cass 建于 1915 年，底层为 Riesterer 药店，上层十套公寓。Bruce Harkness 于 2024 年 3 月 22 日发布的历史照片（拍摄日期未知）显示由右向左的「余風采堂」招牌。Ryan Loo 将此楼识别为底特律余氏宗亲会会址，Kyle Joe Hicks 回忆曾见寄给该组织的旧邮件；这些社区证言与招牌相互支持，但不确定使用年代。总堂官方历史的搜索索引列有底特律分堂，不能独立证明该门牌。2025 年 7 月街景确认同栋建筑仍存，四块字牌已不见。迁入、迁出及具体华人住户和居住年代未知。模型自 1915 年显示，不代表宗亲会自该年使用。 分堂自己的 About Us 提供组织自述，未给出精确成立年或 Cass 会址使用年代；活动页确认组织活动延续至 2026 年。 用户提供的标注 1976 年照片显示旁侧独立单层 Golden Dragon Restaurant 与 Chinese Vegetable Co. 商铺，不能并入本楼三层主体；邻楼门牌及拆除年代未知。"];for(const e of o){if(e.id==="cass2930"){e.name="2930 Cass · former Yee Fung Toy hall";e.nameZh="2930 Cass · 原余風采堂"}}o.push({id:"cass-neighbor1976",ids:["r57-cass-neighbor1976"],entity:"cass-neighbor1976",name:"Golden Dragon / Chinese Vegetable Co. · 1976",nameZh:"1976 单层商铺 · Golden Dragon / 菜庄",kind:"cass-neighbor1976",from:1976,through:1976,height:4.4,body:4.1,floors:1,bays:4,facing:[-.91926,.39364],sources:[],color:"#aaa9a4"});n["cass-neighbor1976"]=["User-supplied photograph bears the caption 1976. The user identifies the left three-storey building as 2930 Cass. The separate one-storey building on its right carries Golden Dragon Restaurant and a Chinese Vegetable Co. sign, provisionally read as WING LEE LUNG. The photograph supports presence in the captioned year, not opening, construction or demolition dates. Photographer, original archive and exact storefront addresses are unknown. Footprint placement beside the south side of 2930, depth, dimensions and grayscale finishes are approximate; the photo is not a survey. The model is limited to 1976 as an observation, not a claim that it existed for only one year.","用户提供照片，图注为 1976。用户指出左侧三层楼为 2930 Cass；右侧为独立单层商铺，可辨 Golden Dragon Restaurant、Chinese Vegetable Co.，后一店名暂读 WING LEE LUNG，仍待核对。照片支持图注年份存在，不确定开业、建造及拆除年代。摄影者、原始馆藏和商铺门牌未知。沿 2930 南侧定位、进深、尺寸与灰度饰面为近似参考，非测绘复原。模型仅在 1976 观测年显示，不代表建筑只存在一年。"];o.push(...[{id:"templebar59",entity:"templebar59",ids:["r59-templebar59"],name:"2906 Cass Avenue, the Temple Bar",nameZh:"2906 Cass Avenue, the Temple Bar",kind:"casspark59",from:1925,through:2026,body:4.25,height:5.35,floors:1,bays:6,facing:[-.92,.39],base:0,color:"#8e3e3e",sources:["2906C"]},{id:"vernon59",entity:"vernon59",ids:["r16-wilburne"],name:"487 Charlotte, Vernon Murphy Apartments",nameZh:"487 Charlotte, Vernon Murphy Apartments",kind:"casspark59",from:1916,through:2026,body:11.4,height:12.5,floors:3,bays:3,facing:[-.39,-.92],base:1,color:"#87765f",sources:["487C"]},{id:"mariners59",entity:"mariners59",ids:["r59-mariners59"],name:"445 Ledyard, Mariners Inn",nameZh:"445 Ledyard, Mariners Inn",kind:"casspark59",from:1955,through:2026,body:7.6,height:8.7,floors:2,bays:5,facing:[-.39,-.92],base:1,color:"#9e7b54",sources:["445L"]},{id:"avery59",entity:"avery59",ids:["r16-avery"],name:"457 Ledyard, John H. Avery House",nameZh:"457 Ledyard, John H. Avery House",kind:"casspark59",from:1878,through:2026,body:12.1,height:13.2,floors:3,bays:3,facing:[-.39,-.92],base:1,color:"#9b5845",sources:["457L"]},{id:"chronicle59",entity:"chronicle59",ids:["r16-chronicle"],name:"479 Ledyard, Michigan Chronicle",nameZh:"479 Ledyard, Michigan Chronicle",kind:"casspark59",from:1936,through:2026,body:8,height:9.1,floors:2,bays:6,facing:[-.39,-.92],base:1,color:"#a69d86",sources:["479L"]},{id:"casspark59",entity:"casspark59",ids:["r16-cass-park-apartments"],name:"2714 Second Avenue, Cass Park Apartments",nameZh:"2714 Second Avenue, Cass Park Apartments",kind:"casspark59",from:1914,through:2026,body:15,height:16.1,floors:4,bays:3,facing:[-.92,.39],base:1,color:"#854e3f",sources:["2714S"]},{id:"ansonia59",entity:"ansonia59",ids:["r16-ansonia"],name:"2900-23 Second Avenue, Ansonia Flats / Ansonia Apartments",nameZh:"2900-23 Second Avenue, Ansonia Flats / Ansonia Apartments",kind:"casspark59",from:1908,through:2026,body:15.3,height:16.400000000000002,floors:4,bays:9,facing:[.92,-.39],base:1,color:"#b59d70",sources:["2900S"]},{id:"boulevard59",entity:"boulevard59",ids:["r16-boulevard"],name:"2931-33 Second Avenue, Boulevard Hotel",nameZh:"2931-33 Second Avenue, Boulevard Hotel",kind:"casspark59",from:1924,through:2026,body:11.3,height:12.4,floors:3,bays:5,facing:[.92,-.39],base:1,color:"#765849",sources:["2931S"]},{id:"cromwell59",entity:"cromwell59",ids:["r16-cromwell"],name:"2942 Second Avenue, Cromwell Flats / Cromwell Apartments",nameZh:"2942 Second Avenue, Cromwell Flats / Cromwell Apartments",kind:"casspark59",from:1904,through:2026,body:11.8,height:12.9,floors:3,bays:4,facing:[-.92,.39],base:1,color:"#84634f",sources:["2942S"]},{id:"altadena59",entity:"altadena59",ids:["r16-altadena"],name:"2952-58 Second Avenue, Altadena Apartments",nameZh:"2952-58 Second Avenue, Altadena Apartments",kind:"casspark59",from:1911,through:2026,body:15.3,height:16.400000000000002,floors:4,bays:6,facing:[-.92,.39],base:1,color:"#91634d",sources:["2952S"]},{id:"manhattan59",entity:"manhattan59",ids:["r16-manhattan"],name:"2966-72 Second Avenue, Manhattan Apartments",nameZh:"2966-72 Second Avenue, Manhattan Apartments",kind:"casspark59",from:1905,through:2026,body:15.3,height:16.400000000000002,floors:4,bays:5,facing:[-.92,.39],base:1,color:"#88604f",sources:["2966S"]},{id:"embassy59",entity:"embassy59",ids:["r59-embassy59"],name:"100-112 Temple, Alhambra Flats / The Embassy",nameZh:"100-112 Temple, Alhambra Flats / The Embassy",kind:"casspark59",from:1895,through:2026,body:22.2,height:23.3,floors:6,bays:7,facing:[.39,.92],base:1,color:"#a78475",sources:["112T"]},{id:"alden59",entity:"alden59",ids:["r59-alden59"],name:"145 Temple, The Alden",nameZh:"145 Temple, The Alden",kind:"casspark59",from:1922,through:2026,body:12,height:13.1,floors:3,bays:7,facing:[-.39,-.92],base:1,color:"#bab3a2",sources:["145T"]},{id:"temple14659",entity:"temple14659",ids:["r59-temple14659"],name:"146-166 Temple",nameZh:"146-166 Temple",kind:"casspark59",from:1923,through:2026,body:11.6,height:12.7,floors:3,bays:7,facing:[.39,.92],base:1,color:"#a8a495",sources:["146T"]},{id:"whitegrove59",entity:"whitegrove59",ids:["r59-whitegrove"],name:"White Grove Restaurant · 3131 Second",nameZh:"White Grove Restaurant · 3131 Second",kind:"casspark59",from:1953,through:2026,body:3.7,height:4.3,floors:1,bays:3,base:0,facing:[-.92,.39],color:"#b8bbaa",sources:["whitegrove"]}]);Object.assign(n,{templebar59:["Glass-block frontage; red enamel-panel fascia. 1925 construction / 1941 remodeling are reported by Wikipedia; inventory says 1935. Exact construction remains disputed; model provisionally begins 1925. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","Glass-block frontage; red enamel-panel fascia. 1925 construction / 1941 remodeling are reported by Wikipedia; inventory says 1935. Exact construction remains disputed; model provisionally begins 1925. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],vernon59:["Three principal floors above a raised base; central arched entry, grouped windows, quoins and bracketed eaves. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","Three principal floors above a raised base; central arched entry, grouped windows, quoins and bracketed eaves. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],mariners59:["1955 two-storey Mariners Inn, Charles Vogel. Horizontal windows and stone entry panel. Model isolates the original Ledyard frontage; it is not the whole later campus. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1955 two-storey Mariners Inn, Charles Vogel. Horizontal windows and stone entry panel. Model isolates the original Ledyard frontage; it is not the whole later campus. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],avery59:["1878 house; third floor added approximately 1900–1910. Paired polygonal bays and bracketed cornice. Upper floor introduced in 1910; earlier state simplified. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1878 house; third floor added approximately 1900–1910. Paired polygonal bays and bracketed cornice. Upper floor introduced in 1910; earlier state simplified. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],chronicle59:["1936 film exchange; later Michigan Chronicle offices. Two-storey limestone frontage, fluted piers and broad window groups. Newspaper move-in date not independently established. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1936 film exchange; later Michigan Chronicle offices. Two-storey limestone frontage, fluted piers and broad window groups. Newspaper move-in date not independently established. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],casspark59:["1914 apartments; four principal floors above basement, four-tier central portico and projecting cornice. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1914 apartments; four principal floors above basement, four-tier central portico and projecting cornice. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],ansonia59:["1908 Ansonia; bow-window facade and projecting cornice. Address range 2900–23 in the page heading conflicts with 2909–23 used elsewhere. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1908 Ansonia; bow-window facade and projecting cornice. Address range 2900–23 in the page heading conflicts with 2909–23 used elsewhere. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],boulevard59:["1924 Boulevard Hotel; three floors above basement, five facade bays and shaped gables. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1924 Boulevard Hotel; three floors above basement, five facade bays and shaped gables. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],cromwell59:["1904 Cromwell per building description; 1905 appears in a narrative. Paired polygonal window bays, alternating trim bands and central arches. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1904 Cromwell per building description; 1905 appears in a narrative. Paired polygonal window bays, alternating trim bands and central arches. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],altadena59:["1911 Altadena; four floors above basement, twin upper projecting bays, metal panels and cornice. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1911 Altadena; four floors above basement, twin upper projecting bays, metal panels and cornice. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],manhattan59:["1905 Manhattan; four floors above basement, two projecting bay stacks and crenellated parapet. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1905 Manhattan; four floors above basement, two projecting bay stacks and crenellated parapet. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],embassy59:["1895 Alhambra / Embassy; six floors, rounded bays, heavy lower stonework and recessed porches. Report credits J. R. Gentle; competing attribution retained in earlier record. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1895 Alhambra / Embassy; six floors, rounded bays, heavy lower stonework and recessed porches. Report credits J. R. Gentle; competing attribution retained in earlier record. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],alden59:["1922 Alden; limestone facade, arched first-floor windows, ornate central portal and balustraded parapet. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1922 Alden; limestone facade, arched first-floor windows, ornate central portal and balustraded parapet. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],temple14659:["1923 Lasky commercial building at Temple / Cass; seven bays along Temple, three floors, grouped windows and pilasters. Matched to the 2900 Cass inventory footprint; inventory 1935 field conflicts. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates.","1923 Lasky commercial building at Temple / Cass; seven bays along Temple, three floors, grouped windows and pilasters. Matched to the 2900 Cass inventory footprint; inventory 1935 field conflicts. Reference facade carried through the documented standing life. Unmeasured dimensions and unseen elevations are interpretations; modern finishes do not establish their original installation dates."],whitegrove59:["3131 Second: Standard Oil station documented in local research by 1921; White Grove restaurant by 1948, closed around 2013, reopening reported June 2026. Inventory construction field is 1953, conflicting with earlier restaurant presence; model starts provisionally 1953. Earlier gas-station form is not asserted. Frieda, Helen Turner and Linwood Martin appear in the local research; operating intervals are unresolved.","3131 Second: Standard Oil station documented in local research by 1921; White Grove restaurant by 1948, closed around 2013, reopening reported June 2026. Inventory construction field is 1953, conflicting with earlier restaurant presence; model starts provisionally 1953. Earlier gas-station form is not asserted. Frieda, Helen Turner and Linwood Martin appear in the local research; operating intervals are unresolved."]});Object.assign(t,{"2906C":{label:"2906 Cass Avenue, the Temple Bar · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2906C"},"2930C":{label:"2930 Cass Avenue, Riesterer Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2930C"},"2949C":{label:"2949 Cass Avenue · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2949C"},"487C":{label:"487 Charlotte, Vernon Murphy Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#487C"},"445L":{label:"445 Ledyard, Mariners Inn · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#445L"},"457L":{label:"457 Ledyard, John H. Avery House · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#457L"},"479L":{label:"479 Ledyard, Michigan Chronicle · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#479L"},"2714S":{label:"2714 Second Avenue, Cass Park Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2714S"},"2727S":{label:"2727 Second Avenue, S.S. Kresge Company / Metropolitan Center for High Technology / The Block at Cass Park · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2727S"},"2900S":{label:"2900-23 Second Avenue, Ansonia Flats / Ansonia Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2900S"},"2931S":{label:"2931-33 Second Avenue, Boulevard Hotel · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2931S"},"2942S":{label:"2942 Second Avenue, Cromwell Flats / Cromwell Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2942S"},"2952S":{label:"2952-58 Second Avenue, Altadena Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2952S"},"2966S":{label:"2966-72 Second Avenue, Manhattan Apartments · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#2966S"},"112T":{label:"100-112 Temple, Alhambra Flats / The Embassy · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#112T"},"145T":{label:"145 Temple, The Alden · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#145T"},"146T":{label:"146-166 Temple · Jeff Bondono / designation report",url:"https://www.jeffbondono.com/DetroitHistoricDistricts/CassPark/#146T"},"400T":{label:"400-426 Temple, Fort Wayne Hotel / American Hotel · Jeff Bondono / 