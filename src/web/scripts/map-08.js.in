/* Two separate inventory envelopes, one parcel. Photographs describe form, not birth. */
const CassHousesArchitecture94=(()=>{
 const ids=new Set(['semcog-8900602','semcog-8135000']),old={profile:LandmarkArchitecture.profile,apply:LandmarkArchitecture.apply,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note};
 function profile(b,y){if(!ids.has(b.id))return old.profile(b,y);if(y<1880||y>=2016)return null;const p=old.profile(b,y);return {...p,north:b.id==='semcog-8135000',sceneYear:y,phaseKey:y>=2014?'vacant-photo-reference':'construction-reference',vacant:y>=2014};}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.apply=(b,y)=>{if(!ids.has(b.id))return old.apply(b,y);const p=profile(b,y);return p?{...b,height:p.height,landmarkArchitecture:p,geometryRevision:(b.geometryRevision||b.id)+'|house94|'+p.phaseKey,referenceGeometry:true,height_basis:'Three visible facade levels; proportional height estimate, not surveyed.'}:b;};
 LandmarkArchitecture.note=(p,zh)=>p.kind!=='houses94'?old.note(p,zh):(zh?'3113 与 3117 是同一地块内的两栋住宅。清册均记 1880 年建造、2016 年拆除；细部从建造年起显示。红砖、凸窗、拱窗、折坡屋顶及尖山墙依据晚期照片推估。1880 年原貌没有直接照片证据；南栋完整屋顶为参考复原。2014 年起显示照片中的空置状态，具体开始时间未知。高度、窗距及背面简化；拆除日未确认。':'3113 and 3117 are separate houses on one parcel. Inventory reports construction in 1880 and demolition in 2016; detail begins at construction. Brickwork, projecting bays, arched openings, mansard-like roofs and pointed dormers follow late photographs. The exact 1880 elevation is unverified; the southern roof is an interpretive intact reconstruction. A vacant-photo phase begins with the 2014 listing evidence, not a verified abandonment date. Heights, openings and rear elevations are approximate; demolition day is unresolved.');
 function build({THREE,rings,building,profile:p,appearance,detail=true}){
  const f=LandmarkArchitecture.frame(rings[0],p);f.ux=-f.ux;f.uz=-f.uz;
  const w=f.w,v=[],colors=[],cache=new Map(),brick='#854735',trim='#9e654d',stone='#aba48d',dark='#27312e',roof='#626f61',H=7.2,top=10.0;
  const pt=(u,y,d=0)=>[f.x+f.ux*u+f.nx*d,y,f.z+f.uz*u+f.nz*d];
  function tri(a,b,c,color){v.push(...a,...b,...c);if(!cache.has(color))cache.set(color,new THREE.Color(color));const q=cache.get(color);for(let i=0;i<3;i++)colors.push(q.r,q.g,q.b);}
  const quad=(a,b,c,d,col)=>{tri(a,b,c,col);tri(a,c,d,col);};
  const panel=(l,r,b,t,col,d=.025)=>quad(pt(l,b,d),pt(l,t,d),pt(r,t,d),pt(r,b,d),col);
  const ring=rings[0].slice();if(Math.hypot(ring[0].x-ring.at(-1).x,ring[0].z-ring.at(-1).z)<.01)ring.pop();
  const outline=ring.map(q=>[(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,(q.x-f.x)*f.nx+(q.z-f.z)*f.nz]);
  for(let i=0;i<outline.length;i++){const a=outline[i],b=outline[(i+1)%outline.length];if(Math.abs(a[1])<.08&&Math.abs(b[1])<.08)continue;quad(pt(a[0],0,a[1]),pt(a[0],top,a[1]),pt(b[0],top,b[1]),pt(b[0],0,b[1]),'#784735');}
  const roofOutline=[];for(let i=0;i<outline.length;i++){const a=outline[i],b=outline[(i+1)%outline.length],inside=a[1]<=-1.05,next=b[1]<=-1.05;if(inside)roofOutline.push(a);if(inside!==next){const t=(-1.05-a[1])/(b[1]-a[1]);roofOutline.push([a[0]+(b[0]-a[0])*t,-1.05]);}}
  const center=roofOutline.reduce((a,b)=>[a[0]+b[0]/roofOutline.length,a[1]+b[1]/roofOutline.length],[0,0]);
  for(let i=0;i<roofOutline.length;i++){const a=roofOutline[i],b=roofOutline[(i+1)%roofOutline.length];tri(pt(center[0],top-.12,center[1]),pt(a[0],top-.12,a[1]),pt(b[0],top-.12,b[1]),'#596254');}
  // Segmented projecting bay: real openings in the facade rather than painted panels on a box.
  const front=[[-w/2,0],[-w*.43,.12],[-w*.29,.91],[-w*.05,.91],[w*.08,.10],[w/2,0]];
  function facade(a,b,lo,hi,holes,col){
   const dx=b[0]-a[0],dd=b[1]-a[1],len=Math.hypot(dx,dd),P=(x,y,o=0)=>pt(a[0]+dx*x/len+dd*o/len,y,a[1]+dd*x/len-dx*o/len);
   const rect=(l,r,bot,t,color,o=0)=>quad(P(l,bot,o),P(l,t,o),P(r,t,o),P(r,bot,o),color);
   const cuts=[0,len,...holes.flatMap(h=>[h.l,h.r])].sort((x,y)=>x-y);
   for(let j=0;j<cuts.length-1;j++){let bottom=lo;const x=(cuts[j]+cuts[j+1])/2;for(const h of holes.filter(h=>x>h.l&&x<h.r).sort((a,b)=>a.b-b.b)){if(h.b>bottom)rect(cuts[j],cuts[j+1],bottom,h.b,col);bottom=h.t;}if(bottom<hi)rect(cuts[j],cuts[j+1],bottom,hi,col);}
   if(detail)for(let y=lo+.25;y<hi;y+=.28){const active=holes.filter(h=>y>h.b&&y<h.t);let l=0;for(const h of active.sort((a,b)=>a.l-b.l)){if(h.l>l)rect(l,h.l,y,y+.011,'#764a39',-.016);l=h.r;}if(l<len)rect(l,len,y,y+.011,'#764a39',-.016);}
   for(const h of holes){
    const mid=(h.l+h.r)/2,rad=(h.r-h.l)/2,cy=h.arch?h.t-rad:h.t;
    rect(h.l,h.r,h.b,cy,p.vacant?'#222a26':'#415150',.07);
    if(h.arch){for(let k=0;k<8;k++){const a=k*Math.PI/8,b=(k+1)*Math.PI/8,A=[mid+rad*Math.cos(a),cy+rad*Math.sin(a)],B=[mid+rad*Math.cos(b),cy+rad*Math.sin(b)];tri(P(mid,cy,.07),P(A[0],A[1],.07),P(B[0],B[1],.07),dark);quad(P(A[0],A[1]),P(A[0],h.t),P(B[0],h.t),P(B[0],B[1]),col);quad(P(A[0],A[1],-.035),P(mid+(rad+.10)*Math.cos(a),cy+(rad+.10)*Math.sin(a),-.035),P(mid+(rad+.10)*Math.cos(b),cy+(rad+.10)*Math.sin(b),-.035),P(B[0],B[1],-.035),trim);}}
    if(detail){rect(h.l-.045,h.l,h.b,cy,stone,-.045);rect(h.r,h.r+.045,h.b,cy,stone,-.045);rect(h.l-.07,h.r+.07,h.b-.065,h.b+.035,stone,-.065);if(!h.door){rect(mid-.022,mid+.022,h.b,cy,'#a5a797',.045);rect(h.l,h.r,h.b+(cy-h.b)*.52,h.b+(cy-h.b)*.52+.045,'#a5a797',.045);}if(p.vacant&&h.b<2.0)rect(h.l+.035,h.r-.035,h.b+.035,cy-.035,'#75755d',.025);}
   }
   return len;
  }
  for(let i=0;i<front.length-1;i++){
   const a=front[i],b=front[i+1],len=Math.hypot(b[0]-a[0],b[1]-a[1]);let holes=[];
   if(i>=1&&i<=3){const ww=Math.min(len*.65,.98),l=(len-ww)/2;holes=[{l,r:l+ww,b:.9,t:3.4,arch:true},{l,r:l+ww,b:4.25,t:6.66}];}
   if(i===4){const ww=Math.min(1.03,len*.6),l=(len-ww)/2;holes=[{l,r:l+ww,b:.6,t:3.1,arch:true,door:true},{l,r:l+ww,b:4.2,t:6.63}];}
   facade(a,b,0,H,holes,brick);
   // String course follows all facets of the bay.
   facade(a,b,3.66,3.83,[],trim);facade(a,b,6.98,7.16,[],stone);
  }
  const towerL=p.north?w*.08:-w/2,towerR=p.north?w/2:w*.03,roofL=p.north?-w/2:w*.03,roofR=p.north?w*.08:w/2;
  const towerWidth=towerR-towerL,winW=Math.min(1.2,towerWidth*.50),winL=(towerWidth-winW)/2;
  const towerD=p.north?.075:.91;
  facade([towerL,towerD],[towerR,towerD],H,top,[{l:winL,r:winL+winW,b:7.62,t:9.34}],brick);
