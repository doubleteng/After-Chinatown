/* Standard Accident: three transverse wings and recessed light courts.
   Footprint: SEMCOG 2024; upper courts interpreted from 2023/2025 photographs.
   Existing construction-date uncertainty and one-mesh near/far pipeline retained. */
const StandardArchitecture76=(()=>{
 const reference={"id":"semcog-8133511","polygon":[[-83.06147208672623,42.34104588689749],[-83.06189827407509,42.3409115385999],[-83.061991868981,42.341076727855686],[-83.06188206013707,42.34111110603414],[-83.06189614563176,42.341135886852065],[-83.06200591900307,42.34110152355863],[-83.06208751644148,42.34124553413961],[-83.06197862010681,42.34127961946831],[-83.06199605627191,42.341309359507214],[-83.06210445421256,42.341275429604096],[-83.06216934244787,42.34138995066612],[-83.06174581694441,42.34152300072332],[-83.06168022650036,42.34140848484278],[-83.0617861737657,42.341375278895384],[-83.06175062806973,42.341313820919886],[-83.06164468037082,42.34134652890438],[-83.06158098046318,42.34123501234167],[-83.06168626358425,42.34120180695578],[-83.06165272963747,42.34114282478419],[-83.0615467826955,42.341176030607095]],"center":[-83.06182630027723,42.34121373593002],"source_year":2024,"source_url":"https://www.arcgis.com/home/item.html?id=c9bd1139cb15497084c328315a2c0c84","geometry_basis":"SEMCOG building-footprint inventory; shape from dated aerial mapping. Original survey registration uncertainty retained."};
 const url='https://historicdetroit.org/galleries/standard-accident-insurance-co-building-photos';
 const oldURL='https://historicdetroit.org/galleries/standard-accident-insurance-co-building-old-photos';
 const notes=[
  'Three parallel eight-storey wings, joined by a recessed central spine, with two light-court recesses on each side. The display footprint uses the 2024 SEMCOG outline; upper-wing divisions and low infill are interpreted from the 2023 and 9 August 2025 photographs. Seven Temple Street bays, a two-storey base, paired upper windows and the stepped cornice follow the early DPL photograph and designation report. Temple-facing entrance corrected. Court dimensions, height and unseen details remain proportional, not surveyed. The 1920–1921 construction-date conflict is retained; carrying this form between observations is an interpretation, not a dated alteration claim.',
  '前、中、后三条八层楼翼以退进的中央连接体相连，两侧各形成两处采光凹槽。显示轮廓采用 2024 年 SEMCOG 资料，上层楼翼分段和低层填充参照 2023 年及 2025 年 8 月 9 日照片推定。Temple 街七跨立面、两层基座、上层双窗及阶梯檐口依据早期 DPL 照片与保护报告；入口已改朝 Temple 街。凹槽尺寸、高度及未摄细部为比例推估，未经实测。保留 1920–1921 年建成年代分歧；将形态沿用至观测之间的年份属于推断，不代表已证实的改造年代。'
 ];
 function apply(b){return {...b,displayPolygons:[[reference.polygon]],displayCenter:reference.center,geometryRevision:'standard-three-wings76',geometryDisplayAdjusted:true,referenceGeometry:true,geometry_basis:reference.geometry_basis+' Upper-storey courts interpreted from dated exterior photographs.',periodNote:'2024 footprint reference; upper-court geometry is photo-interpreted, not a surveyed historical floor plan.'};}
 function build({THREE,mergeGeometries,rings,building,profile:p,appearance,detail=true}){
  const frame=LandmarkArchitecture.frame(rings[0],p),w=frame.w,d=frame.depth,h=p.body,base=7.75;
  const core=w*.48,front=d*.28,middle0=d*.405,middle1=d*.635,rear=d*.765;
  const upper=[[-w/2,0],[w/2,0],[w/2,-front],[core/2,-front],[core/2,-middle0],[w/2,-middle0],[w/2,-middle1],[core/2,-middle1],[core/2,-rear],[w/2,-rear],[w/2,-d],[-w/2,-d],[-w/2,-rear],[-core/2,-rear],[-core/2,-middle1],[-w/2,-middle1],[-w/2,-middle0],[-core/2,-middle0],[-core/2,-front],[-w/2,-front]];
  const ground=rings[0].map(q=>[(q.x-frame.x)*frame.ux+(q.z-frame.z)*frame.uz,(q.x-frame.x)*frame.nx+(q.z-frame.z)*frame.nz]);
  const normalize=ring=>{const r=ring.slice();if(Math.hypot(r[0][0]-r.at(-1)[0],r[0][1]-r.at(-1)[1])<.01)r.pop();const a=r.reduce((sum,q,i)=>{const n=r[(i+1)%r.length];return sum+q[0]*n[1]-n[0]*q[1];},0);return a>0?r.reverse():r;};
  const pieces=[],verts=[],colors=[],stone='#c4baa4',side='#b2aa91',dark='#354344',trim='#d0c8b7';
  const colorCache=new Map();const color=s=>{if(!colorCache.has(s))colorCache.set(s,new THREE.Color(s));return colorCache.get(s);};
  const world=(u,y,v)=>[frame.x+frame.ux*u+frame.nx*v,y,frame.z+frame.uz*u+frame.nz*v];
  function quad(a,b,c,d,col){verts.push(...a,...b,...c,...a,...c,...d);const q=color(col);for(let i=0;i<6;i++)colors.push(q.r,q.g,q.b);}
  function add(g,col){if(g.index){const old=g;g=old.toNonIndexed();old.dispose();}g.deleteAttribute('uv');const c=color(col),a=new Float32Array(g.attributes.position.count*3);for(let i=0;i<a.length;i+=3){a[i]=c.r;a[i+1]=c.g;a[i+2]=c.b;}g.setAttribute('color',new THREE.BufferAttribute(a,3));pieces.push(g);}
  function box(u,y,v,width,height,depth,col){const g=new THREE.BoxGeometry(width,height,depth);g.rotateY(Math.atan2(-frame.uz,frame.ux));g.translate(...world(u,y,v));add(g,col);}
  function roof(ring,y,col){const shape=new THREE.Shape();ring.forEach(([u,v],i)=>{const q=world(u,0,v);i?shape.lineTo(q[0],-q[2]):shape.moveTo(q[0],-q[2]);});shape.closePath();const g=new THREE.ShapeGeometry(shape);g.rotateX(-Math.PI/2);g.translate(0,y,0);add(g,col);}
  function edge(a,b,y0,y1,isFront,levels){
   const length=Math.hypot(b[0]-a[0],b[1]-a[1]),tu=(b[0]-a[0])/length,tv=(b[1]-a[1])/length,nu=-tv,nv=tu;
   const point=(x,y,offset=0)=>world(a[0]+tu*x+nu*offset,y,a[1]+tv*x+nv*offset);
   const panel=(x0,x1,low,high,col,offset=0)=>{if(x1-x0<.001||high-low<.001)return;quad(point(x0,low,offset),point(x0,high,offset),point(x1,high,offset),point(x1,low,offset),col);};
   const col=isFront?stone:side;
   if(!detail||length<2.2){panel(0,length,y0,y1,col);return;}
   const floor=(y1-y0)/levels;
   for(let row=0;row<levels;row++){
    const low=y0+row*floor,high=low+floor,winLow=low+floor*.20,winHigh=low+floor*.82,windows=[];
    if(isFront){
     for(let bay=0;bay<7;bay++){
      const cell=length/7,center=(bay+.5)*cell;
      if(y0===0&&row===0&&bay===3){windows.push({x:center,width:2.1,door:true});continue;}
      const count=y0===0&&bay>0&&bay<6?3:2,gap=.18,ww=Math.min(1.25,(cell*.73-gap*(count-1))/count);
      for(let j=0;j<count;j++)windows.push({x:center+(j-(count-1)/2)*(ww+gap),width:ww});
     }
    }else{
     const bays=Math.max(1,Math.round(length/5.3)),cell=length/bays;
     for(let bay=0;bay<bays;bay++)for(const sign of [-1,1])windows.push({x:(bay+.5)*cell+sign*Math.min(.80,cell*.16),width:Math.min(1.12,cell*.25)});
    }
    windows.sort((a,b)=>a.x-b.x);let cursor=0;
    for(const win of windows){const left=win.x-win.width/2,right=win.x+win.width/2,bottom=win.door ? .15 : winLow;
     panel(cursor,left,low,high,col);panel(left,right,low,bottom,col);panel(left,right,winHigh,high,col);
     panel(left,right,bottom,winHigh,dark,-.08);
     panel(left,right,(bottom+winHigh)/2-.035,(bottom+winHigh)/2+.035,trim,.025);
     if(win.door)panel(win.x-.04,win.x+.04,bottom,winHigh,trim,.03);
     panel(left-.08,right+.08,bottom-.10,bottom,trim,.04);cursor=right;
    }
    panel(cursor,length,low,high,col);
   }
  }
  function volume(ring,y0,y1,levels){ring=normalize(ring);for(let i=0;i<ring.length;i++){const a=ring[i],b=ring[(i+1)%ring.length],isFront=Math.abs(a[1])<.10&&Math.abs(b[1])<.10;edge(a,b,y0,y1,isFront,levels);}roof(ring,y1,'#68716a');}
  volume(ground,0,base,2);volume(upper,base,h,6);
  // Main facade: low frieze, six-storey paired-window field, stepped crown.
  box(0,base+.12,.10,w+.18,.34,.35,stone);
  box(0,h-.05,.16,w+.30,.35,.47,stone);
  box(0,h+.28,.19,w+.30,.20,.51,'#73958b');
  box(0,h+.60,-.13,w,.65,.30,stone);
  for(const u of [-w*.445,0,w*.445])box(u,h+1.02,-.13,u===0?w*.14:w*.11,.56,.30,stone);
  if(detail){
   for(let i=0;i<=7;i++)box((i/7-.5)*w,(base+h)/2,.065,.28,h-base,.16,stone);
   for(let i=0;i<=7;i++)box((i/7-.5)*w,base/2,.08,.46,base,.20,stone);
   box(0,3.45,.13,2.9,.32,.30,trim);for(const sign of [-1,1])box(sign*1.30,1.77,.13,.26,3.35,.30,trim);
  }
  if(verts.length){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));g.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));g.computeVertexNormals();pieces.push(g);}
  const geometry=mergeGeometries(pieces,false);pieces.forEach(g=>g.dispose());geometry.computeBoundingSphere();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1}));
  mesh.userData={building,landmarkId:p.id,standardThreeWings:true,detail};return mesh;
 }
 const profile=LandmarkArchitecture.profiles.find(p=>p.id==='standard');profile.facing=[.39,.92];profile.sources.push('standard76');
 LandmarkArchitecture.sources.standard76={label:'Three-wing form · Helmut Ziewers, March 2023 / 9 August 2025',url};
 const originalApply=LandmarkArchitecture.apply,originalBuild=LandmarkArchitecture.build,originalNote=LandmarkArchitecture.note;
 LandmarkArchitecture.apply=(b,y)=>{const next=originalApply(b,y);return next.landmarkArchitecture?.id==='standard'?apply(next):next;};
 LandmarkArchitecture.build=args=>args.profile.id==='standard'?build(args):originalBuild(args);
 LandmarkArchitecture.note=(p,zh)=>p.id==='standard'?notes[zh?1:0]:originalNote(p,zh);
 return {reference,notes,url,oldURL,build};
})();

/* Explicitly localized story labels; language switching never rebuilds geometry. */
const StoryLocalization76=(()=>{
 const copy={
  '3143 Cass · building':['3143 Cass · 建筑','19 世纪 80 年代的住宅，后来改作会所及其他用途。商会开业不是建筑建造日期。'],
  'On Leong Merchants Association':['安良工商会','1963–1980 年产权和社区用途有记录；1963 年 5 月 12 日开业。'],
  'Former On Leong building':['原安良工商会建筑','建筑保留至 2023 年 7 月 29 日拆除；1983 年 ACJ 会议另有记录。'],
  'Burton School · Chinese classes ≈':['Burton 学校 · 中文班 ≈','20 世纪 70 年代的周日中文班有记录，确切开始与结束年份待考。'],
  'Chung’s Restaurant':['Chung’s 餐厅','1963 年随唐人街迁入，2000 年停业；停业不等于拆除。'],
  'Wah Lee shop / Bow Wah ≈':['Wah Lee 商店／Bow Wah 餐厅 ≈','20 世纪 60 年代的经营有记录，开业及停业年份待考。'],
  'Bow Wah Chop Suey · 1976':['Bow Wah 餐厅 · 1976 年','Tommy Lee 的餐厅见于 1976 年 8 月记录；这次观测不能确定其他年份的营业状态。'],
  'Woodstock Apartments · Chinatown era ≈':['Woodstock 公寓 · 唐人街时期 ≈','市政府调查将此公寓与迁址后的唐人街社区关联；1963–1980 年为背景时段，不是逐户核实的居住时间。'],
  'Forbidden City · Seville Hotel · 3148 Second Ave ≈':['Forbidden City 餐厅 · Seville 酒店 · 3148 Second Ave ≈','20 世纪 60–80 年代为背景时段，并非开业与停业日期。Yee 家族照片标为 1967 年 6 月；StoryMap 定位相差约 18 米，酒店确切轮廓待考。'],
  'Golden Dragon · 1985 meeting · location ≈':['Golden Dragon · 1985 年会议 · 位置约略','1985 年密歇根亚太裔律师协会首次会议有记录，餐厅开闭年份待考。StoryMap 点位在另一处 1976 年候选模型以北约 48 米，均不能确定门牌。'],
  'Shanghai Café · opened in the 1930s ≈':['Shanghai Café · 20 世纪 30 年代开业 ≈','开业时间在 20 世纪 30 年代，确切日期尚未确定。'],
  'Shanghai Café':['Shanghai Café 餐厅','市政府 StoryMap 记载其在 20 世纪 30 年代末至 1981 年间经营。'],
  '2753 Park, William E. Cole House ≈':['2753 Park · William E. Cole 住宅 ≈','19 世纪 80 年代已有住宅，后来由两层改为三层公寓，立面改于 20 世纪 10 年代。清册的 1905 年建造字段存在矛盾；记载 2017 年拆除，页面确认 2026 年 6 月前已不存。未取得历史立面照片。'],
  '131 Temple, Will Mar Garage ≈':['131 Temple · Will Mar 车库 ≈','保护报告记载 1924 年，清册记载 1925 年。文献描述两层、四跨立面，尚未取得照片。清册记载 2017 年拆除；2018 年的八层替代建筑另行记录。'],
  'Forbidden City · June 1967 photograph':['Forbidden City · 1967 年 6 月照片','Yee 家族照片，冲印边框标有 JUN 67。'],
  'Seville residents · recollection ≈':['Seville 居民 · 回忆 ≈','Norm Norm 自述的居住时段。'],
  'White Grove · restaurant ≈':['White Grove · 餐厅 ≈','地方研究记载其在 1948 年前已营业，约于 2013 年停业。'],
  'White Grove · reopening reported':['White Grove · 据报道重新开业','Eric Hergenreder 于 2026 年 6 月更新的报道。']
 };
 for(const place of MerchantHistory.data.storyPlaces){
  for(const period of place.periods){
   const texts=copy[period.label];if(texts){period.labelZh=texts[0];period.noteZh=texts[1];}
   if(!period.noteZh){const phase=Object.values(MerchantHistory.data.histories).flatMap(h=>h.phases).find(p=>p.fromYear===period.from&&p.note===period.note);if(phase)period.noteZh=phase.noteZh;}
  }
  if(place.note==='Sources, dates and uncertainties recorded in archive tags.')place.noteZh='出处、日期与不确定性见史料标签。';
  if(place.note==='Occupant history and building survival are separate; an observation year does not imply a one-year business lifespan.')place.noteZh='商铺沿革与建筑存续分开记录；某年观测不代表商铺只经营一年。';
 }
 const dates={'1960s · observed decade':'20 世纪 60 年代 · 该时段有记录','1976 · photograph caption':'1976 年 · 照片题注','1996–18 Aug 2001':'1996 年—2001 年 8 月 18 日','Aug 1976 · observed':'1976 年 8 月 · 有记录','Sep 2015–present':'2015 年 9 月至今','c. 1935–1955':'约 1935–1955 年','c. 1956–1988/89':'约 1956–1988/89 年','c. 1989–1990':'约 1989–1990 年','closed 18 Aug 2001':'2001 年 8 月 18 日停业','early 1990s':'20 世纪 90 年代初','late 1994 / early 1995':'1994 年末／1995 年初'};
 for(const h of Object.values(MerchantHistory.data.histories))for(const p of h.phases)p.dateLabelZh=dates[p.dateLabel]||p.dateLabel;
 const interchanges={
  'Ford–Lodge · Lodge crossings by 1952':['Ford–Lodge · 1952 年前已有 Lodge 跨线桥','MDOT 记载，Lodge 南北向桥梁于 1952 年末前已投入使用，但整个立交尚未通车。'],
  'Ford–Lodge · complete 1955':['Ford–Lodge · 1955 年全线通车','三个连接匝道于 1955 年 1 月 18 日通车，完整的 14 座桥立交于 10 月通车。时间线采用年末状态。匝道位置取自市政道路资料，相对高程依据 USGS 地形和 FHWA 桥梁净空；历史断面及后续线形变化待考。']
 };
 const previous=MerchantHistory.applySpatial;
 MerchantHistory.applySpatial=spatial=>{const result=previous(spatial);for(const interchange of result.interchanges||[])for(const p of interchange.periods){const text=interchanges[p.label];if(text){p.labelZh=text[0];p.noteZh=text[1];}}for(const place of result.storyPlaces||[]){const reference=MerchantHistory.data.storyPlaces.find(p=>p.id===place.id);if(reference){if(reference.noteZh)place.noteZh=reference.noteZh;for(const period of place.periods){const match=reference.periods.find(p=>p.label===period.label&&p.from===period.from);if(match){period.labelZh=match.labelZh;period.noteZh=match.noteZh;}}}}return result;};
 return {copy};
})();

/* Heather Hall: photo-interpreted exterior, 1924 construction / 2022 rehabilitation.
   Uses the existing SEMCOG parcel envelope, one merged mesh per LOD, no textures. */
const HeatherArchitecture81=(()=>{
 const id='semcog-8136069',url='https://www.oconnordetroit.com/property/3444-second-avenue/';
 const profile={id:'heather81',ids:[id],entity:'heather-hall81',name:'Heather Hall · 3444 Second Avenue',nameZh:'Heather Hall · 3444 Second Avenue',kind:'heather81',from:1924,through:2026,height:33.2,body:33.2,floors:10,bays:7,facing:[-.921,.389],sources:['heather81','heatherPlan81']};
 const notes=[
  'Built in 1924. Ten above-ground levels follow the O’Connor description (residential floors 2–10) and exterior photograph; SEMCOG and an older listing count eleven, a retained source discrepancy. The tower, one-storey north shop wing, seven front window columns, pale second-floor belt and stone entrance are photo-interpreted. Modern black-framed storefronts appear only from the documented 2022 renovation. The 2024 footprint includes rear low volumes; tower/wing boundaries, 33.2 m height, window dimensions and unseen elevations are approximate, not surveyed. Earlier facade continuity is an interpretation; original shop details and annex construction dates remain unverified.',
  '1924 年建成。依据 O’Connor 所述住宅位于第 2–10 层及外观照片，显示地上十层；SEMCOG 与较早房产资料记为十一层，保留该计数分歧。主楼、北侧单层商铺、正面七列窗洞、二层上方浅色腰线及石材入口按照片细化。现代黑框店面仅自有记录的 2022 年翻新起显示。2024 年轮廓包含后部低层体量；高低体量分界、约 33.2 米高度、窗洞尺寸与未摄立面均为比例推估，未经测量。早期外观连续性为解释性重建；原始商铺细部和附属低层的建造年份尚未确认。'
 ];
 const oldApply=LandmarkArchitecture.apply,oldProfile=LandmarkArchitecture.profile,oldBuild=LandmarkArchitecture.build,oldNote=LandmarkArchitecture.note;
 LandmarkArchitecture.profiles.push(profile);
 LandmarkArchitecture.sources.heather81={label:'Heather Hall · 1924 construction / 2022 renovation · O’Connor',url};
 LandmarkArchitecture.sources.heatherPlan81={label:'Heather Hall · exterior photographs and ground-floor plan, pp. 4–5, 9',url:'https://www.oconnordetroit.com/wp-content/uploads/2022/10/3444-Second-Avenue-Retail-Leasing-Brochure.pdf'};
 function getProfile(b,y){return b.id===id&&y>=1924?{...profile,sceneYear:y,phaseKey:y>=2022?'renovated-2022':'historic-reference',referenceYear:2022,historicalReference:y<2022}:oldProfile(b,y);}
 LandmarkArchitecture.profile=getProfile;
 LandmarkArchitecture.apply=(b,y)=>{
  if(b.id!==id||y<1924)return oldApply(b,y);
  const p=getProfile(b,y),ring=HeatherReference81.polygon;
  return {...b,polygon:ring,holes:[],displayPolygons:[[ring]],displayCenter:HeatherReference81.center,center:HeatherReference81.center,height:p.height,landmarkArchitecture:p,reviewed_name:profile.name,geometryRevision:'heather81-'+p.phaseKey,referenceGeometry:true,geometryDisplayAdjusted:true,height_basis:'Approximate photo-interpreted ten-level elevation; 33.2 m is not a surveyed height.',periodNote:y<2022?'1924 construction; later envelope used as an explicit reference. Original shop details unverified.':'2022 renovated exterior reference; source footprint from 2024.'};
 };
 LandmarkArchitecture.note=(p,zh)=>p.id==='heather81'?notes[zh?1:0]:oldNote(p,zh);
 function build({THREE,mergeGeometries,rings,profile:p,appearance,detail=true,building}){
  const f=LandmarkArchitecture.frame(rings[0],p),w=f.w,depth=f.depth;
  const wing=Math.min(3.5,w*.19),left=-w/2,right=w/2-wing,towerWidth=right-left;
  const towerDepth=Math.min(23.0,depth*.68),h=33.2,base=3.9,storey=3.15,renovated=p.sceneYear>=2022;
  const brick='#945b45',brickSide='#9d624a',stone='#d1c4a9',glass='#37464a',frame='#303938',roofColor='#686c67';
  const pieces=[],verts=[],colors=[],cc=new Map();
  const world=(u,y,v)=>[f.x+f.ux*u+f.nx*v,y,f.z+f.uz*u+f.nz*v];
  const color=c=>{if(!cc.has(c))cc.set(c,new THREE.Color(c));return cc.get(c);};
  function quad(a,b,c,d,col){verts.push(...a,...b,...c,...a,...c,...d);const q=color(col);for(let i=0;i<6;i++)colors.push(q.r,q.g,q.b);}
  function add(g,col){if(g.index){const old=g;g=old.toNonIndexed();old.dispose();}g.deleteAttribute('uv');const c=color(col),a=new Float32Array(g.attributes.position.count*3);for(let i=0;i<a.length;i+=3){a[i]=c.r;a[i+1]=c.g;a[i+2]=c.b;}g.setAttribute('color',new THREE.BufferAttribute(a,3));pieces.push(g);}
  function box(u,y,v,ww,hh,dd,col){const g=new THREE.BoxGeometry(ww,hh,dd);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...world(u,y,v));add(g,col);}
  function roof(ring,y){const s=new THREE.Shape();ring.forEach(([u,v],i)=>{const q=world(u,0,v);i?s.lineTo(q[0],-q[2]):s.moveTo(q[0],-q[2]);});s.closePath();const g=new THREE.ShapeGeometry(s);g.rotateX(-Math.PI/2);g.translate(0,y,0);add(g,roofColor);}
  function normalize(ring){const r=ring.slice();if(Math.hypot(r[0][0]-r.at(-1)[0],r[0][1]-r.at(-1)[1])<.01)r.pop();return r.reduce((s,a,i)=>{const b=r[(i+1)%r.length];return s+a[0]*b[1]-b[0]*a[1];},0)>0?r.reverse():r;}
  function wall(a,b,y0,y1,col,windows=[]){
   const len=Math.hypot(b[0]-a[0],b[1]-a[1]),du=(b[0]-a[0])/len,dv=(b[1]-a[1])/len,nu=-dv,nv=du;
   const pt=(x,y,o=0)=>world(a[0]+du*x+nu*o,y,a[1]+dv*x+nv*o);
   function panel(x0,x1,lo,hi,c,o=0){if(x1-x0>.001&&hi-lo>.001)quad(pt(x0,lo,o),pt(x0,hi,o),pt(x1,hi,o),pt(x1,lo,o),c);}
   if(!detail||!windows.length){panel(0,len,y0,y1,col);return;}
   const ys=[...new Set([y0,y1,...windows.flatMap(q=>[q.lo,q.hi])])].sort((a,b)=>a-b);
   for(let j=1;j<ys.length;j++){const lo=ys[j-1],hi=ys[j],mid=(lo+hi)/2;let cursor=0;for(const q of windows.filter(q=>mid>q.lo&&mid<q.hi).sort((a,b)=>a.x-b.x)){panel(cursor,q.x-q.w/2,lo,hi,col);cursor=q.x+q.w/2;}panel(cursor,len,lo,hi,col);}
   for(const q of windows){const l=q.x-q.w/2,r=q.x+q.w/2;panel(l,r,q.lo,q.hi,glass,-.10);
    // Reveal returns close the real openings; no coplanar window overlays.
    quad(pt(l,q.lo),pt(l,q.hi),pt(l,q.hi,-.10),pt(l,q.lo,-.10),brickSide);
    quad(pt(r,q.lo,-.10),pt(r,q.hi,-.10),pt(r,q.hi),pt(r,q.lo),brickSide);
    panel(l-.06,r+.06,q.lo-.08,q.lo,stone,.035);
    const trim=q.shop?frame:'#53544b';panel(l,l+.035,q.lo,q.hi,trim,-.06);panel(r-.035,r,q.lo,q.hi,trim,-.06);
    panel(l,r,q.hi-.04,q.hi,trim,-.06);
    if(q.shop){panel(l,r,q.hi-.62,q.hi-.57,trim,-.05);const count=q.w>3?3:2;for(let k=1;k<count;k++)panel(l+q.w*k/count-.025,l+q.w*k/count+.025,q.lo,q.hi,trim,-.05);}
    else panel(l,r,(q.lo+q.hi)/2-.025,(q.lo+q.hi)/2+.025,trim,-.05);
   }
  }
  const tower=normalize([[left,0],[right,0],[right,-towerDepth],[left,-towerDepth]]);
  for(let edge=0;edge<tower.length;edge++){
   const a=tower[edge],b=tower[(edge+1)%tower.length],len=Math.hypot(b[0]-a[0],b[1]-a[1]);
   const front=Math.abs(a[1])<.01&&Math.abs(b[1])<.01,side=Math.abs(a[0]-b[0])<.01,win=[];
   const bays=front?7:side?9:7;
   if(detail){for(let row=0;row<9;row++)for(let col=0;col<bays;col++){
    const narrow=front&&(col===1||col===5);win.push({x:(col+.5)*len/bays,w:narrow?.72:Math.min(1.23,len/bays*.52),lo:base+row*storey+.62,hi:base+row*storey+2.48});
   }
   if(front){if(renovated){for(const x of [.20,.79])win.push({x:len*x,w:len*.30,lo:.28,hi:3.25,shop:true});win.push({x:len*.49,w:1.35,lo:.08,hi:2.85,shop:true});}
    else{for(const x of [.20,.49,.79])win.push({x:len*x,w:x===.49?1.35:len*.25,lo:x===.49?.08:.5,hi:2.85});}}
   else if(side){for(let col=0;col<bays;col++)win.push({x:(col+.5)*len/bays,w:Math.min(1.05,len/bays*.44),lo:.65,hi:2.75});}
   }
   wall(a,b,0,h,front?brick:brickSide,win);
  }
  roof(tower,h-.18);
  // Low annex and rear service volumes follow the source perimeter, without raising it to tower height.
  const ground=normalize(rings[0].map(q=>[(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,(q.x-f.x)*f.nx+(q.z-f.z)*f.nz]));
  const lowHeight=4.25;
  for(let i=0;i<ground.length;i++){
   const a=ground[i],b=ground[(i+1)%ground.length];
   if(Math.abs(a[1])<.08&&Math.abs(b[1])<.08){wall([right,0],[w/2,0],0,lowHeight,brick,renovated?[{x:wing/2,w:wing*.80,lo:.3,hi:3.0,shop:true}]:[]);continue;}
   // Tower itself already supplies the outer south wall; suppress overlapping base faces.
   const mid=[(a[0]+b[0])/2,(a[1]+b[1])/2];if(mid[0]>=left-.08&&mid[0]<=right+.08&&mid[1]>=-towerDepth-.08&&mid[1]<=.08)continue;
   wall(a,b,0,lowHeight,brickSide);
  }
  roof(ground,lowHeight);
  // The low roof is behind the opaque tower walls; it cannot obscure the tower roof.
  box((left+right)/2,7.12,.075,towerWidth+.08,.20,.20,stone);
  box((left+right)/2,h-.08,-.02,towerWidth,.16,.18,brick);
  box(left+.03,7.12,-towerDepth/2,.16,.20,towerDepth,stone);
  if(detail){
   const entry=left+towerWidth*.49;
   box(entry-1.0,1.70,.10,.27,3.4,.26,stone);box(entry+1.0,1.70,.10,.27,3.4,.26,stone);
   box(entry,3.30,.12,2.25,.38,.30,stone);box(entry,3.67,.12,2.0,.36,.30,stone);
   box(entry,3.92,.12,1.43,.17,.30,stone);box(entry,4.06,.12,.7,.14,.30,stone);
   // Small north-wing decorative plaque, simplified rather than inventing relief sculpture.
   if(renovated){box(right+wing*.5,3.55,.08,1.25,.61,.12,stone);box(right+wing*.5,3.55,.15,1.06,.44,.04,'#79766b');}
  }
  if(verts.length){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));g.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));g.computeVertexNormals();pieces.push(g);}
  const geometry=mergeGeometries(pieces,false);pieces.forEach(g=>g.dispose());geometry.computeBoundingSphere();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1}));mesh.userData={building,heather81:true,detail,phase:p.phaseKey};return mesh;
 }
 LandmarkArchitecture.build=args=>args.profile.id==='heather81'?build(args):oldBuild(args);
 return {profile,notes,build};
})();

/* Photo/document-interpreted detail; concave footprints retain open light courts.
   One merged mesh per building/LOD; no textures, requests or animation work. */
const BlockArchitecture82=(()=>{
 const refs=BlockReference82.buildings,byId=new Map(refs.map(r=>[r.id,r]));
 const old={apply:LandmarkArchitecture.apply,profile:LandmarkArchitecture.profile,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note};
 const notes={
 fred82:[
  '1971 is the requested construction date, also labelled in the city resource map. Photographs support one storey, brick piers, glazed shopfront, white fascia and dark mansard canopy. Raw inventory’s 1929/four-storey record and a later listing’s 1989 date conflict with this evidence and remain preserved as source metadata. Roof height (4.2 m), shop proportions and service-wing details are approximate. Modern sign detail is shown only in the 2026 reference phase; earlier frontage is an interpretation. Business founding is not building construction.',
  '按用户及市资源图所列 1971 年建造。照片支持单层砖墙、玻璃店面、白色招牌带和深色斜檐。原始库存的 1929 年／四层及另一房产记录的 1989 年有分歧，保留为来源信息。约 4.2 米高度、店面比例与附属部分为推估；现代招牌仅在 2026 年参考状态显示，早期店面为解释性重建。商号创办年不等于楼宇建造年。'],
 kings82:[
  'Built 1926 as Hotel Stimson, an apartment hotel. The 2026 applicant narrative describes residential-hotel / affordable SRO use and rehabilitation with continued occupancy. Apartment conversion is a marketing proposal, not a verified completed change. Renaming date is unknown. Four connected blocks and six side recesses follow the inventory outline; four levels, masonry, belt courses and arched entrance openings follow documentary evidence. Height (14 m), window layout and ornament are approximate; listing photos could not be visually retrieved in this session. Earlier facade continuity is interpretive.',
  '1926 年建成，原名 Hotel Stimson，公寓式旅馆。2026 年申请材料仍列住宅旅馆／低价单间住宿，并称修缮期间继续有人居住。改公寓为营销提出的开发方向，未证实已完成用途变更；改名时间未核实。四段连体与两侧六处凹口沿用现有轮廓；四层、砖石、腰线与拱形入口依据文献。约 14 米高度、窗位与装饰比例为推估；本次未能读取房产网站照片的图像内容。早期外观连续性为解释性重建。'],
 wayne82:[
  'Timeline follows the user / LoopNet date 1928; the city district report instead dates Aderna Court to 1924. This conflict is unresolved. The report identifies a four-storey Tudor Revival building with two light courts on each side: three blocks joined along a central spine. The model cuts those courts out of the coarse inventory rectangle; their exact dimensions are estimated. Street photo guides red brick, stone central bay and gable, oriel windows and arched entry. Height follows the report’s approximately 48 ft. Current green awnings are restricted to the 2026 reference phase.',
  '时间线采用用户及 LoopNet 的 1928 年；市历史街区报告将原称 Aderna Court 的建筑记为 1924 年，分歧未解决。报告确认四层、都铎复兴式，两侧各两个采光院落，形成中部连接的三段体量。模型从原库存矩形中挖出四处院落，准确尺寸尚无测绘，按比例推估。街景照片用于红砖、中央石饰与山墙、凸窗及拱形入口；高度依报告约 48 英尺。绿色遮篷仅在 2026 年参考状态显示。']};
 for(const r of refs){LandmarkArchitecture.profiles.push({id:r.key,ids:[r.id],entity:r.entity,name:r.name,nameZh:r.name,kind:r.key,from:r.year,through:2026,height:r.height,body:r.height,floors:r.floors,facing:r.facing,sources:r.sources});}
 Object.assign(LandmarkArchitecture.sources,BlockReference82.sources);
 function profile(b,y){const r=byId.get(b.id);if(!r||y<r.year)return old.profile(b,y);return {...r,id:r.key,ids:[r.id],kind:r.key,from:r.year,through:2026,body:r.height,sceneYear:y,phaseKey:y>=2026?'documented-2026':'earlier-reference',referenceYear:2026,historicalReference:y<2026};}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.apply=(b,y)=>{const r=byId.get(b.id);if(!r||y<r.year)return old.apply(b,y);return {...b,polygon:r.polygon,holes:[],displayPolygons:[[r.polygon]],center:r.center,displayCenter:r.center,height:r.height,reviewed_name:r.name,landmarkArchitecture:profile(b,y),geometryRevision:r.key,geometryDisplayAdjusted:true,referenceGeometry:true,height_basis:r.key==='wayne82'?'City report: about 48 ft; ornamental projection interpreted.':'Illustrative elevation from documented storeys; not surveyed.',periodNote:notes[r.key][0]};};
 LandmarkArchitecture.note=(p,zh)=>notes[p.id]?notes[p.id][zh?1:0]:old.note(p,zh);
 function build({THREE,mergeGeometries,rings,profile:p,appearance,detail=true,building}){
  const f=LandmarkArchitecture.frame(rings[0],p),w=f.w,h=p.id==='wayne82'?p.height-1.35:p.height,kind=p.id;
  const vs=[],cs=[],pieces=[],colorCache=new Map();
  const palette=kind==='fred82'?{brick:'#a66c4c',side:'#aa9279',stone:'#e4dbc6',glass:'#354b4e',frame:'#c4c7c0'}:kind==='wayne82'?{brick:'#954d3b',side:'#997059',stone:'#d0c9b9',glass:'#465661',frame:'#d3d8d5'}:{brick:'#a16c4f',side:'#aa7e5d',stone:'#d0c6ad',glass:'#42545a',frame:'#c1bcae'};
  const world=(u,y,v)=>[f.x+f.ux*u+f.nx*v,y,f.z+f.uz*u+f.nz*v];
  const color=c=>{if(!colorCache.has(c))colorCache.set(c,new THREE.Color(c));return colorCache.get(c);};
  function quad(a,b,c,d,col){vs.push(...a,...b,...c,...a,...c,...d);const q=color(col);for(let i=0;i<6;i++)cs.push(q.r,q.g,q.b);}
  function add(g,col){if(g.index){const q=g;g=q.toNonIndexed();q.dispose();}g.deleteAttribute('uv');const q=color(col),a=new Float32Array(g.attributes.position.count*3);for(let i=0;i<a.length;i+=3){a[i]=q.r;a[i+1]=q.g;a[i+2]=q.b;}g.setAttribute('color',new THREE.BufferAttribute(a,3));pieces.push(g);}
  function box(u,y,v,ww,hh,dd,col){const g=new THREE.BoxGeometry(ww,hh,dd);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...world(u,y,v));add(g,col);}
  let ring=rings[0].map(q=>[(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,(q.x-f.x)*f.nx+(q.z-f.z)*f.nz]);
  if(Math.hypot(ring[0][0]-ring.at(-1)[0],ring[0][1]-ring.at(-1)[1])<.01)ring.pop();
  if(ring.reduce((sum,a,i)=>{const b=ring[(i+1)%ring.length];return sum+a[0]*b[1]-b[0]*a[1];},0)>0)ring.reverse();
  function wall(a,b,win,front){
   const len=Math.hypot(b[0]-a[0],b[1]-a[1]),du=(b[0]-a[0])/len,dv=(b[1]-a[1])/len;
   const pt=(x,y,o=0)=>world(a[0]+du*x-dv*o,y,a[1]+dv*x+du*o);
   const brick=front?palette.brick:palette.side;
   const wh=kind==='fred82'&&front?3.36:h;
   const panel=(l,r,lo,hi,c,o=0)=>{hi=Math.min(hi,wh);if(r-l<=.0001||hi-lo<=.0001)return;if(front&&kind==='wayne82'&&c===brick){if(hi<=3.52)c=palette.stone;else{const cuts=[l,...[len*.372,len*.628].filter(x=>x>l&&x<r),r];for(let k=1;k<cuts.length;k++){const a=cuts[k-1],b=cuts[k],mid=(a+b)/2;quad(pt(a,lo,o),pt(a,hi,o),pt(b,hi,o),pt(b,lo,o),mid>len*.372&&mid<len*.628?palette.stone:c);}return;}}quad(pt(l,lo,o),pt(l,hi,o),pt(r,hi,o),pt(r,lo,o),c);};
   if(!detail)panel(0,len,0,h,brick);
   else{
    const ys=[...new Set([0,h,...(front&&kind==='wayne82'?[3.52]:[]),...win.flatMap(q=>[q.lo,q.hi])])].sort((a,b)=>a-b);
    for(let j=1;j<ys.length;j++){let cursor=0;const lo=ys[j-1],hi=ys[j],mid=(lo+hi)/2;for(const q of win.filter(q=>mid>q.lo&&mid<q.hi).sort((a,b)=>a.x-b.x)){panel(cursor,q.x-q.w/2,lo,hi,brick);cursor=q.x+q.w/2;}panel(cursor,len,lo,hi,brick);}
    for(const q of win){const l=q.x-q.w/2,r=q.x+q.w/2;panel(l,r,q.lo,q.hi,palette.glass,-.13);quad(pt(l,q.lo),pt(l,q.hi),pt(l,q.hi,-.13),pt(l,q.lo,-.13),palette.stone);quad(pt(r,q.lo,-.13),pt(r,q.hi,-.13),pt(r,q.hi),pt(r,q.lo),palette.stone);
     panel(l-.045,r+.045,Math.max(0,q.lo-.09),q.lo,palette.stone,.025);panel(l,r,q.hi-.045,q.hi,palette.frame,-.07);panel(l,l+.045,q.lo,q.hi,palette.frame,-.07);panel(r-.045,r,q.lo,q.hi,palette.frame,-.07);
     panel(l,r,q.lo+(q.hi-q.lo)*.53-.025,q.lo+(q.hi-q.lo)*.53+.025,palette.frame,-.07);
     if(q.w>1.8)for(let k=1;k<(q.shop?3:2);k++){const x=l+q.w*k/(q.shop?3:2);panel(x-.026,x+.026,q.lo,q.hi,palette.frame,-.065);}
    }
   }
   // Parapet coping follows each concave edge, including court returns.
   panel(0,len,h-.13,h,palette.stone,.015);
   if(kind!=='fred82'){panel(0,len,3.52,3.67,palette.stone,.025);panel(0,len,h-.70,h-.61,palette.stone,.02);}
  }
  for(let i=0;i<ring.length;i++){
   const a=ring[i],b=ring[(i+1)%ring.length],len=Math.hypot(b[0]-a[0],b[1]-a[1]);if(len<.001)continue;
   const front=Math.abs(a[1])<.075&&Math.abs(b[1])<.075;const win=[];
   if(detail){
    if(kind==='fred82'){
     if(front){const sw=Math.min(7.5,len*.66),c=len*.67;win.push({x:c-sw*.31,w:sw*.49,lo:.58,hi:2.87,shop:true},{x:c+sw*.08,w:1.03,lo:.05,hi:2.87},{x:c+sw*.34,w:sw*.27,lo:.58,hi:2.87});}
    }else{
     for(let row=0;row<4;row++){
      const lo=.8+row*3.15,hi=lo+1.83;
      if(front&&kind==='wayne82'){
       if(row===0){win.push({x:len*.18,w:2.1,lo:.85,hi:2.4},{x:len*.50,w:2.55,lo:.08,hi:3.07},{x:len*.82,w:2.1,lo:.85,hi:2.4});}
       else{for(const q of [.10,.17,.25,.35,.43,.478,.522,.57,.65,.75,.83,.90])win.push({x:len*q,w:q>.4&&q<.6?.62:q===.25||q===.75?.65:1.02,lo,hi:hi+.1});}
      }else if(front&&kind==='kings82'){
       const positions=row===0?[.14,.32,.50,.68,.86]:[.09,.23,.38,.62,.77,.91];
       for(const q of positions)win.push({x:len*q,w:row===0?1.74:1.0,lo:row===0&&q===.5?.05:lo,hi:row===0?2.90:hi});
      }else{
       const count=Math.floor(len/2.45);for(let j=0;j<count;j++)win.push({x:(j+.5)*len/count,w:j%3===1?.69:1.0,lo:lo+(j%3===1?.3:0),hi});
      }
     }
    }
   }
   wall(a,b,win,front);
  }
  // Triangulate the actual concave polygon; never cap courts with a bounding rectangle.
  let roofRing=ring;if(kind==='fred82'){roofRing=[];for(let i=0;i<ring.length;i++){const a=ring[i],b=ring[(i+1)%ring.length],ain=a[1]<=-.85,bin=b[1]<=-.85;if(ain)roofRing.push(a);if(ain!==bin){const t=(-.85-a[1])/(b[1]-a[1]);roofRing.push([a[0]+t*(b[0]-a[0]),-.85]);}}}
  const shape=new THREE.Shape();roofRing.forEach(([u,v],i)=>{const q=world(u,0,v);i?shape.lineTo(q[0],-q[2]):shape.moveTo(q[0],-q[2]);});shape.closePath();const roof=new THREE.ShapeGeometry(shape);roof.rotateX(-Math.PI/2);roof.translate(0,kind==='fred82'?4.18:h-.16,0);add(roof,'#777970');
  function frontPanel(l,r,lo,hi,col,v=.05){quad(world(l,lo,v),world(l,hi,v),world(r,hi,v),world(r,lo,v),col);}
  function arch(u,y,r,thickness){for(let i=0;i<16;i++){const a=Math.PI*i/16,b=Math.PI*(i+1)/16;quad(world(u+Math.cos(a)*r,y+Math.sin(a)*r,.075),world(u+Math.cos(a)*(r+thickness),y+Math.sin(a)*(r+thickness),.075),world(u+Math.cos(b)*(r+thickness),y+Math.sin(b)*(r+thickness),.075),world(u+Math.cos(b)*r,y+Math.sin(b)*r,.075),palette.stone);}}
  if(kind==='fred82'){
   const lo=-w/2,hi=w/2;box(0,3.13,-.10,w,.43,.25,palette.stone);
   // Sloping shingle canopy remains within the outer footprint; its datum is approximate.
   quad(world(lo,3.36,0),world(lo,4.18,-.85),world(hi,4.18,-.85),world(hi,3.36,0),'#464743');
   if(detail){for(let row=0;row<4;row++){const v=-.85*(row+.5)/4,y=3.36+.82*(row+.5)/4;frontPanel(lo,hi,y-.014,y+.014,'#636560',v+.008);}
    // Modern sign lettering is deliberately omitted before the modern photographic reference.
    if(p.sceneYear>=2026){const glyph={F:['11111','10000','10000','11110','10000','10000','10000'],R:['11110','10001','10001','11110','10100','10010','10001'],E:['11111','10000','10000','11110','10000','10000','11111'],D:['11110','10001','10001','10001','10001','10001','11110'],S:['01111','10000','10000','01110','00001','00001','11110'],K:['10001','10010','10100','11000','10100','10010','10001'],Y:['10001','10001','01010','00100','00100','00100','00100'],H:['10001','10001','10001','11111','10001','10001','10001'],O:['01110','10001','10001','10001','10001','10001','01110'],P:['11110','10001','10001','11110','10000','10000','10000']};const label='FREDS KEY SHOP',sx=.078,sy=.033,start=-w*.17-label.length*6*sx/2;for(let k=0;k<label.length;k++)for(let yy=0;yy<7;yy++)for(let xx=0;xx<5;xx++)if(glyph[label[k]]?.[yy][xx]==='1')frontPanel(start+(k*6+xx)*sx,start+(k*6+xx+.8)*sx,3.235-(yy+1)*sy,3.235-yy*sy,k<5?'#a63e2f':'#2c3935',.031);}
   }
