    const dog=[[-.52,.36],[-.38,.26],[-.05,.29],[.17,.43],[.27,.62],[.39,.68],[.50,.57],[.48,.49],[.30,.43],[.25,.05],[.19,-.18],[.09,-.18],[.10,.08],[-.22,.08],[-.26,-.18],[-.36,-.18],[-.34,.17],[-.52,.25]];
