   if(detail){for(let k=-2;k<=2;k++)box(k*cw/5,h+.25,.09,.09,.9,.10,'#b3ac9a');
    for(const u of [-w*.34,w*.34]){box(u,h-.49,-.01,w*.22,.8,.13,palette.stone);box(u,5.85,.10,.85,1.45,.25,palette.stone);frontPanel(u-.30,u+.30,5.35,6.37,palette.glass,.235);}
