    }
   };
   for(let j=1;j<ys.length;j++){
    const low=ys[j-1],high=ys[j],mid=(low+high)/2;if(high-low<eps)continue;
    const crossings=edges.filter(([p,q])=>mid>Math.min(p.y,q.y)&&mid<Math.max(p.y,q.y)).map(edge=>({edge,u:at(edge,mid),delta:Math.sign(edge[1].y-edge[0].y)})).sort((p,q)=>p.u-q.u);
    let winding=0,left=null;
    for(const cross of crossings){const before=winding;winding+=cross.delta;if(!before&&winding)left=cross.edge;else if(before&&!winding&&left){
     const p=vertex(at(left,low),low),q=vertex(at(cross.edge,low),low),r=vertex(at(cross.edge,high),high),s=vertex(at(left,high),high);emit(p,q,r);emit(p,r,s);left=null;
    }}
   }
  }

  if(changed){
