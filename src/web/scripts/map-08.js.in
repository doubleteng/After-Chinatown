/* Charlotte facades: photo-guided, three main floors above a low basement.
   Metric details and earlier facade continuity remain interpretations. */
const CharlotteArchitecture83=(()=>{
 const refs=CharlotteReference83.buildings,byId=new Map(refs.map(r=>[r.id,r]));
 const old={apply:LandmarkArchitecture.apply,profile:LandmarkArchitecture.profile,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note};
 const notes={
 charlotte62483:[
 '624 Charlotte is distinct from 644. Timeline follows owner: 1919 construction, 2020 renovation. Inventory and listing fields also give 1915; the date conflict is unresolved. Owner describes 40 apartments, while another listing field gives 24. Three visible main floors, brown brick, pale entrance surround, belt courses, triple central windows and stepped parapet follow the owner photograph. Footprint is retained; 11.4 m height, rear windows and historical facade continuity are interpreted. Renovation does not imply a new building or commercial conversion.',
 '624 与隔壁 644 是两栋楼。依业主采用 1919 年建、2020 年翻新；库存与列表字段另记 1915 年，分歧未解决。业主列 40 户，另一列表字段列 24 户。照片显示三层主体、棕砖、浅色石饰入口、腰线、中央三联窗及阶梯女儿墙。沿用占地轮廓；约 11.4 米高度、后侧窗位及早期外观为推估。翻新不作为重建或商业用途变更。'],
 charlotte64483:[
 '644 Charlotte: 1925, three main storeys, 27 apartments. Four connected blocks and six side courts follow the inventory polygon. Restoration photographs guide red-brown brick, limestone base, central entrance and window surrounds. In 2013 the building was reported vacant with a supportive-housing rehabilitation plan. Current operator lists affordable housing; contractor records south-wall rebuilding and replacement limestone sills. Completion date is unverified; 2020 belongs to 624. Approximate 11.4 m height and window spacing; early facade continuity is interpretive. Current geometry is a simplified restored reference, not a measured as-built survey.',
 '644 Charlotte：1925 年建、三层主体、27 户。四段连体和两侧六处采光院落沿用库存轮廓。修缮照片用于红棕砖、石材基座、中央入口及窗框。2013 年报道为空置楼，计划修缮作支持性住房；现运营方列可负担住房，承包商记南立面重建和石灰石窗台更换。竣工年未核实，2020 年仅属于 624。约 11.4 米高度、窗距为推估，早期外观为解释性复原，现代形态为简化修缮参考而非竣工测绘。']};
 for(const r of refs)LandmarkArchitecture.profiles.push({id:r.key,ids:[r.id],entity:r.entity,name:r.name,nameZh:r.name,kind:r.key,from:r.year,through:2026,height:r.height,body:r.height,floors:r.floors,facing:r.facing,sources:r.sources});
 Object.assign(LandmarkArchitecture.sources,CharlotteReference83.sources);
 function profile(b,y){const r=byId.get(b.id);if(!r||y<r.year)return old.profile(b,y);const modern=r.year===1919?y>=2020:y>=2026;return {...r,id:r.key,ids:[r.id],kind:r.key,from:r.year,through:2026,body:r.height,sceneYear:y,phaseKey:modern?(r.year===1919?'renovated-2020':'restoration-reference'):'earlier-reference',referenceYear:r.year===1919?2020:2026,historicalReference:!modern};}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.apply=(b,y)=>{const r=byId.get(b.id);if(!r||y<r.year)return old.apply(b,y);return {...b,polygon:r.polygon,holes:[],displayPolygons:[[r.polygon]],center:r.center,displayCenter:r.center,height:r.height,reviewed_name:r.name,landmarkArchitecture:profile(b,y),geometryRevision:r.key,geometryDisplayAdjusted:true,referenceGeometry:true,height_basis:'Three main storeys plus low basement; 11.4 m illustrative, not measured.',periodNote:notes[r.key][0]};};
 LandmarkArchitecture.note=(p,zh)=>notes[p.id]?notes[p.id][zh?1:0]:old.note(p,zh);
 function build({THREE,mergeGeometries,rings,profile:p,appearance,detail=true,building}){
  const f=LandmarkArchitecture.frame(rings[0],p),w=f.w,h=p.height-.45,is624=p.id==='charlotte62483';
  const palette={brick:is624?'#91663f':'#85553f',side:is624?'#a37a58':'#956e53',stone:'#d1c9b3',frame:is624?'#53605a':'#d3d2c5',glass:'#344a52',roof:'#73766e'};
  const vs=[],cs=[],pieces=[],cache=new Map(),world=(u,y,v)=>[f.x+f.ux*u+f.nx*v,y,f.z+f.uz*u+f.nz*v];
  const color=c=>{if(!cache.has(c))cache.set(c,new THREE.Color(c));return cache.get(c);};
  function quad(a,b,c,d,col){vs.push(...a,...b,...c,...a,...c,...d);const q=color(col);for(let i=0;i<6;i++)cs.push(q.r,q.g,q.b);}
  function add(g,col){if(g.index){const z=g;g=z.toNonIndexed();z.dispose();}g.deleteAttribute('uv');const q=color(col),arr=new Float32Array(g.attributes.position.count*3);for(let i=0;i<arr.length;i+=3){arr[i]=q.r;arr[i+1]=q.g;arr[i+2]=q.b;}g.setAttribute('color',new THREE.BufferAttribute(arr,3));pieces.push(g);}
  function box(u,y,v,ww,hh,dd,col){const g=new THREE.BoxGeometry(ww,hh,dd);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...world(u,y,v));add(g,col);}
  let ring=rings[0].map(q=>[(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,(q.x-f.x)*f.nx+(q.z-f.z)*f.nz]);
  if(Math.hypot(ring[0][0]-ring.at(-1)[0],ring[0][1]-ring.at(-1)[1])<.01)ring.pop();
  if(ring.reduce((s,a,i)=>{const b=ring[(i+1)%ring.length];return s+a[0]*b[1]-b[0]*a[1];},0)>0)ring.reverse();
  for(let i=0;i<ring.length;i++){
   const a=ring[i],b=ring[(i+1)%ring.length],len=Math.hypot(b[0]-a[0],b[1]-a[1]);if(len<.001)continue;
   const du=(b[0]-a[0])/len,dv=(b[1]-a[1])/len,front=Math.abs(a[1])<.075&&Math.abs(b[1])<.075;
   const pt=(x,y,o=0)=>world(a[0]+du*x-dv*o,y,a[1]+dv*x+du*o),brick=front?palette.brick:palette.side;
   function panel(l,r,lo,hi,c,o=0){if(r-l<.001||hi-lo<.001)return;quad(pt(l,lo,o),pt(l,hi,o),pt(r,hi,o),pt(r,lo,o),c);}
   const wins=[];
   if(detail){
    for(let row=0;row<3;row++){
     const lo=1.35+row*3.04,hi=lo+1.95;
     if(front){
      for(const q of [.10,.255,.345,.466,.50,.534,.655,.745,.90]){
       if(row===0&&q>.4&&q<.6)continue;
       wins.push({x:q*len,w:q>.4&&q<.6?len*.03:len*.052,lo,hi});
      }
      if(row===0)wins.push({x:len*.5,w:1.48,lo:.3,hi:3.2});
     }else{
      // Long side walls retain a broad blank pier; windows belong to court returns.
      const count=Math.floor(len/3.3);
      for(let j=0;j<count;j++){
       if(!is624&&len>7&&j>0&&j<count-1)continue;
       wins.push({x:(j+.5)*len/count,w:j%3===1?1.65:1.03,lo,hi});
      }
     }
    }
    if(front)for(const q of [.10,.30,.70,.90])wins.push({x:q*len,w:.9,lo:.12,hi:.72});
   }
   const ys=[...new Set([0,h,1.0,...wins.flatMap(q=>[q.lo,q.hi])])].sort((a,b)=>a-b);
   for(let j=1;j<ys.length;j++){
    const lo=ys[j-1],hi=ys[j],mid=(lo+hi)/2;let cursor=0;
    const material=front&&!is624&&hi<=1?palette.stone:brick;
    for(const q of wins.filter(q=>mid>q.lo&&mid<q.hi).sort((a,b)=>a.x-b.x)){panel(cursor,q.x-q.w/2,lo,hi,material);cursor=q.x+q.w/2;}
    panel(cursor,len,lo,hi,material);
   }
   for(const q of wins){
    const l=q.x-q.w/2,r=q.x+q.w/2;
    panel(l,r,q.lo,q.hi,palette.glass,-.14);
    quad(pt(l,q.lo),pt(l,q.hi),pt(l,q.hi,-.14),pt(l,q.lo,-.14),brick);
    quad(pt(r,q.lo,-.14),pt(r,q.hi,-.14),pt(r,q.hi),pt(r,q.lo),brick);
    panel(l-.05,r+.05,q.lo-.08,q.lo,palette.stone,.025);
    panel(l,l+.04,q.lo,q.hi,palette.frame,-.065);panel(r-.04,r,q.lo,q.hi,palette.frame,-.065);
    panel(l,r,q.hi-.05,q.hi,palette.frame,-.06);panel(l,r,(q.lo+q.hi)/2-.025,(q.lo+q.hi)/2+.025,palette.frame,-.06);
   }
   panel(0,len,h-.12,h,palette.stone,.012);
   if(front){panel(0,len,3.60,3.78,palette.stone,.045);panel(len*.025,len*.975,9.92,10.17,palette.stone,.015);if(!is624)panel(0,len,.95,1.13,palette.stone,.03);}
  }
  // Concave roof preserves all six 644 courts.
  const sh=new THREE.Shape();ring.forEach(([u,v],i)=>{const q=world(u,0,v);i?sh.lineTo(q[0],-q[2]):sh.moveTo(q[0],-q[2]);});sh.closePath();const roof=new THREE.ShapeGeometry(sh);roof.rotateX(-Math.PI/2);roof.translate(0,h-.20,0);add(roof,palette.roof);
  // Rectangular stone entrance portal, central transom and stepped parapet.
  box(-.88,1.82,.02,.25,3.64,.12,palette.stone);box(.88,1.82,.02,.25,3.64,.12,palette.stone);box(0,3.40,.025,2.10,.4,.14,palette.stone);box(0,3.67,.03,2.36,.15,.17,palette.stone);
  box(0,h+.14,-.09,w*.26,.28,.18,palette.brick);box(0,h+.365,-.09,w*.18,.17,.18,palette.brick);
  box(0,h+.45,-.09,w*.18,.025,.2,palette.stone);
  if(detail){
   // Subtle facade masonry courses are drawn on the exterior plane, not full-depth slabs.
   for(const y of [1.18,2.05,2.95])for(const sign of [-1,1]){const l=sign<0?-w/2:1.05,r=sign<0?-1.05:w/2;quad(world(l,y,.012),world(l,y+.018,.012),world(r,y+.018,.012),world(r,y,.012),is624?'#78533b':'#bcb29e');}
   for(const u of [-w*.245,w*.245])box(u,10.52,.014,.22,.18,.06,palette.stone);
   // Shallow entrance stair kept to the immediate frontage; exact step dimensions unmeasured.
   if(is624)for(let j=0;j<3;j++)box(0,.05+j*.10,.17+(2-j)*.22,1.75,.10+j*.2,.23,palette.stone);
  }
  if(vs.length){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(vs,3));g.setAttribute('color',new THREE.Float32BufferAttribute(cs,3));g.computeVertexNormals();pieces.push(g);}
  const geometry=mergeGeometries(pieces,false);pieces.forEach(g=>g.dispose());geometry.computeBoundingSphere();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1}));mesh.userData={building,charlotte83:true,detail,phase:p.phaseKey};return mesh;
 }
 LandmarkArchitecture.build=args=>notes[args.profile.id]?build(args):old.build(args);
 return {build,profile,notes};
})();

/* Documented building types and frontage features; one mesh per LOD, no textures. */
/* 2701 Cass: photo-derived architecture, one merged mesh per LOD; no textures. */
const CassGarageGeometry92=(()=>{
 function build({THREE,mergeGeometries,rings,building,profile:p,appearance,detail=true}){
  const f=LandmarkArchitecture.frame(rings[0],p),w=f.w,H=7.0,dep=f.depth,parts=[],verts=[],colors=[],cache=new Map();
  f.ux=-f.ux;f.uz=-f.uz;
  const brick='#9a5848',stone='#b8b0a0',glass='#779698',grout='#48666a',metal='#666e70',roof='#686b64';
  const rgb=x=>{if(!cache.has(x))cache.set(x,new THREE.Color(x));return cache.get(x);};
  const pt=(u,y,d=0)=>[f.x+f.ux*u+f.nx*d,y,f.z+f.uz*u+f.nz*d];
  function add(g,c){if(g.index){const old=g;g=g.toNonIndexed();old.dispose();}g.deleteAttribute('uv');const q=rgb(c),a=new Float32Array(g.attributes.position.count*3);for(let i=0;i<a.length;i+=3){a[i]=q.r;a[i+1]=q.g;a[i+2]=q.b;}g.setAttribute('color',new THREE.BufferAttribute(a,3));parts.push(g);}
  function quad(a,b,c,d,color){verts.push(...a,...b,...c,...a,...c,...d);const q=rgb(color);for(let i=0;i<6;i++)colors.push(q.r,q.g,q.b);}
  function panel(l,r,b,t,color,d=.035){quad(pt(l,b,d),pt(l,t,d),pt(r,t,d),pt(r,b,d),color);}
  function box(u,y,d,b,h,t,color){const g=new THREE.BoxGeometry(b,h,t);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...pt(u,y,d));add(g,color);}
  // The original registered ring is retained, with a shallow loading-door recess.
  const half=w*.177,rad=w*.061,recess=rad,doorHalf=half-rad,ring=rings[0].slice();
  if(Math.hypot(ring[0].x-ring.at(-1).x,ring[0].z-ring.at(-1).z)<.01)ring.pop();
  const local=q=>({u:(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,d:(q.x-f.x)*f.nx+(q.z-f.z)*f.nz});
  const outline=[];
  for(let i=0;i<ring.length;i++){
   const a=local(ring[i]),b=local(ring[(i+1)%ring.length]);outline.push([a.u,a.d]);
   if(Math.abs(a.d)<.08&&Math.abs(b.d)<.08){
    const notch=[[-half,0]];
    for(let k=1;k<=6;k++){const t=k*Math.PI/12;notch.push([-half+rad*Math.sin(t),-rad+rad*Math.cos(t)]);}
    notch.push([doorHalf,-recess]);
    for(let k=1;k<=6;k++){const t=(6-k)*Math.PI/12;notch.push([half-rad*Math.sin(t),-rad+rad*Math.cos(t)]);}
    if(a.u>b.u)notch.reverse();outline.push(...notch);
   }
  }
  // Build actual wall openings, avoiding coplanar overlays in SVG fallback.
  const frontHoles=[[-w*.414,-w*.210,1.12,5.30],[w*.209,w*.422,2.25,5.30],[w*.232,w*.364,.12,2.18]];
  function wall(a,b,lo=0,hi=H){if(hi>lo+.001)quad(pt(a[0],lo,a[1]),pt(a[0],hi,a[1]),pt(b[0],hi,b[1]),pt(b[0],lo,b[1]),brick);}
  function cutWall(a,b,axis,holes){
   const k=axis==='u'?0:1,low=Math.min(a[k],b[k]),high=Math.max(a[k],b[k]),breaks=[low,high,...holes.flatMap(h=>[h[0],h[1]]).filter(t=>t>low&&t<high)].sort((a,b)=>a-b);
   const at=t=>{const q=(t-a[k])/(b[k]-a[k]);return [a[0]+q*(b[0]-a[0]),a[1]+q*(b[1]-a[1])];};
   for(let j=0;j<breaks.length-1;j++){const l=breaks[j],r=breaks[j+1],mid=(l+r)/2,active=holes.filter(h=>mid>h[0]&&mid<h[1]).sort((a,b)=>a[2]-b[2]);let y=0;for(const h of active){wall(at(l),at(r),y,h[2]);y=h[3];}wall(at(l),at(r),y,H);}
  }
  const sideEdges=ring.map((q,i)=>[local(q),local(ring[(i+1)%ring.length])]).filter(([a,b])=>Math.abs(a.d-b.d)>dep*.5).sort((a,b)=>(a[0].u+a[1].u)-(b[0].u+b[1].u)),edge=sideEdges[0];
  const sideMid=(edge[0].u+edge[1].u)/2;
  for(let i=0;i<outline.length;i++){
   const a=outline[i],b=outline[(i+1)%outline.length];
   if(Math.abs(a[1])<.08&&Math.abs(b[1])<.08)cutWall(a,b,'u',frontHoles);
   else if(Math.abs(a[1]+recess)<.01&&Math.abs(b[1]+recess)<.01&&Math.abs(a[0])<half&&Math.abs(b[0])<half)wall(a,b,5.53,H);
   else if(Math.abs(a[1]-b[1])>dep*.5&&(a[0]+b[0])/2<sideMid+.1)cutWall(a,b,'d',[[-dep+1.3,-1.2,1.2,5.28]]);
   else wall(a,b);
  }
  // Concrete head spans the recessed bay; the shutter is actually behind it.
  box(0,6.49,-recess/2,half*2,1.02,recess,brick);
  box(0,5.77,-recess/2+.08,half*2+.5,.42,recess+.34,stone);
  panel(-doorHalf,doorHalf,.18,5.53,metal,-recess+.024);
  box(-doorHalf-.10,2.78,-recess+.10,.20,5.5,.22,stone);box(doorHalf+.10,2.78,-recess+.10,.20,5.5,.22,stone);
  // Front glass-block bays and pedestrian door: large-scale geometry at both LODs.
  const left=[-w*.414,-w*.210],right=[w*.209,w*.422];
  panel(...left,1.12,5.30,glass);panel(...right,2.25,5.30,glass);
  panel(w*.232,w*.364,.12,2.18,'#625c53');
  for(const u of [-w*.47,w*.20,w*.432])box(u,2.71,.075,.18,5.32,.13,stone);
  panel(-w/2,-half,.96,1.055,stone,.07);panel(half,w/2,.96,1.055,stone,.07);
  // Long Ledyard elevation: brick base, broad infill/window band and piers.
  const su=d=>edge[0].u+(edge[1].u-edge[0].u)*(d-edge[0].d)/(edge[1].d-edge[0].d)-.045;
  const side=(a,b,lo,hi,c)=>{const o=c===glass?0:.025;quad(pt(su(a)-o,lo,a),pt(su(a)-o,hi,a),pt(su(b)-o,hi,b),pt(su(b)-o,lo,b),c);};
  side(-1.2,-dep+1.3,1.2,5.28,glass);side(-.3,-dep+.3,5.28,5.43,stone);side(-.3,-dep+.3,1.05,1.17,stone);
  for(let i=1;i<4;i++){const d=-dep*i/4;side(d-.16,d+.16,1.15,5.4,stone);}
  // Shallow longitudinal gable behind the parapet, read from all three photos.
  const gw=w*.64,front=-2.6,back=-dep+1.0,eave=6.72,peak=7.75;
  quad(pt(-gw/2,eave,front),pt(0,peak,front),pt(0,peak,back),pt(-gw/2,eave,back),roof);
  quad(pt(0,peak,front),pt(gw/2,eave,front),pt(gw/2,eave,back),pt(0,peak,back),roof);
  quad(pt(-w/2+.15,eave,-.10),pt(w/2-.15,eave,-.10),pt(w/2-.15,eave,front),pt(-w/2+.15,eave,front),roof);
  quad(pt(-w/2+.15,eave,back),pt(w/2-.15,eave,back),pt(w/2-.15,eave,-dep+.15),pt(-w/2+.15,eave,-dep+.15),roof);
  for(const sign of [-1,1])quad(pt(sign*w/2*.99,eave,front),pt(sign*gw/2,eave,front),pt(sign*gw/2,eave,back),pt(sign*w/2*.99,eave,back),roof);
  quad(pt(-gw/2,eave,front+.02),pt(0,peak,front+.02),pt(gw/2,eave,front+.02),pt(gw/2,eave,front+.02),stone);
  if(detail){
   for(let y=.45;y<5.5;y+=.27)panel(-doorHalf,doorHalf,y,y+.026,'#4f585b',-recess+.045);
   function grid(l,r,lo,hi){for(let x=l+.29;x<r;x+=.29)panel(x,x+.024,lo,hi,grout,.052);for(let y=lo+.29;y<hi;y+=.29)panel(l,r,y,y+.024,grout,.052);}
   grid(...left,1.12,5.30);grid(...right,2.25,5.30);
   // Sparse course lines give masonry scale without a per-brick mesh or image.
   for(let y=.28;y<H;y+=.36){if(y<1.12||y>5.43){panel(-w/2,-half,y,y+.012,'#784e43',.025);panel(half,w/2,y,y+.012,'#784e43',.025);side(-.3,-dep+.3,y,y+.012,'#784e43');}}
   for(let d=-1.5;d>-dep+1.5;d-=1.2)side(d,d-.024,1.25,5.24,grout);
   box(w*.342,1.08,.12,.10,.11,.10,stone);
  }
  if(verts.length){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));g.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));g.computeVertexNormals();parts.push(g);}
  const geometry=mergeGeometries(parts,false);parts.forEach(g=>g.dispose());geometry.computeBoundingSphere();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1,side:THREE.DoubleSide}));mesh.userData={building,cass2701:true,detail};return mesh;
 }
 return {build};
})();

const CassArchitecture87=(()=>{
 const refs=CassCorridorResearch87.records.filter(r=>r.model),byId=new Map(refs.flatMap(r=>r.ids.map(id=>[id,r])));
 const old={anchorHeight:LandmarkArchitecture.anchorHeight,profile:LandmarkArchitecture.profile,apply:LandmarkArchitecture.apply,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note};
 for(const r of refs){LandmarkArchitecture.profiles.push({...r.model,ids:r.ids,name:r.name,nameZh:r.name});LandmarkArchitecture.sources[r.id]={url:r.sources[0].url,label:r.sources[0].title};}
 function profile(b,y){const r=byId.get(b.id);return r&&y>=r.model.from?{...r.model,ids:r.ids,name:r.name,sceneYear:y,phaseKey:'construction-reference',historicalReference:y<r.model.referenceYear}:old.profile(b,y);}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.anchorHeight=(id,y)=>{const r=CassCorridorResearch87.byId.get(id);return r?r.heightReference+3:old.anchorHeight(id,y);};
 LandmarkArchitecture.apply=(b,y)=>{const r=byId.get(b.id);if(!r||y<r.model.from)return old.apply(b,y);return {...b,height:r.model.height,landmarkArchitecture:profile(b,y),geometryRevision:(b.geometryRevision||b.id)+'|'+r.model.id,referenceGeometry:true,height_basis:'Documented storeys; illustrative metric height.'};};
 LandmarkArchitecture.note=(p,zh)=>p.kind==='garage92'?(zh?"细化模型自清册记录的 1946 年建造年起显示。红砖墙、弧形装卸门侧壁、混凝土门楣、玻璃砖窗及低坡屋顶依据 2016 年外观与用户提供照片；高度及开口尺寸为比例推估。照片年份不控制模型起始时间；原始用途及临时改动年代待核实。":"Detailed model from the reported 1946 construction year. Red-brick walls, curved loading-door reveals, concrete lintel, glass-block bays and a shallow gable follow the 2016 exterior and user-supplied photographs. Heights and opening dimensions are proportional estimates. Later images are references, not activation dates; original use and undated temporary alterations remain unresolved."):p.id?.startsWith('cass87-')?(zh?
  (p.dateBasis==='construction'?`细化模型从${p.constructionApproximate?'约 ':''}${p.from} 年建成起显示。`:`建造年待核实；${p.from} 年是已核实的建筑记录年份。`)+`${p.referenceYear} 年资料用于解释建筑细部，不作为建造日期。早期立面按连续性作参考重建；轮廓、层高、窗距和材料色为简化表达，并非逐年实测。后期屋顶增建未纳入。`:
  (p.dateBasis==='construction'?`Detailed model begins at ${p.constructionApproximate?'c. ':''}${p.from} construction. `:`Construction unconfirmed; ${p.from} is a verified observation. `)+`Exterior evidence dated ${p.referenceYear} guides the detail, not the construction date. Earlier facades are continuity-based reference reconstructions; footprints, heights, window spacing and colors are simplified, not annual surveys. Later rooftop additions are excluded.`):old.note(p,zh);
 function build({THREE,mergeGeometries,shapes,rings,building,profile:p,appearance,detail=true}){
  const f=LandmarkArchitecture.frame(rings[0],p),parts=[],v=[],c=[],stone='#c9c0ab',glass='#3a4c51';
  const colorCache=new Map(),col=x=>{if(!colorCache.has(x))colorCache.set(x,new THREE.Color(x));return colorCache.get(x);};
  function add(g,color){if(g.index){const old=g;g=g.toNonIndexed();old.dispose();}g.deleteAttribute('uv');const q=col(color),a=new Float32Array(g.attributes.position.count*3);for(let i=0;i<a.length;i+=3){a[i]=q.r;a[i+1]=q.g;a[i+2]=q.b;}g.setAttribute('color',new THREE.BufferAttribute(a,3));parts.push(g);}
  const body=new THREE.ExtrudeGeometry(shapes,{depth:p.height,bevelEnabled:false,steps:1});body.rotateX(-Math.PI/2);add(body,p.color);
  const pt=(u,y,d=.022)=>[f.x+f.ux*u+f.nx*d,y,f.z+f.uz*u+f.nz*d];
  function quad(a,b,d,e,color){v.push(...a,...b,...d,...a,...d,...e);const q=col(color);for(let i=0;i<6;i++)c.push(q.r,q.g,q.b);}
  function panel(l,r,lo,hi,color,d=.03){quad(pt(l,lo,d),pt(l,hi,d),pt(r,hi,d),pt(r,lo,d),color);}
  function box(u,y,w,h,depth,color,d=0){const g=new THREE.BoxGeometry(w,h,depth);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...pt(u,y,d));add(g,color);}
  // Facade planes add no independent draw calls. Existing courtyard holes remain open.
  panel(-f.w/2,f.w/2,0,Math.min(1.2,p.height*.2),stone);
  panel(-f.w/2,f.w/2,p.height-.25,p.height,stone);
  if(detail){
   const base=p.kind==='shop'?.45:1.05,step=(p.height-base-.7)/p.floors;
   for(let row=0;row<p.floors;row++){
    const count=p.kind==='industrial'&&row===0?3:p.bays;
    for(let j=0;j<count;j++){
     const u=-f.w/2+(j+.5)*f.w/count,w=Math.min(p.kind==='shop'?f.w/count*.78:1.5,f.w/count*.55),lo=base+row*step,hi=Math.min(p.height-.6,lo+step*.64);
     panel(u-w/2-.055,u+w/2+.055,lo-.08,hi+.08,stone,.036);
     panel(u-w/2,u+w/2,lo,hi,glass,.048);
     panel(u-w/2,u+w/2,(lo+hi)/2-.025,(lo+hi)/2+.025,stone,.053);
     if((p.kind==='arches'&&row===p.floors-1)||(p.kind==='finn'&&row===0)){
      const rr=w/2,cy=hi-rr;
      for(let k=0;k<6;k++){const a=k*Math.PI/6,b=(k+1)*Math.PI/6;quad(pt(u+rr*Math.cos(a),cy+rr*Math.sin(a),.061),pt(u+(rr+.11)*Math.cos(a),cy+(rr+.11)*Math.sin(a),.061),pt(u+(rr+.11)*Math.cos(b),cy+(rr+.11)*Math.sin(b),.061),pt(u+rr*Math.cos(b),cy+rr*Math.sin(b),.061),stone);}
     }
    }
   }
   if(p.kind==='hotel'){panel(-f.w/2,f.w/2,3.2,3.42,stone);panel(-f.w/2,f.w/2,p.height-3.4,p.height-3.18,stone);}
   if(['portal','finn','quoins','elmoore'].includes(p.kind)){const w=Math.min(2.1,f.w*.22);box(-w/2,1.65,.19,3.3,.12,stone);box(w/2,1.65,.19,3.3,.12,stone);box(0,3.3,w+.35,.28,.14,stone);}
   if(p.kind==='quoins')for(let y=.5;y<p.height;y+=.6)for(const side of [-1,1])panel(side*f.w/2-(side>0?.28:0),side*f.w/2+(side<0?.28:0),y,y+.22,stone,.055);
   if(p.kind==='porch')for(let floor=1;floor<4;floor++){box(0,1.0+floor*step,Math.min(3.6,f.w*.3),.16,.42,stone,-.05);for(const u of [-1.2,1.2])box(u,.6+floor*step,.13,step-.3,.13,stone,-.03);}
   if(p.kind==='century'){const u=-f.w*.34;for(let floor=1;floor<4;floor++)box(u,1.0+floor*step,f.w*.14,.18,.20,stone,-.01);box(0,p.height+.12,f.w*.34,.24,.14,p.color,-.03);}
   if(p.kind==='shop')for(let j=0;j<=5;j++){const u=-f.w/2+j*f.w/5;panel(u-.11,u+.11,0,p.height,stone,.06);}
   if(p.kind==='elmoore'){const u=-f.w*.35;for(let j=0;j<3;j++)box(u+(j-1)*.7,p.height+.23,.34,.46,.35,p.color,-.2);}
  }
  if(v.length){const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(v,3));g.setAttribute('color',new THREE.Float32BufferAttribute(c,3));g.computeVertexNormals();parts.push(g);}
  const geometry=mergeGeometries(parts,false);parts.forEach(g=>g.dispose());geometry.computeBoundingSphere();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1}));mesh.userData={building,cass87:true,detail};return mesh;
 }
 LandmarkArchitecture.build=args=>args.profile.kind==='garage92'?CassGarageGeometry92.build(args):args.profile.id?.startsWith('cass87-')?build(args):old.build(args);
 return {profile,build};
})();
/* One initialization pass. Construction controls detail availability; dated
   additions, tenant signs and demolition remain independent phases. */
/* 3443 Cass: original masonry reference and documented April 2011 facade phase. */
const CanineArchitecture93=(()=>{
 const id='semcog-8136471',old={profile:LandmarkArchitecture.profile,apply:LandmarkArchitecture.apply,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note};
 function profile(b,y){const p=old.profile(b,y);if(b.id!==id||!p)return p;return {...p,sceneYear:y,phaseKey:y>=2011?'facade-2011':y>=2005?'masonry-2005':'masonry-1949',modern:y>=2011};}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.apply=(b,y)=>{const a=old.apply(b,y),p=profile(b,y);return b.id===id&&p?{...a,landmarkArchitecture:p,geometryRevision:(a.geometryRevision||b.id)+'|'+p.phaseKey}:a;};
 LandmarkArchitecture.note=(p,zh)=>p.kind!=='canine93'?old.note(p,zh):(zh?(p.modern?'2011 年 4 月立面改造：D MET 确认纤维水泥雨幕、彩色饰板、新门窗和招牌。':'1949 年清册建造记录；细部依据 D MET 改造前照片作连续性参考重建，并非已核实的 1949 年原貌。')+' 高度、比例和开口尺寸为推估；2005 年前不显示犬只护理品牌。2018 年扩建体量另行保留，未回填到 1949 年。':(p.modern?'April 2011 facade renovation: D MET documents fiber-cement rainscreen, colored panels, new windows, doors and signage.':'Reported construction: 1949. Detail uses D MET’s pre-renovation photograph as a continuity-based reference, not a verified 1949 elevation.')+' Heights, proportions and openings are estimates. Dog-care branding begins in 2005. The separately dated 2018 addition is not backdated to 1949.');
 function build({THREE,mergeGeometries,rings,building,profile:p,appearance,detail=true}){
  const f=LandmarkArchitecture.frame(rings[0],p);f.ux=-f.ux;f.uz=-f.uz;
  const w=f.w,H=5.2,v=[],c=[],cache=new Map(),modern=p.modern,brick='#ab926c',gray='#92958b',roof='#646762',glass='#314441';
  const rgb=s=>{if(!cache.has(s))cache.set(s,new THREE.Color(s));return cache.get(s);};
  const pt=(u,y,d=0)=>[f.x+f.ux*u+f.nx*d,y,f.z+f.uz*u+f.nz*d];
  function tri(a,b,d,color){v.push(...a,...b,...d);const q=rgb(color);for(let i=0;i<3;i++)c.push(q.r,q.g,q.b);}
  function quad(a,b,d,e,color){tri(a,b,d,color);tri(a,d,e,color);}
  function panel(l,r,b,t,color,d=.022){quad(pt(l,b,d),pt(l,t,d),pt(r,t,d),pt(r,b,d),color);}
  const ring=rings[0].slice();if(Math.hypot(ring[0].x-ring.at(-1).x,ring[0].z-ring.at(-1).z)<.01)ring.pop();
  const local=q=>[(q.x-f.x)*f.ux+(q.z-f.z)*f.uz,(q.x-f.x)*f.nx+(q.z-f.z)*f.nz];
  const outline=ring.map(local),winCenters=[-.424,-.357,-.287,-.218,-.148,.140,.214,.286,.358,.430].map(x=>x*w),ww=w*.029;
  const holes=[[-w*.045,w*.048,0,2.86],...winCenters.map(x=>[x-ww/2,x+ww/2,1.62,2.84])];
  function wall(a,b){quad(pt(a[0],0,a[1]),pt(a[0],H,a[1]),pt(b[0],H,b[1]),pt(b[0],0,b[1]),'#85897e');}
  for(let i=0;i<outline.length;i++){const a=outline[i],b=outline[(i+1)%outline.length];if(!(Math.abs(a[1])<.08&&Math.abs(b[1])<.08))wall(a,b);}
  function frontCell(l,r,b,t,color,d=.024){
   const cuts=[l,r,...holes.flatMap(h=>[h[0],h[1]]).filter(x=>x>l&&x<r)].sort((a,b)=>a-b);
   for(let i=0;i<cuts.length-1;i++){const x=(cuts[i]+cuts[i+1])/2,active=holes.filter(h=>x>h[0]&&x<h[1]&&h[3]>b&&h[2]<t).sort((a,b)=>a[2]-b[2]);let lo=b;for(const h of active){if(h[2]>lo)panel(cuts[i],cuts[i+1],lo,Math.min(t,h[2]),color,d);lo=Math.max(lo,h[3]);}if(lo<t)panel(cuts[i],cuts[i+1],lo,t,color,d);}
  }
  if(modern){
   frontCell(-w/2,w/2,0,H,'#6c756b',.030);
   // Four rows of dry-jointed panels, with the documented orange/blue rhythm.
   const levels=[.28,1.61,2.86,4.03,5.16],seams=detail?.010:0;
   const columns=24;
   const accents=[{2:'#e76220',3:'#4d9ecb',20:'#e76220',21:'#4d9ecb'},{0:'#4d9ecb',13:'#77afc9'},{2:'#e76220',4:'#d9e1da',5:'#67a4c3',16:'#e76220',23:'#e76220'},{0:'#e76220',1:'#d9e1da',2:'#3593c2',6:'#ed6a1d',8:'#dde3df',9:'#78adca',13:'#ed6a1d',15:'#dde3df',16:'#73abc9',20:'#ec6b20',22:'#559dc2'}];
   for(let row=0;row<4;row++)for(let j=0;j<columns;j++){const l=-w/2+j*w/columns,r=l+w/columns;frontCell(l+seams,r-seams,levels[row]+seams,levels[row+1]-seams,accents[row][j]||gray,.065);}
   frontCell(-w/2,w/2,0,.27,'#6b7468');
  }else{
   frontCell(-w/2,w/2,0,H,brick);
   if(detail)for(let y=.22;y<H;y+=.24)frontCell(-w/2,w/2,y,y+.010,'#917e60',.033);
  }
  // True openings, recessed glazing and entry; no solid front extrusion behind them.
  for(const x of winCenters){panel(x-ww/2,x+ww/2,1.62,2.84,glass,-.045);if(detail){panel(x-ww/2-.028,x-ww/2,1.59,2.88,'#585e55',.09);panel(x+ww/2,x+ww/2+.028,1.59,2.88,'#585e55',.09);panel(x-ww/2,x+ww/2,1.59,1.64,'#bcbca7',.095);if(!modern){panel(x-.014,x+.014,1.63,2.83,'#828d83',-.023);for(let y=1.88;y<2.83;y+=.26)panel(x-ww/2,x+ww/2,y,y+.014,'#828d83',-.020);}}}
  const dl=-w*.045,dr=w*.048;panel(dl,dr,.05,2.86,'#323a35',-.28);panel(dl+.12,dr-.12,.40,2.35,modern?'#344b4a':p.sceneYear>=2005?'#a6402f':'#626550',-.25);panel(dl+.13,dr-.13,1.35,2.25,glass,-.23);
  quad(pt(dl,0,0),pt(dl,2.86,0),pt(dl,2.86,-.30),pt(dl,0,-.30),'#5e655c');quad(pt(dr,0,0),pt(dr,2.86,0),pt(dr,2.86,-.30),pt(dr,0,-.30),'#5e655c');panel(dl,dr,2.72,2.86,'#384139',.075);
  const center=outline.reduce((a,b)=>[a[0]+b[0]/outline.length,a[1]+b[1]/outline.length],[0,0]);
  for(let i=0;i<outline.length;i++){const a=outline[i],b=outline[(i+1)%outline.length];tri(pt(center[0],H-.10,center[1]),pt(a[0],H-.10,a[1]),pt(b[0],H-.10,b[1]),roof);}
  panel(-w/2-.025,w/2+.025,H-.035,H+.055,'#3d463f',.075);
  if(detail){
   for(let i=0;i<outline.length;i++){const a=outline[i],b=outline[(i+1)%outline.length];if(Math.abs(a[1])<.08&&Math.abs(b[1])<.08)continue;for(let y=.4;y<H;y+=.4)quad(pt(a[0]*1.002,y,a[1]*1.001),pt(a[0]*1.002,y+.012,a[1]*1.001),pt(b[0]*1.002,y+.012,b[1]*1.001),pt(b[0]*1.002,y,b[1]*1.001),'#747c70');}
  }
  if(p.sceneYear>=2005){
