  const mesh=new THREE.Mesh(geometry,new THREE.MeshLambertMaterial({vertexColors:true,transparent:appearance.opacity<1,opacity:appearance.opacity,depthWrite:appearance.opacity===1}));mesh.userData={building,block82:true,detail,phase:p.phaseKey};return mesh;
