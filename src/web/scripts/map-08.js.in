   quad(pt(dr+.16,dy-.08,frontD+.20),pt(dormer,peak+.11,frontD+.20),pt(dormer,peak-.7,-.5),pt(dr+.16,dy-.08,-.5),'#626d5c');
   if(detail){quad(pt(dl-.15,dy-.1,frontD+.23),pt(dl-.04,dy-.1,frontD+.23),pt(dormer,peak,frontD+.23),pt(dormer,peak+.14,frontD+.23),stone);quad(pt(dr+.15,dy-.1,frontD+.23),pt(dr+.04,dy-.1,frontD+.23),pt(dormer,peak,frontD+.23),pt(dormer,peak+.14,frontD+.23),stone);}
