   const vertex=(u,y)=>[a.x+ux*u+nx*review.seamMarginM,y,a.z+uz*u+nz*review.seamMarginM];
   const emit=(p,q,r)=>{
    const cross=new THREE.Vector3().subVectors(new THREE.Vector3(...q),new THREE.Vector3(...p)).cross(new THREE.Vector3().subVectors(new THREE.Vector3(...r),new THREE.Vector3(...p)));
    if(cross.lengthSq()<1e-12)return;
    if(cross.x*normal[0]+cross.z*normal[2]<0)[q,r]=[r,q];
