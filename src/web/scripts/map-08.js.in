const ColeArchitecture99=(()=>{
 const id='semcog-8134097',source='https://www.metrotimes.com/news/still-standing-the-cole-2271396/';
 const base={id:'cole99',entity:'cole99',ids:[id],kind:'cole99',name:'The Cole · 2753 Park Avenue',nameZh:'The Cole · 2753 Park Avenue',from:1889,through:2016,body:11.5,height:11.5,floors:3,bays:3,facing:[.861799,-.507250],sources:['cole99']};
 LandmarkArchitecture.profiles.push(base);
 LandmarkArchitecture.sources.cole99={label:'The Cole · dated exterior photographs and building history',url:source};
 const old={profile:LandmarkArchitecture.profile,apply:LandmarkArchitecture.apply,build:LandmarkArchitecture.build,note:LandmarkArchitecture.note,anchorHeight:LandmarkArchitecture.anchorHeight};
 function profile(b,y){if(b.id!==id)return old.profile(b,y);if(y<1889||y>2016)return null;return {...base,sceneYear:y,height:y<1919?7.9:11.5,body:y<1919?6.7:11.5,floors:y<1919?2:3,phaseKey:y<1919?'frame-house':y<2014?'brick-front-and-frame':'boarded-front-reduced-rear',historicalReference:false,additionUncertain:y>=1914&&y<1919};}
 LandmarkArchitecture.profile=profile;
 LandmarkArchitecture.apply=(b,y)=>{if(b.id!==id)return old.apply(b,y);const p=profile(b,y);return p?{...b,reviewed_name:'The Cole · 2753 Park Avenue',height:p.height,landmarkArchitecture:p,geometryRevision:'cole99-'+p.phaseKey,referenceGeometry:true,height_basis:'Photo-proportional heights and registered footprint; not a measured reconstruction.'}:b;};
 LandmarkArchitecture.anchorHeight=(key,y)=>key===id||key==='cass87-R87_04'?((y<1919?7.9:11.5)+2):old.anchorHeight(key,y);
 LandmarkArchitecture.note=(p,zh)=>p.id!=='cole99'?old.note(p,zh):(zh?
  '原木构住宅在 1880 年代已存在。1898 年是 William E. Cole 搬入，不是扩建年。三层砖砌前楼据报道于 1919 年地图上出现；模型以该已存在年份切换，实际施工时间仍在约 1914–1919 年之间待核。2005／2014 年照片用于门窗、入口、檐口和前后高差细化。2014 年封窗及后部缩减是观测状态，具体改动日期未知。历史照片年代不延迟建筑细节显示。轮廓、色彩、未摄立面及尺寸为近似；原始马厩位置未核，未另建。2026年6月调查确认该地址已无建筑；2017年为原清册移除年，年份和具体拆除日均待独立核实。':
  'The frame house existed by the 1880s. 1898 dates William E. Cole’s arrival, not the addition. The brick front is reported on a 1919 map; this documented latest bound controls its model phase, with construction within c.1914–1919 unresolved. The 2005/2014 photos guide openings, entrance, cornice and stepped rear volumes. Boarding and rear reduction are observed by 2014, not dated renovation events. Detail is present from each construction phase. Dimensions, colors and unseen elevations are approximate. The unlocated former stable is not modeled. No building remains by June 2026. Inventory removal year: 2017, awaiting independent year/date confirmation.');
 function build({THREE:T,mergeGeometries,building,profile:p,rings,appearance,detail=true}){
  const f=LandmarkArchitecture.frame(rings[0],base),parts=[],brick='#974d3b',wood='#b9ac84',stone='#bfc0ae',roof='#656b60',glass='#455c57';
  const w=f.w-.18,frontD=4.94,rearW=Math.min(w*.76,6.72),rearU=-.26,depth=f.depth-.2,houseStart=4.94;
  const pos=(u,y,d)=>[f.x+f.ux*u-f.nx*d,y,f.z+f.uz*u-f.nz*d];
  function add(g,color){if(g.index){const a=g;g=a.toNonIndexed();a.dispose();}g.deleteAttribute('uv');const c=new T.Color(color),cs=new Float32Array(g.attributes.position.count*3);for(let i=0;i<cs.length;i+=3){cs[i]=c.r;cs[i+1]=c.g;cs[i+2]=c.b;}g.setAttribute('color',new T.BufferAttribute(cs,3));parts.push(g);}
  function box(u,y,d,a,b,c,color){const g=new T.BoxGeometry(a,b,c);g.rotateY(Math.atan2(-f.uz,f.ux));g.translate(...pos(u,y,d));add(g,color);}
  function volume(u,d0,d1,width,h,color){box(u,h/2,(d0+d1)/2,width,h,d1-d0,color);box(u,h+.06,(d0+d1)/2,width,.12,d1-d0,roof);}
  function frontPanel(u,y,width,h,color,d=-.018){box(u,y,d,width,h,.04,color);}
  function window(u,y,width,h,arched=false){
   frontPanel(u,y,width+.16,h+.16,stone,-.045);frontPanel(u,y,width,h,p.sceneYear>=2014?'#ae5743':glass,-.075);
   if(p.sceneYear<2014){frontPanel(u,y,width,.045,stone,-.102);frontPanel(u,y,.04,h,stone,-.102);}
   box(u,y-h/2-.1,-.08,width+.27,.13,.16,stone);box(u,y+h/2+.1,-.08,width+.29,.16,.15,stone);
