const ConstructionDetailTimeline88=(()=>{
 const audit=[],installed=new WeakSet;let timelineContext;
 function install(spatial,timeline){
  if(installed.has(spatial))return spatial;installed.add(spatial);timelineContext=timeline;
  const buildings=new Map(spatial.buildings.map(b=>[b.id,b]));
  const entities=new Map;for(const e of timeline.buildings||[])for(const id of e.envelopeIds||[])entities.set(id,e);
  const chungs=buildings.get('semcog-8135176');
  if(chungs?.exteriorPhases)chungs.exteriorPhases=chungs.exteriorPhases.map(p=>({...p,text:p.text.replace('base mass only','pre-renovation facade detail retained'),text_zh:p.text_zh.replace('仅显示基础体量','保留修缮前建筑细部')}));
  for(const [module,api] of [['core',CoreArchitecture],['landmark',LandmarkArchitecture]])for(const p of api.profiles){
   const entity=p.ids.map(id=>entities.get(id)).find(Boolean);
   const construction=entity?.events?.find(e=>e.type==='construction');
   const evidence=[...(entity?.events||[]).filter(e=>['observed','opening','use'].includes(e.type)).map(e=>e.from),...p.ids.map(id=>buildings.get(id)?.source_year)].filter(Number.isFinite);
   let start=construction?.to??construction?.from;
   let basis=Number.isFinite(start)?'construction':'standing-evidence';
   if(!Number.isFinite(start))start=Math.min(p.from,...evidence);
   // This is a documented renovation phase of a building whose original
   // exterior is provided by CoreArchitecture, not a separate building birth.
   if(p.id==='chungs-restored'){start=2025;basis='alteration';}
   const previous=p.from;p.from=start;
   if(p.id==='cass-chungs')p.through=2024;
   p.detailTimeline88={from:start,basis,construction:construction?[construction.from,construction.to]:null,previous};
   audit.push({module,id:p.id,ids:p.ids,from:start,previous,through:p.through,basis,construction:p.detailTimeline88.construction});
  }
  // Detail shares the lifetime of the geometry selected by Chronology.
  // A photo window or community move cannot independently turn a visible
  // building into a plain mass. Physical absence and explicit later phases
  // remain authoritative; this does not add or extend any building footprint.
  const profiles=[...CoreArchitecture.profiles,...LandmarkArchitecture.profiles];
  for(const p of profiles){
   const entity=p.ids.map(id=>entities.get(id)).find(Boolean);
   const demolition=entity?.events?.find(e=>e.type==='demolition');
   const inventoryEnd=p.ids.map(id=>buildings.get(id)?.inventory?.demolished).filter(Number.isFinite);
   const successors=profiles.filter(q=>q!==p&&q.from>p.from&&q.ids.some(id=>p.ids.includes(id)));
   const endCandidates=[timeline.maxYear||2026];
   // A sourced entity demolition takes precedence over a conflicting inventory.
   if(demolition)endCandidates.push(demolition.to-1);
   else if(inventoryEnd.length)endCandidates.push(Math.min(...inventoryEnd)-1);
   if(Number.isFinite(entity?.referenceModel?.throughYear))endCandidates.push(entity.referenceModel.throughYear);
   if(successors.length)endCandidates.push(Math.min(...successors.map(q=>q.from))-1);
   const previousThrough=p.through;p.through=Math.min(...endCandidates);
   Object.assign(p.detailTimeline88,{through:p.through,previousThrough,endBasis:'visible-geometry-lifetime',extended:p.through>previousThrough});
   Object.assign(audit.find(a=>a.id===p.id),{through:p.through,previousThrough,endBasis:'visible-geometry-lifetime'});
  }
  return spatial;
 }
 const coreProfile=CoreArchitecture.profile,coreApply=CoreArchitecture.apply,coreNote=CoreArchitecture.note,landmarkNote=LandmarkArchitecture.note;
 CoreArchitecture.profile=(b,y)=>{
  const p=coreProfile(b,y);if(!p)return p;
  if((p.kind==='association'||p.kind==='chungs')&&y<1963)p.variant='unlettered';
  if(p.kind==='onleong'&&y<1942){p.kind='third';p.variant='reference';}
  if(p.kind==='onleong'&&y>=1963){p.signageVisible=false;p.variant='post-relocation';}
  if(p.detailTimeline88?.extended&&y>p.detailTimeline88.previousThrough){
   const state=Chronology.state(b,y,timelineContext);
   p.continuityUnverified=!state.solid;p.sceneYear=y;
  }
  return p;
 };
 CoreArchitecture.apply=(b,y)=>{const next=coreApply(b,y),p=CoreArchitecture.profile(b,y);return p?{...next,height:p.height,coreArchitecture:p}:next;};
 function label(p,zh){const d=p.detailTimeline88;if(!d)return '';
  if(p.continuityUnverified)return zh?`${p.sceneYear} 年存续未核实。细部随时间线保留的历史参考轮廓显示，不代表已确认建筑在该年仍然存在；社区迁移不作为逐栋拆除日期，迁移后的营业招牌不显示。 `:`Presence in ${p.sceneYear} is unverified. Detail follows the historical reference footprint retained by the timeline, not confirmed survival in that year. Community relocation is not a building-specific demolition date; post-relocation business signs are omitted. `;
  if(d.basis==='alteration')return zh?`${d.from} 年修缮阶段；此前显示原建筑细部。 `:`Renovation phase from ${d.from}; earlier years retain original-building detail. `;
  const range=d.construction&&d.construction[0]!==d.construction[1]?d.construction.join('–'):String(d.from);
  return d.basis==='construction'?(zh?`细化模型自 ${d.from} 年起，依据建造记录（${range}）。 `:`Detailed model from ${d.from}, based on construction (${range}). `):(zh?`细化模型自 ${d.from} 年的存续证据起显示；该年不代表已确认的建造年。 `:`Detailed model from standing evidence in ${d.from}; this is not a confirmed construction year. `);
 }
 CoreArchitecture.note=(p,zh)=>label(p,zh)+coreNote(p,zh);
 LandmarkArchitecture.note=(p,zh)=>p.id?.startsWith('cass87-')?landmarkNote(p,zh):label(p,zh)+landmarkNote(p,zh);
 return {install,audit,label};
})();
window.SpatialDataReady=window.SpatialDataReady.then(s=>ConstructionDetailTimeline88.install(s,TIMELINE_DATA));
window.SpatialDataReady.catch(()=>{});
