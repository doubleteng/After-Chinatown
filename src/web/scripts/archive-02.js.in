/* Catalog filtering uses stated places and source dates, never AI-inferred coordinates. */
const ArchiveFilter=(()=>{
 function districts(r){
 if(r.location_unresolved===true)return [];
 if(r.location_approved===true&&['old','new'].includes(r.location_district))return [r.location_district];
  const p=String(r.place||'');
  if(/\bboth Chinatowns\b/i.test(p))return ['old','new'];
  const out=[];
  if(/\b(?:Third|3rd)\s+(?:Street|Avenue|St\.?|Ave\.?)\b|\bOriginal Chinatown\b|\bThird\s*(?:and|&|\/)\s*Porter\b/i.test(p))out.push('old');
  if(/\bCass\b|\bPeterboro\b|\bRelocated Chinatown\b/i.test(p))out.push('new');
  return out;
 }
 function years(r){return [...new Set((String(r.date||'').match(/\b(?:18|19|20)\d{2}\b/g)||[]).map(Number))];}
 function yearMatches(r,y){
  if(!y)return true;
  if(Object.prototype.hasOwnProperty.call(r,"historical_start"))return !!(r.historical_start&&r.historical_end&&r.historical_start<=y+"-12-31"&&r.historical_end>=y+"-01-01");
  if(/\bcollection range\b/i.test(String(r.date||'')))return false;
  const range=String(r.date||'').match(/\b((?:18|19|20)\d{2})\s*[–—-]\s*((?:18|19|20)\d{2})\b/);
  return range?Number(range[1])<=y&&y<=Number(range[2]):years(r).includes(Number(y));
 }
 function matches(r,f){
  if(f.place&&!districts(r).includes(f.place))return false;
  if(f.year&&!yearMatches(r,f.year))return false;
  if(f.kind&&r.category!==f.kind)return false;
  if(f.q&&!([r.title,r.title_zh,r.summary,r.summary_zh,r.place,r.date,r.id,r.credit,r.collection].join(' ').toLowerCase().includes(f.q.toLowerCase())))return false;
  const ys=years(r),period=f.period;
  return !period||(period==='unknown'&&!ys.length)||(period==='early'&&ys.some(y=>y<1940))||(period==='middle'&&ys.some(y=>y>=1940&&y<=1962))||(period==='later'&&ys.some(y=>y>=1963&&y<=1999))||(period==='recent'&&ys.some(y=>y>=2000));
 }
 return {districts,years,yearMatches,matches};
})();
if(typeof module!=='undefined')module.exports=ArchiveFilter;

/* Shared spatial evidence rules. Coordinates are [longitude, latitude]. */
const Spatial=(()=>{
 const validPoint=p=>Array.isArray(p)&&p.length===2&&p.every(Number.isFinite)&&Math.abs(p[0])<=180&&Math.abs(p[1])<=90;
 function distance(a,b){if(!validPoint(a)||!validPoint(b))return Infinity;const rad=Math.PI/180,dl=(b[1]-a[1])*rad,dn=(b[0]-a[0])*rad,t=Math.sin(dl/2)**2+Math.cos(a[1]*rad)*Math.cos(b[1]*rad)*Math.sin(dn/2)**2;return 12742000*Math.asin(Math.sqrt(Math.min(1,t)));}
 function inside(p,poly){if(!validPoint(p)||!Array.isArray(poly))return false;let yes=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){const a=poly[i],b=poly[j],cross=(p[0]-a[0])*(b[1]-a[1])-(p[1]-a[1])*(b[0]-a[0]);if(Math.abs(cross)<1e-12&&p[0]>=Math.min(a[0],b[0])-1e-12&&p[0]<=Math.max(a[0],b[0])+1e-12&&p[1]>=Math.min(a[1],b[1])-1e-12&&p[1]<=Math.max(a[1],b[1])+1e-12)return true;if((a[1]>p[1])!==(b[1]>p[1])&&p[0]<(b[0]-a[0])*(p[1]-a[1])/(b[1]-a[1])+a[0])yes=!yes;}return yes;}
 function areaForPoint(point,data){return data.areas.find(a=>inside(point,a.polygon))||data.areas.filter(a=>distance(point,a.center)<=(data.study_radius_m||0)).sort((a,b)=>distance(point,a.center)-distance(point,b.center))[0];}
 function context(raw,data){if(!raw||!validPoint(raw.point)||!data.radii.includes(Number(raw.radius))||!Number.isInteger(Number(raw.year))||Number(raw.year)<1800||Number(raw.year)>2026)throw new Error('BAD_CONTEXT');const area=areaForPoint(raw.point,data);if(!area)throw new Error('OUTSIDE_AREA');return {point:raw.point.map(n=>Math.round(n*1e7)/1e7),radius:Number(raw.radius),year:Number(raw.year),district:area.id,question:String(raw.question||'').slice(0,500)};}
 function same(a,b){return !!a&&!!b&&a.point.every((v,i)=>Math.abs(v-b.point[i])<1e-7)&&a.radius===b.radius&&a.year===b.year;}
 function photo(r){return r.source_kind==='primary_image'&&!/pamphlet|newspaper page/i.test(r.title||'')&&!!(r.image_url||r.has_private_image);}
 function enrich(records,data){return records.map(r=>{if(r.location_unresolved===true)return Object.assign({},r,{spatial:null});let a=data.anchors[data.record_anchors[r.id]];if(!a&&r.location_approved===true&&validPoint(r.coordinates)&&r.location_source)a={point:r.coordinates,basis:r.location_basis||'Owner-reviewed location',uncertainty_m:Math.max(1,Math.min(5000,Number(r.location_uncertainty)||100)),source_url:r.location_source,district:r.location_district||null};if(!a){const text=String(r.place||'').toLowerCase().replace(/\s+/g,' ');a=Object.values(data.anchors).find(a=>a.aliases.some(s=>text.includes(s)));}return Object.assign({},r,{spatial:a?{point:a.point,basis:a.basis,uncertainty_m:a.uncertainty_m,source_url:a.source_url,district:a.district}:null});});}
 function temporal(r,year){const ys=(String(r.date||'').match(/\b(?:18|19|20)\d{2}\b/g)||[]).map(Number);if(!ys.length)return {label:'Undated source',gap:9999,match:false};const range=String(r.date||'').match(/\b((?:18|19|20)\d{2})\s*[–—-]\s*((?:18|19|20)\d{2})\b/);const match=!/collection range/i.test(r.date||'')&&(ys.includes(year)||(range&&year>=+range[1]&&year<=+range[2]));const gap=match?0:Math.min(...ys.map(y=>Math.abs(y-year)));return {label:match?'Source date overlaps '+year:'Different source date · '+r.date,gap,match:!!match};}
 function photoDate(r,year,tolerance=5){
  const value=String(r.date||'').trim();if(/unknown|undated|unconfirmed|collection range|before|after|prior to|since|不详|未确认|以前|之后|之前|以后/i.test(value))return false;
  const decade=value.match(/\b((?:18|19|20)\d0)(?:s\b|年代)/);if(decade)return year>=+decade[1]-tolerance&&year<=+decade[1]+9+tolerance;
  const years=(value.match(/\b(?:18|19|20)\d{2}\b/g)||[]).map(Number);if(!years.length)return false;
  const range=value.match(/\b((?:18|19|20)\d{2})\s*[–—-]\s*((?:18|19|20)\d{2})\b/);
  if(range){const a=+range[1],b=+range[2];return b>=a&&b-a<=20&&year>=a-tolerance&&year<=b+tolerance;}
  if(years.length>1)return false;return Math.abs(years[0]-year)<=tolerance;
 }
 function nearby(records,c){return records.filter(r=>r.spatial&&photo(r)&&photoDate(r,c.year)).map(record=>({record,distance:distance(c.point,record.spatial.point),uncertainty:record.spatial.uncertainty_m,temporal:temporal(record,c.year)})).filter(x=>x.distance<=c.radius).sort((a,b)=>a.temporal.gap-b.temporal.gap||a.distance-b.distance);}

 function evidence(records,c){const photos=nearby(records,c).map(x=>x.record),ids=new Set(photos.map(r=>r.id));const notes=records.filter(r=>!photo(r)&&r.source_kind!=='generated'&&r.source_kind!=='archive_lead'&&((r.spatial&&distance(c.point,r.spatial.point)<=c.radius)||ArchiveFilter.districts(r).includes(c.district)));notes.sort((a,b)=>{const rank=r=>/Sanborn/i.test(r.title)?0:r.source_kind==='primary_document'?1:r.source_kind==='recollection'?2:3;return rank(a)-rank(b)||temporal(a,c.year).gap-temporal(b,c.year).gap;});return photos.concat(notes.filter(r=>!ids.has(r.id)));}
 function local(p,center){const r=Math.PI/180,k=6378137*Math.cos(center[1]*r);return {x:(p[0]-center[0])*r*k,z:-k*(Math.asinh(Math.tan(p[1]*r))-Math.asinh(Math.tan(center[1]*r)))};}
 function geographic(p,center){const r=Math.PI/180,k=6378137*Math.cos(center[1]*r);return [center[0]+p.x/(r*k),Math.atan(Math.sinh(Math.asinh(Math.tan(center[1]*r))-p.z/k))/r];}
 return {validPoint,distance,inside,areaForPoint,context,same,photo,photoDate,enrich,temporal,nearby,evidence,local,geographic};
})();
if(typeof module!=='undefined')module.exports=Spatial;
