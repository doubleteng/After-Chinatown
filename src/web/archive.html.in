<!doctype html>
<html lang="en"><head><base target="_blank"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Archive | After Chinatown</title>
<style>
:root{--paper:#f3f1e9;--card:#fffef9;--ink:#1c3735;--muted:#63716c;--line:#d1d7cd;--accent:#b3613f}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-underline-offset:4px}button,input,select{font:inherit;color:inherit}button{cursor:pointer}button:disabled{opacity:.6;cursor:wait}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}[hidden]{display:none!important}header{padding:22px 30px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:18.2px Georgia,serif;text-decoration:none}nav{display:flex;gap:20px;font-size:8.4px;flex-wrap:wrap}main{max-width:1440px;margin:auto;padding:38px 30px 60px}.eyebrow{font:7.7px ui-monospace,monospace;color:var(--accent);letter-spacing:.1em;text-transform:uppercase;margin:0 0 10px}h1{font:26.6px/1.2 Georgia,serif;letter-spacing:-.02em;margin:0 0 12px}.context{font:15.4px Georgia,serif;margin:0 0 13px;color:var(--accent)}.intro{max-width:790px;margin:0;font-size:9.1px;color:var(--muted)}.filters{margin:26px 0 20px;background:var(--card);border:1px solid var(--line);padding:18px;display:grid;grid-template-columns:2fr 1.5fr .7fr 1.5fr 1.5fr auto;gap:12px;align-items:end}.filters label{display:flex;flex-direction:column;gap:6px;font-size:11px}.filters input,.filters select{width:100%;min-width:0;border:1px solid var(--line);background:var(--paper);border-radius:3px;padding:9px 10px;font-size:12px;height:39px}.button{background:var(--ink);color:var(--card);border:1px solid var(--ink);border-radius:3px;padding:9px 14px;font-size:12px;min-height:39px}.quiet{background:transparent;color:var(--ink);border-color:var(--line)}.results-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}.count{font-size:12px;color:var(--muted);margin:0}.archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.archive-card{border:1px solid var(--line);background:var(--card);padding:17px;overflow-wrap:anywhere;display:flex;flex-direction:column;align-items:start}.archive-card img{display:block;width:100%;height:220px;object-fit:contain;background:#e5e4db;margin-bottom:14px}.archive-card h2{font:16.1px/1.3 Georgia,serif;margin:8px 0}.archive-card p{font-size:12px;margin:5px 0}.archive-card .date{font-size:11px;color:var(--accent);margin:0}.archive-card .place{font-weight:600}.archive-card .kind{font:10px ui-monospace,monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.archive-card a{font-size:12px;margin-top:12px}.archive-card .credit{font-size:10px;color:var(--muted);margin-top:12px}.archive-card button{margin-top:12px}.empty{padding:35px;background:var(--card);border:1px solid var(--line);max-width:750px}.empty h2{font:17.5px Georgia,serif;margin:0 0 10px}.empty p{font-size:13px;margin:8px 0;color:var(--muted)}.more{margin-top:23px}details{border-top:1px solid var(--line);padding-top:18px;margin-top:35px;font-size:13px}summary{cursor:pointer}#archive-map{height:320px;margin-top:15px;border:1px solid var(--line)}.map-note{font-size:11px;color:var(--muted)}footer{border-top:1px solid var(--line);padding:17px 30px;color:var(--muted);font:10px ui-monospace,monospace;display:flex;justify-content:space-between;gap:20px}.error{color:#8d412a}.validation{font-size:12px;color:#8d412a;margin-top:-8px}@media(max-width:1100px){.filters{grid-template-columns:2fr 1.5fr .7fr}.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){header{padding:20px;align-items:start;flex-direction:column;gap:12px}.brand{font-size:16.8px}main{padding:26px 18px 45px}h1{font-size:21.7px}.context{font-size:14px}.filters{grid-template-columns:1fr 1fr;padding:14px}.filters .search-label{grid-column:1/-1}.archive-grid{grid-template-columns:1fr}.archive-card img{height:240px}.results-head{align-items:start}footer{padding:17px 18px}.empty{padding:24px}}
</style><style id="heading-scale91-inherited">
header .button{font-size:8.4px}
summary{font-size:9.1px}
h3{font-size:.819em}h4{font-size:.7em}h5{font-size:.581em}h6{font-size:.469em}
</style></head><body>
<header><a class="brand" id="brand-home" target="_top">After Chinatown</a><nav aria-label="Archive navigation"><button id="language-switch" class="button quiet" type="button" aria-label="Switch to Chinese">中文</button><a id="back-to-scene" target="_top">Return to the scene</a><a id="browse-all" target="_blank" rel="noopener noreferrer" title="Opens in a new tab">Browse the archive ↗</a></nav></header>
<main><p class="eyebrow">Detroit / Historical sources</p><h1 id="page-heading">Browse the archive</h1><p class="context" id="archive-context" hidden></p><p class="intro" id="archive-intro">Explore photographs, maps, films and recollections of Chinese American life in Detroit. Check each record for its date and source.</p>
<form id="archive-filters" class="filters"><label class="search-label">Search<input id="archive-search" type="search" aria-label="Search the historical archive" placeholder="A person, address, activity…"></label><label>Place<select id="archive-place" aria-label="Filter archive by place"><option value="">All places</option><option value="old">Original Chinatown · Third / Porter</option><option value="new">Relocated Chinatown · Cass / Peterboro</option></select></label><label>Year<input id="archive-year" aria-label="Filter archive by year" type="number" min="1800" max="2026" step="1" placeholder="Any"></label><label><span id="archive-category-title80" data-no-translate>Record category</span><select id="archive-kind" aria-label="Filter archive by source type" data-no-translate><option value="">All ten categories</option><option value="municipal">Municipal building records</option><option value="property">Commercial property records</option><option value="commerce">Business use & occupancy</option><option value="transport">Municipal transport records</option><option value="news">News</option><option value="community">Online leads</option><option value="history">Historical archives</option><option value="oral">Oral history</option><option value="photo">Historical imagery</option><option value="map">Historical maps & surveys</option></select></label><label>Period<select id="archive-period" aria-label="Filter archive by date"><option value="">All dates, including unknown</option><option value="early">Before 1940</option><option value="middle">1940–1962</option><option value="later">1963–1999</option><option value="recent">2000 onward / recollections</option><option value="unknown">Unknown date</option></select></label><button class="button" type="submit">Apply filters</button></form>
<p class="validation" id="filter-error" role="status" hidden>Enter a year from 1800 to 2026, or leave it blank.</p>
<div class="results-head"><label style="font-size:12px"><input id="archive-batch80" type="checkbox"> <span id="archive-batch-label80" data-no-translate>Cass Corridor research · September 2026</span></label><p id="archive-count" class="count" role="status">Loading source records…</p><button class="button quiet" id="clear-filters" type="button">Clear filters</button></div><details id="archive-review80" style="margin:0 0 20px;padding:10px 0"><summary data-no-translate>About this source review</summary><p data-no-translate></p></details><div id="archive-grid" class="archive-grid"></div><div id="archive-empty" class="empty" hidden><h2>No matching sources yet</h2><p id="empty-message"></p><p>Try another year, or browse all dates and places.</p><a id="empty-browse" target="_blank" rel="noopener noreferrer">Browse the archive ↗</a></div><button id="archive-more" type="button" class="button more" hidden>Show more records</button>

</main><footer style="display:block;font-family:system-ui;line-height:1.6"><p style="font-size:14px">Designed and developed by <strong><a href="https://teng-teng.org/" target="_blank" rel="noopener noreferrer">Teng Teng</a> and Zhen Cheng</strong></p><p style="font:18px/1.5 Georgia,serif;max-width:900px">Preserving Chinese American urban memory as Detroit changes.</p><p>Historical materials are credited in their individual source records.</p><span id="build"></span></footer>
<script>__SCRIPT_archive-00.js.in__</script><script>__SCRIPT_archive-01.js.in__</script>
<script>__SCRIPT_archive-02.js.in__</script>
<script>__SCRIPT_archive-03.js.in__</script></body></html>
